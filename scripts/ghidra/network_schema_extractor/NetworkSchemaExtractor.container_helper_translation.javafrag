    private boolean translateContainerHelperMemberStorage(
        Function owner,
        PcodeOpAST call,
        Function target,
        List<ContainerCodecCall> members) {

        if (owner == null || call == null || target == null || members == null) {
            return false;
        }
        List<ContainerCodecCall> leaves = logicalContainerCodecLeaves(members);
        if (leaves == null || leaves.isEmpty()) {
            return false;
        }

        boolean complete = true;
        for (ContainerCodecCall leaf : leaves) {
            Integer formalSlot = pcodeParameterIndex(leaf.elementBase);
            if (formalSlot == null || leaf.elementOffset == null) {
                complete = false;
                continue;
            }
            PcodeStorage callerStorage = helperCallArgumentStorage(
                owner,
                call,
                target,
                formalSlot);
            Long translatedOffset = callerStorage == null
                ? null
                : addExactOrNull(callerStorage.offset, leaf.elementOffset);
            if (!isParameterStorage(callerStorage) || translatedOffset == null ||
                translatedOffset < 0L || translatedOffset > 0x100000L) {
                complete = false;
                continue;
            }
            leaf.elementBase = callerStorage.base;
            leaf.elementOffset = translatedOffset;
        }
        return complete;
    }

    private PcodeStorage helperCallArgumentStorage(
        Function owner,
        PcodeOpAST call,
        Function target,
        int formalSlot) {

        return provenCallArgumentStorage(owner, call, target, formalSlot);
    }
