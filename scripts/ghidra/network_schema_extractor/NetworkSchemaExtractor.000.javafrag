    private int nestedTypeShapesRecovered;
    private int nestedTypeShapeFailures;
    private final Map<String, Integer> nestedTypeShapeRejectCounts = new LinkedHashMap<>();
    private JsonArray containerValueShapeRejectSamples = new JsonArray();
    private JsonArray interproceduralCollectionCountSamples = new JsonArray();
    private final Map<String, Integer> countedCollectionRejectCounts = new LinkedHashMap<>();
    private JsonArray countedCollectionRejectSamples = new JsonArray();
    private JsonArray localVectorOwnerDiagnostics = new JsonArray();
    private final Set<String> localVectorOwnerDiagnosticKeys = new LinkedHashSet<>();
    private JsonArray nestedParentConsumptionDiagnostics = new JsonArray();
    private final Set<String> nestedParentConsumptionDiagnosticKeys =
        new LinkedHashSet<>();
    private int countedCollectionsRecovered;
    private int countedCollectionsApplied;
    private JsonArray countedCollectionRecoveredSamples = new JsonArray();
    private int recoveredFunctionCount;
    private int recoveredFunctionFailureCount;
    private int registerFieldLoopRecoveredFunctionCount;
    private int registerFieldLoopRecoveredCallCount;
    private final Map<String, Integer> registerFieldLoopRejectCounts = new LinkedHashMap<>();
    private int queuedRegistrationReferenceCount;
    private int queuedRegistrationDecodedCount;
    private int queuedRegistrationNoFunctionCount;
    private int queuedRegistrationNoHelperCount;
    private int queuedRegistrationNoTypeIdCount;
    private int directRegisterTypeReferenceCount;
    private int directRegisterTypeDecodedCount;
    private int directRegisterTypeCoveredCount;
    private int directRegisterTypeNoFunctionCount;
    private int directRegisterTypeNoTypeIdCount;
    private JsonArray queuedRegistrationFailureSamples = new JsonArray();
    private JsonArray directRegisterTypeFailureSamples = new JsonArray();

    @Override
    protected void run() throws Exception {
        resetAnalysisCachesForRun();
        NetworkSchemaControlFlow.setCancellationCheckpoint(this::checkAnalysisCancelled);
        try {
            runAnalysis();
        }
        catch (AnalysisCancelledException cancelled) {
            monitor.checkCancelled();
            throw cancelled;
        }
        finally {
            NetworkSchemaControlFlow.clearCancellationCheckpoint();
            releaseDecompilerResources();
        }
    }

    private void runAnalysis() throws Exception {
        println("NetworkSchemaExtractor version: " + EXTRACTOR_VERSION);
        AnalysisRequest analysis = analysisRequest();
        Set<Integer> selectedTypeIndices = analysis.typeIndices();
        boolean analyzeHandlersOnly = analysis.mode() == AnalysisMode.HANDLER_VTABLES;
        boolean focusedTypes = analysis.mode() == AnalysisMode.SELECTED_TYPES;
        boolean analyzeStates = !analyzeHandlersOnly;
        boolean analyzeMessages = !analyzeHandlersOnly;
        File input = inputFile();
        File output = outputFile(input, analysis);
        Address registerField = currentProgram.getImageBase().add(REGISTER_FIELD_RVA);

        long phaseStarted = runMetrics.startPhase();
        JsonObject root;
        try (Reader reader = new FileReader(input)) {
            root = JsonParser.parseReader(reader).getAsJsonObject();
        }
        loadSerializeTypeIndex(input);
        println("Phase load-inputs: " +
            runMetrics.finishPhase("load-inputs", phaseStarted) + " ms");

        if (analysis.mode() == AnalysisMode.FUNCTION_TRACE) {
            initializeDecompiler();
            JsonObject trace = countedCollectionFunctionTraces(analysis.functionAddress());
            File actualOutput = writeReportFile(output, trace, createGson());
            println("Wrote counted-collection trace: " + actualOutput.getAbsolutePath());
            return;
        }

        phaseStarted = runMetrics.startPhase();
        List<RegistryEntry> registry = parseRegistry(root);
        indexRegistryHandlerEntries(registry);
        println("Phase registry-parse: " +
            runMetrics.finishPhase("registry-parse", phaseStarted) + " ms");
        initializeDecompiler();

        if (analysis.mode() == AnalysisMode.HANDLER_VTABLES) {
            JsonObject selectedHandlers = selectedHandlerVtableReport(analysis.handlerVtables());
            File actualOutput = writeReportFile(output, selectedHandlers, createGson());
            println("Wrote selected handler report: " + actualOutput.getAbsolutePath());
            return;
        }

        List<RegistryEntry> analysisRegistry =
            selectedRegistryEntries(registry, selectedTypeIndices);
        if (!selectedTypeIndices.isEmpty()) {
            println("Selected TypeRegistry entries: " + selectedTypeIndices);
        }
        phaseStarted = runMetrics.startPhase();
        startAnalysisWorklist("registration-identities", 0);
        Map<String, HookTypeEvidence> hookTypeNamesById = analyzeHandlersOnly
            ? Collections.emptyMap()
            : focusedTypes
                ? collectSelectedRegistrationHookTypeNames(analysisRegistry)
                : collectRegistrationHookTypeNames(analysisRegistry);
        monitor.checkCancelled();
        registrationHooksByTypeId.clear();
        registrationHooksByTypeId.putAll(hookTypeNamesById);
        finishAnalysisWorklist("registration-identities", 0);
        println("Phase registration-identities: " +
            runMetrics.finishPhase("registration-identities", phaseStarted) + " ms");

        phaseStarted = runMetrics.startPhase();
        Map<String, RegistrationFunction> registrationFunctions = focusedTypes
            ? collectSelectedRegistrationFunctions(analysisRegistry)
            : collectRegistrationFunctions(registerField);
        monitor.checkCancelled();
        println("Phase dynamic-field-registration: " +
            runMetrics.finishPhase("dynamic-field-registration", phaseStarted) + " ms");

        phaseStarted = runMetrics.startPhase();
        if (!analyzeHandlersOnly) {
            collectDirectFieldTableRegistrationFunctions(
                analysisRegistry,
                registrationFunctions);
        }
        monitor.checkCancelled();
        println("Phase direct-field-registration: " +
            runMetrics.finishPhase("direct-field-registration", phaseStarted) + " ms");

        phaseStarted = runMetrics.startPhase();
        if (analyzeStates) {
            enrichRegistrationFieldHandlers(registrationFunctions);
            classifyReplicatedStateAbis(registrationFunctions.values());
        }
        monitor.checkCancelled();
        println("Phase field-handler-enrichment: " +
            runMetrics.finishPhase("field-handler-enrichment", phaseStarted) + " ms");

        JsonArray registryJson = new JsonArray();
        int mappedRegistryEntries = 0;
        int mappedFieldCount = 0;
        int mappedMessageEntries = 0;
        int mappedMessageFields = 0;
        int registryEntriesWithAzRtti = 0;
        int registryEntriesWithValueAzRtti = 0;
        int registryEntriesWithRegistrationTypeName = 0;
        int registryEntriesWithRecoveredTypeName = 0;
        int baseOrInterfaceRegistryEntries = 0;
        JsonArray identityFallbackJson = new JsonArray();
        JsonArray identityBlockerJson = new JsonArray();
        LinkedHashMap<String, Integer> identityBlockerCounts = new LinkedHashMap<>();
        phaseStarted = runMetrics.startPhase();
        int registryEntriesAnalyzed = 0;
        startAnalysisWorklist("registry-analysis", analysisRegistry.size());
        long registryHeartbeat = System.nanoTime();
        for (RegistryEntry entry : analyzeHandlersOnly
                ? Collections.<RegistryEntry>emptyList()
                : analysisRegistry) {
            registryHeartbeat = updateAnalysisWorklist(
                "registry-analysis",
                registryEntriesAnalyzed,
                analysisRegistry.size(),
                registryProgressDetail(entry),
                registryHeartbeat);
            registryEntriesAnalyzed++;
            List<RegistrationFunction> matches =
                constructorMatches(entry, registrationFunctions);
            if (!matches.isEmpty() && !analyzeStates || matches.isEmpty() && !analyzeMessages) {
                continue;
            }
            long registryEntryStarted = System.nanoTime();
            long requestsBefore = runMetrics.counter("highFunctionRequests");
            long missesBefore = runMetrics.counter("highFunctionMisses");
            long pcodeMissesBefore = runMetrics.counter("pcodeMemoryPathMisses");
            AzRttiEvidence resolvedRtti =
                resolvedAzRtti(entry, matches);
            HookTypeEvidence hookType = registrationHookForEntry(entry, hookTypeNamesById);
            TypeNameEvidence recoveredTypeName =
                resolvedTypeName(resolvedRtti, hookType, matches);
            AzRttiEvidence valueRtti = matches.isEmpty()
                ? resolvedValueAzRtti(entry, resolvedRtti, hookType, recoveredTypeName)
                : null;
            if (resolvedRtti != null) {
                registryEntriesWithAzRtti++;
            }
            if (valueRtti != null) {
                registryEntriesWithValueAzRtti++;
            }
            if (hookType != null && isPlausibleTypeName(hookType.typeName)) {
                registryEntriesWithRegistrationTypeName++;
            }
            if (recoveredTypeName != null &&
                isPlausibleTypeName(recoveredTypeName.typeName)) {
                registryEntriesWithRecoveredTypeName++;
            }
            if (isBaseOrInterfaceRegistryEntry(entry, resolvedRtti)) {
                baseOrInterfaceRegistryEntries++;
            }
            if (isRegistryTypeNameFallback(hookType)) {
                identityFallbackJson.add(identityFallbackJson(
                    entry,
                    resolvedRtti,
                    hookType,
                    recoveredTypeName,
                    matches));
            }
            String identityBlockerReason =
                identityBlockerReason(
                    entry,
                    resolvedRtti,
                    valueRtti,
                    hookType,
                    recoveredTypeName,
                    matches);
            if (identityBlockerReason != null) {
                incrementCount(identityBlockerCounts, identityBlockerReason);
                identityBlockerJson.add(identityBlockerJson(
                    entry,
                    resolvedRtti,
                    valueRtti,
                    hookType,
                    recoveredTypeName,
                    matches,
                    identityBlockerReason));
            }
            JsonObject row = entry.toJson(resolvedRtti, valueRtti, hookType, recoveredTypeName);
            if (!matches.isEmpty()) {
                mappedRegistryEntries++;
                ReplicatedStateAbiEvidence replicatedStateAbi =
                    replicatedStateAbiEvidence(matches);
                if (replicatedStateAbi != null) {
                    row.add("replicatedStateAbi", replicatedStateAbi.toJson(addressFormatter));
                }
                JsonArray constructorJson = new JsonArray();
                JsonArray fieldJson = new JsonArray();
                for (RegistrationFunction match : matches) {
                    mappedFieldCount += match.fields.size();
                    constructorJson.add(match.toJson());
                    for (FieldCall field : match.fields) {
                        fieldJson.add(field.toJson());
                    }
                }
                row.add("fields", fieldJson);
                row.add("constructorMatches", constructorJson);
            }
            else {
                MessageMarshalPlan marshalPlan = recoverMessageMarshalPlan(entry);
                MessageUnmarshalPlan messagePlan = recoverMessageUnmarshalPlan(entry);
                marshalPlan = recoverConcreteDelegatedFragmentMarshalPlan(
                    entry,
                    marshalPlan,
                    messagePlan);
                marshalPlan = recoverConcreteVirtualMessageMarshalPlan(
                    entry,
                    marshalPlan,
                    messagePlan);
                reconcileMessageCollectionShapes(entry, messagePlan);
                alignMessageMarshalFieldsToUnmarshal(marshalPlan, messagePlan);
                refineMessageUnmarshalCapability(messagePlan, marshalPlan);
                classifyMessageAnalysis(messagePlan, marshalPlan);
                if (marshalPlan != null) {
                    row.add("messageMarshal", marshalPlan.toJson(addressFormatter));
                }
                if (messagePlan != null) {
                    row.add("messageUnmarshal", messagePlan.toJson());
                    if (!messagePlan.fields.isEmpty()) {
                        mappedMessageEntries++;
                        mappedMessageFields += messagePlan.fields.size();
                        JsonArray fieldJson = new JsonArray();
                        for (FieldCall field : messagePlan.fields) {
                            fieldJson.add(field.toJson());
                        }
                        row.add("fields", fieldJson);
                    }
                    else if (messagePlan.emptyWireProven) {
                        mappedMessageEntries++;
                    }
                }
            }
            recordRegistryAnalysisCost(
                entry,
                row,
                registryEntryStarted,
                requestsBefore,
                missesBefore,
                pcodeMissesBefore);
            registryJson.add(row);
        }
        updateAnalysisWorklist(
            "registry-analysis",
            registryEntriesAnalyzed,
            analysisRegistry.size(),
            "high-function-misses=" + runMetrics.counter("highFunctionMisses") +
                ", recompilations=" + runMetrics.counter("highFunctionRecompilations"),
            registryHeartbeat);
        finishAnalysisWorklist("registry-analysis", analysisRegistry.size());
        println("Phase registry-analysis: " +
            runMetrics.finishPhase("registry-analysis", phaseStarted) + " ms");

        phaseStarted = runMetrics.startPhase();
        JsonArray functionJson = new JsonArray();
        int dynamicFieldCount = 0;
        for (RegistrationFunction function : registrationFunctions.values()) {
            dynamicFieldCount += function.fields.size();
            functionJson.add(function.toJson());
        }
        JsonArray fieldHandlerVtableJson = fieldHandlerVtablesJson(registrationFunctions);
        JsonObject fieldWireShapeDiagnostics = fieldWireShapeDiagnostics(registryJson);
        println("Phase handler-analysis: " +
            runMetrics.finishPhase("handler-analysis", phaseStarted) + " ms");

        JsonObject report = new JsonObject();
        report.addProperty("schema", "newworld.network_schema.static.v1");
        report.addProperty("extractorVersion", EXTRACTOR_VERSION);
        report.addProperty("cacheSchemaVersion", CACHE_SCHEMA_VERSION);
        report.addProperty("analysisMode", analysis.mode().jsonName);
        if (!selectedTypeIndices.isEmpty()) {
            JsonArray selectedTypeIndicesJson = new JsonArray();
            selectedTypeIndices.forEach(selectedTypeIndicesJson::add);
            report.add("selectedTypeIndices", selectedTypeIndicesJson);
        }
        report.addProperty("program", currentProgram.getName());
        report.addProperty("imageBase", formatAddress(currentProgram.getImageBase()));
        report.addProperty("input", input.getAbsolutePath());
        report.addProperty("registerField", formatAddress(registerField));

        JsonObject summary = new JsonObject();
        summary.addProperty("typeregistryEntries", registry.size());
        summary.addProperty("analyzedRegistryEntries", analysisRegistry.size());
        NetworkSchemaJson.add(summary, "typeIndexSlots", typeIndexSlotCount(root));
        NetworkSchemaJson.add(summary, "registeredTypes", registeredTypeCount(root, registry.size()));
        Integer assetOnlyTypeIndexSlots = assetOnlyTypeIndexSlotCount(root, registry.size());
        NetworkSchemaJson.add(summary, "assetOnlyTypeIndexSlots", assetOnlyTypeIndexSlots);
        summary.addProperty("installRegistrationHooks", hookTypeNamesById.size());
        summary.addProperty("fieldRegistrationFunctions", registrationFunctions.size());
        summary.addProperty("fieldRegistrationCalls", dynamicFieldCount);
        summary.addProperty("fieldHandlerVtables", fieldHandlerVtableJson.size());
        summary.addProperty("mappedRegistryEntries", mappedRegistryEntries);
        summary.addProperty("mappedRegistryFields", mappedFieldCount);
        summary.addProperty("mappedMessageEntries", mappedMessageEntries);
        summary.addProperty("mappedMessageFields", mappedMessageFields);
        summary.addProperty("pcodeMessageFieldCandidates", pcodeMessageFieldCandidateCount);
        summary.addProperty("pcodeMessageFieldsAccepted", pcodeMessageFieldAcceptedCount);
        summary.addProperty("pcodeMessageFieldsRejected", pcodeMessageFieldRejectedCount);
        summary.add("pcodeMessageFieldRejectSummary", countMapJson(pcodeMessageFieldRejectCounts));
        summary.addProperty("nestedTypeShapesRecovered", nestedTypeShapesRecovered);
        summary.addProperty("nestedTypeShapeFailures", nestedTypeShapeFailures);
        summary.add("nestedTypeShapeRejectSummary", countMapJson(nestedTypeShapeRejectCounts));
        summary.addProperty(
            "fieldsMissingWireShape",
            integer(fieldWireShapeDiagnostics, "missingWireShapeFields"));
        summary.addProperty(
            "fieldsMissingWireShapeWithNestedTypeShape",
            integer(fieldWireShapeDiagnostics, "missingWireShapeWithNestedTypeShape"));
        summary.addProperty(
            "fieldsMissingWireShapeWithoutNestedTypeShape",
            integer(fieldWireShapeDiagnostics, "missingWireShapeWithoutNestedTypeShape"));
        summary.addProperty("recoveredFunctions", recoveredFunctionCount);
        summary.addProperty("recoveredFunctionFailures", recoveredFunctionFailureCount);
        summary.addProperty("registryEntriesWithAzRtti", registryEntriesWithAzRtti);
        summary.addProperty("registryEntriesWithValueAzRtti", registryEntriesWithValueAzRtti);
        summary.addProperty(
            "registryEntriesWithRegistrationTypeName",
            registryEntriesWithRegistrationTypeName);
        summary.addProperty(
            "registryEntriesWithRecoveredTypeName",
            registryEntriesWithRecoveredTypeName);
        summary.addProperty(
            "baseOrInterfaceRegistryEntries",
            baseOrInterfaceRegistryEntries);
        summary.addProperty("registryTypeNameFallbacks", identityFallbackJson.size());
        summary.addProperty("identityBlockers", identityBlockerJson.size());
        report.add("summary", summary);

        JsonObject identityDiagnostics = new JsonObject();
        identityDiagnostics.add("registryTypeNameFallbacks", identityFallbackJson);
        identityDiagnostics.add("identityBlockers", identityBlockerJson);
        identityDiagnostics.add("identityBlockerSummary", countMapJson(identityBlockerCounts));
        report.add("identityDiagnostics", identityDiagnostics);

        report.add(
            "containerValueShapeDiagnostics",
            containerValueShapeDiagnosticsJson());
        report.add("fieldWireShapeDiagnostics", fieldWireShapeDiagnostics);
        report.add("replicatedStateAbiDiagnostics", replicatedStateAbiDiagnostics);

        JsonObject registrationEvidenceDiagnostics = new JsonObject();
        registrationEvidenceDiagnostics.addProperty(
            "queuedReferenceCount",
            queuedRegistrationReferenceCount);
        registrationEvidenceDiagnostics.addProperty(
            "queuedDecodedCount",
            queuedRegistrationDecodedCount);
        registrationEvidenceDiagnostics.addProperty(
            "queuedNoFunctionCount",
            queuedRegistrationNoFunctionCount);
        registrationEvidenceDiagnostics.addProperty(
            "queuedNoHelperCount",
            queuedRegistrationNoHelperCount);
        registrationEvidenceDiagnostics.addProperty(
            "queuedNoTypeIdCount",
            queuedRegistrationNoTypeIdCount);
        registrationEvidenceDiagnostics.add("queuedFailureSamples", queuedRegistrationFailureSamples);
        registrationEvidenceDiagnostics.addProperty(
            "directReferenceCount",
            directRegisterTypeReferenceCount);
        registrationEvidenceDiagnostics.addProperty(
            "directDecodedCount",
            directRegisterTypeDecodedCount);
        registrationEvidenceDiagnostics.addProperty(
            "directCoveredCount",
            directRegisterTypeCoveredCount);
        registrationEvidenceDiagnostics.addProperty(
            "directNoFunctionCount",
            directRegisterTypeNoFunctionCount);
        registrationEvidenceDiagnostics.addProperty(
            "directNoTypeIdCount",
            directRegisterTypeNoTypeIdCount);
        registrationEvidenceDiagnostics.addProperty(
            "registerFieldLoopRecoveredFunctionCount",
            registerFieldLoopRecoveredFunctionCount);
        registrationEvidenceDiagnostics.addProperty(
            "registerFieldLoopRecoveredAdditionalCallCount",
            registerFieldLoopRecoveredCallCount);
        registrationEvidenceDiagnostics.add(
            "registerFieldLoopRejectSummary",
            countMapJson(registerFieldLoopRejectCounts));
        registrationEvidenceDiagnostics.add(
            "directFailureSamples",
            directRegisterTypeFailureSamples);
        report.add("registrationEvidenceDiagnostics", registrationEvidenceDiagnostics);

        JsonObject registrationInvariants =
            registrationInvariants(hookTypeNamesById, registry);
        report.add("registrationInvariants", registrationInvariants);

        report.add("codecTraceDiagnostics", codecTraceDiagnosticsJson());

        report.add("registryEntries", registryJson);
        report.add("installRegistrationHooks", hookTypeNamesJson(hookTypeNamesById));
        report.add("fieldRegistrationFunctions", functionJson);
        report.add("fieldHandlerVtables", fieldHandlerVtableJson);
        JsonObject performance = runMetrics.toJson();
        performance.addProperty(
            "integerEvaluatorQueries",
            NetworkSchemaIntegerEvaluator.queryCount());
        performance.addProperty(
            "integerEvaluatorExactCacheHits",
            NetworkSchemaIntegerEvaluator.exactCacheHitCount());
        performance.addProperty(
            "integerEvaluatorBitCacheHits",
            NetworkSchemaIntegerEvaluator.bitCacheHitCount());
        performance.addProperty(
            "integerEvaluatorBudgetExhaustions",
            NetworkSchemaIntegerEvaluator.budgetExhaustionCount());
        performance.add(
            "highFunctionRecompileHotspots",
            highFunctionRecompileHotspotsJson());
        performance.add("highFunctionFailureSamples", highFunctionFailureSamples.deepCopy());
        performance.add("registryAnalysisHotspots", registryAnalysisHotspotsJson());
        report.add("performance", performance);

        File actualOutput = writeReportFile(output, report, gson);

        println("Wrote network schema static report: " + actualOutput.getAbsolutePath());
        println("RegisterField functions: " + registrationFunctions.size() +
            ", calls: " + dynamicFieldCount +
            ", mapped registry entries: " + mappedRegistryEntries);
        println("RegisterField loop recovery: functions=" +
            registerFieldLoopRecoveredFunctionCount +
            ", additional calls=" + registerFieldLoopRecoveredCallCount);
        println("Registration invariants: hook UUIDs not in registry=" +
            registrationInvariants.get("hookUuidsNotInRegistryCount").getAsInt() +
            ", zero UUIDs=" +
            registrationInvariants.get("zeroUuidDecodedCount").getAsInt() +
            ", name mismatches=" +
            registrationInvariants.get("decodedButNameMismatchCount").getAsInt() +
            ", native rejects=" + countMapJson(nativeUuidRejectCounts));
        println("Extractor caches: highFunctions=" + cacheSizeWithLimit(
                highFunctionCache.size(),
                HIGH_FUNCTION_CACHE_LIMIT) +
            ", smallHighFunctions=" + cacheSizeWithLimit(
                smallHighFunctionCache.size(),
                SMALL_HIGH_FUNCTION_CACHE_LIMIT) +
            ", instructions=" + cacheSizeWithLimit(
                functionInstructionsCache.size(),
                FUNCTION_INSTRUCTION_CACHE_LIMIT) +
            ", functions=" + cacheSizeWithLimit(
                functionLookupCache.size(),
                FUNCTION_LOOKUP_CACHE_LIMIT) +
            ", marshalLeaves=" + cacheSizeWithLimit(
                marshalLeafCache.size(),
                CODEC_CLASSIFICATION_CACHE_LIMIT) +
            ", unmarshalLeaves=" + cacheSizeWithLimit(
                unmarshalLeafCache.size(),
                CODEC_CLASSIFICATION_CACHE_LIMIT) +
            ", integerEvaluatorBudgetExhaustions=" +
                NetworkSchemaIntegerEvaluator.budgetExhaustionCount());
        println("Extractor performance: " + performance);
    }
