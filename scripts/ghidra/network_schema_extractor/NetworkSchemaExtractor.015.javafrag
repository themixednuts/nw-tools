    private TypeNameDecode decodeAzRttiTypeNameProvider(Address function) {
        Address provider = resolvedCodeTarget(function);
        return decodeTypeNameFromReturnFlow(function, provider);
    }

    private Address resolvedCodeTarget(Address address) {
        Address current = address;
        LinkedHashSet<String> seen = new LinkedHashSet<>();
        while (true) {
            if (!isExecutableAddress(current)) {
                return current;
            }
            if (!seen.add(current.toString())) {
                return current;
            }

            Address target = terminalJumpTarget(current);
            if (target != null && !target.equals(current)) {
                current = target;
                continue;
            }
            return current;
        }
    }

    private Address terminalJumpTarget(Address address) {
        if (!isExecutableAddress(address)) {
            return null;
        }
        Address cursor = address;
        for (int i = 0; i < 32; i++) {
            Instruction instruction = currentProgram.getListing().getInstructionAt(cursor);
            if (instruction == null) {
                return null;
            }
            String mnemonic = NetworkSchemaX86.upperMnemonic(instruction);
            if ("JMP".equals(mnemonic)) {
                Address target = branchTarget(instruction);
                return isProgramAddress(target) ? target : null;
            }
            if (mnemonic != null && (mnemonic.startsWith("RET") || mnemonic.startsWith("INT"))) {
                return null;
            }
            if (!isThunkPassThroughInstruction(instruction)) {
                return null;
            }
            Address fallThrough = instruction.getFallThrough();
            if (fallThrough == null || !isProgramAddress(fallThrough)) {
                return null;
            }
            cursor = fallThrough;
        }
        return null;
    }

    private boolean isThunkPassThroughInstruction(Instruction instruction) {
        String mnemonic = NetworkSchemaX86.upperMnemonic(instruction);
        if (mnemonic == null) {
            return false;
        }
        if ("NOP".equals(mnemonic)) {
            return true;
        }
        if ("MOV".equals(mnemonic) || "LEA".equals(mnemonic)) {
            String destination = NetworkSchemaX86.registerOperand(instruction, 0);
            return destination != null &&
                ("RAX".equals(destination) ||
                    "RCX".equals(destination) ||
                    "RDX".equals(destination) ||
                    "R8".equals(destination) ||
                    "R9".equals(destination));
        }
        return false;
    }

    private Address branchTarget(Instruction instruction) {
        Address target = callTarget(instruction);
        if (isProgramAddress(target)) {
            return target;
        }

        for (Address referenced : referencedAddresses(instruction)) {
            if (isExecutableAddress(referenced)) {
                return referenced;
            }

            Address indirect = readPointer(referenced);
            if (isProgramAddress(indirect)) {
                return indirect;
            }
        }

        return null;
    }

    private HandlerWireShapeEvidence classifyHandlerWireShape(
        Address marshal,
        Address marshalTarget,
        Address unmarshal,
        Address unmarshalTarget) {

        HandlerWireShapeEvidence evidence = new HandlerWireShapeEvidence();
        Address effectiveMarshal = marshalTarget == null ? marshal : marshalTarget;
        Address effectiveUnmarshal = unmarshalTarget == null ? unmarshal : unmarshalTarget;
        evidence.marshal = classifyMarshalPath(effectiveMarshal, evidence);
        evidence.unmarshal = classifyUnmarshalPath(effectiveUnmarshal, evidence);
        reconcileHandlerWireShape(evidence);
        return evidence;
    }
    private WireShape classifyUnmarshalPath(
        Address address,
        HandlerWireShapeEvidence evidence) {

        Address targetAddress = resolvedCodeTarget(address);
        if (!isExecutableAddress(targetAddress)) {
            evidence.unmarshalDiagnostic = "unmarshal-target-not-executable";
            return null;
        }
        Function function = functionAtOrContaining(targetAddress);
        if (function == null) {
            evidence.unmarshalDiagnostic = "unmarshal-function-missing";
            return null;
        }
        List<String> readBufferParameters = readBufferParameters(function);
        if (readBufferParameters.size() != 1) {
            evidence.unmarshalDiagnostic = readBufferParameters.isEmpty()
                ? "read-buffer-root-missing"
                : "read-buffer-root-ambiguous:" + String.join(",", readBufferParameters);
            return null;
        }
        String readBufferParameter = readBufferParameters.get(0);
        evidence.unmarshalReadBufferParameter = readBufferParameter;
        WireShape fixedArray = fixedArrayLoopWireShape(
            function,
            readBufferParameter,
            NetworkSchemaCodecClassifier.CodecDirection.DECODE);
        if (fixedArray != null) {
            evidence.unmarshalDiagnostic = "proven-fixed-array";
            return fixedArray;
        }
        FixedSequenceShape fixedSequence = fixedSequenceShape(
            function,
            readBufferParameter,
            NetworkSchemaCodecClassifier.CodecDirection.DECODE);
        if (fixedSequence != null && fixedSequence.wireEvidence != null) {
            evidence.unmarshalSequence = fixedSequence;
            evidence.unmarshalDiagnostic = "proven-fixed-sequence";
            return fixedSequence.wireEvidence;
        }
        CodecWireTrace trace = traceUnmarshalCodec(
            function,
            readBufferParameter,
            codecWireTraceActiveContexts,
            codecWireTraceCompletedContexts);
        if (trace == null) {
            evidence.unmarshalDiagnostic = "unmarshal-codec-trace-missing:" +
                Objects.toString(
                    codecWireTraceDiagnostic(
                        function,
                        new PcodeStorage(readBufferParameter, 0L)),
                    "unknown");
            return null;
        }
        evidence.unmarshalEventCount = trace.events.size();
        evidence.unmarshalEvents.addAll(trace.events);
        WireShape countedSequence = handlerCountedUnmarshalShape(
            function,
            readBufferParameter,
            trace.events);
        if (countedSequence != null) {
            evidence.unmarshalDiagnostic = "proven-counted-sequence";
            return countedSequence;
        }
        WireShape quantizedVec3 = quantizedVec3UnmarshalShape(
            function,
            readBufferParameter,
            trace.events,
            evidence);
        if (quantizedVec3 != null) {
            evidence.unmarshalDiagnostic = "proven-quantized-vec3";
            return quantizedVec3;
        }
        WireShape ordered = orderedCodecWireEvidence(
            trace.events,
            "unmarshal-pcode-call-stack");
        evidence.unmarshalDiagnostic = ordered == null
            ? "unmarshal-codec-sequence-incomplete:" + trace.events.size()
            : trace.events.size() == 1
                ? "proven"
                : "proven-ordered-composite:" + trace.events.size();
        return ordered;
    }
    private void reconcileHandlerWireShape(HandlerWireShapeEvidence evidence) {
        if (!reconcileFixedSequenceShape(evidence)) {
            return;
        }
        if (evidence.selectedSequence != null &&
            evidence.marshalSequence == null &&
            evidence.unmarshalSequence != null) {
            evidence.selected = evidence.selectedSequence.wireEvidence;
            evidence.resolution = "bounded-marshal+fixed-unmarshal-agreement";
            return;
        }
        WireShape marshal = evidence.marshal;
        WireShape unmarshal = evidence.unmarshal;
        if (marshal == null && unmarshal == null) {
            evidence.resolution = "no-codec-evidence";
            return;
        }
        if (marshal == null || unmarshal == null) {
            evidence.selected = marshal == null ? unmarshal : marshal;
            evidence.resolution = marshal == null
                ? "unmarshal-only"
                : "marshal-only";
            return;
        }
        boolean exactLayoutAgreement = Objects.equals(marshal.layout, unmarshal.layout);
        if (!exactLayoutAgreement) {
            Integer marshalWidth = wireShapeByteWidth(marshal.layout);
            Integer unmarshalWidth = wireShapeByteWidth(unmarshal.layout);
            WireShape semantic = unmarshal.hasProvenSemantics()
                ? unmarshal
                : marshal.hasProvenSemantics() ? marshal : null;
            Integer semanticWidth = semantic == null
                ? null
                : wireShapeByteWidth(semantic.shape);
            if (marshalWidth == null || unmarshalWidth == null || semanticWidth == null ||
                !marshalWidth.equals(unmarshalWidth) || !marshalWidth.equals(semanticWidth)) {
                evidence.conflict = "marshal/unmarshal layout disagreement";
                evidence.resolution = "conflict";
                return;
            }
        }
        if (marshal.hasProvenSemantics() && unmarshal.hasProvenSemantics() &&
            !compatibleWireSemantics(marshal.shape, unmarshal.shape)) {
            evidence.conflict = "marshal/unmarshal semantic disagreement";
            evidence.resolution = "conflict";
            return;
        }

        WireShape semantic = unmarshal.hasProvenSemantics()
            ? unmarshal
            : marshal.hasProvenSemantics() ? marshal : null;
        if (semantic != null) {
            evidence.selected = WireShape.semantic(
                semantic.shape,
                semantic.layout,
                marshal.hasProvenSemantics() && unmarshal.hasProvenSemantics()
                    ? "marshal+unmarshal-pcode-agreement"
                    : unmarshal.hasProvenSemantics()
                        ? "unmarshal-semantics+marshal-layout-agreement"
                        : "marshal-semantics+unmarshal-layout-agreement");
            evidence.resolution = exactLayoutAgreement
                ? "semantic-layout-agreement"
                : "semantic-fixed-width-layout-agreement";
            return;
        }
        evidence.selected = WireShape.layout(
            marshal.layout,
            "marshal+unmarshal-pcode-layout-agreement");
        evidence.resolution = "layout-agreement";
    }

    private boolean compatibleWireSemantics(String left, String right) {
        if (Objects.equals(left, right) ||
            isSemanticDecomposition(left, right) ||
            isSemanticDecomposition(right, left)) {
            return true;
        }
        List<String> leftMembers = compositeWireShapeMembers(left);
        List<String> rightMembers = compositeWireShapeMembers(right);
        return leftMembers != null && rightMembers != null &&
            compatibleWireSemanticMembers(leftMembers, rightMembers);
    }

    private List<String> compositeWireShapeMembers(String shape) {
        if (shape == null || !shape.startsWith("composite<") ||
            !shape.endsWith(">")) {
            return null;
        }
        List<String> members = NetworkSchemaText.splitTopLevel(
            shape.substring("composite<".length(), shape.length() - 1));
        return members.isEmpty() ? null : members;
    }

    private boolean compatibleWireSemanticMembers(
        List<String> left,
        List<String> right) {

        int leftIndex = 0;
        int rightIndex = 0;
        while (leftIndex < left.size() && rightIndex < right.size()) {
            String leftMember = left.get(leftIndex);
            String rightMember = right.get(rightIndex);
            if (compatibleWireSemantics(leftMember, rightMember)) {
                leftIndex++;
                rightIndex++;
                continue;
            }
            int rightWidth = semanticMemberCount(leftMember, right, rightIndex);
            if (rightWidth > 0) {
                leftIndex++;
                rightIndex += rightWidth;
                continue;
            }
            int leftWidth = semanticMemberCount(rightMember, left, leftIndex);
            if (leftWidth <= 0) {
                return false;
            }
            leftIndex += leftWidth;
            rightIndex++;
        }
        return leftIndex == left.size() && rightIndex == right.size();
    }

    private int semanticMemberCount(
        String semantic,
        List<String> members,
        int start) {

        List<String> expected = semanticMembers(semantic);
        if (expected == null || start < 0 || start + expected.size() > members.size()) {
            return 0;
        }
        for (int index = 0; index < expected.size(); index++) {
            if (!expected.get(index).equals(members.get(start + index))) {
                return 0;
            }
        }
        return expected.size();
    }

    private List<String> semanticMembers(String semantic) {
        if (semantic != null && semantic.startsWith("delta-vec3<") &&
            semantic.endsWith(">")) {
            return List.of("u8", "u8", "u8");
        }
        return switch (semantic) {
            case "vec2" -> List.of("f32", "f32");
            case "vec3" -> List.of("f32", "f32", "f32");
            case "vec4" -> List.of("f32", "f32", "f32", "f32");
            case "quat" -> List.of("f32", "f32", "f32", "f32");
            case "vec2-comp" -> List.of("half-f32", "half-f32");
            case "vec3-comp", "vec3-comp-norm" ->
                List.of("half-f32", "half-f32", "half-f32");
            case "quat-comp", "quat-comp-norm" ->
                List.of("half-f32", "half-f32", "half-f32", "half-f32");
            case "aabb2d" -> List.of("vec2", "vec2");
            case "aabb3d" -> List.of("vec3", "vec3");
            case "mat3" -> List.of("vec3", "vec3", "vec3");
            case "affine3", "transform" -> List.of("vec3", "vec3", "vec3", "vec3");
            case "actor-ref" ->
                List.of("fixed-bytes-4", "fixed-bytes-16", "fixed-bytes-16");
            default -> null;
        };
    }

    private boolean isSemanticDecomposition(String semantic, String decomposition) {
        if (semantic == null || decomposition == null) {
            return false;
        }
        List<String> expected = semanticMembers(semantic);
        List<String> observed = compositeWireShapeMembers(decomposition);
        if (expected == null || observed == null ||
            expected.size() != observed.size()) {
            return false;
        }
        for (int index = 0; index < expected.size(); index++) {
            if (!sameCodecProduct(expected.get(index), observed.get(index)) &&
                !Objects.equals(expected.get(index), observed.get(index))) {
                return false;
            }
        }
        return true;
    }

    private boolean reconcileFixedSequenceShape(HandlerWireShapeEvidence evidence) {
        FixedSequenceShape marshal = evidence.marshalSequence;
        FixedSequenceShape unmarshal = evidence.unmarshalSequence;
        if (marshal == null && unmarshal == null) {
            return true;
        }
        if (marshal == null && unmarshal != null &&
            hasExactBoundedMarshalAgreement(evidence.marshal, unmarshal)) {
            evidence.selectedSequence = unmarshal;
            return true;
        }
        if (marshal == null || unmarshal == null) {
            evidence.conflict = marshal == null
                ? "fixed-sequence marshal evidence missing or inconsistent"
                : "fixed-sequence unmarshal evidence missing";
            evidence.resolution = "conflict";
            return false;
        }
        if (!marshal.sameStorageAndWire(unmarshal)) {
            evidence.conflict = "marshal/unmarshal fixed-sequence disagreement";
            evidence.resolution = "conflict";
            return false;
        }
        FixedSequenceShape selected = unmarshal;
        if (selected.elementTypeInfo == null && marshal.elementTypeInfo != null) {
            selected = selected.withElementTypeInfo(
                marshal.elementTypeInfo,
                "marshal+unmarshal-fixed-sequence-agreement");
        }
        evidence.selectedSequence = selected;
        return true;
    }

    private boolean hasExactBoundedMarshalAgreement(
        WireShape marshal,
        FixedSequenceShape unmarshal) {

        return marshal != null && marshal.hasProvenSemantics() &&
            "cfg-bounded-inline-sequence".equals(marshal.source) &&
            unmarshal.wireEvidence != null &&
            Objects.equals(marshal.shape, unmarshal.wireEvidence.shape);
    }

    private ContainerWireShape classifyReplicatedContainerWireShape(Address vtable) {
        Address marshal = readPointer(vtable.add(FIELD_HANDLER_MARSHAL_SLOT * 8L));
        Address marshalFull = readPointer(vtable.add(14L * 8L));
        Address unmarshalFull = readPointer(vtable.add(15L * 8L));
        if (!hasReplicatedContainerVtableAbi(vtable) ||
            !isExecutableAddress(marshalFull) ||
            !isExecutableAddress(unmarshalFull)) {
            return null;
        }

        ArrayList<WireShape> deltaShapeEvidence = new ArrayList<>();
        collectOrderedMarshalShapes(marshal, "param_2", deltaShapeEvidence);
        ArrayList<WireShape> fullShapeEvidence = new ArrayList<>();
        collectOrderedMarshalShapes(marshalFull, "param_2", fullShapeEvidence);
        FullContainerPlanRecovery fullContainerRecovery =
            recoverFullContainerPlan(marshalFull);
        List<String> deltaTokens = wireEvidenceTokens(deltaShapeEvidence);
        List<String> fullTokens = wireEvidenceTokens(fullShapeEvidence);
        WireShape pairedSingleValueShape =
            pairedContainerWireShapeFromDeltaKeyAndFullValue(deltaTokens, fullTokens);
        boolean structuredValue = hasStructuredContainerValue(deltaTokens, fullTokens);
        String deltaLayout = structuredValue
            ? null
            : containerShapeFromDeltaMarshalShapes(deltaTokens);
        String fullLayout = structuredValue
            ? null
            : containerShapeFromFullMarshalShapes(fullTokens);
        String primaryLayout = pairedSingleValueShape != null
            ? pairedSingleValueShape.shape
            : deltaLayout == null ? fullLayout : deltaLayout;
        reconcileFullContainerValueSemantics(
            fullContainerRecovery.plan,
            unmarshalFull);
        reconcileFullContainerUnmarshalSemantics(
            fullContainerRecovery.plan,
            unmarshalFull);
        WireShape planShape = completeFullContainerIndexMapWireShape(
            fullContainerRecovery.plan);
        List<NativeTypeInfoEvidence> valueTypeInfoCandidates =
            collectReplicatedContainerValueTypeInfoCandidates(
                marshal,
                marshalFull,
                readPointer(vtable.add(FIELD_HANDLER_UNMARSHAL_SLOT * 8L)),
                unmarshalFull,
                fullContainerRecovery.plan);
        NestedTypeShape valueTypeShape = replicatedContainerExactValueTypeShapeFromPcode(
            valueTypeInfoCandidates,
            unmarshalFull,
            vtable,
            fullContainerRecovery.plan);
        discardUnprovenContainerTypeId(valueTypeShape);
        List<NativeTypeInfoEvidence> provenValueTypeInfoCandidates =
            provenReplicatedContainerValueTypeInfoCandidates(
                valueTypeInfoCandidates,
                valueTypeShape);
        NativeTypeInfoEvidence valueTypeInfo =
            selectedReplicatedContainerValueTypeInfo(
                provenValueTypeInfoCandidates,
                valueTypeShape);
        boolean semanticsProven =
            deltaShapeEvidence.stream().allMatch(WireShape::hasProvenSemantics) &&
            fullShapeEvidence.stream().allMatch(WireShape::hasProvenSemantics);
        String primarySource = pairedSingleValueShape == null
            ? "replicated-container-pcode-call-stack"
            : pairedSingleValueShape.source;
        WireShape primaryShape = primaryLayout == null
            ? null
            : semanticsProven
                ? WireShape.semantic(primaryLayout, primarySource)
                : WireShape.layout(primaryLayout, primarySource);
        if (planShape != null &&
            (primaryShape == null || !primaryShape.hasProvenSemantics())) {
            primaryShape = planShape;
        }
        WireShape deltaShape = deltaLayout == null
            ? null
            : semanticsProven
                ? WireShape.semantic(deltaLayout, "replicated-container-pcode-call-stack")
                : WireShape.layout(deltaLayout, "replicated-container-pcode-call-stack");
        WireShape fullShape = fullLayout == null
            ? null
            : semanticsProven
                ? WireShape.semantic(fullLayout, "replicated-container-pcode-call-stack")
                : WireShape.layout(fullLayout, "replicated-container-pcode-call-stack");
        List<ContainerPlanDiagnostic> planDiagnostics = fullContainerRecovery.plan == null
            ? fullContainerRecovery.diagnostics
            : Collections.emptyList();
        return new ContainerWireShape(
            primaryShape,
            deltaShape,
            fullShape,
            null,
            null,
            deltaShapeEvidence,
            fullShapeEvidence,
            valueTypeInfo,
            valueTypeShape,
            provenValueTypeInfoCandidates,
            Collections.emptyList(),
            fullContainerRecovery.plan,
            planDiagnostics);
    }

    private ContainerWireShape classifyInlineReplicatedContainerWireShape(Address vtable) {
        if (!hasScalarFieldHandlerVtableAbi(vtable)) {
            return null;
        }
        Address marshal = readPointer(vtable.add(FIELD_HANDLER_MARSHAL_SLOT * 8L));
        Address unmarshal = readPointer(vtable.add(FIELD_HANDLER_UNMARSHAL_SLOT * 8L));
        if (!hasInlineReplicatedContainerProtocol(marshal)) {
            return null;
        }
        FullContainerPlanRecovery recovery = recoverFullContainerPlan(marshal);
        FullContainerPlan plan = recovery.plan;
        if (plan == null || plan.storageKind != ContainerStorageKind.INDEX_MAP ||
            !plan.sequenceMarkerProven || plan.keyCodecs.isEmpty() ||
            plan.valueCodecs.isEmpty()) {
            return null;
        }

        reconcileFullContainerUnmarshalSemantics(plan, unmarshal);
        if (plan.unmarshalReconciliation == null ||
            !plan.unmarshalReconciliation.startsWith("complete-")) {
            return null;
        }
        WireShape planShape = completeFullContainerIndexMapWireShape(plan);
        if (planShape == null) {
            return null;
        }

        List<NativeTypeInfoEvidence> valueTypeInfoCandidates =
            collectReplicatedContainerValueTypeInfoCandidates(
                marshal,
                marshal,
                unmarshal,
                unmarshal,
                plan);
        NestedTypeShape valueTypeShape = replicatedContainerExactValueTypeShapeFromPcode(
            valueTypeInfoCandidates,
            unmarshal,
            vtable,
            plan);
        discardUnprovenContainerTypeId(valueTypeShape);
        List<NativeTypeInfoEvidence> provenValueTypeInfoCandidates =
            provenReplicatedContainerValueTypeInfoCandidates(
                valueTypeInfoCandidates,
                valueTypeShape);
        NativeTypeInfoEvidence valueTypeInfo =
            selectedReplicatedContainerValueTypeInfo(
                provenValueTypeInfoCandidates,
                valueTypeShape);

        return new ContainerWireShape(
            planShape,
            null,
            null,
            null,
            null,
            Collections.emptyList(),
            Collections.emptyList(),
            valueTypeInfo,
            valueTypeShape,
            provenValueTypeInfoCandidates,
            Collections.emptyList(),
            plan,
            Collections.emptyList());
    }

    private boolean hasInlineReplicatedContainerProtocol(Address marshal) {
        Function function = functionAtOrContaining(resolvedCodeTarget(marshal));
        if (function == null) {
            return false;
        }
        HighFunction high = highFunction(function);
        if (high == null || NetworkSchemaControlFlow.naturalLoops(high).isEmpty()) {
            return false;
        }
        PcodeStorage writeBuffer = new PcodeStorage("param_2", 0L);
        boolean count = false;
        boolean key = false;
        boolean sequence = false;
        boolean mask = false;
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            if (operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            Function target = pcodeCallTarget(operation);
            Integer writeBufferSlot = target == null
                ? null
                : provenCallArgumentSlot(
                    function,
                    operation,
                    target,
                    writeBuffer);
            if (target == null || writeBufferSlot == null) {
                continue;
            }
            WireShape evidence = directCallWireEvidence(operation);
            if (evidence == null) {
                evidence = validatedMarshalLeaf(
                    target,
                    "param_" + writeBufferSlot);
            }
            String shape = evidence == null
                ? null
                : firstNonEmpty(evidence.shape, evidence.layout);
            count |= "vlq-u32".equals(shape);
            key |= isInlineReplicatedContainerKeyShape(shape);
            sequence |= isContainerSequenceMarker(shape);
            mask |= "u8".equals(shape) || "fixed-bytes-1".equals(shape);
        }
        return count && key && sequence && mask;
    }

    private boolean isInlineReplicatedContainerKeyShape(String shape) {
        return "u8".equals(shape) ||
            "u16".equals(shape) ||
            "u32".equals(shape) ||
            "u64".equals(shape) ||
            "vlq-u32".equals(shape) ||
            "vlq-u64".equals(shape) ||
            "fixed-bytes-8".equals(shape) ||
            "fixed-bytes-16".equals(shape) ||
            "actor-ref".equals(shape) ||
            "entity-ref".equals(shape);
    }

    private boolean hasScalarFieldHandlerVtableAbi(Address vtable) {
        if (!isProgramAddress(vtable)) {
            return false;
        }
        for (int slot = 0; slot < FIELD_HANDLER_SCALAR_VTABLE_SLOTS; slot++) {
            if (!isExecutableAddress(readPointer(vtable.add(slot * 8L)))) {
                return false;
            }
        }
        return true;
    }

    private boolean hasReplicatedContainerVtableAbi(Address vtable) {
        if (!isProgramAddress(vtable)) {
            return false;
        }
        for (int slot = 0; slot < FIELD_HANDLER_CONTAINER_VTABLE_SLOTS; slot++) {
            if (!isExecutableAddress(readPointer(vtable.add(slot * 8L)))) {
                return false;
            }
        }
        Address marshal = readPointer(vtable.add(FIELD_HANDLER_MARSHAL_SLOT * 8L));
        Address unmarshal = readPointer(vtable.add(FIELD_HANDLER_UNMARSHAL_SLOT * 8L));
        return hasSelfVirtualDispatch(marshal, 14L * 8L) &&
            hasSelfVirtualDispatch(unmarshal, 15L * 8L);
    }

    private boolean hasSelfVirtualDispatch(Address entry, long slotOffset) {
        Function function = functionAtOrContaining(resolvedCodeTarget(entry));
        HighFunction high = highFunction(function);
        if (high == null) {
            return false;
        }
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            if (operation.getOpcode() != PcodeOp.CALLIND ||
                operation.getNumInputs() == 0) {
                continue;
            }
            PcodeVirtualDispatch dispatch = pcodeVirtualDispatch(operation.getInput(0));
            if (dispatch != null && dispatch.objectOffset() == 0L &&
                dispatch.slotOffset() == slotOffset &&
                dispatch.root().isStorage("param_1")) {
                return true;
            }
        }
        return false;
    }
