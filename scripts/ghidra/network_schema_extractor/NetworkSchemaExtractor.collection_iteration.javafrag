    private record CollectionElementCodec(
        PcodeOpAST operation,
        List<CodecWireEvent> events,
        boolean writesElement) {

        CollectionElementCodec {
            events = List.copyOf(events);
        }
    }

    private record CollectionIteration(
        String nativeType,
        WireShape wireEvidence,
        Set<Address> codecCallsites) {

        CollectionIteration {
            codecCallsites = Set.copyOf(codecCallsites);
        }
    }

    private record CollectionElementSequence(
        List<PcodeCodecCall> codecs,
        Set<Address> consumedCallsites) {

        CollectionElementSequence {
            codecs = List.copyOf(codecs);
            consumedCallsites = Set.copyOf(consumedCallsites);
        }
    }

    private record InlineNestedCollection(
        NetworkSchemaNaturalLoop loop,
        PcodeOpAST count,
        PcodeStorage storage,
        WireShape wireEvidence,
        Set<Address> codecCallsites) {

        InlineNestedCollection {
            codecCallsites = Set.copyOf(codecCallsites);
        }
    }

    private CollectionIteration collectionIteration(
        Function function,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations,
        PcodeStorage readBuffer,
        SequenceExtent extent) {

        if (function == null || high == null || loop == null || readBuffer == null ||
            extent == null) {
            return null;
        }
        HashMap<PcodeBlockBasic, List<CollectionElementCodec>> codecsByBlock =
            new HashMap<>();
        LinkedHashSet<Address> callsites = new LinkedHashSet<>();
        for (PcodeOpAST operation : operations) {
            if (!loop.contains(operation) || operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            Function target = pcodeCallTarget(operation);
            if (target == null) {
                continue;
            }
            // Presence tags are often GridMate::ReadBuffer::ReadRaw(1) with a
            // void Ghidra signature (e.g. NewWorld+0x15c29b0). Recover those from
            // the callsite rather than requiring ReadRaw body buffer flow.
            RawPcodeWrite rawWrite = pcodeReadRawWrite(operation, target);
            WireShape rawEvidence = pcodeReadRawWireEvidence(operation, target);
            WireShape booleanEvidence = rawWrite == null
                ? null
                : boundedNormalizedBooleanReadEvidence(
                    high,
                    operations,
                    operation,
                    rawWrite);
            if (booleanEvidence != null) {
                rawEvidence = booleanEvidence;
            }
            List<CodecWireEvent> nestedEvents = null;
            boolean writesElement;
            if (rawEvidence != null) {
                writesElement = unmarshalCodecWritesSequenceElement(
                    function,
                    high,
                    loop,
                    operations,
                    operation,
                    extent,
                    readBuffer);
                nestedEvents = List.of(new CodecWireEvent(
                    rawWrite == null ? null : rawWrite.nativeType,
                    rawEvidence,
                    operation.getSeqnum().getTarget(),
                    target.getEntryPoint(),
                    fullFunctionName(target),
                    rawWrite == null
                        ? sequenceOwnerStorageForElementUnmarshal(
                            operation,
                            readBuffer)
                        : rawWrite.storage,
                    null));
            }
            else {
                WireShape directEvidence = directCallWireEvidence(function, operation);
                if (directEvidence != null && directEvidence.hasProvenSemantics()) {
                    writesElement = unmarshalCodecWritesSequenceElement(
                        function,
                        high,
                        loop,
                        operations,
                        operation,
                        extent,
                        readBuffer);
                    if (!writesElement) {
                        continue;
                    }
                    nestedEvents = List.of(new CodecWireEvent(
                        unmarshalNativeTypeFromTarget(target),
                        directEvidence,
                        operation.getSeqnum().getTarget(),
                        target.getEntryPoint(),
                        fullFunctionName(target),
                        provenUnmarshalOutputStorage(operation),
                        null));
                }
                else {
                    PcodeStorage targetReadBuffer = callTargetReadBufferStorage(
                        high,
                        operations,
                        operation,
                        target,
                        readBuffer,
                        codecWireTraceActiveContexts);
                    String preferredBuffer = targetReadBuffer == null
                        ? null
                        : formalParameterBaseFromStorage(target, targetReadBuffer);
                    // Descriptor class-value helpers (NewWorld+0x15ac710) are proven
                    // as instruction leaves; their CFG body is not a standard codec
                    // event sequence. Emit the leaf directly so optional-suffix
                    // recovery can see writesElement=true.
                    WireShape classValueLeaf = classValueUnmarshalLeaf(
                        target,
                        preferredBuffer);
                    if (classValueLeaf != null) {
                        writesElement = true;
                        nestedEvents = List.of(new CodecWireEvent(
                            null,
                            classValueLeaf,
                            operation.getSeqnum().getTarget(),
                            target.getEntryPoint(),
                            fullFunctionName(target),
                            null,
                            null));
                    }
                    else {
                        if (targetReadBuffer == null) {
                            continue;
                        }
                        if (!hasReadBufferFlow(
                                target,
                                targetReadBuffer,
                                codecWireTraceActiveContexts)) {
                            continue;
                        }
                        writesElement = unmarshalCodecWritesSequenceElement(
                            function,
                            high,
                            loop,
                            operations,
                            operation,
                            extent,
                            readBuffer);
                        CodecWireTrace nested = traceUnmarshalCodec(
                            target,
                            targetReadBuffer,
                            codecWireTraceActiveContexts,
                            codecWireTraceCompletedContexts);
                        if (nested == null || nested.events.isEmpty()) {
                            if (writesElement && directEvidence != null &&
                                directEvidence.layout != null) {
                                nestedEvents = List.of(new CodecWireEvent(
                                    unmarshalNativeTypeFromTarget(target),
                                    directEvidence,
                                    operation.getSeqnum().getTarget(),
                                    target.getEntryPoint(),
                                    fullFunctionName(target),
                                    provenUnmarshalOutputStorage(operation),
                                    null));
                            }
                            // Cursor/telemetry helpers often take the ReadBuffer (e.g.
                            // NewWorld+0x873230 size delta in 0x15c29b0) but are not
                            // element codecs. Only fail the iteration when the call
                            // actually stores into the sequence element.
                            else if (writesElement) {
                                recordNestedTypeShapeReject(
                                    "dynamic-collection-element-codec-unproven");
                                return null;
                            }
                            else {
                                continue;
                            }
                        }
                        else {
                            nestedEvents = nested.events;
                        }
                        boolean presence = nestedEvents.size() == 1 &&
                            nestedEvents.get(0).wireEvidence() != null &&
                            "bool".equals(nestedEvents.get(0).wireEvidence().shape) &&
                            nestedEvents.get(0).wireEvidence().hasProvenSemantics();
                        if (!writesElement && !presence) {
                            continue;
                        }
                    }
                }
            }
            PcodeBlockBasic block = NetworkSchemaControlFlow.parentBlock(operation);
            if (block == null) {
                return null;
            }
            codecsByBlock.computeIfAbsent(block, ignored -> new ArrayList<>()).add(
                new CollectionElementCodec(
                    operation,
                    nestedEvents,
                    writesElement));
            callsites.add(operation.getSeqnum().getTarget());
        }
        if (codecsByBlock.isEmpty()) {
            return null;
        }

        NetworkSchemaFlowSequence.Result<CollectionElementCodec> sequence =
            NetworkSchemaFlowSequence.analyzeLoopIteration(
                loop,
                codecsByBlock,
                this::sameCollectionElementCodec);
        ArrayList<CodecWireEvent> events = new ArrayList<>();
        if (sequence.complete() && !sequence.events().isEmpty()) {
            if (sequence.events().stream().anyMatch(
                    codec -> !codec.writesElement())) {
                recordNestedTypeShapeReject(
                    "dynamic-collection-element-store-unproven");
                return null;
            }
            sequence.events().forEach(codec -> events.addAll(codec.events()));
        }
        else {
            CodecWireEvent masked = sharedMaskCollectionElementEvent(
                function,
                high,
                loop,
                operations,
                extent,
                codecsByBlock);
            if (masked != null) {
                events.add(masked);
                runMetrics.increment("sharedMaskCollectionElements");
            }
            else {
                CodecWireEvent optional = optionalCollectionElementEvent(
                    function,
                    high,
                    loop,
                    operations,
                    codecsByBlock);
                if (optional == null) {
                    recordNestedTypeShapeReject(
                        "dynamic-collection-iteration-" + sequence.status());
                    return null;
                }
                events.add(optional);
            }
        }
        WireShape evidence = dynamicSequenceWireEvidence(events);
        return evidence == null
            ? null
            : new CollectionIteration(
                dynamicSequenceNativeType(events),
                evidence,
                callsites);
    }

    private CodecWireEvent collectionElementProductEvent(
        CollectionElementCodec element) {

        if (element == null || element.operation() == null ||
            element.events().isEmpty()) {
            return null;
        }
        if (element.events().size() == 1) {
            return element.events().get(0);
        }
        Function target = pcodeCallTarget(element.operation());
        if (target == null) {
            return null;
        }
        String nativeType = unmarshalNativeTypeFromTarget(target);
        WireShape product = codecWireProduct(
            nativeType,
            element.events(),
            "cfg-complete-collection-element-call-product");
        if (product == null) {
            return null;
        }
        runMetrics.increment("collectionElementCallProducts");
        return new CodecWireEvent(
            nativeType,
            product,
            element.operation().getSeqnum().getTarget(),
            target.getEntryPoint(),
            fullFunctionName(target),
            provenUnmarshalOutputStorage(element.operation()),
            null);
    }

    private Set<PcodeBlockBasic> mandatorySuccessfulLoopIterationBlocks(
        HighFunction high,
        NetworkSchemaNaturalLoop loop) {

        if (high == null || loop == null || loop.header() == null) {
            return Set.of();
        }
        List<PcodeBlockBasic> latches = loop.body().stream()
            .filter(block -> NetworkSchemaControlFlow.successors(block)
                .contains(loop.header()))
            .toList();
        if (latches.isEmpty()) {
            return Set.of();
        }
        return loop.body().stream()
            .filter(candidate -> latches.stream().allMatch(latch ->
                candidate == latch ||
                    NetworkSchemaControlFlow.dominates(high, candidate, latch)))
            .collect(Collectors.toUnmodifiableSet());
    }

    private CodecWireEvent optionalCollectionElementEvent(
        Function function,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations,
        Map<PcodeBlockBasic, List<CollectionElementCodec>> codecsByBlock) {

        NetworkSchemaLoopSequence.OptionalSuffixResult<CollectionElementCodec> optional =
            NetworkSchemaLoopSequence.analyzeOptionalSuffix(
                loop,
                codecsByBlock,
                this::sameCollectionElementCodec);
        if (!optional.hasOptionalSuffix() ||
            optional.distinctSequenceCount() != 2 ||
            optional.requiredEvents().size() != 1 ||
            optional.requiredEvents().get(0).writesElement() ||
            optional.optionalEvents().isEmpty() ||
            optional.optionalEvents().stream().anyMatch(
                codec -> !codec.writesElement())) {
            return null;
        }
        ArrayList<CodecWireEvent> requiredEvents = new ArrayList<>();
        optional.requiredEvents().forEach(codec ->
            requiredEvents.addAll(codec.events()));
        ArrayList<CodecWireEvent> optionalEvents = new ArrayList<>();
        optional.optionalEvents().forEach(codec ->
            optionalEvents.addAll(codec.events()));
        if (requiredEvents.size() != 1 || optionalEvents.isEmpty()) {
            return null;
        }

        CodecWireEvent presence = requiredEvents.get(0);
        WireShape presenceShape = presence.wireEvidence();
        HashMap<PcodeBlockBasic, List<CodecWireEvent>> eventsByBlock =
            new HashMap<>();
        codecsByBlock.forEach((block, codecs) -> {
            ArrayList<CodecWireEvent> events = new ArrayList<>();
            codecs.forEach(codec -> events.addAll(codec.events()));
            eventsByBlock.put(block, List.copyOf(events));
        });
        boolean classValueBody = optionalEvents.size() == 1 &&
            optionalEvents.get(0).wireEvidence() != null &&
            "class-value".equals(optionalEvents.get(0).wireEvidence().shape);
        // Presence is normally a proven bool. 0x15c29b0 sometimes only surfaces
        // the ReadRaw(1) layout when normalization is split across ok/range
        // checks; accept fixed-bytes-1 when the optional body is class-value.
        boolean presenceOk = presenceShape != null && (
            "bool".equals(presenceShape.shape) &&
                presenceShape.hasProvenSemantics() ||
            classValueBody &&
                "fixed-bytes-1".equals(presenceShape.layout));
        if (!presenceOk) {
            return null;
        }
        boolean guarded = presenceBooleanControlsOptionalEvents(
            high,
            operations,
            eventsByBlock,
            presence,
            optionalEvents,
            loop);
        // 0x15c29b0 gates class-value with (ok && presence) rather than a single
        // normalized-boolean CBRANCH; accept when the optional body is exactly
        // one class-value store under the loop.
        if (!guarded && !classValueBody) {
            return null;
        }
        WireShape inner = orderedCodecWireEvidence(
            optionalEvents,
            "unmarshal-cfg-loop-optional-body");
        if (inner == null || inner.layout == null) {
            return null;
        }
        String layout = "optional<" + inner.layout + ">";
        WireShape shape = inner.hasProvenSemantics()
            ? WireShape.semantic(
                "optional<" + inner.shape + ">",
                layout,
                "unmarshal-cfg-loop-presence-prefixed-optional")
            : WireShape.layout(
                layout,
                "unmarshal-cfg-loop-presence-prefixed-optional");
        String nativeType = optionalEvents.size() == 1 &&
            optionalEvents.get(0).nativeType() != null
            ? "AZStd::optional<" + optionalEvents.get(0).nativeType() + ">"
            : null;
        return new CodecWireEvent(
            nativeType,
            shape,
            presence.callsite(),
            function.getEntryPoint(),
            fullFunctionName(function),
            null,
            null);
    }

    private String dynamicSequenceNativeType(List<CodecWireEvent> events) {
        if (events == null || events.size() != 1) {
            return null;
        }
        String elementType = events.get(0).nativeType();
        if (elementType == null || elementType.isBlank() ||
            "unknown".equals(elementType)) {
            return null;
        }
        return "AZStd::vector<" + elementType + ">";
    }

    private boolean sameCollectionElementCodec(
        CollectionElementCodec left,
        CollectionElementCodec right) {

        if (left.events().size() != right.events().size()) {
            return false;
        }
        if (left.writesElement() != right.writesElement()) {
            return false;
        }
        for (int index = 0; index < left.events().size(); index++) {
            if (!sameWireEvidence(
                    left.events().get(index).wireEvidence(),
                    right.events().get(index).wireEvidence())) {
                return false;
            }
        }
        return true;
    }

    private CollectionElementSequence loopElementCodecs(
        Function owner,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations) {

        return loopElementCodecs(owner, high, loop, operations, true);
    }

    private CollectionElementSequence loopElementCodecs(
        Function owner,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations,
        boolean includeInlineNestedCollections) {

        HashMap<String, String> tempNativeTypes = new HashMap<>();
        HashMap<String, String> tempWireShapes = new HashMap<>();
        for (PcodeOpAST operation : operations) {
            if (operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            Function target = pcodeCallTarget(operation);
            WireShape evidence = directCallWireEvidence(
                owner,
                high,
                operations,
                operation);
            observePcodeTempUnmarshal(
                tempNativeTypes,
                tempWireShapes,
                operation,
                unmarshalNativeTypeFromTarget(target),
                evidence == null ? null : firstNonEmpty(evidence.shape, evidence.layout));
        }

        List<InlineNestedCollection> inlineNestedCollections =
            includeInlineNestedCollections
                ? inlineNestedCollections(owner, high, loop, operations)
                : List.of();
        IdentityHashMap<PcodeOpAST, InlineNestedCollection> inlineNestedByCount =
            new IdentityHashMap<>();
        inlineNestedCollections.forEach(collection ->
            inlineNestedByCount.put(collection.count(), collection));

        IdentityHashMap<PcodeOpAST, WireShape> nestedCollections = new IdentityHashMap<>();
        Set<PcodeOpAST> nestedHelpers = Collections.newSetFromMap(new IdentityHashMap<>());
        LinkedHashSet<Address> consumedCallsites = new LinkedHashSet<>();
        for (PcodeOpAST operation : operations) {
            if (!loop.contains(operation) || operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            InterproceduralCollectionCall collection = interproceduralCollectionCall(
                owner,
                operation,
                pcodeCallTarget(operation),
                Collections.emptyMap());
            if (collection == null || collection.count() == null) {
                // A self-counted helper has no caller-side count to bind a
                // nested-loop boundary to.
                continue;
            }
            PcodeOpAST count = uniqueUnmarshalCountProducer(
                owner,
                high,
                operations,
                operation,
                collection.count());
            if (count == null || !loop.contains(count) ||
                nestedCollections.putIfAbsent(count, collection.wireEvidence()) != null) {
                recordNestedTypeShapeReject("nested-loop-collection-boundary-ambiguous");
                return null;
            }
            nestedHelpers.add(operation);
            consumedCallsites.add(count.getSeqnum().getTarget());
            consumedCallsites.add(operation.getSeqnum().getTarget());
        }

        ArrayList<PcodeCodecCall> result = new ArrayList<>();
        for (PcodeOpAST operation : operations) {
            if (!loop.contains(operation) || operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            InlineNestedCollection inlineNested = inlineNestedByCount.get(operation);
            if (inlineNested != null) {
                result.add(new PcodeCodecCall(operation, inlineNested.wireEvidence()));
                consumedCallsites.add(operation.getSeqnum().getTarget());
                consumedCallsites.addAll(inlineNested.codecCallsites());
                continue;
            }
            if (inlineNestedCollections.stream().anyMatch(
                    collection -> collection.loop().contains(operation))) {
                continue;
            }
            WireShape nested = nestedCollections.get(operation);
            if (nested != null) {
                result.add(new PcodeCodecCall(operation, nested));
                continue;
            }
            if (nestedHelpers.contains(operation)) {
                continue;
            }
            WireShape evidence = directCallWireEvidence(
                owner,
                high,
                operations,
                operation);
            if (evidence != null && evidence.layout != null) {
                result.add(new PcodeCodecCall(operation, evidence));
                consumedCallsites.add(operation.getSeqnum().getTarget());
            }
        }
        return new CollectionElementSequence(result, consumedCallsites);
    }

    private List<InlineNestedCollection> inlineNestedCollections(
        Function owner,
        HighFunction high,
        NetworkSchemaNaturalLoop parent,
        List<PcodeOpAST> operations) {

        ArrayList<InlineNestedCollection> result = new ArrayList<>();
        List<NetworkSchemaNaturalLoop> loops = NetworkSchemaControlFlow.naturalLoops(high);
        for (NetworkSchemaNaturalLoop child : loops) {
            if (monitor.isCancelled()) {
                break;
            }
            if (!isStrictNestedLoop(parent, child)) {
                continue;
            }
            PcodeOpAST count = nearestCountCallForLoop(
                owner,
                high,
                child,
                operations);
            if (count == null) {
                continue;
            }
            InlineNestedCollection collection = inlineNestedCollection(
                owner,
                high,
                child,
                operations,
                count);
            if (collection == null) {
                continue;
            }
            if (!nestedCollectionFeedsParentOutput(
                    owner,
                    high,
                    parent,
                    operations,
                    collection)) {
                recordCountedCollectionReject(
                    owner,
                    child,
                    "inline-nested-parent-consumption-unproven");
                continue;
            }
            result.add(collection);
        }
        return List.copyOf(result);
    }

    private InlineNestedCollection inlineNestedCollection(
        Function owner,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations,
        PcodeOpAST count) {

        DynamicSequenceExtent extent = dynamicSequenceExtent(loop, operations);
        String readBufferParameter = callReadBufferParameter(owner, count);
        if (readBufferParameter == null) {
            readBufferParameter = uniqueReadBufferParameter(owner);
        }
        CollectionIteration iteration =
            extent == null || readBufferParameter == null
                ? null
                : collectionIteration(
                    owner,
                    high,
                    loop,
                    operations,
                    new PcodeStorage(readBufferParameter, 0L),
                    extent);
        if (iteration != null &&
            isStableCollectionStorage(
                extent.data(),
                new PcodeStorage(readBufferParameter, 0L))) {
            return new InlineNestedCollection(
                loop,
                count,
                extent.data(),
                iteration.wireEvidence(),
                iteration.codecCallsites());
        }

        CollectionElementSequence elements = loopElementCodecs(
            owner,
            high,
            loop,
            operations,
            false);
        if (elements == null || elements.codecs().isEmpty() ||
            !strictlyOrderedCodecCalls(high, elements.codecs())) {
            recordCountedCollectionReject(
                owner,
                loop,
                "inline-nested-element-codecs-unproven");
            return null;
        }
        PcodeStorage storage = countedCollectionIndexedOutputStorage(
            owner,
            high,
            loop,
            operations,
            elements.codecs(),
            false);
        WireShape evidence = countedSequenceWireEvidence(elements.codecs());
        if (storage == null) {
            recordCountedCollectionReject(
                owner,
                loop,
                "inline-nested-local-storage-unproven");
            return null;
        }
        if (evidence == null) {
            recordCountedCollectionReject(
                owner,
                loop,
                "inline-nested-wire-evidence-unproven");
            return null;
        }
        return new InlineNestedCollection(
            loop,
            count,
            storage,
            evidence,
            elements.consumedCallsites());
    }

    private boolean isStrictNestedLoop(
        NetworkSchemaNaturalLoop parent,
        NetworkSchemaNaturalLoop child) {

        return parent != null && child != null && parent != child &&
            parent.body().containsAll(child.body()) &&
            !parent.body().equals(child.body());
    }

    private boolean nestedCollectionFeedsParentOutput(
        Function owner,
        HighFunction high,
        NetworkSchemaNaturalLoop parent,
        List<PcodeOpAST> operations,
        InlineNestedCollection nested) {

        for (PcodeOpAST operation : operations) {
            if (monitor.isCancelled()) {
                return false;
            }
            if (!parent.contains(operation) || nested.loop().contains(operation) ||
                operation.getOpcode() != PcodeOp.CALL ||
                directCallWireEvidence(operation) != null) {
                continue;
            }
            boolean countPrecedes =
                NetworkSchemaControlFlow.precedes(high, nested.count(), operation);
            String output = uniqueLikelyOutputParameter(owner, operation);
            boolean outputProven = isProvenOutputParameterBase(owner, output);
            boolean consumes = callConsumesNestedCollectionStorage(
                owner,
                operation,
                nested.storage());
            boolean successfulLoopExitReachesCall =
                nestedLoopExitReachesConsumingCall(
                    nested.loop(),
                    nested.codecCallsites(),
                    operations,
                    operation);
            recordNestedParentConsumptionDiagnostic(
                owner,
                operation,
                nested.storage(),
                countPrecedes,
                output,
                outputProven,
                consumes,
                successfulLoopExitReachesCall);
            if (countPrecedes && outputProven && consumes &&
                successfulLoopExitReachesCall) {
                return true;
            }
        }
        return false;
    }

    private boolean nestedLoopExitReachesConsumingCall(
        NetworkSchemaNaturalLoop loop,
        Set<Address> codecCallsites,
        List<PcodeOpAST> operations,
        PcodeOpAST call) {

        PcodeBlockBasic target = NetworkSchemaControlFlow.parentBlock(call);
        if (loop == null || target == null || loop.contains(target) ||
            codecCallsites == null || codecCallsites.isEmpty()) {
            return false;
        }
        boolean codecsBelongToLoop = codecCallsites.stream()
            .map(callsite -> operationAt(operations, callsite))
            .allMatch(codec -> codec != null && loop.contains(codec));
        if (!codecsBelongToLoop) {
            return false;
        }
        for (PcodeBlockBasic block : loop.body()) {
            for (PcodeBlockBasic successor :
                    NetworkSchemaControlFlow.successors(block)) {
                if (loop.contains(successor)) {
                    continue;
                }
                if (successor == target ||
                    NetworkSchemaControlFlow.reaches(successor, target)) {
                    return true;
                }
            }
        }
        return false;
    }

    private void recordNestedParentConsumptionDiagnostic(
        Function owner,
        PcodeOpAST call,
        PcodeStorage nestedStorage,
        boolean countPrecedes,
        String output,
        boolean outputProven,
        boolean consumes,
        boolean successfulLoopExitReachesCall) {

        if (call == null || call.getSeqnum() == null ||
            nestedParentConsumptionDiagnostics.size() >= 32) {
            return;
        }
        Address callsite = call.getSeqnum().getTarget();
        String key = formatAddress(callsite) + ':' + storageKey(nestedStorage);
        if (!nestedParentConsumptionDiagnosticKeys.add(key)) {
            return;
        }

        Function target = pcodeCallTarget(call);
        HighFunction targetHigh = highFunction(target);
        JsonObject diagnostic = new JsonObject();
        NetworkSchemaJson.addAddress(
            diagnostic,
            "function",
            owner == null ? null : owner.getEntryPoint(),
            addressFormatter);
        NetworkSchemaJson.addAddress(
            diagnostic,
            "callsite",
            callsite,
            addressFormatter);
        NetworkSchemaJson.addAddress(
            diagnostic,
            "target",
            target == null ? null : target.getEntryPoint(),
            addressFormatter);
        NetworkSchemaJson.add(diagnostic, "output", output);
        diagnostic.addProperty("countPrecedes", countPrecedes);
        diagnostic.addProperty("outputProven", outputProven);
        diagnostic.addProperty("consumes", consumes);
        diagnostic.addProperty(
            "successfulLoopExitReachesCall",
            successfulLoopExitReachesCall);
        addStorageDiagnostic(diagnostic, "nestedStorage", nestedStorage);

        JsonArray arguments = new JsonArray();
        int argumentCount = provenCallArgumentCount(call, target);
        for (int slot = 1; slot <= argumentCount; slot++) {
            PcodeStorage argument = provenCallArgumentStorage(
                owner,
                call,
                target,
                slot);
            JsonObject entry = new JsonObject();
            entry.addProperty("slot", slot);
            addStorageDiagnostic(entry, "storage", argument);
            if (argument != null && nestedStorage != null &&
                Objects.equals(argument.base, nestedStorage.base)) {
                long relative = nestedStorage.offset - argument.offset;
                entry.addProperty("relativeMemberOffset", relative);
                JsonArray offsets = new JsonArray();
                if (targetHigh != null) {
                    for (Long offset : directReceiverOffsets(
                            targetHigh,
                            "param_" + slot)) {
                        offsets.add(offset);
                    }
                }
                entry.add("calleeOffsets", offsets);
            }
            arguments.add(entry);
        }
        diagnostic.add("arguments", arguments);
        nestedParentConsumptionDiagnostics.add(diagnostic);
    }

    private boolean callConsumesNestedCollectionStorage(
        Function owner,
        PcodeOpAST call,
        PcodeStorage nestedStorage) {

        Function target = pcodeCallTarget(call);
        HighFunction targetHigh = highFunction(target);
        int argumentCount = provenCallArgumentCount(call, target);
        for (int slot = 1; slot <= argumentCount; slot++) {
            if (monitor.isCancelled()) {
                return false;
            }
            PcodeStorage argument = provenCallArgumentStorage(
                owner,
                call,
                target,
                slot);
            if (argument == null && slot < call.getNumInputs()) {
                argument = pcodeStorageExpression(call.getInput(slot));
            }
            if (argument == null || nestedStorage == null ||
                !Objects.equals(argument.base, nestedStorage.base)) {
                continue;
            }
            if (argument.sameLocation(nestedStorage)) {
                return true;
            }
            long relative = nestedStorage.offset - argument.offset;
            if (relative < 0L || relative > 0x1000L || targetHigh == null) {
                continue;
            }
            Set<Long> offsets = directReceiverOffsets(
                targetHigh,
                "param_" + slot);
            if (offsets.contains(relative) &&
                offsets.contains(relative + 8L) &&
                offsets.contains(relative + 16L)) {
                return true;
            }
        }
        return false;
    }
