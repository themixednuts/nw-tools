    private record CollectionElementCodec(
        PcodeOpAST operation,
        List<CodecWireEvent> events,
        boolean writesElement) {

        CollectionElementCodec {
            events = List.copyOf(events);
        }
    }

    private record CollectionIteration(
        String nativeType,
        WireShape wireEvidence,
        Set<Address> codecCallsites) {

        CollectionIteration {
            codecCallsites = Set.copyOf(codecCallsites);
        }
    }

    private record CollectionElementSequence(
        List<PcodeCodecCall> codecs,
        Set<Address> consumedCallsites) {

        CollectionElementSequence {
            codecs = List.copyOf(codecs);
            consumedCallsites = Set.copyOf(consumedCallsites);
        }
    }

    private CollectionIteration collectionIteration(
        Function function,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations,
        PcodeStorage readBuffer,
        SequenceExtent extent) {

        if (function == null || high == null || loop == null || readBuffer == null ||
            extent == null) {
            return null;
        }
        HashMap<PcodeBlockBasic, List<CollectionElementCodec>> codecsByBlock =
            new HashMap<>();
        LinkedHashSet<Address> callsites = new LinkedHashSet<>();
        for (PcodeOpAST operation : operations) {
            if (!loop.contains(operation) || operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            Function target = pcodeCallTarget(operation);
            if (target == null) {
                continue;
            }
            // Presence tags are often GridMate::ReadBuffer::ReadRaw(1) with a
            // void Ghidra signature (e.g. NewWorld+0x15c29b0). Recover those from
            // the callsite rather than requiring ReadRaw body buffer flow.
            RawPcodeWrite rawWrite = pcodeReadRawWrite(operation, target);
            WireShape rawEvidence = rawWrite == null
                ? null
                : boundedNormalizedBooleanReadEvidence(
                    high,
                    operations,
                    operation,
                    rawWrite);
            if (rawEvidence == null && rawWrite != null) {
                rawEvidence = rawWrite.wireEvidence;
            }
            List<CodecWireEvent> nestedEvents = null;
            boolean writesElement;
            if (rawEvidence != null) {
                writesElement = false;
                nestedEvents = List.of(new CodecWireEvent(
                    rawWrite.nativeType,
                    rawEvidence,
                    operation.getSeqnum().getTarget(),
                    target.getEntryPoint(),
                    fullFunctionName(target),
                    rawWrite.storage,
                    null));
            }
            else {
                PcodeStorage targetReadBuffer = callTargetReadBufferStorage(
                    high,
                    operations,
                    operation,
                    target,
                    readBuffer,
                    codecWireTraceActiveContexts);
                String preferredBuffer = targetReadBuffer == null
                    ? null
                    : formalParameterBaseFromStorage(target, targetReadBuffer);
                // Descriptor class-value helpers (NewWorld+0x15ac710) are proven
                // as instruction leaves; their CFG body is not a standard codec
                // event sequence. Emit the leaf directly so optional-suffix
                // recovery can see writesElement=true.
                WireShape classValueLeaf = classValueUnmarshalLeaf(
                    target,
                    preferredBuffer);
                if (classValueLeaf != null) {
                    writesElement = true;
                    nestedEvents = List.of(new CodecWireEvent(
                        null,
                        classValueLeaf,
                        operation.getSeqnum().getTarget(),
                        target.getEntryPoint(),
                        fullFunctionName(target),
                        null,
                        null));
                }
                else {
                    if (targetReadBuffer == null) {
                        continue;
                    }
                    if (!hasReadBufferFlow(
                            target,
                            targetReadBuffer,
                            codecWireTraceActiveContexts)) {
                        continue;
                    }
                    writesElement = unmarshalCodecWritesSequenceElement(
                        function,
                        high,
                        loop,
                        operations,
                        operation,
                        extent,
                        readBuffer);
                    CodecWireTrace nested = traceUnmarshalCodec(
                        target,
                        targetReadBuffer,
                        codecWireTraceActiveContexts,
                        codecWireTraceCompletedContexts);
                    if (nested == null || nested.events.isEmpty()) {
                        // Cursor/telemetry helpers often take the ReadBuffer (e.g.
                        // NewWorld+0x873230 size delta in 0x15c29b0) but are not
                        // element codecs. Only fail the iteration when the call
                        // actually stores into the sequence element.
                        if (writesElement) {
                            recordNestedTypeShapeReject(
                                "dynamic-collection-element-codec-unproven");
                            return null;
                        }
                        continue;
                    }
                    nestedEvents = nested.events;
                    boolean presence = nestedEvents.size() == 1 &&
                        nestedEvents.get(0).wireEvidence() != null &&
                        "bool".equals(nestedEvents.get(0).wireEvidence().shape) &&
                        nestedEvents.get(0).wireEvidence().hasProvenSemantics();
                    if (!writesElement && !presence) {
                        continue;
                    }
                }
            }
            PcodeBlockBasic block = NetworkSchemaControlFlow.parentBlock(operation);
            if (block == null) {
                return null;
            }
            codecsByBlock.computeIfAbsent(block, ignored -> new ArrayList<>()).add(
                new CollectionElementCodec(
                    operation,
                    nestedEvents,
                    writesElement));
            callsites.add(operation.getSeqnum().getTarget());
        }
        if (codecsByBlock.isEmpty()) {
            return null;
        }

        NetworkSchemaFlowSequence.Result<CollectionElementCodec> sequence =
            NetworkSchemaFlowSequence.analyzeLoopIteration(
                loop,
                codecsByBlock,
                this::sameCollectionElementCodec);
        ArrayList<CodecWireEvent> events = new ArrayList<>();
        if (sequence.complete() && !sequence.events().isEmpty()) {
            if (sequence.events().stream().anyMatch(
                    codec -> !codec.writesElement())) {
                recordNestedTypeShapeReject(
                    "dynamic-collection-element-store-unproven");
                return null;
            }
            sequence.events().forEach(codec -> events.addAll(codec.events()));
        }
        else {
            CodecWireEvent optional = optionalCollectionElementEvent(
                function,
                high,
                loop,
                operations,
                codecsByBlock);
            if (optional == null) {
                recordNestedTypeShapeReject(
                    "dynamic-collection-iteration-" + sequence.status());
                return null;
            }
            events.add(optional);
        }
        WireShape evidence = dynamicSequenceWireEvidence(events);
        return evidence == null
            ? null
            : new CollectionIteration(
                dynamicSequenceNativeType(events),
                evidence,
                callsites);
    }

    private CodecWireEvent optionalCollectionElementEvent(
        Function function,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations,
        Map<PcodeBlockBasic, List<CollectionElementCodec>> codecsByBlock) {

        NetworkSchemaLoopSequence.OptionalSuffixResult<CollectionElementCodec> optional =
            NetworkSchemaLoopSequence.analyzeOptionalSuffix(
                loop,
                codecsByBlock,
                this::sameCollectionElementCodec);
        if (!optional.hasOptionalSuffix() ||
            optional.distinctSequenceCount() != 2 ||
            optional.requiredEvents().size() != 1 ||
            optional.requiredEvents().get(0).writesElement() ||
            optional.optionalEvents().isEmpty() ||
            optional.optionalEvents().stream().anyMatch(
                codec -> !codec.writesElement())) {
            return null;
        }
        ArrayList<CodecWireEvent> requiredEvents = new ArrayList<>();
        optional.requiredEvents().forEach(codec ->
            requiredEvents.addAll(codec.events()));
        ArrayList<CodecWireEvent> optionalEvents = new ArrayList<>();
        optional.optionalEvents().forEach(codec ->
            optionalEvents.addAll(codec.events()));
        if (requiredEvents.size() != 1 || optionalEvents.isEmpty()) {
            return null;
        }

        CodecWireEvent presence = requiredEvents.get(0);
        WireShape presenceShape = presence.wireEvidence();
        HashMap<PcodeBlockBasic, List<CodecWireEvent>> eventsByBlock =
            new HashMap<>();
        codecsByBlock.forEach((block, codecs) -> {
            ArrayList<CodecWireEvent> events = new ArrayList<>();
            codecs.forEach(codec -> events.addAll(codec.events()));
            eventsByBlock.put(block, List.copyOf(events));
        });
        boolean classValueBody = optionalEvents.size() == 1 &&
            optionalEvents.get(0).wireEvidence() != null &&
            "class-value".equals(optionalEvents.get(0).wireEvidence().shape);
        // Presence is normally a proven bool. 0x15c29b0 sometimes only surfaces
        // the ReadRaw(1) layout when normalization is split across ok/range
        // checks; accept fixed-bytes-1 when the optional body is class-value.
        boolean presenceOk = presenceShape != null && (
            "bool".equals(presenceShape.shape) &&
                presenceShape.hasProvenSemantics() ||
            classValueBody &&
                "fixed-bytes-1".equals(presenceShape.layout));
        if (!presenceOk) {
            return null;
        }
        boolean guarded = presenceBooleanControlsOptionalEvents(
            high,
            operations,
            eventsByBlock,
            presence,
            optionalEvents,
            loop);
        // 0x15c29b0 gates class-value with (ok && presence) rather than a single
        // normalized-boolean CBRANCH; accept when the optional body is exactly
        // one class-value store under the loop.
        if (!guarded && !classValueBody) {
            return null;
        }
        WireShape inner = orderedCodecWireEvidence(
            optionalEvents,
            "unmarshal-cfg-loop-optional-body");
        if (inner == null || inner.layout == null) {
            return null;
        }
        String layout = "optional<" + inner.layout + ">";
        WireShape shape = inner.hasProvenSemantics()
            ? WireShape.semantic(
                "optional<" + inner.shape + ">",
                layout,
                "unmarshal-cfg-loop-presence-prefixed-optional")
            : WireShape.layout(
                layout,
                "unmarshal-cfg-loop-presence-prefixed-optional");
        String nativeType = optionalEvents.size() == 1 &&
            optionalEvents.get(0).nativeType() != null
            ? "AZStd::optional<" + optionalEvents.get(0).nativeType() + ">"
            : null;
        return new CodecWireEvent(
            nativeType,
            shape,
            presence.callsite(),
            function.getEntryPoint(),
            fullFunctionName(function),
            null,
            null);
    }

    private String dynamicSequenceNativeType(List<CodecWireEvent> events) {
        if (events == null || events.size() != 1) {
            return null;
        }
        String elementType = events.get(0).nativeType();
        if (elementType == null || elementType.isBlank() ||
            "unknown".equals(elementType)) {
            return null;
        }
        return "AZStd::vector<" + elementType + ">";
    }

    private boolean sameCollectionElementCodec(
        CollectionElementCodec left,
        CollectionElementCodec right) {

        if (left.events().size() != right.events().size()) {
            return false;
        }
        if (left.writesElement() != right.writesElement()) {
            return false;
        }
        for (int index = 0; index < left.events().size(); index++) {
            if (!sameWireEvidence(
                    left.events().get(index).wireEvidence(),
                    right.events().get(index).wireEvidence())) {
                return false;
            }
        }
        return true;
    }

    private CollectionElementSequence loopElementCodecs(
        Function owner,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations) {

        HashMap<String, String> tempNativeTypes = new HashMap<>();
        HashMap<String, String> tempWireShapes = new HashMap<>();
        for (PcodeOpAST operation : operations) {
            if (operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            Function target = pcodeCallTarget(operation);
            WireShape evidence = directCallWireEvidence(high, operations, operation);
            observePcodeTempUnmarshal(
                tempNativeTypes,
                tempWireShapes,
                operation,
                unmarshalNativeTypeFromTarget(target),
                evidence == null ? null : firstNonEmpty(evidence.shape, evidence.layout));
        }

        IdentityHashMap<PcodeOpAST, WireShape> nestedCollections = new IdentityHashMap<>();
        Set<PcodeOpAST> nestedHelpers = Collections.newSetFromMap(new IdentityHashMap<>());
        LinkedHashSet<Address> consumedCallsites = new LinkedHashSet<>();
        for (PcodeOpAST operation : operations) {
            if (!loop.contains(operation) || operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            InterproceduralCollectionCall collection = interproceduralCollectionCall(
                owner,
                operation,
                pcodeCallTarget(operation),
                Collections.emptyMap());
            if (collection == null) {
                continue;
            }
            PcodeOpAST count = uniqueUnmarshalCountProducer(
                high,
                operations,
                operation,
                collection.count());
            if (count == null || !loop.contains(count) ||
                nestedCollections.putIfAbsent(count, collection.wireEvidence()) != null) {
                recordNestedTypeShapeReject("nested-loop-collection-boundary-ambiguous");
                return null;
            }
            nestedHelpers.add(operation);
            consumedCallsites.add(count.getSeqnum().getTarget());
            consumedCallsites.add(operation.getSeqnum().getTarget());
        }

        ArrayList<PcodeCodecCall> result = new ArrayList<>();
        for (PcodeOpAST operation : operations) {
            if (!loop.contains(operation) || operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            WireShape nested = nestedCollections.get(operation);
            if (nested != null) {
                result.add(new PcodeCodecCall(operation, nested));
                continue;
            }
            if (nestedHelpers.contains(operation)) {
                continue;
            }
            WireShape evidence = directCallWireEvidence(high, operations, operation);
            if (evidence != null && evidence.layout != null) {
                result.add(new PcodeCodecCall(operation, evidence));
                consumedCallsites.add(operation.getSeqnum().getTarget());
            }
        }
        return new CollectionElementSequence(result, consumedCallsites);
    }
