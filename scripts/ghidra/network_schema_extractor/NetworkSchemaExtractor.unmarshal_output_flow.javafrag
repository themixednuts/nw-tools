    private Integer unmarshalOutputParameterSlot(Function function) {
        if (function == null || function.getEntryPoint() == null) {
            return null;
        }
        String key = functionCacheKey("unmarshal-output-slot", function);
        Integer cached = unmarshalOutputParameterSlotCache.get(key);
        if (cached != null) {
            return cached > 0 ? cached : null;
        }
        if (!unmarshalOutputParameterSlotActive.add(key)) {
            return null;
        }

        Integer selected = null;
        try {
            List<String> readBuffers = readBufferParameters(function);
            if (readBuffers.isEmpty()) {
                return null;
            }
            LinkedHashSet<Integer> candidates = new LinkedHashSet<>();
            HighFunction high = highFunction(function);
            if (high == null) {
                return null;
            }
            for (PcodeOpAST operation : orderedPcodeOps(high)) {
                collectDirectUnmarshalOutputCandidate(candidates, operation);
                collectNestedUnmarshalOutputCandidate(
                    candidates,
                    function,
                    operation);
            }

            Integer returnedSlot = returnedParameterSlot(function);
            if (returnedSlot != null) {
                candidates.remove(returnedSlot);
            }
            for (String readBuffer : readBuffers) {
                Integer readBufferSlot = pcodeParameterIndex(readBuffer);
                if (readBufferSlot != null) {
                    candidates.remove(readBufferSlot);
                }
            }
            if (candidates.isEmpty()) {
                for (PcodeOpAST operation : orderedPcodeOps(high)) {
                    collectMutatingHelperOutputCandidates(
                        candidates,
                        function,
                        operation);
                }
                if (returnedSlot != null) {
                    candidates.remove(returnedSlot);
                }
                for (String readBuffer : readBuffers) {
                    Integer readBufferSlot = pcodeParameterIndex(readBuffer);
                    if (readBufferSlot != null) {
                        candidates.remove(readBufferSlot);
                    }
                }
            }
            selected = candidates.size() == 1
                ? candidates.iterator().next()
                : null;
            return selected;
        }
        finally {
            unmarshalOutputParameterSlotActive.remove(key);
            unmarshalOutputParameterSlotCache.put(
                key,
                selected == null ? -1 : selected);
        }
    }

    private Integer transportedFormalParameterSlot(Varnode node) {
        return transportedFormalParameterSlot(
            node,
            new LinkedHashSet<>(),
            0);
    }

    private Integer transportedFormalParameterSlot(
        Varnode node,
        Set<String> active,
        int depth) {

        if (node == null || depth > 32 ||
            !active.add("transported-parameter:" + pcodeSsaNodeKey(node))) {
            return null;
        }
        Integer direct = formalParameterSlot(node);
        if (direct != null) {
            return direct;
        }
        PcodeStorage storage = pcodeStorageExpression(node);
        Integer storageSlot = formalParameterSlot(storage);
        if (storageSlot != null && storage.offset == 0L) {
            return storageSlot;
        }

        PcodeOp definition = node.getDef();
        if (definition == null) {
            return null;
        }
        return switch (definition.getOpcode()) {
            case PcodeOp.COPY,
                 PcodeOp.CAST -> definition.getNumInputs() == 0
                ? null
                : transportedFormalParameterSlot(
                    definition.getInput(0),
                    active,
                    depth + 1);
            case PcodeOp.MULTIEQUAL -> commonTransportedFormalParameterSlot(
                definition,
                active,
                depth + 1);
            case PcodeOp.CALL -> {
                Function target = pcodeCallTarget(definition);
                Integer returnedSlot = returnedParameterSlot(target);
                yield returnedSlot == null || returnedSlot >= definition.getNumInputs()
                    ? null
                    : transportedFormalParameterSlot(
                        definition.getInput(returnedSlot),
                        active,
                        depth + 1);
            }
            default -> null;
        };
    }

    private Integer commonTransportedFormalParameterSlot(
        PcodeOp operation,
        Set<String> active,
        int depth) {

        Integer selected = null;
        for (int index = 0; index < operation.getNumInputs(); index++) {
            Integer candidate = transportedFormalParameterSlot(
                operation.getInput(index),
                new LinkedHashSet<>(active),
                depth);
            if (candidate == null) {
                return null;
            }
            if (selected == null) {
                selected = candidate;
            }
            else if (!selected.equals(candidate)) {
                return null;
            }
        }
        return selected;
    }

    private void collectDirectUnmarshalOutputCandidate(
        Set<Integer> candidates,
        PcodeOpAST operation) {

        if (candidates == null || operation == null) {
            return;
        }
        if (operation.getOpcode() == PcodeOp.STORE && operation.getNumInputs() >= 3) {
            addFormalOutputCandidate(
                candidates,
                pcodeStorageExpression(operation.getInput(1)));
            addFormalOutputCandidate(
                candidates,
                pcodeLoadedStorageExpression(operation.getInput(1)));
            Integer ownerSlot = formalPointerRootSlot(operation.getInput(1));
            if (ownerSlot != null) {
                candidates.add(ownerSlot);
            }
            return;
        }
        if (operation.getOpcode() != PcodeOp.CALL) {
            return;
        }
        RawPcodeWrite rawWrite = pcodeReadRawWrite(
            operation,
            pcodeCallTarget(operation));
        if (rawWrite != null) {
            addFormalOutputCandidate(candidates, rawWrite.storage);
        }
    }

    private void collectNestedUnmarshalOutputCandidate(
        Set<Integer> candidates,
        Function owner,
        PcodeOpAST operation) {

        if (candidates == null || owner == null || operation == null ||
            operation.getOpcode() != PcodeOp.CALL) {
            return;
        }
        Function target = pcodeCallTarget(operation);
        Integer outputSlot = unmarshalOutputParameterSlot(target);
        if (outputSlot == null) {
            return;
        }
        addFormalOutputCandidate(
            candidates,
            provenCallArgumentStorage(owner, operation, target, outputSlot));
    }

    private void collectMutatingHelperOutputCandidates(
        Set<Integer> candidates,
        Function owner,
        PcodeOpAST operation) {

        if (candidates == null || owner == null || operation == null ||
            operation.getOpcode() != PcodeOp.CALL) {
            return;
        }
        Function target = pcodeCallTarget(operation);
        HighFunction targetHigh = highFunction(target);
        if (targetHigh == null) {
            return;
        }

        LinkedHashSet<Integer> mutatedSlots = new LinkedHashSet<>();
        for (PcodeOpAST targetOperation : orderedPcodeOps(targetHigh)) {
            if (targetOperation.getOpcode() != PcodeOp.STORE ||
                targetOperation.getNumInputs() < 3) {
                continue;
            }
            Integer slot = formalPointerRootSlot(targetOperation.getInput(1));
            if (slot != null) {
                mutatedSlots.add(slot);
            }
        }
        int argumentCount = provenCallArgumentCount(operation, target);
        for (Integer slot : mutatedSlots) {
            if (slot == null || slot <= 0 || slot > argumentCount) {
                continue;
            }
            addFormalOutputCandidate(
                candidates,
                provenCallArgumentStorage(
                    owner,
                    operation,
                    target,
                    slot));
        }
    }

    private void addFormalOutputCandidate(
        Set<Integer> candidates,
        PcodeStorage storage) {

        Integer slot = formalParameterSlot(storage);
        if (slot != null) {
            candidates.add(slot);
        }
    }

    private Integer formalPointerRootSlot(Varnode node) {
        if (node == null) {
            return null;
        }
        String key = "formal-pointer-root:" + pcodeMemoryPathCacheKey(node, 0);
        Optional<Integer> cached = formalPointerRootSlotCache.get(key);
        if (cached != null) {
            return cached.orElse(null);
        }
        Integer result = formalPointerRootSlot(
            node,
            new HashSet<>(),
            new HashMap<>());
        formalPointerRootSlotCache.put(key, Optional.ofNullable(result));
        return result;
    }

    private Integer formalPointerRootSlot(
        Varnode node,
        Set<String> active,
        Map<String, Optional<Integer>> memo) {

        if (node == null) {
            return null;
        }
        String key = pcodeSsaNodeKey(node);
        Optional<Integer> cached = memo.get(key);
        if (cached != null) {
            return cached.orElse(null);
        }
        if (!active.add(key)) {
            return null;
        }

        Integer result;
        try {
            result = formalParameterSlot(node);
            if (result == null) {
                result = formalPointerRootSlotFromDef(
                    node.getDef(),
                    active,
                    memo);
            }
        }
        finally {
            active.remove(key);
        }
        memo.put(key, Optional.ofNullable(result));
        return result;
    }

    private Integer formalPointerRootSlotFromDef(
        PcodeOp operation,
        Set<String> active,
        Map<String, Optional<Integer>> memo) {

        if (operation == null) {
            return null;
        }
        return switch (operation.getOpcode()) {
            case PcodeOp.COPY,
                 PcodeOp.CAST,
                 PcodeOp.INT_ZEXT,
                 PcodeOp.INT_SEXT,
                 PcodeOp.SUBPIECE -> operation.getNumInputs() == 0
                    ? null
                    : formalPointerRootSlot(operation.getInput(0), active, memo);
            case PcodeOp.LOAD -> operation.getNumInputs() < 2
                ? null
                : formalPointerRootSlot(operation.getInput(1), active, memo);
            case PcodeOp.PTRADD,
                 PcodeOp.PTRSUB -> operation.getNumInputs() == 0
                    ? null
                    : formalPointerRootSlot(operation.getInput(0), active, memo);
            case PcodeOp.INT_ADD,
                 PcodeOp.INT_SUB -> uniqueFormalPointerOperand(
                    operation,
                    active,
                    memo);
            case PcodeOp.MULTIEQUAL -> commonFormalPointerRoot(
                operation,
                active,
                memo);
            case PcodeOp.CALL -> returnedFormalPointerRoot(
                operation,
                active,
                memo);
            // INDIRECT marks a value invalidated by a call or memory effect. Its
            // pre-effect input is not proof of the post-effect pointer value.
            case PcodeOp.INDIRECT -> null;
            default -> null;
        };
    }

    private Integer uniqueFormalPointerOperand(
        PcodeOp operation,
        Set<String> active,
        Map<String, Optional<Integer>> memo) {

        Integer selected = null;
        for (int index = 0; index < operation.getNumInputs(); index++) {
            Integer candidate = formalPointerRootSlot(
                operation.getInput(index),
                active,
                memo);
            if (candidate == null) {
                continue;
            }
            if (selected != null) {
                return null;
            }
            selected = candidate;
        }
        return selected;
    }

    private Integer commonFormalPointerRoot(
        PcodeOp operation,
        Set<String> active,
        Map<String, Optional<Integer>> memo) {

        Integer selected = null;
        Varnode phiOutput = operation.getOutput();
        for (int index = 0; index < operation.getNumInputs(); index++) {
            Boolean recurrence = affinePointerRecurrence(
                operation.getInput(index),
                phiOutput,
                new HashSet<>(),
                0);
            if (Boolean.TRUE.equals(recurrence)) {
                continue;
            }
            Integer candidate = formalPointerRootSlot(
                operation.getInput(index),
                active,
                memo);
            if (candidate == null || selected != null && !selected.equals(candidate)) {
                return null;
            }
            selected = candidate;
        }
        return selected;
    }

    private Boolean affinePointerRecurrence(
        Varnode node,
        Varnode phiOutput,
        Set<String> active,
        int depth) {

        if (node == null || phiOutput == null || depth > 48) {
            return null;
        }
        if (sameVarnodeIdentity(node, phiOutput)) {
            return true;
        }
        if (node.isConstant() || node.getDef() == null) {
            return false;
        }
        String key = pcodeSsaNodeKey(node);
        if (!active.add(key)) {
            return null;
        }
        try {
            PcodeOp definition = node.getDef();
            return switch (definition.getOpcode()) {
                case PcodeOp.COPY,
                     PcodeOp.CAST,
                     PcodeOp.INT_ZEXT,
                     PcodeOp.INT_SEXT -> definition.getNumInputs() == 1
                        ? affinePointerRecurrence(
                            definition.getInput(0),
                            phiOutput,
                            active,
                            depth + 1)
                        : null;
                case PcodeOp.SUBPIECE -> isZeroSubpiece(definition)
                    ? affinePointerRecurrence(
                        definition.getInput(0),
                        phiOutput,
                        active,
                        depth + 1)
                    : null;
                case PcodeOp.PTRADD,
                     PcodeOp.PTRSUB -> affinePointerBaseRecurrence(
                        definition,
                        phiOutput,
                        active,
                        depth + 1);
                case PcodeOp.INT_ADD -> affineAddRecurrence(
                    definition,
                    phiOutput,
                    active,
                    depth + 1);
                case PcodeOp.INT_SUB -> affineSubtractRecurrence(
                    definition,
                    phiOutput,
                    active,
                    depth + 1);
                default -> null;
            };
        }
        finally {
            active.remove(key);
        }
    }

    private boolean isZeroSubpiece(PcodeOp operation) {
        return operation.getNumInputs() == 2 &&
            operation.getInput(1).isConstant() &&
            operation.getInput(1).getOffset() == 0L;
    }

    private Boolean affinePointerBaseRecurrence(
        PcodeOp operation,
        Varnode phiOutput,
        Set<String> active,
        int depth) {

        if (operation.getNumInputs() < 2) {
            return null;
        }
        Boolean base = affinePointerRecurrence(
            operation.getInput(0),
            phiOutput,
            active,
            depth);
        if (base == null) {
            return null;
        }
        for (int index = 1; index < operation.getNumInputs(); index++) {
            Boolean offset = affinePointerRecurrence(
                operation.getInput(index),
                phiOutput,
                active,
                depth);
            if (!Boolean.FALSE.equals(offset)) {
                return null;
            }
        }
        return base;
    }

    private Boolean affineAddRecurrence(
        PcodeOp operation,
        Varnode phiOutput,
        Set<String> active,
        int depth) {

        if (operation.getNumInputs() != 2) {
            return null;
        }
        Boolean left = affinePointerRecurrence(
            operation.getInput(0),
            phiOutput,
            active,
            depth);
        Boolean right = affinePointerRecurrence(
            operation.getInput(1),
            phiOutput,
            active,
            depth);
        if (left == null || right == null) {
            return null;
        }
        if (!left && !right) {
            return false;
        }
        return left != right ? true : null;
    }

    private Boolean affineSubtractRecurrence(
        PcodeOp operation,
        Varnode phiOutput,
        Set<String> active,
        int depth) {

        if (operation.getNumInputs() != 2) {
            return null;
        }
        Boolean left = affinePointerRecurrence(
            operation.getInput(0),
            phiOutput,
            active,
            depth);
        Boolean right = affinePointerRecurrence(
            operation.getInput(1),
            phiOutput,
            active,
            depth);
        if (left == null || right == null) {
            return null;
        }
        if (!left && !right) {
            return false;
        }
        return left && !right ? true : null;
    }

    private Integer returnedFormalPointerRoot(
        PcodeOp operation,
        Set<String> active,
        Map<String, Optional<Integer>> memo) {

        Function target = pcodeCallTarget(operation);
        Integer returnedSlot = returnedParameterSlot(target);
        return returnedSlot == null || returnedSlot >= operation.getNumInputs()
            ? null
            : formalPointerRootSlot(
                operation.getInput(returnedSlot),
                active,
                memo);
    }
