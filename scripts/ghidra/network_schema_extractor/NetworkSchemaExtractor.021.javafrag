    private String compositeWireShape(List<String> shapes) {
        if (shapes == null || shapes.isEmpty()) {
            return null;
        }
        if (shapes.size() == 1) {
            return shapes.get(0);
        }
        return "composite<" + String.join(",", shapes) + ">";
    }

    private Long serializeTypeByteWidth(SerializeTypeInfo info) {
        if (info == null) {
            return null;
        }
        String normalized = normalizeUuid(info.typeId);
        if (normalized != null && serializeTypeByteWidthCache.containsKey(normalized)) {
            long cached = serializeTypeByteWidthCache.get(normalized);
            return cached < 0 ? null : cached;
        }
        Long width = serializeTypeByteWidth(info, new LinkedHashSet<>());
        if (normalized != null) {
            serializeTypeByteWidthCache.put(normalized, width == null ? -1L : width);
        }
        return width;
    }

    private Long serializeTypeByteWidth(SerializeTypeInfo info, Set<String> seen) {
        if (info == null || info.layoutFields.isEmpty()) {
            return null;
        }
        String normalized = normalizeUuid(info.typeId);
        if (normalized != null && serializeTypeByteWidthCache.containsKey(normalized)) {
            long cached = serializeTypeByteWidthCache.get(normalized);
            return cached < 0 ? null : cached;
        }
        if (normalized != null && !seen.add(normalized)) {
            return null;
        }
        Long end = null;
        for (SerializeFieldInfo field : info.layoutFields) {
            if (field == null || field.offset == null) {
                continue;
            }
            Long width = field.dataSize;
            if (width == null || width <= 0) {
                width = serializeTypeByteWidth(
                    serializeTypesById.get(normalizeUuid(field.typeId)),
                    new LinkedHashSet<>(seen));
            }
            if (width == null || width <= 0) {
                continue;
            }
            Long fieldEnd = addExactOrNull(field.offset, width);
            if (fieldEnd == null) {
                return null;
            }
            end = end == null ? fieldEnd : Math.max(end, fieldEnd);
        }
        if (normalized != null) {
            serializeTypeByteWidthCache.put(normalized, end == null ? -1L : end);
        }
        return end;
    }

    private void collectContainerValuePcodeMemberCandidates(
        Map<String, LinkedHashMap<Long, NestedTypeMember>> byBase,
        Function target,
        Map<String, PcodeStorage> callerParamStorage) {

        collectContainerValuePcodeMemberCandidates(
            byBase,
            target,
            new LinkedHashSet<>(),
            new LinkedHashSet<>(),
            callerParamStorage);
    }

    private void collectContainerValuePcodeMemberCandidates(
        Map<String, LinkedHashMap<Long, NestedTypeMember>> byBase,
        Function target,
        Set<String> activeContexts,
        Set<String> completedContexts,
        Map<String, PcodeStorage> callerParamStorage) {

        if (byBase == null || target == null) {
            return;
        }
        Address entry = target.getEntryPoint();
        if (entry == null) {
            return;
        }
        HighFunction high = highFunction(target);
        if (high == null) {
            return;
        }
        String contextKey = containerValuePcodeContextKey(target, callerParamStorage);
        if (completedContexts.contains(contextKey)) {
            return;
        }
        if (!activeContexts.add(contextKey)) {
            recordNestedTypeShapeReject("container-value-pcode-helper-cycle");
            return;
        }

        try {
            HashMap<String, String> tempNativeTypes = new HashMap<>();
            HashMap<String, String> tempWireShapes = new HashMap<>();
            Map<Address, CollectionOutputShape> countedCollections =
                containerCollectionOutputs(target);
            ArrayList<CollectionStorageSpan> collectionSpans = new ArrayList<>();
            List<PcodeOpAST> operations = orderedPcodeOps(high);
            for (PcodeOpAST op : operations) {
                if (op.getOpcode() == PcodeOp.CALL) {
                CollectionOutputShape collection = countedCollections.get(
                    op.getSeqnum().getTarget());
                if (collection != null) {
                    countedCollectionsApplied++;
                    PcodeStorage storage = translatedAbsoluteHelperStorage(
                        collection.storage,
                        callerParamStorage);
                    if (storage != null && collection.interiorSpan != null) {
                        CollectionStorageSpan span = new CollectionStorageSpan(
                            storage,
                            collection.interiorSpan);
                        removeCollectionStorageMembers(byBase, span, true);
                        collectionSpans.add(span);
                    }
                    addNestedTypeMemberCandidate(
                        byBase,
                        storage,
                        null,
                        collection.wireEvidence,
                        op,
                        pcodeCallTarget(op),
                        "container-value-pcode-counted-collection");
                    markNestedTypeMemberWireOrder(
                        byBase,
                        storage,
                        "cfg-count-call-order");
                    continue;
                }
                Function callTarget = pcodeCallTarget(op);
                InterproceduralCollectionCall collectionCall =
                    interproceduralCollectionCall(
                        target,
                        op,
                        callTarget,
                        callerParamStorage);
                if (collectionCall != null) {
                    countedCollectionsApplied++;
                    addNestedTypeMemberCandidate(
                        byBase,
                        collectionCall.owner(),
                        null,
                        collectionCall.wireEvidence(),
                        op,
                        callTarget,
                        "container-value-pcode-interprocedural-collection");
                    markNestedTypeMemberWireOrder(
                        byBase,
                        collectionCall.owner(),
                        "cfg-interprocedural-count-call-order");
                    continue;
                }
                RawPcodeWrite rawWrite = pcodeReadRawWrite(op, callTarget);
                if (rawWrite != null) {
                    WireShape rawEvidence = boundedNormalizedBooleanReadEvidence(
                        high,
                        operations,
                        op,
                        rawWrite);
                    if (rawEvidence == null) {
                        rawEvidence = rawWrite.wireEvidence;
                    }
                    putPcodeTempUnmarshal(
                        tempNativeTypes,
                        tempWireShapes,
                        rawWrite.storage,
                        rawWrite.nativeType,
                        rawEvidence.shape == null
                            ? rawEvidence.layout
                            : rawEvidence.shape);
                    PcodeStorage rawStorage =
                        translatedAbsoluteHelperStorage(rawWrite.storage, callerParamStorage);
                    addNestedTypeMemberCandidate(
                        byBase,
                        rawStorage,
                        rawWrite.nativeType,
                        rawEvidence,
                        op,
                        callTarget,
                        "container-value-pcode-readraw-fixed-bytes");
                    markNestedTypeMemberWireOrder(
                        byBase,
                        rawStorage,
                        "cfg-call-order");
                    continue;
                }

                addHelperStoreRelationMembers(
                    byBase,
                    target,
                    op,
                    callTarget,
                    tempNativeTypes,
                    tempWireShapes,
                    callerParamStorage);

                String memberType = firstNonEmpty(
                    unmarshalNativeTypeFromTarget(callTarget),
                    scalarOutputStoreNativeType(callTarget));
                WireShape memberWireEvidence =
                    wireShapeEvidenceFromUnmarshalTarget(callTarget, memberType);
                if (memberWireEvidence == null &&
                    wireShapeFromNativeType(memberType) != null) {
                    memberWireEvidence = validatedAtomicUnmarshalCodecEvidence(
                        callTarget,
                        memberType);
                }
                NestedTypeShape nestedMemberShape = recoverNestedDirectMemberShape(
                    target,
                    callTarget);
                if (nestedMemberShape != null) {
                    PcodeStorage storage = nestedDirectTypeCallOutputStorage(
                        target,
                        op,
                        nestedMemberShape,
                        callerParamStorage);
                    storage = translatedAbsoluteHelperStorage(storage, callerParamStorage);
                    if (addNestedDirectTypeMemberCandidates(
                            byBase,
                            storage,
                            nestedMemberShape,
                            op,
                            callTarget,
                            "container-value-pcode-nested-direct-type-call")) {
                        continue;
                    }
                }
                if (shouldRecurseContainerValueHelper(
                        callTarget,
                        memberWireEvidence)) {
                    Map<String, PcodeStorage> helperParamStorage =
                        callArgumentStorageMap(target, op, callerParamStorage);
                    collectContainerValuePcodeMemberCandidates(
                        byBase,
                        callTarget,
                        activeContexts,
                        completedContexts,
                        helperParamStorage);
                }
                observePcodeTempUnmarshal(
                    tempNativeTypes,
                    tempWireShapes,
                    op,
                    memberType,
                    memberWireEvidence == null ? null : memberWireEvidence.shape);
                PcodeStorage storage = containerValueUnmarshalOutputStorage(
                    op,
                    callerParamStorage);
                storage = translatedAbsoluteHelperStorage(storage, callerParamStorage);
                addNestedTypeMemberCandidate(
                    byBase,
                    storage,
                    memberType,
                    memberWireEvidence,
                    op,
                    callTarget,
                    "container-value-pcode-call");
                applyAtomicUnmarshalNativeSpan(
                    byBase,
                    storage,
                    callTarget,
                    memberWireEvidence);
                markNestedTypeMemberWireOrder(
                    byBase,
                    storage,
                    "cfg-call-order");
                    continue;
                }

                if (op.getOpcode() != PcodeOp.STORE || op.getNumInputs() < 3) {
                    continue;
                }
                PcodeStorage storage = pcodeStorageExpression(op.getInput(1));
                storage = translatedAbsoluteHelperStorage(storage, callerParamStorage);
                if (collectionStorageContains(collectionSpans, storage)) {
                    continue;
                }
                String memberType = pcodeValueNativeType(op.getInput(2), tempNativeTypes);
                PcodeCallTargetInfo valueTarget = pcodeValueCallTargetInfo(op.getInput(2));
                WireShape memberWireEvidence = valueTarget == null
                    ? null
                    : wireShapeEvidenceFromUnmarshalTarget(valueTarget.target, memberType);
                String valueShape = pcodeValueWireShape(
                    op.getInput(2),
                    tempWireShapes,
                    tempNativeTypes);
                String booleanLayout = "bool".equals(valueShape)
                    ? normalizedBooleanReadLayout(target, op, op.getInput(2))
                    : null;
                if (booleanLayout != null) {
                    memberWireEvidence = WireShape.semantic(
                        "bool",
                        booleanLayout,
                        "container-value-pcode-boolean-lineage");
                }
                else if (memberWireEvidence == null && valueShape != null) {
                    memberWireEvidence = WireShape.layout(
                        valueShape,
                        "container-value-pcode-value-lineage");
                }
                addNestedTypeMemberCandidate(
                    byBase,
                    storage,
                    memberType,
                    memberWireEvidence,
                    op,
                    valueTarget == null ? null : valueTarget.target,
                    "container-value-pcode-store");
                markNestedTypeMemberWireOrder(
                    byBase,
                    storage,
                    "cfg-store-order");
            }
            collapseCollectionInteriorMembers(byBase, collectionSpans);
        }
        finally {
            activeContexts.remove(contextKey);
            completedContexts.add(contextKey);
        }
    }

    private String normalizedBooleanReadLayout(
        Function function,
        PcodeOpAST store,
        Varnode value) {

        HighFunction high = highFunction(function);
        if (high == null || store == null || value == null) {
            return null;
        }
        List<PcodeOpAST> operations = orderedPcodeOps(high);
        for (PcodeOpAST readCall : operations) {
            if (readCall.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            RawPcodeWrite rawRead = pcodeReadRawWrite(
                readCall,
                pcodeCallTarget(readCall));
            Integer width = rawRead == null
                ? null
                : wireShapeByteWidth(rawRead.wireEvidence.layout);
            if (width == null || width != Byte.BYTES) {
                continue;
            }
            PcodeOpAST normalization = boundedNormalizedBooleanOperation(
                high,
                operations,
                readCall,
                rawRead);
            if (normalization != null &&
                pcodeNodeDependsOn(
                    value,
                    normalization.getOutput(),
                    new LinkedHashSet<>(),
                    0) &&
                NetworkSchemaControlFlow.precedes(high, normalization, store)) {
                return rawRead.wireEvidence.layout;
            }
        }
        return null;
    }

    private String containerValuePcodeContextKey(
        Function target,
        Map<String, PcodeStorage> callerParamStorage) {

        StringBuilder key = new StringBuilder(target.getEntryPoint().toString());
        if (callerParamStorage == null || callerParamStorage.isEmpty()) {
            return key.toString();
        }
        ArrayList<String> parameters = new ArrayList<>(callerParamStorage.keySet());
        Collections.sort(parameters);
        for (String parameter : parameters) {
            PcodeStorage storage = callerParamStorage.get(parameter);
            key.append('|').append(parameter).append('=');
            if (storage != null) {
                key.append(storage.base).append(':').append(storage.offset);
            }
        }
        return key.toString();
    }

    private boolean isProvenOutputParameterBase(Function function, String base) {
        if (base == null || !base.matches("param_\\d+")) {
            return false;
        }
        return function != null && !readBufferParameters(function).contains(base);
    }

    private PcodeStorage sequenceOwnerStorageForElementUnmarshal(
        PcodeOp op,
        PcodeStorage readBuffer) {

        if (op == null) {
            return null;
        }
        for (int i = 1; i < op.getNumInputs(); i++) {
            PcodeStorage direct = pcodeStorageExpression(op.getInput(i));
            PcodeStorage loaded = pcodeLoadedStorageExpression(op.getInput(i));
            if (readBuffer != null &&
                (readBuffer.sameLocation(direct) || readBuffer.sameLocation(loaded))) {
                continue;
            }
            PcodeStorage storage = vectorOwnerStorageForElementPointer(
                op.getInput(i),
                new LinkedHashSet<>(),
                0);
            if (storage != null) {
                return storage;
            }
        }
        return null;
    }

    private Varnode storageVarnodeForCallOutput(PcodeOp op, PcodeStorage storage) {
        if (op == null || storage == null) {
            return null;
        }
        for (int i = 1; i < op.getNumInputs(); i++) {
            PcodeStorage inputStorage = pcodeStorageExpression(op.getInput(i));
            if (storage.sameLocation(inputStorage)) {
                return op.getInput(i);
            }
        }
        return null;
    }

    private PcodeStorage vectorOwnerStorageForElementPointer(
        Varnode node,
        Set<String> seen,
        int depth) {
