    private WireShape structuralSmallestThreeUnmarshalLeaf(
        Function function,
        String readBufferParameter) {

        HighFunction high = highFunction(function);
        if (high == null ||
            !(isDirectSmallestThreeUnmarshalCore(function, readBufferParameter) ||
              hasExclusiveSmallestThreeReadBufferCall(
                  function,
                  readBufferParameter)) ||
            !hasReadBufferFlow(function, readBufferParameter, new LinkedHashSet<>())) {
            return null;
        }
        if (NetworkSchemaCodecClassifier.isProjectedVec3SmallestThreeDecodeWrapper(high)) {
            return WireShape.semantic(
                "vec3-smallest-three",
                "unmarshal-pcode-projected-smallest-three");
        }
        if (NetworkSchemaCodecClassifier.isQuaternionSmallestThreeDecodeWrapper(high)) {
            return WireShape.semantic(
                "quat-smallest-three",
                "unmarshal-pcode-quaternion-smallest-three");
        }
        return null;
    }

    private boolean isDirectSmallestThreeUnmarshalCore(
        Function function,
        String readBufferParameter) {

        return function != null && readBufferParameter != null &&
            NetworkSchemaCodecClassifier.smallestThreeCoreDirection(
                highFunction(function)) ==
                    NetworkSchemaCodecClassifier.CodecDirection.DECODE &&
            hasReadBufferFlow(
                function,
                readBufferParameter,
                new LinkedHashSet<>());
    }

    private boolean hasExclusiveSmallestThreeReadBufferCall(
        Function function,
        String readBufferParameter) {

        HighFunction high = highFunction(function);
        if (high == null || readBufferParameter == null) {
            return false;
        }
        List<PcodeOpAST> operations = orderedPcodeOps(high);
        for (PcodeOpAST operation : operations) {
            if (directCursorReadEvent(
                    high,
                    operation,
                    operations,
                    readBufferParameter) != null) {
                runMetrics.increment("smallestThreeCompositeLeafRejections");
                return false;
            }
        }

        PcodeStorage readBuffer = new PcodeStorage(readBufferParameter, 0L);
        int coreCalls = 0;
        for (PcodeOpAST operation : operations) {
            if (operation.getOpcode() != PcodeOp.CALL &&
                operation.getOpcode() != PcodeOp.CALLIND) {
                continue;
            }
            Function target = pcodeCallTarget(operation);
            Integer bufferSlot = provenCallArgumentSlot(
                function,
                operation,
                target,
                readBuffer);
            if (bufferSlot == null) {
                continue;
            }
            if (target == null) {
                runMetrics.increment("smallestThreeCompositeLeafRejections");
                return false;
            }
            if (NetworkSchemaCodecClassifier.smallestThreeCoreDirection(
                    highFunction(target)) ==
                NetworkSchemaCodecClassifier.CodecDirection.DECODE) {
                coreCalls++;
                continue;
            }
            if (hasReadBufferFlow(
                    target,
                    "param_" + bufferSlot,
                    new LinkedHashSet<>())) {
                runMetrics.increment("smallestThreeCompositeLeafRejections");
                return false;
            }
        }
        if (coreCalls == 1) {
            runMetrics.increment("exclusiveSmallestThreeReadBufferProofs");
            return true;
        }
        return false;
    }

    private boolean hasSmallestThreeCoreCall(
        Function function,
        NetworkSchemaCodecClassifier.CodecDirection direction) {

        HighFunction high = highFunction(function);
        if (high == null) {
            return false;
        }
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            if (operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            Function target = pcodeCallTarget(operation);
            if (NetworkSchemaCodecClassifier.smallestThreeCoreDirection(highFunction(target)) ==
                direction) {
                return true;
            }
        }
        return false;
    }
