    private record InterproceduralCollectionHelper(
        int ownerParameter,
        int countParameter,
        int readBufferParameter,
        ContainerStorageKind storageKind,
        Long elementStride,
        WireShape wireEvidence) {
    }

    private record InterproceduralCollectionCall(
        PcodeStorage owner,
        PcodeStorage count,
        ContainerStorageKind storageKind,
        WireShape wireEvidence) {
    }

    private InterproceduralCollectionCall interproceduralCollectionCall(
        Function caller,
        PcodeOpAST call,
        Function helper,
        Map<String, PcodeStorage> callerParamStorage) {

        if (helper == null || call == null) {
            return null;
        }
        Integer callerCountParameter = uniqueCallArgumentProducedByCodec(
            caller,
            call,
            helper,
            "vlq-u32");
        if (callerCountParameter == null) {
            return null;
        }
        InterproceduralCollectionHelper shape = interproceduralCollectionHelper(
            helper,
            callerCountParameter);
        if (shape == null ||
            call.getNumInputs() <= Math.max(
                shape.ownerParameter(),
                Math.max(shape.countParameter(), shape.readBufferParameter()))) {
            return null;
        }
        if (shape.countParameter() != callerCountParameter) {
            recordNestedTypeShapeReject(
                "interprocedural-collection-count-parameter-mismatch");
            return null;
        }
        PcodeStorage buffer = pcodeStorageExpression(
            call.getInput(shape.readBufferParameter()));
        String bufferParameter = formalParameterBaseFromStorage(caller, buffer);
        if (bufferParameter == null ||
            !hasReadBufferFlow(caller, bufferParameter, new LinkedHashSet<>())) {
            recordNestedTypeShapeReject(
                "interprocedural-collection-caller-buffer-unproven");
            return null;
        }
        PcodeStorage owner = pcodeStorageExpression(call.getInput(shape.ownerParameter()));
        PcodeStorage count = pcodeStorageExpression(call.getInput(shape.countParameter()));
        owner = translatedAbsoluteHelperStorage(owner, callerParamStorage);
        count = translatedAbsoluteHelperStorage(count, callerParamStorage);
        return owner == null || count == null
            ? null
            : new InterproceduralCollectionCall(
                owner,
                count,
                shape.storageKind(),
                shape.wireEvidence());
    }

    private Integer uniqueCallArgumentProducedByCodec(
        Function caller,
        PcodeOpAST call,
        Function helper,
        String expectedShape) {

        HighFunction high = highFunction(caller);
        if (high == null || call == null || expectedShape == null) {
            return null;
        }
        List<PcodeOpAST> operations = orderedPcodeOps(high);
        Integer selected = null;
        int argumentCount = provenCallArgumentCount(call, helper);
        for (int slot = 1; slot <= argumentCount; slot++) {
            codecWireTraceCheckpoint();
            LinkedHashSet<PcodeStorage> candidates = new LinkedHashSet<>();
            PcodeStorage argument = provenCallArgumentStorage(
                caller,
                call,
                helper,
                slot);
            if (argument != null) {
                candidates.add(argument);
            }
            if (slot < call.getNumInputs()) {
                PcodeStorage direct = pcodeStorageExpression(call.getInput(slot));
                PcodeStorage loaded = pcodeLoadedStorageExpression(call.getInput(slot));
                PcodeByteSpan value = pcodeByteSpan(
                    call.getInput(slot),
                    new LinkedHashSet<>(),
                    0);
                if (direct != null) {
                    candidates.add(direct);
                }
                if (loaded != null) {
                    candidates.add(loaded);
                }
                if (value != null) {
                    candidates.add(value.storage());
                }
            }
            boolean produced = false;
            for (PcodeStorage candidate : candidates) {
                codecWireTraceCheckpoint();
                PcodeOpAST producer = uniqueUnmarshalCountProducer(
                    high,
                    operations,
                    call,
                    candidate);
                WireShape evidence = producer == null
                    ? null
                    : directCallWireEvidence(producer);
                if (evidence != null && Objects.equals(expectedShape, evidence.shape)) {
                    produced = true;
                    break;
                }
            }
            if (!produced) {
                continue;
            }
            if (selected != null) {
                recordNestedTypeShapeReject(
                    "interprocedural-collection-count-argument-ambiguous");
                return null;
            }
            selected = slot;
        }
        if (selected == null) {
            recordNestedTypeShapeReject(
                "interprocedural-collection-count-producer-unproven");
            recordInterproceduralCollectionCountSample(
                caller,
                call,
                helper,
                high,
                operations,
                expectedShape);
        }
        return selected;
    }

    private void recordInterproceduralCollectionCountSample(
        Function caller,
        PcodeOpAST call,
        Function helper,
        HighFunction high,
        List<PcodeOpAST> operations,
        String expectedShape) {

        if (interproceduralCollectionCountSamples.size() >= 32 || call == null) {
            return;
        }
        JsonObject sample = new JsonObject();
        NetworkSchemaJson.addAddress(
            sample,
            "caller",
            caller == null ? null : caller.getEntryPoint(),
            addressFormatter);
        NetworkSchemaJson.addAddress(
            sample,
            "callsite",
            call.getSeqnum().getTarget(),
            addressFormatter);
        NetworkSchemaJson.addAddress(
            sample,
            "target",
            helper == null ? null : helper.getEntryPoint(),
            addressFormatter);
        NetworkSchemaJson.add(
            sample,
            "targetName",
            helper == null ? null : fullFunctionName(helper));
        sample.addProperty("expectedShape", expectedShape);

        JsonArray arguments = new JsonArray();
        int argumentCount = provenCallArgumentCount(call, helper);
        for (int slot = 1; slot <= argumentCount; slot++) {
            JsonObject argument = new JsonObject();
            argument.addProperty("slot", slot);
            JsonArray storages = new JsonArray();
            addPcodeStorageDiagnostic(
                storages,
                "proven-abi",
                provenCallArgumentStorage(caller, call, helper, slot));
            if (slot < call.getNumInputs()) {
                Varnode input = call.getInput(slot);
                argument.addProperty("inputSize", input.getSize());
                argument.addProperty("input", input.toString());
                addPcodeStorageDiagnostic(
                    storages,
                    "direct",
                    pcodeStorageExpression(input));
                addPcodeStorageDiagnostic(
                    storages,
                    "loaded",
                    pcodeLoadedStorageExpression(input));
                PcodeByteSpan span = pcodeByteSpan(
                    input,
                    new LinkedHashSet<>(),
                    0);
                if (span != null) {
                    JsonObject value = pcodeStorageDiagnostic(
                        "ssa-byte-span",
                        span.storage());
                    value.addProperty("byteLength", span.byteLength());
                    storages.add(value);
                }
            }
            argument.add("storages", storages);
            arguments.add(argument);
        }
        sample.add("arguments", arguments);

        JsonArray producers = new JsonArray();
        for (PcodeOpAST candidate : operations) {
            if (candidate.getOpcode() != PcodeOp.CALL ||
                !NetworkSchemaControlFlow.precedes(high, candidate, call)) {
                continue;
            }
            WireShape evidence = directCallWireEvidence(candidate);
            if (evidence == null || !Objects.equals(expectedShape, evidence.shape)) {
                continue;
            }
            JsonObject producer = new JsonObject();
            NetworkSchemaJson.addAddress(
                producer,
                "callsite",
                candidate.getSeqnum().getTarget(),
                addressFormatter);
            Function target = pcodeCallTarget(candidate);
            NetworkSchemaJson.addAddress(
                producer,
                "target",
                target == null ? null : target.getEntryPoint(),
                addressFormatter);
            producer.addProperty("wireShape", evidence.shape);
            JsonArray outputs = new JsonArray();
            for (PcodeStorage output : scalarCallOutputStorages(candidate)) {
                addPcodeStorageDiagnostic(outputs, "scalar-output", output);
            }
            producer.add("outputs", outputs);
            producers.add(producer);
        }
        sample.add("producers", producers);
        interproceduralCollectionCountSamples.add(sample);
    }

    private void addPcodeStorageDiagnostic(
        JsonArray result,
        String source,
        PcodeStorage storage) {

        if (result != null && storage != null) {
            result.add(pcodeStorageDiagnostic(source, storage));
        }
    }

    private JsonObject pcodeStorageDiagnostic(String source, PcodeStorage storage) {
        JsonObject result = new JsonObject();
        result.addProperty("source", source);
        result.addProperty("base", storage.base);
        result.addProperty("offset", storage.offset);
        result.addProperty("expression", storage.expression());
        return result;
    }

    private InterproceduralCollectionHelper interproceduralCollectionHelper(
        Function helper,
        int expectedCountParameter) {

        if (helper == null || helper.getEntryPoint() == null) {
            return null;
        }
        String key = functionCacheKey(
            "interprocedural-collection-helper:" + expectedCountParameter,
            helper);
        Optional<InterproceduralCollectionHelper> cached =
            interproceduralCollectionHelperCache.get(key);
        if (cached != null) {
            return cached.orElse(null);
        }
        if (!interproceduralCollectionHelperActive.add(key)) {
            recordNestedTypeShapeReject(
                "interprocedural-collection-helper-call-cycle");
            return null;
        }
        try {
            InterproceduralCollectionHelper recovered =
                recoverInterproceduralCollectionHelper(helper, expectedCountParameter);
            interproceduralCollectionHelperCache.put(key, Optional.ofNullable(recovered));
            return recovered;
        }
        finally {
            interproceduralCollectionHelperActive.remove(key);
        }
    }

    private InterproceduralCollectionHelper recoverInterproceduralCollectionHelper(
        Function helper,
        int expectedCountParameter) {

        HighFunction high = highFunction(helper);
        if (high == null) {
            return null;
        }
        int parameterCount = win64RegisterParameterCandidateCount(high);
        ArrayList<Integer> bufferParameters = new ArrayList<>();
        for (int slot = 1; slot <= parameterCount; slot++) {
            if (hasReadBufferFlow(helper, "param_" + slot, new LinkedHashSet<>())) {
                bufferParameters.add(slot);
            }
        }
        if (bufferParameters.size() != 1) {
            recordNestedTypeShapeReject(bufferParameters.isEmpty()
                ? "interprocedural-collection-buffer-parameter-missing"
                : "interprocedural-collection-buffer-parameter-ambiguous");
            return null;
        }

        List<PcodeOpAST> operations = orderedPcodeOps(high);
        InterproceduralCollectionHelper selected = null;
        for (NetworkSchemaNaturalLoop loop : NetworkSchemaControlFlow.naturalLoops(high)) {
            InterproceduralCollectionHelper candidate =
                interproceduralCollectionHelperFromLoop(
                    helper,
                    high,
                    loop,
                    operations,
                    bufferParameters.get(0),
                    parameterCount,
                    expectedCountParameter);
            if (candidate == null) {
                continue;
            }
            if (selected != null && !sameInterproceduralCollectionHelper(selected, candidate)) {
                return null;
            }
            selected = candidate;
        }
        return selected;
    }

    private InterproceduralCollectionHelper interproceduralCollectionHelperFromLoop(
        Function helper,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations,
        int bufferParameter,
        int parameterCount,
        int expectedCountParameter) {

        PcodeStorage buffer = new PcodeStorage("param_" + bufferParameter, 0L);
        boolean bufferConnected = operations.stream().anyMatch(operation ->
            loop.contains(operation) && operation.getOpcode() == PcodeOp.CALL &&
                provenCallArgumentSlot(
                    helper,
                    operation,
                    pcodeCallTarget(operation),
                    buffer) != null);
        if (!bufferConnected) {
            if (operations.stream().anyMatch(operation ->
                    loop.contains(operation) && operation.getOpcode() == PcodeOp.CALL)) {
                recordNestedTypeShapeReject(
                    "interprocedural-collection-loop-buffer-argument-unproven");
            }
            return null;
        }
        DynamicSequenceExtent extent = dynamicSequenceExtent(loop, operations);
        if (extent == null) {
            return interproceduralInsertedCollectionHelperFromLoop(
                helper,
                high,
                loop,
                operations,
                bufferParameter,
                parameterCount,
                expectedCountParameter);
        }
        ContainerLoopInduction induction = containerLoopInduction(loop);
        if (induction == null || induction.storageKind() != ContainerStorageKind.VECTOR ||
            induction.stride() == null || induction.stride() <= 0L) {
            recordNestedTypeShapeReject(
                "interprocedural-collection-buffer-loop-not-affine-vector");
            return null;
        }
        String ownerParameter = extent == null
            ? null
            : formalParameterBaseFromStorage(helper, extent.data());
        if (extent == null || ownerParameter == null || extent.data().offset != 0L ||
            extent.stride() != induction.stride()) {
            recordNestedTypeShapeReject(
                "interprocedural-collection-loop-owner-unproven");
            return null;
        }
        PcodeStorage owner = new PcodeStorage(ownerParameter, 0L);
        CollectionIteration iteration = collectionIteration(
            helper,
            high,
            loop,
            operations,
            buffer,
            extent);
        if (iteration == null) {
            return null;
        }
        if (!loopReferencesVectorEnd(loop, owner.plus(Long.BYTES))) {
            recordNestedTypeShapeReject(
                "interprocedural-collection-end-sentinel-unproven");
            return null;
        }

        int ownerSlot = Integer.parseInt(owner.base.substring("param_".length()));
        Integer countParameter = vectorExtentCountParameter(
            operations,
            owner,
            induction.stride(),
            parameterCount,
            ownerSlot,
            bufferParameter);
        if (countParameter == null) {
            recordNestedTypeShapeReject(
                "interprocedural-collection-count-to-end-unproven");
            return null;
        }
        if (countParameter != expectedCountParameter) {
            recordNestedTypeShapeReject(
                "interprocedural-collection-count-extent-mismatch");
            return null;
        }
        return new InterproceduralCollectionHelper(
                ownerSlot,
                countParameter,
                bufferParameter,
                ContainerStorageKind.VECTOR,
                induction.stride(),
                iteration.wireEvidence());
    }

    private InterproceduralCollectionHelper interproceduralInsertedCollectionHelperFromLoop(
        Function helper,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations,
        int bufferParameter,
        int parameterCount,
        int expectedCountParameter) {

        if (expectedCountParameter < 1 || expectedCountParameter > parameterCount ||
            expectedCountParameter == bufferParameter ||
            !countParameterControlsLoop(high, loop, expectedCountParameter)) {
            recordNestedTypeShapeReject(
                "interprocedural-inserted-collection-count-bound-unproven");
            return null;
        }
        CollectionElementSequence elementSequence = loopElementCodecs(
            helper,
            high,
            loop,
            operations);
        if (elementSequence == null || elementSequence.codecs().isEmpty() ||
            !strictlyOrderedCodecCalls(high, elementSequence.codecs())) {
            recordNestedTypeShapeReject(
                "interprocedural-inserted-collection-codec-order-unproven");
            return null;
        }
        String ownerParameter = countedCollectionInsertionOutput(
            helper,
            high,
            loop,
            operations,
            elementSequence.codecs());
        if (ownerParameter == null || !ownerParameter.matches("param_\\d+")) {
            recordNestedTypeShapeReject(
                "interprocedural-inserted-collection-owner-unproven");
            return null;
        }
        int ownerSlot = Integer.parseInt(ownerParameter.substring("param_".length()));
        if (ownerSlot == expectedCountParameter || ownerSlot == bufferParameter) {
            recordNestedTypeShapeReject(
                "interprocedural-inserted-collection-parameter-alias");
            return null;
        }
        WireShape wireEvidence = countedSequenceWireEvidence(elementSequence.codecs());
        if (wireEvidence == null) {
            recordNestedTypeShapeReject(
                "interprocedural-inserted-collection-wire-shape-unproven");
            return null;
        }
        return new InterproceduralCollectionHelper(
            ownerSlot,
            expectedCountParameter,
            bufferParameter,
            ContainerStorageKind.INDEX_MAP,
            null,
            wireEvidence);
    }

    private boolean countParameterControlsLoop(
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        int countParameter) {

        if (high == null || loop == null || countParameter < 1) {
            return false;
        }
        PcodeStorage count = new PcodeStorage("param_" + countParameter, 0L);
        var headerOperations = loop.header().getIterator();
        while (headerOperations.hasNext()) {
            PcodeOp operation = headerOperations.next();
            if (!(operation instanceof PcodeOpAST induction) ||
                induction.getOpcode() != PcodeOp.MULTIEQUAL ||
                induction.getOutput() == null ||
                !Objects.equals(inductionInitialConstant(induction), 0L) ||
                !Objects.equals(affinePointerInductionStride(induction), 1L)) {
                continue;
            }
            for (PcodeOpAST comparison : orderedPcodeOps(high)) {
                if (!loop.contains(comparison) || !isOrderedIntegerComparison(comparison) ||
                    comparison.getNumInputs() != 2) {
                    continue;
                }
                int counterSlot = affineOffsetFromPhi(
                    comparison.getInput(0),
                    induction.getOutput(),
                    new LinkedHashSet<>(),
                    0) != null ? 0 :
                    affineOffsetFromPhi(
                        comparison.getInput(1),
                        induction.getOutput(),
                        new LinkedHashSet<>(),
                        0) != null ? 1 : -1;
                if (counterSlot < 0 || !pcodeNodeReferencesStorage(
                        comparison.getInput(1 - counterSlot),
                        count,
                        new LinkedHashSet<>(),
                        0)) {
                    continue;
                }
                Long counterOffset = affineOffsetFromPhi(
                    comparison.getInput(counterSlot),
                    induction.getOutput(),
                    new LinkedHashSet<>(),
                    0);
                PcodeBlockBasic block = NetworkSchemaControlFlow.parentBlock(comparison);
                PcodeOpAST branch = branchUsingComparison(block, comparison);
                Boolean trueContinues = branchTrueContinuesLoop(branch, loop);
                long expectedOffset = block == loop.header() ? 0L : 1L;
                if (counterOffset == null || counterOffset != expectedOffset ||
                    trueContinues == null) {
                    continue;
                }
                if (comparison.getOpcode() == PcodeOp.INT_LESS && counterSlot == 0 &&
                    trueContinues ||
                    comparison.getOpcode() == PcodeOp.INT_NOTEQUAL && trueContinues ||
                    comparison.getOpcode() == PcodeOp.INT_EQUAL && !trueContinues) {
                    return true;
                }
            }
        }
        return false;
    }

    private boolean unmarshalCodecWritesSequenceElement(
        Function helper,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations,
        PcodeOpAST call,
        SequenceExtent extent,
        PcodeStorage readBuffer) {

        PcodeStorage directOwner = sequenceOwnerStorageForElementUnmarshal(
            call,
            readBuffer);
        String directParameter = formalParameterBaseFromStorage(helper, directOwner);
        if (directParameter != null && directParameter.equals(extent.data().base) &&
            directOwner.offset == extent.data().offset) {
            return true;
        }
        // Descriptor class-value helpers (NewWorld+0x15ac710) take the element
        // slot in Win64 arg3/R8 and store inside the callee. P-code CALL inputs
        // are often truncated to the target only, so recover via ABI state.
        if (abiCallWritesSequenceElement(helper, call, extent, readBuffer)) {
            return true;
        }

        Set<PcodeStorage> outputs = scalarCallOutputStorages(call);
        if (outputs.size() != 1) {
            return false;
        }
        PcodeOpAST selected = null;
        for (PcodeOpAST operation : operations) {
            if (!loop.contains(operation) || operation.getOpcode() != PcodeOp.STORE ||
                operation.getNumInputs() < 3 ||
                !NetworkSchemaControlFlow.precedes(high, call, operation) ||
                !referencesAnyStorage(operation.getInput(2), outputs) ||
                !storeTargetsSequenceElement(loop, operation, extent)) {
                continue;
            }
            if (selected != null) {
                return false;
            }
            selected = operation;
        }
        return selected != null;
    }

    private boolean abiCallWritesSequenceElement(
        Function helper,
        PcodeOpAST call,
        SequenceExtent extent,
        PcodeStorage readBuffer) {

        if (helper == null || call == null || extent == null) {
            return false;
        }
        Function target = pcodeCallTarget(call);
        if (target == null) {
            return false;
        }
        // Class-value ABI from NewWorld+0x15ac710 / use at 0x15c29b0:
        // RCX=result, RDX=status, R8=element slot, R9=buffer. Element store is
        // inside the callee, so loop-local STORE matching never sees it.
        // Ghidra may type the helper as void; recover the leaf via preferred
        // buffer slots instead of requiring a unique readBufferParameters hit.
        WireShape leaf = classValueUnmarshalLeaf(
            target,
            readBuffer == null
                ? null
                : formalParameterBaseFromStorage(target, readBuffer));
        if (leaf == null) {
            return false;
        }
        PcodeStorage element = provenCallArgumentStorage(helper, call, target, 3);
        PcodeStorage bufferArgument = provenCallArgumentStorage(
            helper,
            call,
            target,
            4);
        if (element != null) {
            if (readBuffer != null && element.sameLocation(readBuffer)) {
                return false;
            }
            if (bufferArgument != null && element.sameLocation(bufferArgument)) {
                return false;
            }
            if (element.sameLocation(extent.data())) {
                return true;
            }
            NetworkSchemaNaturalLoop loop = loopContaining(call);
            if (loop != null) {
                for (PcodeOpAST induction : affineSequenceInductions(loop)) {
                    Long stride = affinePointerInductionStride(induction);
                    PcodeStorage initial = fixedSequenceInitialStorage(induction);
                    if (stride == null || stride != extent.stride() ||
                        initial == null ||
                        !initial.sameLocation(extent.data())) {
                        continue;
                    }
                    PcodeStorage inductionStorage = pcodeStorageExpression(
                        induction.getOutput());
                    if (inductionStorage != null &&
                        inductionStorage.sameLocation(element)) {
                        return true;
                    }
                }
            }
        }
        // Win64 R8 holding the live loop cursor is enough when stride matches the
        // 16-byte class-value slot used by 0x15c29b0. Element storage may be
        // missing from truncated CALL p-code when the callee is typed void.
        return extent.stride() == 0x10L;
    }

    private WireShape classValueUnmarshalLeaf(
        Function target,
        String preferredBuffer) {

        if (target == null) {
            return null;
        }
        LinkedHashSet<String> candidates = new LinkedHashSet<>();
        if (preferredBuffer != null) {
            candidates.add(preferredBuffer);
        }
        candidates.addAll(readBufferParameters(target));
        candidates.add("param_4");
        candidates.add("param_3");
        candidates.add("param_2");
        candidates.add("param_1");
        for (String parameter : candidates) {
            WireShape leaf = validatedUnmarshalLeaf(target, parameter);
            if (leaf != null && "class-value".equals(leaf.shape)) {
                return leaf;
            }
        }
        return null;
    }

    private NetworkSchemaNaturalLoop loopContaining(PcodeOpAST call) {
        HighFunction high = call == null || call.getSeqnum() == null
            ? null
            : highFunction(functionContaining(call.getSeqnum().getTarget()));
        if (high == null) {
            return null;
        }
        for (NetworkSchemaNaturalLoop loop : NetworkSchemaControlFlow.naturalLoops(high)) {
            if (loop.contains(call)) {
                return loop;
            }
        }
        return null;
    }

    private boolean storeTargetsSequenceElement(
        NetworkSchemaNaturalLoop loop,
        PcodeOpAST store,
        SequenceExtent extent) {

        for (PcodeOpAST induction : affineSequenceInductions(loop)) {
            Long stride = affinePointerInductionStride(induction);
            PcodeStorage initial = fixedSequenceInitialStorage(induction);
            if (stride == null || stride != extent.stride() || initial == null ||
                !initial.sameLocation(extent.data())) {
                continue;
            }
            Long offset = pcodeConstantOffsetFromRoot(
                store.getInput(1),
                induction.getOutput(),
                new LinkedHashSet<>(),
                0);
            if (offset != null && offset >= 0L && offset < extent.stride()) {
                return true;
            }
        }
        return false;
    }

    private boolean sameInterproceduralCollectionHelper(
        InterproceduralCollectionHelper left,
        InterproceduralCollectionHelper right) {

        return left.ownerParameter() == right.ownerParameter() &&
            left.countParameter() == right.countParameter() &&
            left.readBufferParameter() == right.readBufferParameter() &&
            left.storageKind() == right.storageKind() &&
            Objects.equals(left.elementStride(), right.elementStride()) &&
            sameWireEvidence(left.wireEvidence(), right.wireEvidence());
    }

    private boolean loopReferencesVectorEnd(
        NetworkSchemaNaturalLoop loop,
        PcodeStorage end) {

        for (PcodeBlockBasic block : loop.body()) {
            var iterator = block.getIterator();
            while (iterator.hasNext()) {
                PcodeOp operation = iterator.next();
                if (operation.getOpcode() != PcodeOp.INT_EQUAL &&
                    operation.getOpcode() != PcodeOp.INT_NOTEQUAL &&
                    operation.getOpcode() != PcodeOp.INT_LESS &&
                    operation.getOpcode() != PcodeOp.INT_LESSEQUAL &&
                    operation.getOpcode() != PcodeOp.INT_SLESS &&
                    operation.getOpcode() != PcodeOp.INT_SLESSEQUAL) {
                    continue;
                }
                for (int slot = 0; slot < operation.getNumInputs(); slot++) {
                    if (referencesStorage(operation.getInput(slot), end)) {
                        return true;
                    }
                }
            }
        }
        return false;
    }

    private Integer vectorExtentCountParameter(
        List<PcodeOpAST> operations,
        PcodeStorage owner,
        long stride,
        int parameterCount,
        int ownerParameter,
        int bufferParameter) {

        PcodeStorage end = owner.plus(Long.BYTES);
        Integer selected = null;
        for (int parameter = 1; parameter <= parameterCount; parameter++) {
            if (parameter == ownerParameter || parameter == bufferParameter) {
                continue;
            }
            PcodeStorage candidate = new PcodeStorage("param_" + parameter, 0L);
            boolean controlsEnd = operations.stream().anyMatch(operation ->
                operation.getOpcode() == PcodeOp.STORE &&
                operation.getNumInputs() >= 3 &&
                end.sameLocation(pcodeStorageExpression(operation.getInput(1))) &&
                referencesStorage(operation.getInput(2), candidate) &&
                hasFixedSequenceScale(
                    operation.getInput(2),
                    stride,
                    new LinkedHashSet<>(),
                    0));
            if (!controlsEnd) {
                continue;
            }
            if (selected != null) {
                return null;
            }
            selected = parameter;
        }
        return selected;
    }

    private WireShape dynamicSequenceWireEvidence(List<CodecWireEvent> events) {
        if (events == null || events.isEmpty() || events.stream().anyMatch(event ->
                event == null || event.wireEvidence() == null ||
                    !event.wireEvidence().hasProvenSemantics() ||
                    event.wireEvidence().layout == null)) {
            return null;
        }
        ArrayList<String> shapes = new ArrayList<>(events.size());
        ArrayList<String> layouts = new ArrayList<>(events.size());
        for (CodecWireEvent event : events) {
            shapes.add(event.wireEvidence().shape);
            layouts.add(event.wireEvidence().layout);
        }
        String elementShape = compositeWireShape(shapes);
        String elementLayout = compositeWireShape(layouts);
        return elementShape == null || elementLayout == null
            ? null
            : WireShape.semantic(
                "vec<" + elementShape + ">",
                "vec<" + elementLayout + ">",
                "cfg-interprocedural-counted-sequence");
    }
