    private boolean pcodeNodeDependsOn(
        Varnode node,
        Varnode expected,
        Set<String> seen,
        int depth) {

        if (node == null || expected == null || depth > 48) {
            return false;
        }
        if (sameVarnodeIdentity(node, expected)) {
            return true;
        }
        if (!seen.add(pcodeNodeKey(node))) {
            return false;
        }
        PcodeOp definition = node.getDef();
        if (definition == null || definition.getOpcode() == PcodeOp.CALL ||
            definition.getOpcode() == PcodeOp.CALLIND) {
            return false;
        }
        int inputs = definition.getOpcode() == PcodeOp.INDIRECT
            ? Math.min(1, definition.getNumInputs())
            : definition.getNumInputs();
        for (int slot = 0; slot < inputs; slot++) {
            Varnode input = definition.getInput(slot);
            if (input != null && !input.isConstant() && pcodeNodeDependsOn(
                input,
                expected,
                seen,
                depth + 1)) {
                return true;
            }
        }
        return false;
    }

    private boolean transparentPcodeDefinition(PcodeOp definition) {
        return definition != null && definition.getNumInputs() > 0 && switch (definition.getOpcode()) {
            case PcodeOp.COPY, PcodeOp.CAST, PcodeOp.INDIRECT,
                PcodeOp.INT_ZEXT, PcodeOp.INT_SEXT, PcodeOp.SUBPIECE -> true;
            default -> false;
        };
    }
