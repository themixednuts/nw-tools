    private Map<String, CollectionOutputShape> collectionOutputShapesByParameterFromPcode(
        Function target) {

        if (target == null || target.getEntryPoint() == null) {
            return Collections.emptyMap();
        }
        String context = functionCacheKey("collection-output-shape", target);
        Map<String, CollectionOutputShape> cached = collectionOutputShapeCache.get(context);
        if (cached != null) {
            return cached;
        }
        if (!collectionOutputShapeActive.add(context)) {
            recordNestedTypeShapeReject("collection-output-call-cycle");
            return Collections.emptyMap();
        }
        try {
            HighFunction high = highFunction(target);
            if (high == null) {
                return Collections.emptyMap();
            }

            List<PcodeOpAST> operations = orderedPcodeOps(high);
            LinkedHashMap<String, CollectionOutputShape> result = new LinkedHashMap<>();
            for (NetworkSchemaNaturalLoop loop : NetworkSchemaControlFlow.naturalLoops(high)) {
                CollectionOutputShape shape = countedCollectionOutputFromLoop(
                    target,
                    high,
                    loop,
                    operations);
                if (shape == null) {
                    continue;
                }
                CollectionOutputShape previous = result.putIfAbsent(
                    storageKey(shape.storage),
                    shape);
                if (previous != null &&
                    (!Objects.equals(previous.countCallsite, shape.countCallsite) ||
                     !sameWireEvidence(previous.wireEvidence, shape.wireEvidence))) {
                    recordNestedTypeShapeReject("ambiguous-counted-collection-output");
                    result.clear();
                    break;
                }
            }
            Map<String, CollectionOutputShape> immutable = Map.copyOf(result);
            collectionOutputShapeCache.put(context, immutable);
            return immutable;
        }
        finally {
            collectionOutputShapeActive.remove(context);
        }
    }
