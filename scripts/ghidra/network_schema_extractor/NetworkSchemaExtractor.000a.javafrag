    private enum AnalysisMode {
        FULL_SCHEMA("Full schema", "full-schema", "network-schema.static.json"),
        SELECTED_TYPES(
            "Selected type indices",
            "selected-types",
            "network-schema.static.selected.json"),
        HANDLER_VTABLES(
            "Handler vtables",
            "handler-vtables",
            "network-schema.handlers.selected.json"),
        FUNCTION_TRACE(
            "Function trace",
            "function-trace",
            "network-schema.function-trace.json");

        final String label;
        final String jsonName;
        final String outputFileName;

        AnalysisMode(String label, String jsonName, String outputFileName) {
            this.label = label;
            this.jsonName = jsonName;
            this.outputFileName = outputFileName;
        }

        @Override
        public String toString() {
            return label;
        }
    }

    private record AnalysisRequest(
        AnalysisMode mode,
        Set<Integer> typeIndices,
        String handlerVtables,
        String functionAddress) {

        static AnalysisRequest fullSchema() {
            return new AnalysisRequest(AnalysisMode.FULL_SCHEMA, Set.of(), null, null);
        }
    }

    private AnalysisRequest analysisRequest() throws Exception {
        if (isRunningHeadless()) {
            return headlessAnalysisRequest(getScriptArgs());
        }

        List<AnalysisMode> modes = List.of(AnalysisMode.values());
        AnalysisMode mode = askChoice(
            "Network schema extraction",
            "Choose the analysis to run",
            modes,
            AnalysisMode.FULL_SCHEMA);
        return switch (mode) {
            case FULL_SCHEMA -> AnalysisRequest.fullSchema();
            case SELECTED_TYPES -> new AnalysisRequest(
                mode,
                parseTypeIndices(askString(
                    "Selected network types",
                    "Type indices (decimal or 0x-prefixed, separated by commas)")),
                null,
                null);
            case HANDLER_VTABLES -> new AnalysisRequest(
                mode,
                Set.of(),
                requireAnalysisValue(
                    askString(
                        "Selected field handlers",
                        "Vtable addresses (module-relative, separated by commas)"),
                    "handler vtable addresses"),
                null);
            case FUNCTION_TRACE -> new AnalysisRequest(
                mode,
                Set.of(),
                null,
                requireAnalysisValue(
                    askString(
                        "Function trace",
                        "Function address (module-relative)"),
                    "function address"));
        };
    }

    private AnalysisRequest headlessAnalysisRequest(String[] arguments) {
        if (arguments.length == 0 || "full".equalsIgnoreCase(arguments[0])) {
            return AnalysisRequest.fullSchema();
        }
        if (arguments.length != 2) {
            throw new IllegalArgumentException(
                "Expected no arguments, or one mode and value: types, handlers, or trace");
        }
        return switch (arguments[0].toLowerCase(Locale.ROOT)) {
            case "types" -> new AnalysisRequest(
                AnalysisMode.SELECTED_TYPES,
                parseTypeIndices(arguments[1]),
                null,
                null);
            case "handlers" -> new AnalysisRequest(
                AnalysisMode.HANDLER_VTABLES,
                Set.of(),
                requireAnalysisValue(arguments[1], "handler vtable addresses"),
                null);
            case "trace" -> new AnalysisRequest(
                AnalysisMode.FUNCTION_TRACE,
                Set.of(),
                null,
                requireAnalysisValue(arguments[1], "function address"));
            default -> throw new IllegalArgumentException(
                "Unknown analysis mode: " + arguments[0]);
        };
    }

    private Set<Integer> parseTypeIndices(String value) {
        LinkedHashSet<Integer> result = new LinkedHashSet<>();
        for (String token : value.split("[,\\s]+")) {
            if (token.isBlank()) {
                continue;
            }
            try {
                int typeIndex = Integer.decode(token.trim());
                if (typeIndex < 0) {
                    throw new NumberFormatException("negative type index");
                }
                result.add(typeIndex);
            }
            catch (NumberFormatException exception) {
                throw new IllegalArgumentException(
                    "Invalid type index: " + token,
                    exception);
            }
        }
        if (result.isEmpty()) {
            throw new IllegalArgumentException("No type indices were provided");
        }
        return Collections.unmodifiableSet(result);
    }

    private String requireAnalysisValue(String value, String description) {
        if (value == null || value.isBlank()) {
            throw new IllegalArgumentException("No " + description + " were provided");
        }
        return value.strip();
    }

    private List<RegistryEntry> selectedRegistryEntries(
        List<RegistryEntry> registry,
        Set<Integer> selectedTypeIndices) {

        if (selectedTypeIndices.isEmpty()) {
            return registry;
        }
        List<RegistryEntry> selected = registry.stream()
            .filter(entry -> entry.typeIndex != null && selectedTypeIndices.contains(entry.typeIndex))
            .toList();
        if (selected.size() != selectedTypeIndices.size()) {
            LinkedHashSet<Integer> missing = new LinkedHashSet<>(selectedTypeIndices);
            for (RegistryEntry entry : selected) {
                missing.remove(entry.typeIndex);
            }
            throw new IllegalArgumentException(
                "TypeRegistry contains no entries for type indices: " + missing);
        }
        return selected;
    }

    private static Gson createGson() {
        GsonBuilder builder = new GsonBuilder()
            .disableHtmlEscaping();
        if (envFlag("NW_NETWORK_SCHEMA_PRETTY")) {
            builder.setPrettyPrinting();
        }
        return builder.create();
    }

    private static boolean envFlag(String name) {
        String value = System.getenv(name);
        if (value == null) {
            return false;
        }
        value = value.trim();
        return !value.isEmpty() &&
            !"0".equals(value) &&
            !"false".equalsIgnoreCase(value) &&
            !"no".equalsIgnoreCase(value);
    }

    private static int envInt(String name, int defaultValue) {
        String value = System.getenv(name);
        if (value == null || value.isBlank()) {
            return defaultValue;
        }
        try {
            int parsed = Integer.parseInt(value.trim());
            return parsed < 0 ? defaultValue : parsed;
        }
        catch (NumberFormatException ignored) {
            return defaultValue;
        }
    }

    private static <K, V> Map<K, V> lruCache(int maxEntries) {
        if (maxEntries == 0) {
            return new HashMap<>();
        }
        return new LinkedHashMap<K, V>(Math.min(1024, maxEntries), 0.75f, true) {
            @Override
            protected boolean removeEldestEntry(Map.Entry<K, V> eldest) {
                return size() > maxEntries;
            }
        };
    }

    private static String cacheSizeWithLimit(int size, int limit) {
        return limit == 0 ? Integer.toString(size) : size + "/" + limit;
    }

    private JsonArray highFunctionRecompileHotspotsJson() {
        ArrayList<Map.Entry<String, Integer>> entries =
            new ArrayList<>(highFunctionRecompileCounts.entrySet());
        entries.sort((left, right) -> {
            int countOrder = Integer.compare(right.getValue(), left.getValue());
            return countOrder != 0 ? countOrder : left.getKey().compareTo(right.getKey());
        });

        JsonArray result = new JsonArray();
        int limit = Math.min(entries.size(), 32);
        for (int index = 0; index < limit; index++) {
            Map.Entry<String, Integer> entry = entries.get(index);
            JsonObject row = new JsonObject();
            row.addProperty("function", entry.getKey());
            row.addProperty("recompilations", entry.getValue());
            result.add(row);
        }
        return result;
    }

    private void releaseDecompilerResources() {
        clearAnalysisCaches();
        if (decompiler != null) {
            decompiler.dispose();
            decompiler = null;
        }
    }

    private void initializeDecompiler() {
        if (decompiler != null) {
            return;
        }
        DecompInterface next = new DecompInterface();
        next.toggleCCode(false);
        next.toggleSyntaxTree(true);
        if (!next.openProgram(currentProgram)) {
            next.dispose();
            throw new IllegalStateException(
                "failed to initialize the Ghidra decompiler for " + currentProgram.getName());
        }
        decompiler = next;
    }

    private void resetAnalysisCachesForRun() {
        if (decompiler != null) {
            decompiler.dispose();
            decompiler = null;
        }
        NetworkSchemaIntegerEvaluator.resetMetrics();
        clearAnalysisCaches();
        cacheProgramKey = currentProgramCacheKey();
    }

