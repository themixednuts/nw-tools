    private void ensureAnalysisCachesValid() {
        String key = currentProgramCacheKey();
        if (key.equals(cacheProgramKey)) {
            return;
        }
        clearAnalysisCaches();
        cacheProgramKey = key;
        if (decompiler != null && currentProgram != null) {
            decompiler.openProgram(currentProgram);
        }
    }

    private String currentProgramCacheKey() {
        if (currentProgram == null) {
            return "<no-program>";
        }
        return CACHE_SCHEMA_VERSION + ":" + System.identityHashCode(currentProgram) + ":" +
            currentProgram.getName() + "@" + currentProgram.getImageBase();
    }

    private String addressCacheKey(String kind, Address address) {
        ensureAnalysisCachesValid();
        return kind + "|" + address.getOffset();
    }

    private String functionCacheKey(String kind, Function function) {
        ensureAnalysisCachesValid();
        return kind + "|" + function.getEntryPoint().getOffset();
    }

    private String programTextCacheKey(String kind, String value) {
        ensureAnalysisCachesValid();
        return kind + "|" + value;
    }

    private File inputFile() throws Exception {
        String explicit = envValue("NW_NETWORK_SCHEMA_TYPEREGISTRY_JSON");
        if (explicit != null) {
            return new File(explicit);
        }
        return askFile("Select New World typeregistry.json", "Open");
    }

    private File outputFile(File input, AnalysisRequest analysis) {
        File parent = input.getParentFile();
        if (parent == null) {
            parent = new File(".");
        }
        return new File(parent, analysis.mode().outputFileName);
    }

    private Address moduleRelativeAddress(String value) {
        String normalized = value.trim();
        int plus = normalized.indexOf('+');
        if (plus >= 0) {
            normalized = normalized.substring(plus + 1);
        }
        normalized = normalized.trim();
        if (normalized.startsWith("0x") || normalized.startsWith("0X")) {
            normalized = normalized.substring(2);
        }
        long offset = Long.parseUnsignedLong(normalized, 16);
        return currentProgram.getImageBase().add(offset);
    }

    private File writeReportFile(File output, JsonObject report, Gson gson) throws IOException {
        Path outputPath = output.toPath();
        Path absoluteOutput = outputPath.toAbsolutePath();
        Path parent = absoluteOutput.getParent();
        if (parent == null) {
            parent = new File(".").toPath().toAbsolutePath();
        }

        Path temp = Files.createTempFile(parent, output.getName() + ".", ".tmp");
        try {
            try (Writer writer = Files.newBufferedWriter(temp, StandardCharsets.UTF_8)) {
                gson.toJson(report, writer);
            }
            long expectedSize = Files.size(temp);
            Path actualOutput;

            try {
                Files.move(
                    temp,
                    absoluteOutput,
                    StandardCopyOption.REPLACE_EXISTING,
                    StandardCopyOption.ATOMIC_MOVE);
                actualOutput = absoluteOutput;
            }
            catch (IOException atomicFailure) {
                try {
                    Files.move(temp, absoluteOutput, StandardCopyOption.REPLACE_EXISTING);
                    actualOutput = absoluteOutput;
                }
                catch (IOException replaceFailure) {
                    Path fallback = lockedFallbackOutputPath(absoluteOutput);
                    Files.move(temp, fallback, StandardCopyOption.REPLACE_EXISTING);
                    println(
                        "Primary report path is locked; wrote fallback report: " +
                        fallback.toFile().getAbsolutePath());
                    actualOutput = fallback;
                }
            }
            verifyWrittenReport(actualOutput, expectedSize, report);
            return actualOutput.toFile();
        }
        finally {
            Files.deleteIfExists(temp);
        }
    }

    private void verifyWrittenReport(
        Path output,
        long expectedSize,
        JsonObject report) throws IOException {

        long actualSize = Files.size(output);
        if (actualSize != expectedSize) {
            throw new IOException(
                "Report write verification failed for " + output +
                ": expected " + expectedSize + " bytes, found " + actualSize);
        }
        String expectedVersion = report.get("extractorVersion").getAsString();
        char[] header = new char[16 * 1024];
        int length;
        try (Reader reader = Files.newBufferedReader(output, StandardCharsets.UTF_8)) {
            length = reader.read(header);
        }
        String prefix = length <= 0 ? "" : new String(header, 0, length);
        String compactVersion = "\"extractorVersion\":\"" + expectedVersion + "\"";
        String prettyVersion = "\"extractorVersion\": \"" + expectedVersion + "\"";
        if (!prefix.contains(compactVersion) && !prefix.contains(prettyVersion)) {
            throw new IOException(
                "Report write verification found stale extractor metadata at " + output);
        }
    }

    private Path lockedFallbackOutputPath(Path output) {
        Path fileName = output.getFileName();
        String name = fileName == null ? "network-schema.static.json" : fileName.toString();
        String base = name.endsWith(".json")
            ? name.substring(0, name.length() - ".json".length())
            : name;
        String fallbackName =
            base + ".locked-" + Long.toUnsignedString(System.currentTimeMillis()) + ".json";
        Path parent = output.getParent();
        return parent == null ? new File(fallbackName).toPath() : parent.resolve(fallbackName);
    }

    private String envValue(String name) {
        String value = System.getenv(name);
        if (value == null || value.trim().isEmpty()) {
            return null;
        }
        return value.trim();
    }

    private void loadSerializeTypeIndex(File typeregistryInput) {
        File serialize = serializeJsonFile(typeregistryInput);
        if (serialize == null || !serialize.isFile()) {
            println("Serialize type index not loaded; expected serialize.json beside typeregistry.json or in an ancestor directory.");
            return;
        }

        try (Reader reader = new FileReader(serialize)) {
            JsonObject root = JsonParser.parseReader(reader).getAsJsonObject();
            collectSerializeObjectRefs(root);
            JsonObject uuidMap = object(root, "uuidMap");
            if (uuidMap == null) {
                println("Serialize type index has no uuidMap: " + serialize);
                return;
            }
            for (Map.Entry<String, JsonElement> entry : uuidMap.entrySet()) {
                registerSerializeType(entry.getValue(), entry.getKey());
            }
            JsonArray uuidGenericMap = array(root, "uuidGenericMap");
            if (uuidGenericMap != null) {
                for (JsonElement element : uuidGenericMap) {
                    if (!element.isJsonArray()) {
                        continue;
                    }
                    JsonArray pair = element.getAsJsonArray();
                    if (pair.size() < 2) {
                        continue;
                    }
                    registerSerializeType(pair.get(1), stringValue(pair.get(0)));
                }
            }
            for (Map.Entry<String, JsonElement> entry : uuidMap.entrySet()) {
                populateSerializeTypeFields(entry.getValue(), entry.getKey());
            }
            if (uuidGenericMap != null) {
                for (JsonElement element : uuidGenericMap) {
                    if (!element.isJsonArray()) {
                        continue;
                    }
                    JsonArray pair = element.getAsJsonArray();
                    if (pair.size() >= 2) {
                        populateSerializeTypeFields(pair.get(1), stringValue(pair.get(0)));
                    }
                }
            }
            println("Loaded serialize type index: " + serializeTypesById.size() +
                " types from " + serialize);
        }
        catch (Exception exception) {
            println("Serialize type index load failed: " + exception.getMessage());
        }
    }

    private void registerSerializeType(JsonElement element, String fallbackTypeId) {
        if (element == null || !element.isJsonObject()) {
            return;
        }
        JsonObject value = resolveSerializeObject(element.getAsJsonObject());
        JsonObject classData = resolveSerializeObject(object(value, "classData"));
        String typeId = canonicalUuidFromString(firstNonEmpty(
            string(value, "typeId"),
            classData == null ? null : string(classData, "typeId"),
            fallbackTypeId));
        String name = firstNonEmpty(
            string(value, "name"),
            classData == null ? null : string(classData, "name"));
        if (typeId == null || name == null || name.trim().isEmpty()) {
            return;
        }

        String key = normalizeUuid(typeId);
        SerializeTypeInfo info = serializeTypesById.get(key);
        if (info == null) {
            info = new SerializeTypeInfo();
            info.typeId = typeId;
            info.name = name.trim();
            serializeTypesById.put(key, info);
            serializeTypesByName
                .computeIfAbsent(info.name, ignored -> new ArrayList<>())
                .add(info);
            serializeTypesByLeafName
                .computeIfAbsent(
                    NetworkSchemaText.sourceTypeLeaf(info.name),
                    ignored -> new ArrayList<>())
                .add(info);
        }
        info.factory = firstNonEmpty(
            info.factory,
            string(value, "factory"),
            classData == null ? null : string(classData, "factory"));
        JsonObject azRtti = resolveSerializeObject(object(value, "azRtti"));
        if (azRtti == null && classData != null) {
            azRtti = resolveSerializeObject(object(classData, "azRtti"));
        }
        info.azRttiAddress = firstNonEmpty(
            info.azRttiAddress,
            azRtti == null ? null : string(azRtti, "address"));
    }

    private void populateSerializeTypeFields(JsonElement element, String fallbackTypeId) {
        if (element == null || !element.isJsonObject()) {
            return;
        }
        JsonObject value = resolveSerializeObject(element.getAsJsonObject());
        JsonObject classData = resolveSerializeObject(object(value, "classData"));
        String typeId = canonicalUuidFromString(firstNonEmpty(
            string(value, "typeId"),
            classData == null ? null : string(classData, "typeId"),
            fallbackTypeId));
        SerializeTypeInfo info = typeId == null
            ? null
            : serializeTypesById.get(normalizeUuid(typeId));
        if (info == null) {
            return;
        }
        if (info.fields.isEmpty()) {
            info.fields.addAll(parseSerializeFields(value, false));
            if (info.fields.isEmpty() && classData != null) {
                info.fields.addAll(parseSerializeFields(classData, false));
            }
            info.fields.sort((left, right) -> {
                int offset = Long.compare(left.offset, right.offset);
                return offset != 0 ? offset : left.name.compareTo(right.name);
            });
        }
        if (info.layoutFields.isEmpty()) {
            info.layoutFields.addAll(parseSerializeFields(value, true));
            if (info.layoutFields.isEmpty() && classData != null) {
                info.layoutFields.addAll(parseSerializeFields(classData, true));
            }
        }
    }

    private void collectSerializeObjectRefs(JsonElement element) {
        if (element == null || element.isJsonNull()) {
            return;
        }
        if (element.isJsonArray()) {
            for (JsonElement child : element.getAsJsonArray()) {
                collectSerializeObjectRefs(child);
            }
            return;
        }
        if (!element.isJsonObject()) {
            return;
        }

        JsonObject object = element.getAsJsonObject();
        String typeId = canonicalUuidFromString(string(object, "typeId"));
        Long dataSize = longValue(object, "dataSize");
        boolean pointerStorage = Boolean.TRUE.equals(bool(object, "is_pointer"));
        if (typeId != null && dataSize != null && dataSize > 0L && !pointerStorage) {
            serializeDeclaredSizesByTypeId
                .computeIfAbsent(normalizeUuid(typeId), ignored -> new LinkedHashSet<>())
                .add(dataSize);
        }
        JsonElement id = object.get("$id");
        if (id != null && !id.isJsonNull()) {
            serializeObjectsByRef.put("#" + id.getAsString(), object);
        }
        for (Map.Entry<String, JsonElement> entry : object.entrySet()) {
            collectSerializeObjectRefs(entry.getValue());
        }
    }

    private JsonObject resolveSerializeObject(JsonObject object) {
        if (object == null) {
            return null;
        }
        String ref = string(object, "$ref");
        if (ref == null) {
            return object;
        }
