            default:
                return null;
        }
    }

    private String pcodeMergedValueNativeType(
        PcodeOp def,
        Map<String, String> tempNativeTypes,
        Set<String> seen,
        int depth) {

        String merged = null;
        for (int i = 0; i < def.getNumInputs(); i++) {
            String valueType =
                pcodeValueNativeType(
                    def.getInput(i),
                    tempNativeTypes,
                    new LinkedHashSet<>(seen),
                    depth);
            if (valueType == null) {
                return null;
            }
            if (merged == null) {
                merged = valueType;
            }
            else if (!merged.equals(valueType)) {
                return null;
            }
        }
        return merged;
    }

    private String pcodeNativeTypeAtValueWidth(String nativeType, int valueWidth) {
        if (nativeType == null || valueWidth <= 0) {
            return nativeType;
        }
        Integer nativeWidth = nativeTypeByteWidth(nativeType);
        if (nativeWidth == null || nativeWidth == valueWidth) {
            return nativeType;
        }
        return scalarNativeTypeFromByteWidth(valueWidth);
    }

    private WireShape pcodeStoredValueWireEvidence(
        Varnode value,
        Map<String, String> tempWireShapes,
        Map<String, String> tempNativeTypes,
        PcodeCallTargetInfo valueTarget,
        String nativeType) {

        WireShape evidence = valueTarget == null
            ? null
            : wireShapeEvidenceFromUnmarshalTarget(valueTarget.target, nativeType);
        if (evidence != null) {
            return evidence;
        }
        String shape = pcodeValueWireShape(value, tempWireShapes, tempNativeTypes);
        return shape == null
            ? null
            : WireShape.semantic(shape, shape, "pcode-stored-value-lineage");
    }

    private String pcodePieceValueNativeType(
        PcodeOp def,
        Map<String, String> tempNativeTypes,
        Set<String> seen,
        int depth) {

        if (def.getNumInputs() != 2 || def.getOutput() == null) {
            return null;
        }
        String nativeType = pcodeTempRangeEvidence(def.getOutput(), tempNativeTypes);
        Integer width = nativeType == null ? null : nativeTypeByteWidth(nativeType);
        return width != null && width == def.getOutput().getSize()
                ? nativeType
                : null;
    }

    private String pcodeTempNativeType(
        Varnode node,
        Map<String, String> tempNativeTypes) {

        if (tempNativeTypes == null || tempNativeTypes.isEmpty()) {
            return null;
        }
        PcodeStorage storage = pcodeStorageExpression(node);
        if (!isPcodeLocalTempStorage(storage)) {
            storage = pcodeLoadedStorageExpression(node);
        }
        if (!isPcodeLocalTempStorage(storage)) {
            return null;
        }
        return tempNativeTypes.get(storageKey(storage));
    }

    private String pcodeTempWireShape(
        Varnode node,
        Map<String, String> tempWireShapes) {

        if (tempWireShapes == null || tempWireShapes.isEmpty()) {
            return null;
        }
        PcodeStorage storage = pcodeStorageExpression(node);
        if (!isPcodeLocalTempStorage(storage)) {
            storage = pcodeLoadedStorageExpression(node);
        }
        if (!isPcodeLocalTempStorage(storage)) {
            return null;
        }
        return tempWireShapes.get(storageKey(storage));
    }

    private String pcodeHighName(Varnode node) {
        if (!(node instanceof VarnodeAST ast) || ast.getHigh() == null) {
            return null;
        }
        try {
            String name = ast.getHigh().getName();
            if (name == null || name.isBlank() || name.startsWith("UNNAMED")) {
                return null;
            }
            return name;
        }
        catch (Exception ignored) {
            return null;
        }
    }

    private boolean isPcodeStorageBase(String name) {
        return name != null &&
            (name.equals("this") ||
                name.equals("_Dst") ||
                name.matches("param_\\d+") ||
                name.matches("p[lub]?Var\\d*"));
    }

    private String pcodeNodeKey(Varnode node) {
        if (node == null) {
            return "<null>";
        }
        if (node instanceof VarnodeAST ast) {
            return "ssa:" + ast.getUniqueId();
        }
        return "storage:" + node.getAddress() + ":" + node.getOffset() + ":" +
            node.getSize() + ":" + node.isConstant();
    }

    private String pcodeSsaNodeKey(Varnode node) {
        return pcodeNodeKey(node);
    }

    private String wireShapeFromNativeType(String nativeType) {
        if (nativeType == null) {
            return null;
        }
        String normalized = normalizeNativeType(nativeType);
        String marshallerShape = wireShapeFromMarshallerType(normalized);
        if (marshallerShape != null) {
            return marshallerShape;
        }
        if ("bool".equals(normalized)) {
            return "bool";
        }
        if ("Amazon::Hub::ActorRef".equals(normalized) ||
            "ActorRef".equals(normalized) ||
            "HubAddress".equals(normalized) ||
            "ProxyAddress".equals(normalized)) {
            return "actor-ref";
        }
        if ("EntityRef".equals(normalized)) {
            return "entity-ref";
        }
        if ("u8".equals(normalized) ||
            "uint8_t".equals(normalized) ||
            "std::uint8_t".equals(normalized) ||
            "AZ::u8".equals(normalized) ||
            "i8".equals(normalized) ||
            "int8_t".equals(normalized) ||
            "std::int8_t".equals(normalized) ||
            "AZ::s8".equals(normalized) ||
            "unsigned char".equals(normalized) ||
            "char".equals(normalized)) {
            return "u8";
        }
        if ("u16".equals(normalized) ||
            "uint16_t".equals(normalized) ||
            "std::uint16_t".equals(normalized) ||
            "AZ::u16".equals(normalized) ||
            "i16".equals(normalized) ||
            "int16_t".equals(normalized) ||
            "std::int16_t".equals(normalized) ||
            "AZ::s16".equals(normalized)) {
            return "u16";
        }
        if ("u32".equals(normalized) ||
            "uint32_t".equals(normalized) ||
            "std::uint32_t".equals(normalized) ||
            "AZ::u32".equals(normalized) ||
            "i32".equals(normalized) ||
            "int32_t".equals(normalized) ||
            "std::int32_t".equals(normalized) ||
            "AZ::s32".equals(normalized) ||
            "AZ::Crc32".equals(normalized) ||
            "FragmentKey".equals(normalized) ||
            "Amazon::Hub::FragmentKey".equals(normalized)) {
            return "u32";
        }
        if ("u64".equals(normalized) ||
            "uint64_t".equals(normalized) ||
            "std::uint64_t".equals(normalized) ||
            "AZ::u64".equals(normalized) ||
            "i64".equals(normalized) ||
            "int64_t".equals(normalized) ||
            "std::int64_t".equals(normalized) ||
            "AZ::s64".equals(normalized) ||
            "AZ::EntityId".equals(normalized) ||
            "TimePoint".equals(normalized) ||
            "MB::TimePoint".equals(normalized) ||
            "WallClockTimePoint".equals(normalized) ||
            "MB::WallClockTimePoint".equals(normalized)) {
            return "u64";
        }
        if ("Amazon::Hub::SequenceNumber".equals(normalized) ||
            "SequenceNumber".equals(normalized)) {
            return "sequence-number";
        }
        if ("f32".equals(normalized) || "float".equals(normalized)) {
            return "f32";
        }
        if ("f64".equals(normalized) || "double".equals(normalized)) {
            return "f64";
        }
        if ("AZ::Uuid".equals(normalized) ||
            "AZ::TypeId".equals(normalized) ||
            "Uuid".equals(normalized) ||
            "Amazon::Pervasives::CrcID".equals(normalized) ||
            "Amazon::Pervasives::UID".equals(normalized) ||
            normalized.startsWith("Amazon::Pervasives::UID<")) {
            return "fixed-bytes-16";
        }
        GenericType generic = parseGenericTemplateType(normalized);
        if (generic != null && "unordered_set".equals(generic.simpleName) &&
            !generic.args.isEmpty()) {
            String element = wireShapeFromNativeType(generic.args.get(0));
            return element == null ? null : "set<" + element + ">";
        }
        if (normalized.matches("fixed-bytes-[1-9][0-9]*")) {
            return normalized;
        }
        if ("AZ::Vector2".equals(normalized)) {
            return "vec2";
        }
        if ("AZ::Vector3".equals(normalized)) {
            return "vec3";
        }
        if ("AZ::Vector4".equals(normalized)) {
            return "vec4";
        }
        if ("AZ::Quaternion".equals(normalized)) {
            return "quat";
        }
        if ("AZ::Matrix3x3".equals(normalized)) {
            return "mat3";
        }
        if ("AZ::Transform".equals(normalized)) {
            return "affine3";
        }
        if ("AZ::Bounds".equals(normalized)) {
            return "aabb2d";
        }
        if ("AZ::Aabb".equals(normalized)) {
            return "aabb3d";
        }
        if ("EntityRef".equals(normalized)) {
            return "entity-ref";
        }
        if ("AZStd::string".equals(normalized) ||
            "std::string".equals(normalized) ||
            "string".equals(normalized)) {
            return "string";
        }
        return null;
    }

    private String wireShapeFromRawByteLength(int byteLength) {
        if (byteLength == 1) {
            return "u8";
        }
        if (byteLength > 1) {
            return "fixed-bytes-" + byteLength;
        }
        return null;
    }

    private String normalizeNativeType(String value) {
        if (value == null) {
            return null;
        }
        String result = value
            .replace('\r', ' ')
            .replace('\n', ' ')
            .replace('\t', ' ')
            .replaceAll("\\s+", " ")
            .replace(" ,", ",")
            .replace(", ", ",")
            .replace(" <", "<")
            .replace("< ", "<")
            .replace(" >", ">")
            .trim();
        return result.isEmpty() ? null : result;
    }

    private FieldCall recoverFieldCall(Function owner, Address callsite, int index) {
        ArgState state = recoverForwardArgState(owner, callsite);
        return fieldCallFromArgState(owner, callsite, index, state);
    }

    private FieldCall fieldCallFromArgState(
        Function owner,
        Address callsite,
        int index,
        ArgState state) {

        FieldCall field = new FieldCall();
        field.index = index;
        field.callsite = callsite;
        field.nameAddress = state.nameAddress;
        field.name = state.name;
        field.group = state.groupKnown ? state.group : null;
        field.handlerOffset = state.handlerOffset;
        field.handlerExpression = state.handlerExpression;
        field.handlerVtable = state.handlerVtable;
        field.handlerConstruction = handlerConstructionOwnedBy(
            owner,
            state.handlerConstruction);
        field.constructorWrites = state.handlerConstructorWrites;
        field.registrationKind = "field";
        field.confidence = field.name == null
            ? "register-field-call-unresolved-name"
            : "register-field-call";
        return field;
    }

    private HandlerConstruction handlerConstructionOwnedBy(
        Function owner,
        HandlerConstruction construction) {

        if (construction == null || construction.constructor != null || owner == null ||
            construction.callsite == null) {
            return construction;
        }
        Function writeOwner = functionAtOrContaining(construction.callsite);
        if (writeOwner == null ||
            !writeOwner.getEntryPoint().equals(owner.getEntryPoint())) {
            return construction;
        }
        return new HandlerConstruction(
            construction.pattern,
            construction.callsite,
            owner.getEntryPoint(),
            fullFunctionName(owner),
            construction.vtable);
    }

    private void enrichRegistrationFieldHandlers(
        Map<String, RegistrationFunction> registrationFunctions) throws CancelledException {

        if (registrationFunctions == null) {
            return;
        }
        int total = registrationFunctions.values().stream()
            .mapToInt(function -> function.fields.size())
            .sum();
        startAnalysisWorklist("field-handler-enrichment", total);
        long heartbeat = System.nanoTime();
        int completed = 0;
        for (RegistrationFunction function : registrationFunctions.values()) {
            for (FieldCall field : function.fields) {
                String detail = "registration=" +
                    formatAddress(function.function.getEntryPoint()) +
                    ", field=" + field.index +
                    ", handler=" + formatAddress(field.handlerVtable);
                heartbeat = updateAnalysisWorklist(
                    "field-handler-enrichment",
                    completed,
                    total,
                    detail,
                    heartbeat);
                field.handlerConstruction = handlerConstructionOwnedBy(
                    function.function,
                    field.handlerConstruction);
                applyFieldHandlerShape(field, fieldHandlerShape(field.handlerVtable));
                field.handlerTypeName =
                    fieldHandlerTypeName(field.handlerConstruction, field.handlerVtable);
                completed++;
            }
        }
        updateAnalysisWorklist(
            "field-handler-enrichment",
            completed,
            total,
            "unique-vtables=" + fieldHandlerShapeCache.size(),
            heartbeat);
        finishAnalysisWorklist("field-handler-enrichment", total);
    }

    private void applyFieldHandlerShape(FieldCall field, FieldHandlerShape shape) {
        if (field == null || shape == null) {
            return;
        }

        field.handlerKind = shape.kind;
        field.handlerKindSource = shape.kindSource;
        field.handlerVtableSlots = shape.vtableSlots;
        field.physicalFieldCount = shape.physicalFieldCount;
        applyWireEvidence(field, shape.wireShape);
        if (shape.handlerWireEvidence != null) {
            field.fixedSequenceShape = shape.handlerWireEvidence.selectedSequence;
        }

        ContainerWireShape container = shape.containerWireShape;
        if (container == null) {
            if (field.nestedTypeShape == null) {
                field.nestedTypeShape = recoverHandlerValueTypeShape(field);
            }
            if (field.nestedTypeShape != null && field.sourceTypeName == null) {
                field.sourceTypeName = field.nestedTypeShape.typeNameFull;
            }
            if (field.wireShape == null && field.nestedTypeShape != null) {
                String nestedWireShape = wireShapeFromNestedTypeShape(field.nestedTypeShape);
                if (nestedWireShape != null) {
                    applyWireEvidence(
                        field,
                        WireShape.semantic(
                            nestedWireShape,
                            "handler-value-complete-nested-shape"));
                }
            }
            return;
        }
        if (field.nestedTypeShape == null && container.valueTypeShape != null) {
            field.nestedTypeShape = container.valueTypeShape;
        }
        if (field.wireShape == null) {
            WireShape derivedShape = scalarContainerWireShape(container);
            applyWireEvidence(field, derivedShape);
        }
    }

    private void applyWireEvidence(FieldCall field, WireShape evidence) {
        if (field == null || evidence == null) {
            return;
        }
        String incoming = firstNonEmpty(evidence.layout, evidence.shape);
        if (incoming == null) {
            return;
        }
        String existing = firstNonEmpty(field.wireLayout, field.wireShape);
        if (existing == null) {
            if (evidence.shape != null) {
                field.wireShape = evidence.shape;
                field.wireShapeSource = evidence.source;
            }
            if (evidence.layout != null) {
                field.wireLayout = evidence.layout;
                field.wireLayoutSource = evidence.layoutSource;
            }
            else if (field.wireLayout == null && evidence.shape != null) {
                field.wireLayout = evidence.shape;
                field.wireLayoutSource = evidence.source;
            }
            return;
        }
        if (compatibleCodecProducts(existing, incoming) &&
            (evidence.shape == null ||
                compatibleCodecProducts(existing, evidence.shape)) &&
            (evidence.layout == null ||
                compatibleCodecProducts(existing, evidence.layout))) {
            // Alternate spellings of the same payload (ActorRequestId as
            // fixed-bytes-8/u64 limbs vs typed u64s, ActorRef limbs vs actor-ref).
            // Prefer the richer product; do not concatenate into a false product.
            String incomingShape = firstNonEmpty(evidence.shape, evidence.layout);
            if (field.wireShape == null ||
                preferIncomingCodecProduct(field.wireShape, incomingShape)) {
                field.wireShape = incomingShape;
                field.wireShapeSource = evidence.shape != null
                    ? evidence.source
                    : evidence.layoutSource;
            }
            boolean explicitLayout = evidence.layout != null &&
                !Objects.equals(evidence.layout, evidence.shape);
            if (field.wireLayout == null || explicitLayout) {
                field.wireLayout = firstNonEmpty(evidence.layout, evidence.shape);
                field.wireLayoutSource = evidence.layout != null
                    ? evidence.layoutSource
                    : evidence.source;
            }
            return;
        }
        // Same storage, successive helpers: compose an ordered product instead of
        // first-winning a partial helper body (FilterChat GameChatMessage pattern).
        String composed = compositeWireShape(List.of(existing, incoming));
        field.wireLayout = composed;
        field.wireLayoutSource = "cfg-ordered-multi-helper-wire-product";
        field.wireShape = composed;
        field.wireShapeSource = field.wireLayoutSource;
        field.typeConflict = null;
        collapseAlternateSpellingWireProduct(field);
    }

    private void reconcileComposableMessageFieldWireProducts(
        MessageUnmarshalPlan plan) {

        if (plan == null) {
            return;
        }
        for (FieldCall field : plan.fields) {
            reconcileComposableMessageFieldWireProduct(field);
        }
    }

    private void reconcileComposableMessageFieldWireProduct(FieldCall field) {
        if (field == null) {
            return;
        }
        collapseAlternateSpellingWireProduct(field);
        String layout = field.wireLayout;
        String shape = field.wireShape;
        if (layout == null || shape == null ||
            sameCodecProduct(layout, shape) ||
            compatibleCodecProducts(layout, shape) ||
            compatibleWireSemantics(layout, shape)) {
            return;
        }
        if (canonicalLayoutWireShape(layout) == null ||
            canonicalLayoutWireShape(shape) == null) {
            return;
        }
        String composed = compositeWireShape(List.of(layout, shape));
        field.wireLayout = composed;
        field.wireLayoutSource = "cfg-ordered-multi-helper-wire-product";
        field.wireShape = composed;
        field.wireShapeSource = field.wireLayoutSource;
        field.typeConflict = null;
        collapseAlternateSpellingWireProduct(field);
    }

    private void collapseAlternateSpellingWireProduct(FieldCall field) {
        if (field == null) {
            return;
        }
        String product = firstNonEmpty(field.wireLayout, field.wireShape);
        List<String> members = compositeWireShapeMembers(product);
        if (members == null || members.size() != 2) {
            return;
        }
        String left = members.get(0);
        String right = members.get(1);
        if (compatibleCodecProducts(left, right)) {
            boolean preferRight = preferIncomingCodecProduct(left, right);
            field.wireShape = preferRight ? right : left;
            field.wireLayout = sameCodecProduct(left, right)
                ? field.wireShape
                : preferRight ? left : right;
            field.wireLayoutSource = "cfg-multi-helper-alternate-spelling-collapse";
            field.wireShapeSource = field.wireLayoutSource;
            field.typeConflict = null;
            return;
        }
        String preferred = collapseRedundantCompositeBoundaryLimb(
            left,
            right,
            field.nestedTypeShape);
        if (preferred == null) {
            return;
        }
        field.wireLayout = preferred;
        field.wireShape = preferred;
        field.wireLayoutSource = "cfg-multi-helper-alternate-spelling-collapse";
        field.wireShapeSource = field.wireLayoutSource;
        field.typeConflict = null;
    }

    private String collapseRedundantCompositeBoundaryLimb(
        String left,
        String right,
        NestedTypeShape nested) {

        // Nested shape must prove which side is the real product so we do not
        // collapse legitimate composite<field, same-scalar-type> payloads.
        List<String> nestedProducts = provenNestedTypeProducts(nested);
        if (nestedProducts.isEmpty()) {
            return null;
        }
        boolean leftMatches = matchesAnyCodecProduct(left, nestedProducts);
        boolean rightMatches = matchesAnyCodecProduct(right, nestedProducts);
        if (leftMatches && !rightMatches && boundaryLimbIsRedundant(left, right)) {
            return left;
        }
        if (rightMatches && !leftMatches && boundaryLimbIsRedundant(right, left)) {
            return right;
        }
        if (leftMatches && rightMatches) {
            return preferIncomingCodecProduct(left, right) ? right : left;
        }
        return null;
    }

    private boolean boundaryLimbIsRedundant(String product, String limb) {
        List<String> members = compositeWireShapeMembers(product);
        if (members == null || members.isEmpty()) {
            return false;
        }
        return compatibleCodecProducts(members.get(0), limb) ||
            compatibleCodecProducts(members.get(members.size() - 1), limb);
    }

    private boolean compatibleCodecProducts(String left, String right) {
        if (left == null || right == null) {
            return false;
        }
        if (sameCodecProduct(left, right) || compatibleWireSemantics(left, right)) {
            return true;
        }
        String leftContainer = wireCodecContainerName(left);
        String rightContainer = wireCodecContainerName(right);
        if (leftContainer != null && leftContainer.equals(rightContainer)) {
            List<String> leftArgs = wireCodecContainerArguments(left);
            List<String> rightArgs = wireCodecContainerArguments(right);
            return leftArgs.size() == rightArgs.size() &&
                compatibleCodecProductLists(leftArgs, rightArgs);
        }
        List<String> leftMembers = compositeWireShapeMembers(left);
        List<String> rightMembers = compositeWireShapeMembers(right);
        if (leftMembers != null && rightMembers != null) {
            if (leftMembers.size() != rightMembers.size()) {
                return false;
            }
            for (int index = 0; index < leftMembers.size(); index++) {
                if (!compatibleCodecProducts(
                        leftMembers.get(index),
                        rightMembers.get(index))) {
                    return false;
                }
            }
            return true;
        }
        if (leftMembers != null) {
            List<String> expected = semanticMembers(right);
            return expected != null &&
                leftMembers.size() == expected.size() &&
                compatibleCodecProductLists(leftMembers, expected);
        }
        if (rightMembers != null) {
            List<String> expected = semanticMembers(left);
            return expected != null &&
                rightMembers.size() == expected.size() &&
                compatibleCodecProductLists(expected, rightMembers);
        }
        return false;
    }

    private String wireCodecContainerName(String product) {
        if (product == null || !product.endsWith(">")) {
            return null;
        }
        int open = product.indexOf('<');
        if (open <= 0) {
            return null;
        }
        String name = product.substring(0, open);
        return switch (name) {
            case "vec", "set", "map", "optional", "fixed-vector", "array" -> name;
            default -> null;
        };
    }

    private List<String> wireCodecContainerArguments(String product) {
        int open = product.indexOf('<');
        return NetworkSchemaText.splitTopLevel(
            product.substring(open + 1, product.length() - 1));
    }

    private boolean compatibleCodecProductLists(
        List<String> left,
        List<String> right) {

        for (int index = 0; index < left.size(); index++) {
            if (!compatibleCodecProducts(left.get(index), right.get(index))) {
                return false;
            }
        }
        return true;
    }

    private boolean preferIncomingCodecProduct(String existing, String incoming) {
        if (existing == null) {
            return incoming != null;
        }
        if (incoming == null) {
            return false;
        }
        int existingScore = codecProductSemanticScore(existing);
        int incomingScore = codecProductSemanticScore(incoming);
        return incomingScore > existingScore;
    }

    private int codecProductSemanticScore(String product) {
        if (product == null) {
            return Integer.MIN_VALUE;
        }
        if ("actor-ref".equals(product) || "entity-ref".equals(product)) {
            return 1_000;
        }
        List<String> members = compositeWireShapeMembers(product);
        if (members == null) {
            List<String> containerArgs = wireCodecContainerName(product) == null
                ? null
                : wireCodecContainerArguments(product);
            if (containerArgs == null) {
                return product.startsWith("fixed-bytes-") ? 0 : 10;
            }
            int score = 0;
            for (String argument : containerArgs) {
                score += codecProductSemanticScore(argument);
            }
            return score;
        }
        int score = 0;
        for (String member : members) {
            score += codecProductSemanticScore(member);
        }
        return score;
    }

    private String composedMessageFieldWireProduct(FieldCall field) {
        if (field == null) {
            return null;
        }
        reconcileComposableMessageFieldWireProduct(field);
        return firstNonEmpty(field.wireShape, field.wireLayout);
    }

    private String wireShapeFromMarshallerType(String marshallerType) {
        String normalized = normalizeNativeType(marshallerType);
        if (normalized == null) {
            return null;
        }
        if (normalized.contains("HalfMarshaler")) {
            return "half-f32";
        }
        if (normalized.contains("NonUniformScaleCompMarshaler")) {
            return "non-uniform-scale-comp";
        }
        if (normalized.contains("Vec2CompMarshaler")) {
            return "vec2-comp";
        }
        if (normalized.contains("Vec3CompNormMarshaler")) {
            return "vec3-comp-norm";
        }
        if (normalized.contains("PackedNormalizedVec3Marshaller")) {
            return "vec3-smallest-three";
        }
        if (normalized.contains("Vec3CompMarshaler")) {
            return "vec3-comp";
        }
        if (normalized.contains("Marshaler<Amazon::Hub::ActorRef>") ||
            normalized.contains("Marshaller<Amazon::Hub::ActorRef>")) {
            return "actor-ref";
        }
        if (normalized.contains("Marshaler<EntityRef>") ||
            normalized.contains("Marshaller<EntityRef>")) {
            return "entity-ref";
        }
        if (normalized.contains("VlqU32Marshaler")) {
            return "vlq-u32";
        }
        if (normalized.contains("VlqU64Marshaler")) {
            return "vlq-u64";
        }
        if (normalized.contains("QuatSmallestThreeQuantizedMarshaler") ||
            normalized.contains("PackedQuaternionMarshaller") ||
            normalized.contains("QuatCompressSmallestThree")) {
            return "quat-smallest-three";
        }
        if (normalized.contains("QuatCompNormMarshaler")) {
            return "quat-comp-norm";
        }
        if (normalized.contains("QuatCompMarshaler")) {
            return "quat-comp";
        }
        if (normalized.contains("TransformCompressor")) {
            return "transform-compressor";
        }
        if (normalized.contains("PackedSize")) {
            return "packed-size";
        }
        return null;
    }

    private String unmarshalWireShapeFromTarget(Function target) {
        WireShape evidence = validatedUnmarshalLeaf(target);
        return evidence == null ? null : evidence.shape;
    }

    private ArgState recoverForwardArgState(Function owner, Address callsite) {
        ForwardArgState state = initialForwardArgState(owner, new LinkedHashSet<>());
        for (Instruction instruction : functionInstructions(owner)) {
            if (instruction.getMinAddress().compareTo(callsite) >= 0) {
                break;
            }
            observeForwardInstruction(instruction, state);
        }

        return argStateFromForwardState(state);
    }

    private ArgState argStateFromForwardState(ForwardArgState state) {
        ArgState result = new ArgState();
        TrackedValue name = state.registers.get("RDX");
        if (name != null && name.fieldName != null) {
            result.nameAddress = name.fieldNameAddress;
            result.name = name.fieldName;
        }
        else if (name != null && name.address != null) {
            StringDecode decoded = readFieldNameAtOrThroughPointer(name.address);
            if (decoded != null) {
                result.nameAddress = decoded.address;
                result.name = decoded.value;
            }
        }

        TrackedValue handler = state.registers.get("R8");
        if (handler != null) {
            result.handlerKnown = true;
            if (handler.thisOffset != null) {
                result.handlerOffset = handler.thisOffset;
                result.handlerExpression = handler.expression;
                result.handlerVtable = state.vtablesByThisOffset.get(handler.thisOffset);
                result.handlerConstruction =
                    state.handlerConstructionsByThisOffset.get(handler.thisOffset);
                result.handlerConstructorWrites =
                    state.constructorWritesByHandlerOffset.get(handler.thisOffset);
            }
            else if (handler.baseKey != null && handler.baseOffset != null) {
                ObjectOffset key = baseOffsetKey(handler.baseKey, handler.baseOffset);
                result.handlerExpression = handler.expression;
                result.handlerVtable = state.vtablesByBaseOffset.get(key);
                result.handlerConstruction = state.handlerConstructionsByBaseOffset.get(key);
                result.handlerConstructorWrites =
                    state.constructorWritesByBaseOffset.get(key);
            }
            else if (handler.address != null) {
                result.handlerExpression = formatAddress(handler.address);
            }
            else {
                result.handlerExpression = handler.expression;
            }
        }

        TrackedValue group = state.registers.get("R9");
        if (group != null && group.immediate != null) {
            result.groupKnown = true;
            result.group = group.immediate.intValue();
        }
        return result;
    }

    private ForwardArgState initialForwardArgState(
        Function owner,
        Set<String> activeFunctions) {

        ForwardArgState inherited = inheritedForwardArgState(owner, activeFunctions);
        return inherited == null ? newForwardArgState() : inherited.copy();
    }

    private ForwardArgState inheritedForwardArgState(
        Function owner,
        Set<String> activeFunctions) {

        if (owner == null) {
            return null;
        }
        String key = functionCacheKey("inherited-forward-state", owner);
        if (inheritedForwardStateCache.containsKey(key)) {
            ForwardArgState cached = inheritedForwardStateCache.get(key);
            return cached == null ? null : cached.copy();
        }
        String activeKey = owner.getEntryPoint().toString();
        if (!activeFunctions.add(activeKey)) {
            return null;
        }
        try {
            ForwardArgState result = recoverInheritedForwardArgState(owner, activeFunctions);
            inheritedForwardStateCache.put(key, result == null ? null : result.copy());
            return result;
        }
        finally {
            activeFunctions.remove(activeKey);
        }
    }

    private ForwardArgState recoverInheritedForwardArgState(
        Function callee,
        Set<String> activeFunctions) {

        ForwardArgState mergedState = null;
        ReferenceIterator references =
            currentProgram.getReferenceManager().getReferencesTo(callee.getEntryPoint());
        while (references.hasNext()) {
            Reference reference = references.next();
            if (!reference.getReferenceType().isCall()) {
                continue;
            }
            Address callsite = reference.getFromAddress();
            Instruction callInstruction =
                currentProgram.getListing().getInstructionAt(callsite);
            if (callInstruction == null ||
                !callee.getEntryPoint().equals(resolvedCodeTarget(callTarget(callInstruction)))) {
                continue;
            }

            Function caller = functionAtOrContaining(callsite);
            if (caller == null || caller.getEntryPoint().equals(callee.getEntryPoint())) {
                continue;
            }

            ForwardArgState callerState =
                initialForwardArgState(caller, activeFunctions);
            for (Instruction instruction : functionInstructions(caller)) {
                if (instruction.getMinAddress().compareTo(callsite) >= 0) {
                    break;
                }
                observeForwardInstruction(instruction, callerState);
            }

            TrackedValue receiver = callerState.registers.get("RCX");
            if (receiver == null || receiver.thisOffset == null) {
                continue;
            }

            ForwardArgState calleeState = newForwardArgState();
            calleeState.copyObjectEvidenceFrom(callerState);
            calleeState.registers.put("RCX", receiver.copy());
            copyCallArgument(calleeState, callerState, "RDX");
            copyCallArgument(calleeState, callerState, "R8");
            copyCallArgument(calleeState, callerState, "R9");
            if (mergedState == null) {
                mergedState = calleeState;
            }
            else if (!mergedState.mergeCompatibleObjectEvidenceFrom(calleeState)) {
                return null;
            }
        }
        return mergedState;
    }

    private void copyCallArgument(
        ForwardArgState calleeState,
        ForwardArgState callerState,
        String register) {

        TrackedValue value = callerState.registers.get(register);
        if (value != null) {
            calleeState.registers.put(register, value.copy());
        }
    }

    private ForwardArgState newForwardArgState() {
        ForwardArgState state = new ForwardArgState();
        state.registers.put("RCX", TrackedValue.thisOffset(0));
        state.registers.put("RDX", TrackedValue.baseOffset("arg:RDX", 0));
        state.registers.put("R8", TrackedValue.baseOffset("arg:R8", 0));
        state.registers.put("R9", TrackedValue.baseOffset("arg:R9", 0));
        state.registers.put("RSP", TrackedValue.stackOffset(0));
        return state;
    }

    private void observeForwardInstruction(Instruction instruction, ForwardArgState state) {
        observeForwardInstruction(instruction, state, true);
    }
