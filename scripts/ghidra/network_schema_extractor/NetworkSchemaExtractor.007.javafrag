        if (callTarget == null ||
            (current != null && callTarget.getEntryPoint().equals(current.getEntryPoint()))) {
            return null;
        }

        String owner = directUnmarshalValueTypeName(callTarget);
        if (owner == null) {
            return null;
        }
        if (wireShapeFromNativeType(owner) != null) {
            return null;
        }

        return recoverNestedDirectTypeShape(callTarget, owner);
    }

    private boolean addNestedDirectTypeMemberCandidates(
        Map<String, LinkedHashMap<Long, NestedTypeMember>> byBase,
        PcodeStorage storage,
        NestedTypeShape shape,
        PcodeOp op,
        Function target,
        String source) {

        if (byBase == null || storage == null || shape == null ||
            shape.members.isEmpty()) {
            return false;
        }
        if (addAtomicDirectWireSequenceMemberCandidate(
                byBase,
                storage,
                shape,
                op,
                target,
                source)) {
            markNestedTypeMemberWireOrder(
                byBase,
                storage,
                "cfg-call-order+atomic-direct-wire-product");
            return true;
        }
        String typeIdentitySource = Boolean.TRUE.equals(shape.identityProven) &&
            shape.typeId != null
            ? shape.identitySource
            : null;
        if (typeIdentitySource != null) {
            boolean added = addProvenNestedTypeMemberCandidate(
                byBase,
                storage,
                shape,
                op,
                target,
                source,
                typeIdentitySource);
            if (added) {
                markNestedTypeMemberWireOrder(
                    byBase,
                    storage,
                    "cfg-call-order+proven-nested-type");
            }
            return added;
        }
        if (!Boolean.TRUE.equals(shape.layoutProven)) {
            return false;
        }

        boolean added = false;
        for (NestedTypeMember member : shape.members) {
            WireShape wireEvidence = nestedMemberWireEvidence(member);
            if (wireEvidence == null) {
                continue;
            }
            LinkedHashMap<Long, NestedTypeMember> members = byBase.get(storage.base);
            int before = members == null ? 0 : members.size();
            addNestedTypeMemberCandidate(
                byBase,
                storage.plus(member.offset),
                member.nativeType,
                wireEvidence,
                op,
                target,
                source == null ? "pcode-nested-direct-type-call" : source);
            members = byBase.get(storage.base);
            int after = members == null ? 0 : members.size();
            NestedTypeMember expanded = members == null
                ? null
                : members.get(storage.offset + member.offset);
            copyExpandedNestedMemberEvidence(expanded, member);
            added = added || after > before;
        }
        if (added && Boolean.TRUE.equals(shape.wireOrderProven)) {
            applyExpandedNestedMemberWireOrder(byBase, storage, shape, source);
        }
        return added;
    }

    private void copyExpandedNestedMemberEvidence(
        NestedTypeMember target,
        NestedTypeMember source) {

        if (target == null || source == null) {
            return;
        }
        if (source.typeId != null && Boolean.TRUE.equals(source.typeIdentityProven)) {
            target.typeId = source.typeId;
            target.typeIdSource = source.typeIdSource;
            target.typeIdentityProven = true;
            target.typeIdentitySource = source.typeIdentitySource;
        }
    }

    private void applyExpandedNestedMemberWireOrder(
        Map<String, LinkedHashMap<Long, NestedTypeMember>> byBase,
        PcodeStorage storage,
        NestedTypeShape shape,
        String source) {

        List<NestedTypeMember> ordered = provenWireOrderedMembers(shape.members);
        Map<Long, NestedTypeMember> members = byBase.get(storage.base);
        if (ordered == null || members == null) {
            return;
        }
        int nextOrdinal = members.values().stream()
            .map(member -> member.wireOrdinal)
            .filter(Objects::nonNull)
            .max(Integer::compareTo)
            .map(ordinal -> ordinal + 1)
            .orElse(0);
        ArrayList<NestedTypeMember> expanded = new ArrayList<>(ordered.size());
        for (NestedTypeMember child : ordered) {
            NestedTypeMember member = members.get(storage.offset + child.offset);
            if (member == null || Boolean.TRUE.equals(member.typeConflict) ||
                member.wireOrdinal != null) {
                return;
            }
            expanded.add(member);
        }
        for (int index = 0; index < expanded.size(); index++) {
            NestedTypeMember member = expanded.get(index);
            member.wireOrdinal = nextOrdinal + index;
            member.wireOrderSource = firstNonEmpty(
                source,
                "pcode-nested-direct-type-call") + "+nested-wire-order";
        }
    }
    private boolean addProvenNestedTypeMemberCandidate(
        Map<String, LinkedHashMap<Long, NestedTypeMember>> byBase,
        PcodeStorage storage,
        NestedTypeShape shape,
        PcodeOp op,
        Function target,
        String source,
        String typeIdentitySource) {

        ArrayList<String> layouts = new ArrayList<>();
        for (NestedTypeMember nested : shape.members) {
            WireShape evidence = nestedMemberWireEvidence(nested);
            if (evidence == null || evidence.layout == null) {
                return false;
            }
            layouts.add(evidence.layout);
        }
        String layout = compositeWireShape(layouts);
        String semantic = firstNonEmpty(
            provenNestedTypeIdentityWireShape(shape),
            wireShapeFromNestedTypeShape(shape));
        String evidenceSource = source == null
            ? "pcode-proven-nested-direct-type"
            : source + "+proven-direct-type";
        WireShape wireEvidence = semantic == null
            ? WireShape.layout(layout, evidenceSource)
            : WireShape.semantic(semantic, layout, evidenceSource);
        addNestedTypeMemberCandidate(
            byBase,
            storage,
            shape.typeNameFull == null ? shape.typeName : shape.typeNameFull,
            wireEvidence,
            op,
            target,
            evidenceSource);

        LinkedHashMap<Long, NestedTypeMember> members = byBase.get(storage.base);
        NestedTypeMember member = members == null ? null : members.get(storage.offset);
        if (member == null || Boolean.TRUE.equals(member.typeConflict)) {
            return false;
        }
        member.typeId = shape.typeId;
        member.typeIdSource = shape.typeIdSource;
        member.typeIdentityProven = true;
        member.typeIdentitySource = typeIdentitySource;
        if (shape.nativeSize != null && shape.nativeSize > 0 &&
            shape.nativeSize <= Integer.MAX_VALUE) {
            member.byteWidth = shape.nativeSize.intValue();
        }
        return true;
    }

    private void proveDirectTypeIdentity(NestedTypeShape shape, Function target) {
        if (shape == null || target == null || shape.members.isEmpty()) {
            return;
        }

        LinkedHashMap<String, String> evidenceByTypeId = new LinkedHashMap<>();
        addDirectTypeIdentityCandidate(
            evidenceByTypeId,
            directUnmarshalValueTypeName(target),
            "ghidra-direct-unmarshal-value-type");
        if (evidenceByTypeId.size() > 1) {
            recordNestedTypeShapeReject("conflicting-direct-type-identity");
            return;
        }
        Map.Entry<String, String> evidence = evidenceByTypeId.isEmpty()
            ? null
            : evidenceByTypeId.entrySet().iterator().next();
        SerializeTypeInfo reflected = evidence == null
            ? uniqueSerializeTypeForObservedNativeLayout(shape)
            : serializeTypesById.get(evidence.getKey());
        if (reflected == null) {
            proveDirectSymbolicTypeIdentity(shape, target);
            return;
        }
        String identitySource = evidence == null
            ? "ghidra-pcode-output-layout+unique-serialize-native-layout"
            : evidence.getValue();
        if (!nativeLayoutMatchesSerializeType(shape, reflected)) {
            if (evidence == null ||
                !proveSparseDirectTypeIdentity(shape, reflected, evidence)) {
                recordNestedTypeShapeReject("direct-type-identity-layout-mismatch");
            }
            return;
        }
        shape.typeId = reflected.typeId;
        shape.typeIdSource = identitySource;
        shape.identityProven = true;
        shape.identitySource = identitySource + "+exact-native-layout";
        shape.typeName = NetworkSchemaText.sourceTypeLeaf(reflected.name);
        shape.typeNameFull = reflected.name;
        shape.typeNameSource = identitySource;
        enrichKnownSerializeIdentity(shape);
    }

    private void proveDirectSymbolicTypeIdentity(
        NestedTypeShape shape,
        Function target) {

        if (shape == null || target == null || shape.members.isEmpty() ||
            !Boolean.TRUE.equals(shape.layoutProven) ||
            !Boolean.TRUE.equals(shape.memberCoverageProven) ||
            !Boolean.TRUE.equals(shape.wireOrderProven)) {
            return;
        }
        String typeName = directUnmarshalValueTypeName(target);
        if (typeName == null || wireShapeFromNativeType(typeName) != null) {
            return;
        }
        String observed = firstNonEmpty(shape.typeNameFull, shape.typeName);
        if (observed != null &&
            !normalizeNativeType(observed).equals(normalizeNativeType(typeName))) {
            return;
        }
        String source =
            "ghidra-direct-unmarshal-value-type+complete-output-storage+cfg-complete-wire-product";
        shape.identityProven = true;
        shape.identitySource = source;
        shape.typeName = NetworkSchemaText.sourceTypeLeaf(typeName);
        shape.typeNameFull = typeName;
        shape.typeNameSource = "ghidra-symbol";
        shape.validation = appendValidation(
            shape.validation,
            "symbolic-direct-type-identity");
    }

    private SerializeTypeInfo uniqueSerializeTypeForObservedNativeLayout(
        NestedTypeShape shape) {

        Long nativeSize = observedNativeSize(shape);
        List<SerializeWireSlot> observed = observedNativeWireLayout(shape);
        if (nativeSize == null || observed.isEmpty()) {
            return null;
        }
        String observedLayout = nativeWireLayoutKey(nativeSize, observed);
        SerializeTypeInfo selected = null;
        for (SerializeTypeInfo candidate : serializeTypesWithExactNativeSize(nativeSize)) {
            List<SerializeWireSlot> expected = serializeTypeNativeWireLayout(candidate.typeId);
            if (expected.isEmpty() || !observedLayout.equals(
                    nativeWireLayoutKey(nativeSize, expected))) {
                continue;
            }
            if (selected != null && !uuidEquals(selected.typeId, candidate.typeId)) {
                recordNestedTypeShapeReject("ambiguous-direct-type-native-layout");
                return null;
            }
            selected = candidate;
        }
        return selected;
    }

    private boolean proveSparseDirectTypeIdentity(
        NestedTypeShape shape,
        SerializeTypeInfo reflected,
        Map.Entry<String, String> evidence) {

        if (shape == null || reflected == null || evidence == null ||
            !reflected.layoutFields.isEmpty()) {
            return false;
        }
        String typeId = normalizeUuid(reflected.typeId);
        LinkedHashSet<Long> declaredSizes = serializeDeclaredSizesByTypeId.get(typeId);
        Long observedSize = observedNativeSize(shape);
        boolean completeWireSequence = "wire-sequence".equals(shape.memberBase) &&
            Boolean.TRUE.equals(shape.memberCoverageProven) &&
            Boolean.TRUE.equals(shape.wireOrderProven);
        if (declaredSizes == null || declaredSizes.size() != 1 ||
            observedSize == null && !completeWireSequence) {
            return false;
        }
        long declaredSize = declaredSizes.iterator().next();
        if (declaredSize <= 0L || observedSize != null && observedSize > declaredSize) {
            return false;
        }
        shape.typeId = reflected.typeId;
        shape.typeIdSource = evidence.getValue();
        shape.identityProven = true;
        shape.identitySource = evidence.getValue() +
            (completeWireSequence
                ? "+complete-wire-sequence+declared-native-size"
                : "+callee-output-parameter+declared-native-size");
        shape.typeName = NetworkSchemaText.sourceTypeLeaf(reflected.name);
        shape.typeNameFull = reflected.name;
        shape.typeNameSource = evidence.getValue();
        shape.factory = reflected.factory;
        shape.azRttiAddress = reflected.azRttiAddress;
        shape.nativeSize = declaredSize;
        shape.nativeSizeSource = "serialize-field-data-size";
        shape.validation = appendValidation(
            shape.validation,
            completeWireSequence
                ? "typed-complete-wire-sequence"
                : "typed-output-members-within-declared-native-size");
        return true;
    }

    private void addDirectTypeIdentityCandidate(
        Map<String, String> evidenceByTypeId,
        String typeName,
        String source) {

        SerializeTypeInfo reflected = serializeTypeForTypeName(typeName);
        String typeId = reflected == null ? null : normalizeUuid(reflected.typeId);
        if (typeId != null) {
            evidenceByTypeId.putIfAbsent(typeId, source);
        }
    }

    private void addNestedTypeMemberCandidate(
        Map<String, LinkedHashMap<Long, NestedTypeMember>> byBase,
        PcodeStorage storage,
        String nativeType,
        WireShape wireEvidence,
        PcodeOp op,
        Function target,
        String source) {

        boolean allowLocalTempStorage =
            source != null && source.startsWith("container-value-pcode");
        if (byBase == null || storage == null || wireEvidence == null ||
            wireEvidence.layout == null ||
            (!allowLocalTempStorage && isPcodeLocalTempStorage(storage))) {
            return;
        }
        LinkedHashMap<Long, NestedTypeMember> members =
            byBase.computeIfAbsent(storage.base, ignored -> new LinkedHashMap<>());
        if (members.size() >= NESTED_DIRECT_TYPE_MEMBER_LIMIT) {
            return;
        }
        NestedTypeMember existing = members.get(storage.offset);
        if (existing != null) {
            if ((existing.nativeType != null && nativeType != null &&
                    !existing.nativeType.equals(nativeType)) ||
                (existing.wireLayout != null &&
                    !existing.wireLayout.equals(wireEvidence.layout))) {
                existing.typeConflict = true;
            }
            if (existing.nativeType == null) {
                existing.nativeType = nativeType;
            }
            if (existing.wireShape == null) {
                existing.wireShape = wireEvidence.shape;
                existing.wireShapeSource = wireEvidence.source == null
                    ? source
                    : wireEvidence.source;
            }
            if (existing.wireLayout == null) {
                existing.wireLayout = wireEvidence.layout;
                existing.wireLayoutSource = wireEvidence.layoutSource == null
                    ? source
                    : wireEvidence.layoutSource;
            }
            if (existing.byteWidth == null) {
                existing.byteWidth = nativeTypeByteWidth(nativeType);
                if (existing.byteWidth == null) {
                    existing.byteWidth = wireShapeByteWidth(wireEvidence.layout);
                }
            }
            return;
        }

        NestedTypeMember member = new NestedTypeMember();
        member.offset = storage.offset;
        member.nativeType = nativeType;
        member.wireShape = wireEvidence.shape;
        member.wireShapeSource = wireEvidence.source == null ? source : wireEvidence.source;
        member.wireLayout = wireEvidence.layout;
        member.wireLayoutSource = wireEvidence.layoutSource == null
            ? source
            : wireEvidence.layoutSource;
        member.byteWidth = nativeTypeByteWidth(nativeType);
        if (member.byteWidth == null) {
            member.byteWidth = wireShapeByteWidth(wireEvidence.layout);
        }
        member.name = "_" + members.size();
        member.nameSource = "synthetic-offset";
        member.nameProven = false;
        member.callsite = op == null ? null : op.getSeqnum().getTarget();
        member.target = target == null ? null : target.getEntryPoint();
        member.targetName = fullFunctionName(target);
        members.put(storage.offset, member);
    }

    private WireShape nestedMemberWireEvidence(NestedTypeMember member) {
        if (member == null || member.wireLayout == null && member.wireShape == null) {
            return null;
        }
        String layout = member.wireLayout == null ? member.wireShape : member.wireLayout;
        if (member.wireShape != null) {
            String source = member.wireShapeSource == null
                ? "nested-type-member-pcode"
                : member.wireShapeSource;
            return WireShape.semantic(member.wireShape, layout, source);
        }
        String source = member.wireLayoutSource == null
            ? "nested-type-member-pcode"
            : member.wireLayoutSource;
        return WireShape.layout(layout, source);
    }

    private NestedTypeShape directTypeShapeFromCandidates(
        String owner,
        Function target,
        String targetName,
        Map<String, LinkedHashMap<Long, NestedTypeMember>> byBase,
        boolean anonymousHelper) {

        NestedTypeShape selected = null;
        int matches = 0;
        for (Map.Entry<String, LinkedHashMap<Long, NestedTypeMember>> entry : byBase.entrySet()) {
            ArrayList<NestedTypeMember> members =
                new ArrayList<>(entry.getValue().values());
            members.sort((left, right) -> Long.compare(left.offset, right.offset));
            if (!isGenericDirectTypeMemberShape(members)) {
                continue;
            }
            matches++;
            normalizeGenericDirectTypeMemberOffsets(members, entry.getKey());

            for (int i = 0; i < members.size(); i++) {
                NestedTypeMember member = members.get(i);
                member.index = i;
                member.name = "_" + i;
            }

            NestedTypeShape shape = new NestedTypeShape();
            shape.typeName = NetworkSchemaText.sourceTypeLeaf(owner);
            shape.typeNameFull = owner;
            shape.typeNameSource = anonymousHelper ? "anonymous-helper" : "ghidra-symbol";
            shape.function = target.getEntryPoint();
            shape.functionName = targetName;
            shape.memberBase = entry.getKey();
            shape.memberNameSource = "synthetic-offset";
            shape.memberNamesProven = false;
            shape.layoutProven = true;
            shape.validation = "layout-consistent-direct-type";
            shape.members.addAll(members);
            applyNestedTypeMemberNames(shape);
            applyLabeledMemberName(shape, "ActorRequestId", "targetLocalId");
            selected = shape;
        }
        if (matches > 1) {
            recordNestedTypeShapeReject("ambiguous-member-base");
            return null;
        }
        if (selected == null) {
            recordNestedTypeShapeReject("direct-type-shape-mismatch");
        }
        return selected;
    }

    private boolean isGenericDirectTypeMemberShape(List<NestedTypeMember> members) {
        if (members == null || members.size() < 2 ||
            members.size() > NESTED_DIRECT_TYPE_MEMBER_LIMIT) {
            return false;
        }
        long end = 0;
        for (int i = 0; i < members.size(); i++) {
            NestedTypeMember member = members.get(i);
            if (member == null ||
                Boolean.TRUE.equals(member.typeConflict) ||
                member.byteWidth == null ||
                member.byteWidth <= 0 ||
                member.offset < 0 ||
                member.offset < end) {
                return false;
            }
            end = member.offset + member.byteWidth;
            if (end > 0x400) {
                return false;
            }
        }
        return true;
    }

    private void normalizeGenericDirectTypeMemberOffsets(
        List<NestedTypeMember> members,
        String memberBase) {

        if (members == null || members.isEmpty()) {
            return;
        }
        if ("this".equals(memberBase) || pcodeParameterIndex(memberBase) != null) {
            return;
        }
        long baseOffset = members.get(0).offset;
        if (baseOffset <= 0L) {
            return;
        }
        for (NestedTypeMember member : members) {
            member.nativeOffset = member.offset;
            member.offset -= baseOffset;
        }
    }

    private void applyNestedTypeMemberNames(NestedTypeShape shape) {
        if (shape == null || shape.members.isEmpty()) {
            return;
        }

        List<Structure> structures = nestedTypeStructures(shape);
        if (structures.isEmpty()) {
            recordNestedTypeShapeReject("datatype-member-structure-missing");
            return;
        }

        Structure selected = null;
        ArrayList<String> selectedNames = null;
        int matches = 0;
        for (Structure structure : structures) {
            ArrayList<String> names = datatypeMemberNamesForShape(structure, shape);
            if (names == null) {
                continue;
            }
            matches++;
            if (selected == null) {
                selected = structure;
                selectedNames = names;
                continue;
            }
            if (!selectedNames.equals(names)) {
                recordNestedTypeShapeReject("ambiguous-datatype-member-names");
                return;
            }
        }

        if (selected == null || selectedNames == null) {
            recordNestedTypeShapeReject("datatype-member-names-missing");
            return;
        }

        for (int i = 0; i < shape.members.size(); i++) {
            NestedTypeMember member = shape.members.get(i);
            member.name = selectedNames.get(i);
            member.nameSource = "ghidra-datatype";
            member.nameProven = true;
        }
        shape.memberNameSource = "ghidra-datatype";
        shape.memberNamesProven = true;
        shape.datatypePath = selected.getPathName();
    }

    private void applyLabeledMemberName(
        NestedTypeShape shape,
        String expectedType,
        String label) {

        if (shape == null || !expectedType.equals(shape.typeName)) {
            return;
        }
        Integer memberIndex = provenLabeledMemberIndex(shape, label);
        if (memberIndex == null) {
            return;
        }

        NestedTypeMember member = shape.members.get(memberIndex);
        member.name = label;
        member.nameSource = "ghidra-pcode-labeled-member";
        member.nameProven = true;
        member.nameEvidence = "native label and member load share one p-code call";
        if (!Boolean.TRUE.equals(shape.memberNamesProven)) {
            shape.memberNameSource = "partial-ghidra-pcode-labeled-member";
            shape.memberNamesProven = false;
        }
    }

    private Integer provenLabeledMemberIndex(NestedTypeShape shape, String label) {
        Address labelAddress = exactAsciiStringAddress(label);
        if (labelAddress == null) {
            recordNestedTypeShapeReject("labeled-member-string-missing");
            return null;
        }

        LinkedHashSet<Integer> candidates = new LinkedHashSet<>();
        ReferenceIterator references =
            currentProgram.getReferenceManager().getReferencesTo(labelAddress);
        while (references.hasNext()) {
            Reference reference = references.next();
            Function function = functionAtOrContaining(reference.getFromAddress());
            HighFunction high = highFunction(function);
            if (high == null) {
                continue;
            }
            Iterator<PcodeOpAST> ops = high.getPcodeOps();
            while (ops.hasNext()) {
                PcodeOpAST op = ops.next();
                if (op.getOpcode() != PcodeOp.CALL ||
                    !pcodeCallHasAddressArgument(op, labelAddress)) {
                    continue;
                }
                for (int i = 1; i < op.getNumInputs(); i++) {
                    PcodeStorage storage = pcodeLoadedStorageExpression(op.getInput(i));
                    Integer memberIndex = nestedMemberIndexAtNativeOffset(shape, storage);
                    if (memberIndex != null) {
                        candidates.add(memberIndex);
                    }
                }
            }
        }
        if (candidates.size() != 1) {
            recordNestedTypeShapeReject(
                candidates.isEmpty()
                    ? "labeled-member-flow-missing"
                    : "ambiguous-labeled-member-flow");
            return null;
        }
        return candidates.iterator().next();
    }

    private boolean pcodeCallHasAddressArgument(PcodeOp op, Address expected) {
        for (int i = 1; i < op.getNumInputs(); i++) {
            if (expected.equals(pcodeAddress(op.getInput(i)))) {
                return true;
            }
            Long value = NetworkSchemaIntegerEvaluator.evaluate(op.getInput(i));
            if (value != null && expected.equals(absoluteAddress(value))) {
                return true;
            }
        }
        return false;
    }

    private Integer nestedMemberIndexAtNativeOffset(
        NestedTypeShape shape,
        PcodeStorage storage) {

        if (storage == null ||
            !("this".equals(storage.base) || pcodeParameterIndex(storage.base) != null)) {
            return null;
        }
        Integer selected = null;
        for (int i = 0; i < shape.members.size(); i++) {
            NestedTypeMember member = shape.members.get(i);
            long nativeOffset = member.nativeOffset == null
                ? member.offset
                : member.nativeOffset;
            if (nativeOffset != storage.offset) {
                continue;
            }
            if (selected != null) {
                return null;
            }
            selected = i;
        }
        return selected;
    }

    private Address exactAsciiStringAddress(String value) {
        Address selected = null;
        for (Address address : asciiStringsContaining(value)) {
            if (!value.equals(readPrintableString(address))) {
                continue;
            }
            if (selected != null && !selected.equals(address)) {
                return null;
            }
            selected = address;
        }
        return selected;
    }

    private List<Structure> nestedTypeStructures(NestedTypeShape shape) {
        if (shape == null || currentProgram == null) {
            return Collections.emptyList();
        }
        String qualifiedName = shape.typeNameFull != null ? shape.typeNameFull : shape.typeName;
        String leafName = shape.typeName != null ? shape.typeName : NetworkSchemaText.sourceTypeLeaf(qualifiedName);
        if (leafName == null || leafName.isEmpty()) {
            return Collections.emptyList();
        }

        String key = qualifiedName + "|" + leafName;
        if (nestedTypeStructureCache.containsKey(key)) {
            return nestedTypeStructureCache.get(key);
        }

        ArrayList<Structure> exact = new ArrayList<>();
        ArrayList<Structure> leaf = new ArrayList<>();
        Iterator<DataType> iterator = currentProgram.getDataTypeManager().getAllDataTypes();
        while (iterator.hasNext()) {
            DataType dataType = iterator.next();
            if (!(dataType instanceof Structure)) {
                continue;
            }
            Structure structure = (Structure) dataType;
            if (qualifiedName != null && datatypeMatchesQualifiedName(dataType, qualifiedName)) {
                exact.add(structure);
                continue;
            }
            if (leafName.equals(dataType.getName())) {
                leaf.add(structure);
            }
        }

        List<Structure> result = exact.isEmpty() ? leaf : exact;
        nestedTypeStructureCache.put(key, result);
        return result;
    }

    private boolean datatypeMatchesQualifiedName(DataType dataType, String qualifiedName) {
        if (dataType == null || qualifiedName == null || qualifiedName.isBlank()) {
            return false;
        }
        String leaf = NetworkSchemaText.sourceTypeLeaf(qualifiedName);
        String path = dataType.getPathName();
        String categoryPath = dataType.getCategoryPath() == null
            ? ""
            : dataType.getCategoryPath().getPath();
        if (qualifiedName.equals(dataType.getName()) || qualifiedName.equals(path)) {
            return true;
        }

        String qualifiedPath = "/" + qualifiedName.replace("::", "/");
        String normalizedPath = path == null ? "" : path.replace('\\', '/');
        String normalizedCategory = categoryPath.replace('\\', '/');
        if (normalizedPath.equals(qualifiedPath) || normalizedPath.endsWith(qualifiedPath)) {
            return true;
        }
        if (normalizedCategory.equals(qualifiedPath) || normalizedCategory.endsWith(qualifiedPath)) {
            return true;
        }
        return leaf != null &&
            leaf.equals(dataType.getName()) &&
            normalizedCategory.endsWith("/" + qualifiedName.replace("::", "/"));
    }

    private ArrayList<String> datatypeMemberNamesForShape(
        Structure structure,
        NestedTypeShape shape) {

        if (structure == null || shape == null || shape.members.isEmpty()) {
            return null;
        }
        int requiredLength = nestedTypeRequiredLength(shape);
        if (requiredLength <= 0 || structure.getLength() != requiredLength) {
            return null;
        }

        ArrayList<String> names = new ArrayList<>();
        for (NestedTypeMember member : shape.members) {
            DataTypeComponent component = datatypeComponentAtOffset(structure, member.offset);
            if (component == null) {
                return null;
            }
            if (member.byteWidth != null && component.getLength() != member.byteWidth) {
                return null;
            }
            String name = component.getFieldName();
            if (!isProvenDatatypeMemberName(name)) {
                return null;
            }
            names.add(name);
        }
        return names;
    }

    private int nestedTypeRequiredLength(NestedTypeShape shape) {
        long length = 0;
        for (NestedTypeMember member : shape.members) {
            if (member.byteWidth == null || member.byteWidth <= 0) {
                return -1;
            }
            length = Math.max(length, member.offset + member.byteWidth);
        }
        return length > Integer.MAX_VALUE ? -1 : (int) length;
    }

    private DataTypeComponent datatypeComponentAtOffset(Structure structure, long offset) {
        if (structure == null || offset < 0 || offset > Integer.MAX_VALUE) {
            return null;
        }
        for (DataTypeComponent component : structure.getDefinedComponents()) {
            if (component.getOffset() == (int) offset) {
                return component;
            }
        }
        return null;
    }

    private boolean isProvenDatatypeMemberName(String name) {
        if (name == null) {
            return false;
        }
        String trimmed = name.trim();
        if (trimmed.isEmpty()) {
            return false;
        }
        String lower = trimmed.toLowerCase(Locale.ROOT);
        return !lower.equals("field") &&
            !lower.matches("field_?\\d+") &&
            !lower.matches("undefined\\d*") &&
            !lower.matches("padding_?\\d*") &&
            !lower.startsWith("unnamed");
    }

    private Integer nativeTypeByteWidth(String nativeType) {
        String shape = wireShapeFromNativeType(nativeType);
        return wireShapeByteWidth(shape);
    }

    private Integer wireShapeByteWidth(String shape) {
        if (shape == null) {
            return null;
        }
        if (shape.startsWith("composite<") && shape.endsWith(">")) {
            List<String> members = NetworkSchemaText.splitTopLevel(
                shape.substring("composite<".length(), shape.length() - 1));
            if (members.isEmpty()) {
                return null;
            }
            int width = 0;
            for (String member : members) {
                Integer memberWidth = wireShapeByteWidth(member);
                if (memberWidth == null) {
                    return null;
                }
                try {
                    width = Math.addExact(width, memberWidth);
                }
                catch (ArithmeticException ignored) {
                    return null;
                }
            }
            return width;
        }
        if (shape.startsWith("fixed-bytes-")) {
            Long byteLength = NetworkSchemaText.parseIntegerLiteral(shape.substring("fixed-bytes-".length()));
            return byteLength == null ||
                byteLength <= 0 ||
                byteLength > Integer.MAX_VALUE
                    ? null
                    : byteLength.intValue();
        }
        if (isPackedPositionShape(shape)) {
            return 10;
        }
        if (shape.startsWith("delta-vec3<") && shape.endsWith(">")) {
            return 3;
        }
        if (vectorElementWireShape(shape) != null) {
            return 24;
        }
        return switch (shape) {
            case "bool", "byte", "u8" -> 1;
            case "u16", "half-f32" -> 2;
            case "u32", "f32", "vec2-comp" -> 4;
            case "vec3-comp", "vec3-comp-norm" -> 6;
            case "u64", "f64", "vec2", "quat-comp", "quat-comp-norm" -> 8;
            case "uuid", "vec4", "quat", "aabb2d" -> 16;
            case "vec3" -> 12;
            case "aabb3d" -> 24;
            case "actor-ref", "mat3" -> 36;
            case "transform", "affine3" -> 48;
            default -> null;
        };
    }

    private String scalarOutputStoreNativeType(Function target) {
        if (target == null) {
            return null;
        }
        return scalarOutputStoreNativeTypeFromPcode(target);
    }

    private String scalarOutputStoreNativeTypeFromPcode(Function target) {
        HighFunction high = highFunction(target);
        if (high == null) {
            return null;
        }

        LinkedHashMap<String, String> candidateTypes = new LinkedHashMap<>();
        Iterator<PcodeOpAST> ops = high.getPcodeOps();
        while (ops.hasNext()) {
            PcodeOpAST op = ops.next();
            if (op.getOpcode() != PcodeOp.STORE || op.getNumInputs() < 3) {
                continue;
            }
            PcodeStorage storage = pcodeStorageExpression(op.getInput(1));
            if (!isScalarOutputPointerStorage(storage)) {
                continue;
            }
            String nativeType = scalarNativeTypeFromByteWidth(op.getInput(2).getSize());
            if (nativeType == null) {
                continue;
            }
            String previous = candidateTypes.putIfAbsent(storage.base, nativeType);
            if (previous != null && !previous.equals(nativeType)) {
                return null;
            }
        }
        return selectedScalarOutputCandidate(candidateTypes);
    }

    private String selectedScalarOutputCandidate(Map<String, String> candidateTypes) {
        if (candidateTypes == null || candidateTypes.isEmpty()) {
            return null;
        }
        for (String preferred : List.of("param_3", "arg:R8", "R8")) {
            String nativeType = candidateTypes.get(preferred);
            if (nativeType != null) {
                return nativeType;
            }
        }
        if (candidateTypes.size() == 1) {
            return candidateTypes.values().iterator().next();
        }
        return null;
    }

    private boolean isScalarOutputPointerStorage(PcodeStorage storage) {
        return storage != null &&
            storage.offset == 0L &&
            (storage.base.matches("param_[3-9]") ||
                storage.base.matches("p[lub]?Var\\d*"));
    }

    private String scalarNativeTypeFromByteWidth(int byteWidth) {
        return switch (byteWidth) {
            case 1 -> "u8";
            case 2 -> "u16";
            case 4 -> "u32";
            case 8 -> "u64";
            default -> null;
        };
    }

    private void recordNestedTypeShapeReject(String reason) {
        nestedTypeShapeRejectCounts.merge(reason, 1, Integer::sum);
    }

    private boolean isPcodeMessageStorage(PcodeStorage storage, Set<String> messageBases) {
        return storage != null &&
            messageBases != null &&
            messageBases.contains(storage.base) &&
            isLikelyMessageStorage(storage.expression());
    }
