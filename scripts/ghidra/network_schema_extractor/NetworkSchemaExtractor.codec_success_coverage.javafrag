    private record CodecSuccessCoverageAnalysis(
        boolean complete,
        String diagnostic) {
    }

    private UnmarshalTerminalFlow unmarshalFlowWithExcludedEdges(
        HighFunction high,
        UnmarshalTerminalFlow source,
        Map<PcodeBlockBasic, Set<PcodeBlockBasic>> excludedEdges,
        String status) {

        if (high == null || source == null) {
            return UnmarshalTerminalFlow.unresolved("missing-flow");
        }
        LinkedHashSet<PcodeBlockBasic> mandatory = new LinkedHashSet<>(
            source.mandatoryBlocks());
        mandatory.addAll(mandatoryPhysicalBlocks(
            high,
            source.terminals(),
            excludedEdges));
        return new UnmarshalTerminalFlow(
            source.terminals(),
            excludedEdges,
            Set.copyOf(mandatory),
            status);
    }

    private Set<PcodeBlockBasic> mandatoryPhysicalBlocks(
        HighFunction high,
        Set<PcodeBlockBasic> terminals,
        Map<PcodeBlockBasic, Set<PcodeBlockBasic>> excludedEdges) {

        if (high == null || terminals == null || terminals.isEmpty()) {
            return Set.of();
        }
        List<PcodeBlockBasic> entries = high.getBasicBlocks().stream()
            .filter(block -> NetworkSchemaControlFlow.predecessors(block).isEmpty())
            .toList();
        if (entries.isEmpty()) {
            return Set.of();
        }
        Set<PcodeBlockBasic> reachable = reachablePhysicalBlocks(
            entries,
            terminals,
            excludedEdges,
            null);
        LinkedHashSet<PcodeBlockBasic> mandatory =
            new LinkedHashSet<>(reachable);
        mandatory.removeIf(block -> !reachablePhysicalBlocks(
            entries,
            terminals,
            excludedEdges,
            block).isEmpty());
        return Set.copyOf(mandatory);
    }

    private Set<PcodeBlockBasic> reachablePhysicalBlocks(
        List<PcodeBlockBasic> entries,
        Set<PcodeBlockBasic> terminals,
        Map<PcodeBlockBasic, Set<PcodeBlockBasic>> excludedEdges,
        PcodeBlockBasic removed) {

        ArrayDeque<PcodeBlockBasic> pending = new ArrayDeque<>();
        LinkedHashSet<PcodeBlockBasic> visited = new LinkedHashSet<>();
        for (PcodeBlockBasic entry : entries) {
            if (entry != removed && visited.add(entry)) {
                pending.addLast(entry);
            }
        }
        boolean reachedTerminal = false;
        while (!pending.isEmpty()) {
            checkAnalysisCancelled();
            PcodeBlockBasic block = pending.removeFirst();
            if (terminals.contains(block)) {
                reachedTerminal = true;
            }
            for (PcodeBlockBasic successor :
                    NetworkSchemaControlFlow.successors(block)) {
                if (successor == removed ||
                    excludedEdges.getOrDefault(block, Set.of()).contains(successor) ||
                    !visited.add(successor)) {
                    continue;
                }
                pending.addLast(successor);
            }
        }
        return reachedTerminal ? Set.copyOf(visited) : Set.of();
    }

    private CodecSuccessCoverageAnalysis codecSuccessCoverage(
        Map<PcodeBlockBasic, List<CodecWireEvent>> eventsByBlock,
        UnmarshalTerminalFlow terminalFlow,
        int expectedEventCount) {

        if (eventsByBlock == null || terminalFlow == null ||
            expectedEventCount <= 0) {
            return new CodecSuccessCoverageAnalysis(false, "missing-input");
        }
        ArrayList<Map.Entry<PcodeBlockBasic, List<CodecWireEvent>>> entries =
            eventsByBlock.entrySet().stream()
                .filter(entry -> entry.getValue() != null && !entry.getValue().isEmpty())
                .sorted(Comparator
                    .comparing(
                        (Map.Entry<PcodeBlockBasic, List<CodecWireEvent>> entry) ->
                            entry.getKey() == null
                            ? null
                            : entry.getKey().getStart(),
                        Comparator.nullsLast(Address::compareTo))
                    .thenComparingInt(entry -> entry.getKey() == null
                        ? Integer.MAX_VALUE
                        : entry.getKey().getIndex()))
                .collect(Collectors.toCollection(ArrayList::new));
        int observedEventCount = 0;
        boolean allMandatory = !terminalFlow.mandatoryBlocks().isEmpty();
        ArrayList<String> blocks = new ArrayList<>();
        for (Map.Entry<PcodeBlockBasic, List<CodecWireEvent>> entry : entries) {
            PcodeBlockBasic block = entry.getKey();
            int eventCount = entry.getValue().size();
            boolean mandatory = block != null &&
                terminalFlow.mandatoryBlocks().contains(block);
            observedEventCount += eventCount;
            allMandatory &= mandatory;
            blocks.add(
                (block == null ? "missing" : formatAddress(block.getStart())) +
                    "x" + eventCount + (mandatory ? "+" : "-"));
        }
        boolean complete = allMandatory && observedEventCount == expectedEventCount;
        return new CodecSuccessCoverageAnalysis(
            complete,
            "expected=" + expectedEventCount +
                ",observed=" + observedEventCount +
                ",mandatory=" + terminalFlow.mandatoryBlocks().size() +
                ",blocks=" + blocks);
    }

    private boolean isAcyclicLinearCodecProduct(
        HighFunction high,
        List<PcodeOpAST> operations,
        List<CodecWireEvent> events,
        UnmarshalTerminalFlow terminalFlow) {

        if (high == null || operations == null || events == null ||
            events.size() < 2 || terminalFlow == null ||
            terminalFlow.terminals().isEmpty()) {
            return false;
        }
        List<NetworkSchemaNaturalLoop> loops =
            NetworkSchemaControlFlow.naturalLoops(high);
        PcodeOpAST previous = null;
        for (CodecWireEvent event : events) {
            checkAnalysisCancelled();
            if (event == null || event.callsite() == null ||
                event.wireEvidence() == null) {
                return false;
            }
            PcodeOpAST operation = pcodeCallAt(high, event.callsite());
            if (operation == null || loops.stream().anyMatch(loop -> loop.contains(operation)) ||
                normalizedBooleanBranch(high, operations, event) != null) {
                return false;
            }
            if (previous != null) {
                PcodeBlockBasic previousBlock =
                    NetworkSchemaControlFlow.parentBlock(previous);
                PcodeBlockBasic currentBlock =
                    NetworkSchemaControlFlow.parentBlock(operation);
                boolean ordered = previousBlock == currentBlock
                    ? previous.getSeqnum().compareTo(operation.getSeqnum()) < 0
                    : NetworkSchemaControlFlow.reaches(previousBlock, currentBlock) &&
                        !NetworkSchemaControlFlow.reaches(currentBlock, previousBlock);
                if (!ordered) {
                    return false;
                }
            }
            previous = operation;
        }
        PcodeBlockBasic lastBlock = NetworkSchemaControlFlow.parentBlock(previous);
        return lastBlock != null && terminalFlow.terminals().stream().anyMatch(terminal ->
            terminal == lastBlock || NetworkSchemaControlFlow.reaches(lastBlock, terminal));
    }

    private Map<PcodeBlockBasic, Set<PcodeBlockBasic>>
        unsuccessfulCodecEventEdges(
            HighFunction high,
            Map<PcodeBlockBasic, List<CodecWireEvent>> eventsByBlock,
            Map<PcodeBlockBasic, PcodeOpAST> eventOriginsByBlock,
            Set<PcodeBlockBasic> successfulTerminals) {

        if (high == null || eventsByBlock == null || eventsByBlock.isEmpty() ||
            successfulTerminals == null || successfulTerminals.isEmpty()) {
            return Map.of();
        }
        HashMap<PcodeBlockBasic, List<ContainerCodecCall>> codecsByBlock =
            new HashMap<>();
        for (Map.Entry<PcodeBlockBasic, List<CodecWireEvent>> entry :
                eventsByBlock.entrySet()) {
            List<CodecWireEvent> events = entry.getValue();
            if (events == null || events.isEmpty()) {
                continue;
            }
            CodecWireEvent event = events.get(events.size() - 1);
            PcodeOpAST operation = eventOriginsByBlock == null
                ? null
                : eventOriginsByBlock.get(entry.getKey());
            if (operation == null && event.callsite() != null) {
                operation = pcodeCallAt(high, event.callsite());
            }
            if (operation == null ||
                NetworkSchemaControlFlow.parentBlock(operation) != entry.getKey()) {
                continue;
            }
            ContainerCodecCall codec = new ContainerCodecCall();
            codec.operation = operation;
            codec.callsite = operation.getSeqnum().getTarget();
            Function target = pcodeCallTarget(operation);
            codec.target = target == null ? event.target() : target.getEntryPoint();
            codec.targetName = target == null ? event.targetName() : fullFunctionName(target);
            codec.nativeType = event.nativeType();
            codec.wireEvidence = event.wireEvidence();
            codec.evidenceSource = target != null &&
                pcodeReadRawWireEvidence(operation, target) != null
                    ? "container-helper-unmarshal-read-raw"
                    : "codec-wire-event";
            codecsByBlock.put(entry.getKey(), List.of(codec));
        }
        if (codecsByBlock.isEmpty()) {
            return Map.of();
        }

        HashMap<PcodeBlockBasic, Set<PcodeBlockBasic>> failedEdges =
            new HashMap<>();
        for (Map.Entry<PcodeBlockBasic, List<ContainerCodecCall>> entry :
                codecsByBlock.entrySet()) {
            List<ContainerCodecCall> codecs = entry.getValue();
            CodecFailureEdge failed = failedCodecEdge(
                entry.getKey(),
                codecs.get(codecs.size() - 1),
                codecsByBlock,
                successfulTerminals);
            if (failed != null) {
                failedEdges.put(failed.source(), Set.of(failed.target()));
            }
        }
        return Map.copyOf(failedEdges);
    }

    private void recordUnmarshalEventOrigin(
        Map<PcodeBlockBasic, PcodeOpAST> originsByBlock,
        Map<CodecWireEvent, PcodeOpAST> originsByEvent,
        PcodeOpAST operation,
        List<CodecWireEvent> events) {

        if (originsByBlock == null || operation == null ||
            events == null || events.isEmpty()) {
            return;
        }
        PcodeBlockBasic block = NetworkSchemaControlFlow.parentBlock(operation);
        if (block != null) {
            originsByBlock.put(block, operation);
        }
        if (originsByEvent != null) {
            for (CodecWireEvent event : events) {
                if (event != null) {
                    originsByEvent.put(event, operation);
                }
            }
        }
    }
