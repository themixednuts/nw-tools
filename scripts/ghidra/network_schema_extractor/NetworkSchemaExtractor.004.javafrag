
    private boolean isZeroUuid(String uuid) {
        String normalized = normalizeUuid(uuid);
        return NIL_TYPE_ID.equals(normalized);
    }

    private void collectQueuedRegistrationHooks(
        Map<String, HookTypeEvidence> result) throws CancelledException {
        queuedRegistrationReferenceCount = 0;
        queuedRegistrationDecodedCount = 0;
        queuedRegistrationNoFunctionCount = 0;
        queuedRegistrationNoHelperCount = 0;
        queuedRegistrationNoTypeIdCount = 0;
        queuedRegistrationFailureSamples = new JsonArray();
        Address queueRegistrationHook =
            currentProgram.getImageBase().add(QUEUE_REGISTRATION_HOOK_RVA);
        ReferenceIterator references =
            currentProgram.getReferenceManager().getReferencesTo(queueRegistrationHook);
        while (references.hasNext()) {
            monitor.checkCancelled();
            Reference reference = references.next();
            queuedRegistrationReferenceCount++;
            if (queuedRegistrationReferenceCount % 512 == 0) {
                println(
                    "Queued registration progress: references=" +
                    queuedRegistrationReferenceCount +
                    ", decoded=" + queuedRegistrationDecodedCount);
            }

            Function owner = functionContaining(reference.getFromAddress());
            if (owner == null) {
                queuedRegistrationNoFunctionCount++;
                recordRegistrationFailure(
                    queuedRegistrationFailureSamples,
                    "queued-hook",
                    "no-function",
                    reference,
                    null,
                    null,
                    null);
                continue;
            }
            Address helperTable =
                findRegistrationHelperTable(owner, reference.getFromAddress());
            if (helperTable == null) {
                queuedRegistrationNoHelperCount++;
                recordRegistrationFailure(
                    queuedRegistrationFailureSamples,
                    "queued-hook",
                    "no-helper-table",
                    reference,
                    owner,
                    null,
                    null);
                continue;
            }
            HookTypeEvidence hook = decodeRegistrationHelperTable(
                owner.getEntryPoint(),
                helperTable,
                registrationHookTypeNameFromSlot(helperTable, 3));
            if (hook == null || hook.typeId == null) {
                queuedRegistrationNoTypeIdCount++;
                recordRegistrationFailure(
                    queuedRegistrationFailureSamples,
                    "queued-hook",
                    "no-type-id",
                    reference,
                    owner,
                    helperTable,
                    hook);
                continue;
            }
            queuedRegistrationDecodedCount++;
            result.putIfAbsent(normalizeUuid(hook.typeId), hook);
        }
    }

    private void collectDirectRegisterTypeProviders(
        Map<String, HookTypeEvidence> result) throws CancelledException {
        directRegisterTypeReferenceCount = 0;
        directRegisterTypeDecodedCount = 0;
        directRegisterTypeCoveredCount = 0;
        directRegisterTypeNoFunctionCount = 0;
        directRegisterTypeNoTypeIdCount = 0;
        directRegisterTypeFailureSamples = new JsonArray();
        LinkedHashSet<Address> coveredRegisterThunks = new LinkedHashSet<>();
        for (HookTypeEvidence hook : result.values()) {
            Address registerThunk = resolvedCodeTarget(hook.registerThunk);
            if (isExecutableAddress(registerThunk)) {
                coveredRegisterThunks.add(registerThunk);
            }
        }
        Address registerType =
            currentProgram.getImageBase().add(TYPE_REGISTRY_REGISTER_TYPE_RVA);
        ReferenceIterator references =
            currentProgram.getReferenceManager().getReferencesTo(registerType);
        while (references.hasNext()) {
            monitor.checkCancelled();
            Reference reference = references.next();
            directRegisterTypeReferenceCount++;
            if (directRegisterTypeReferenceCount % 512 == 0) {
                println(
                    "Direct RegisterType progress: references=" +
                    directRegisterTypeReferenceCount +
                    ", covered=" + directRegisterTypeCoveredCount +
                    ", decoded=" + directRegisterTypeDecodedCount);
            }

            Function owner = functionContaining(reference.getFromAddress());
            if (owner == null) {
                directRegisterTypeNoFunctionCount++;
                recordRegistrationFailure(
                    directRegisterTypeFailureSamples,
                    "direct-register-type",
                    "no-function",
                    reference,
                    null,
                    null,
                    null);
                continue;
            }
            if (coveredRegisterThunks.contains(owner.getEntryPoint())) {
                directRegisterTypeCoveredCount++;
                continue;
            }

            HookTypeEvidence hook =
                decodeDirectRegisterTypeProvider(owner, reference.getFromAddress());
            if (hook == null || hook.typeId == null) {
                directRegisterTypeNoTypeIdCount++;
                HookTypeEvidence partialHook =
                    hook == null ? partialDirectRegisterTypeProvider(owner, reference.getFromAddress()) : hook;
                recordRegistrationFailure(
                    directRegisterTypeFailureSamples,
                    "direct-register-type",
                    "no-type-id",
                    reference,
                    owner,
                    null,
                    partialHook);
                continue;
            }

            directRegisterTypeDecodedCount++;
            result.putIfAbsent(normalizeUuid(hook.typeId), hook);
        }
    }

    private void recordRegistrationFailure(
        JsonArray samples,
        String scan,
        String reason,
        Reference reference,
        Function owner,
        Address helperTable,
        HookTypeEvidence partialHook) {

        if (samples.size() >= REGISTRATION_FAILURE_SAMPLE_LIMIT) {
            return;
        }

        JsonObject object = new JsonObject();
        object.addProperty("scan", scan);
        object.addProperty("reason", reason);
        if (reference != null) {
            NetworkSchemaJson.add(object, "callsite", formatAddress(reference.getFromAddress()));
            NetworkSchemaJson.add(object, "target", formatAddress(reference.getToAddress()));
        }
        if (owner != null) {
            NetworkSchemaJson.add(object, "owner", formatAddress(owner.getEntryPoint()));
            NetworkSchemaJson.add(object, "ownerName", fullFunctionName(owner));
        }
        NetworkSchemaJson.add(object, "helperTable", formatAddress(helperTable));
        if (partialHook != null) {
            NetworkSchemaJson.add(object, "partialTypeName", partialHook.typeName);
            NetworkSchemaJson.add(object, "partialSlotTypeName", partialHook.slotTypeName);
            NetworkSchemaJson.add(object, "partialTypeProvider", formatAddress(partialHook.typeProvider));
            NetworkSchemaJson.add(object, "partialUuidSource", formatAddress(partialHook.uuidSource));
            NetworkSchemaJson.add(object, "partialTypeDescriptor", formatAddress(partialHook.typeDescriptor));
        }
        samples.add(object);
    }

    private HookTypeEvidence decodeDirectRegisterTypeProvider(
        Function owner,
        Address registerTypeCallsite) {
        TypeIdDecode typeId = typeIdForRegisterTypeCall(owner, registerTypeCallsite);
        if (typeId == null) {
            return null;
        }
        TypeNameDecode typeName = decodeTypeNameFromReturnFlow(
            typeId.function,
            typeId.provider);

        HookTypeEvidence hook = new HookTypeEvidence();
        hook.source = "direct-register-type-pcode";
        hook.typeId = typeId.typeId;
        hook.typeName = typeName == null ? null : typeName.typeName;
        hook.typeNameEvidenceSource = typeName == null ? null : typeName.typeNameSource;
        hook.hookFunction = owner.getEntryPoint();
        hook.registerThunk = owner.getEntryPoint();
        hook.typeProvider = typeId.provider;
        hook.uuidSource = typeId.sourceAddress;
        return hook;
    }

    private HookTypeEvidence partialDirectRegisterTypeProvider(
        Function owner,
        Address registerTypeCallsite) {

        Address typeProvider = typeProviderForRegisterTypeCall(owner, registerTypeCallsite);
        if (typeProvider == null) {
            return null;
        }

        HookTypeEvidence hook = new HookTypeEvidence();
        hook.source = "direct-register-type-partial";
        hook.hookFunction = owner.getEntryPoint();
        hook.registerThunk = owner.getEntryPoint();
        hook.typeProvider = typeProvider;
        return hook;
    }

    private String registrationHookTypeName(Symbol symbol) {
        String qualifiedName = symbol.getName(true);
        String parsed = parseInstallRegistrationHookTypeName(qualifiedName);
        if (parsed != null) {
            return parsed;
        }

        boolean registrationHook = false;
        for (String templateName : REGISTRATION_HOOK_TEMPLATE_NAMES) {
            if (templateName.equals(symbol.getName())) {
                registrationHook = true;
                break;
            }
        }
        if (!registrationHook) {
            return null;
        }

        Function function = currentProgram.getFunctionManager().getFunctionAt(symbol.getAddress());
        if (function == null) {
            return null;
        }
        String namespace = function.getParentNamespace() == null
            ? null
            : function.getParentNamespace().getName(true);
        if (namespace == null || namespace.isEmpty() ||
            "Global".equals(namespace) || "Amazon::Hub".equals(namespace)) {
            return null;
        }
        return namespace;
    }

    private String parseInstallRegistrationHookTypeName(String value) {
        if (value == null) {
            return null;
        }

        int start = -1;
        int markerLength = 0;
        for (String templateName : REGISTRATION_HOOK_TEMPLATE_NAMES) {
            String marker = templateName + "<";
            int candidate = value.indexOf(marker);
            if (candidate >= 0 && (start < 0 || candidate < start)) {
                start = candidate;
                markerLength = marker.length();
            }
        }
        if (start < 0) {
            return null;
        }
        start += markerLength;

        int depth = 1;
        for (int index = start; index < value.length(); index++) {
            char ch = value.charAt(index);
            if (ch == '<') {
                depth++;
            }
            else if (ch == '>') {
                depth--;
                if (depth == 0) {
                    String typeName =
                        stripNativeTypeQualifier(value.substring(start, index).trim());
                    return isPlausibleTypeName(typeName) ? typeName : null;
                }
            }
        }
        return null;
    }

    private String stripNativeTypeQualifier(String typeName) {
        if (typeName == null) {
            return null;
        }
        String result = typeName.trim();
        boolean changed;
        do {
            changed = false;
            if (result.startsWith("class ")) {
                result = result.substring("class ".length()).trim();
                changed = true;
            }
            else if (result.startsWith("struct ")) {
                result = result.substring("struct ".length()).trim();
                changed = true;
            }
            else if (result.startsWith("class_")) {
                result = result.substring("class_".length()).trim();
                changed = true;
            }
            else if (result.startsWith("struct_")) {
                result = result.substring("struct_".length()).trim();
                changed = true;
            }
        } while (changed);
        return result;
    }

    private HookTypeEvidence decodeRegistrationHook(Function hookFunction, String typeName) {
        Address helperTable = findRegistrationHelperTable(hookFunction);
        if (helperTable == null) {
            TypeIdDecode directTypeId =
                decodeRegistrationThunkTypeId(hookFunction.getEntryPoint());
            if (directTypeId == null) {
                return null;
            }

            HookTypeEvidence hook = new HookTypeEvidence();
            hook.typeName = typeName;
            hook.typeId = directTypeId.typeId;
            hook.hookFunction = hookFunction.getEntryPoint();
            hook.registerThunk = hookFunction.getEntryPoint();
            hook.typeProvider = directTypeId.provider;
            hook.uuidSource = directTypeId.sourceAddress;
            return hook;
        }

        return decodeRegistrationHelperTable(hookFunction.getEntryPoint(), helperTable, typeName);
    }

    private HookTypeEvidence decodeRegistrationHelperTable(
        Address hookFunction,
        Address helperTable,
        String typeName) {

        if (helperTable == null) {
            return null;
        }

        Address registerThunk = registrationCodePointer(helperTable.add(0x10));
        TypeIdDecode typeId = decodeRegistrationThunkTypeId(registerThunk);
        if (typeId == null) {
            HookTypeEvidence hook = new HookTypeEvidence();
            hook.typeName = typeName;
            hook.hookFunction = hookFunction;
            hook.helperTable = helperTable;
            hook.registerThunk = registerThunk;
            hook.typeProvider = null;
            String slotTypeName = registrationHookTypeNameFromSlot(helperTable, 3);
            if (isPlausibleTypeName(slotTypeName)) {
                hook.slotTypeName = slotTypeName;
            }
            return hook;
        }

        HookTypeEvidence hook = new HookTypeEvidence();
        hook.typeName = typeName;
        hook.typeId = typeId.typeId;
        hook.hookFunction = hookFunction;
        hook.helperTable = helperTable;
        hook.registerThunk = registerThunk;
        hook.typeProvider = typeId.provider;
        hook.uuidSource = typeId.sourceAddress;

        String slotTypeName = registrationHookTypeNameFromSlot(helperTable, 3);
        if (isPlausibleTypeName(slotTypeName)) {
            hook.slotTypeName = slotTypeName;
        }
        return hook;
    }

    private HookTypeEvidence decodeRegistrationHookTypeDescriptor(
        Address typeDescriptor,
        String typeName) {

        ReferenceIterator descriptorReferences =
            currentProgram.getReferenceManager().getReferencesTo(typeDescriptor);
        while (descriptorReferences.hasNext()) {
            Reference descriptorReference = descriptorReferences.next();
            Function slotFunction = functionContaining(descriptorReference.getFromAddress());
            if (slotFunction == null) {
                continue;
            }

            ReferenceIterator slotReferences =
                currentProgram.getReferenceManager().getReferencesTo(slotFunction.getEntryPoint());
            while (slotReferences.hasNext()) {
                Reference slotReference = slotReferences.next();
                Address helperTable = subtract(slotReference.getFromAddress(), 0x18L);
                if (!isRegistrationHelperTable(helperTable)) {
                    continue;
                }

                Address registerThunk = registrationCodePointer(helperTable.add(0x10));
                TypeIdDecode typeId = decodeRegistrationThunkTypeId(registerThunk);
                if (typeId == null) {
                    continue;
                }

                HookTypeEvidence hook = new HookTypeEvidence();
                hook.typeName = typeName;
                hook.slotTypeName = registrationHookTypeNameFromSlot(helperTable, 3);
                hook.typeId = typeId.typeId;
                hook.helperTable = helperTable;
                hook.registerThunk = registerThunk;
                hook.typeProvider = typeId.provider;
                hook.uuidSource = typeId.sourceAddress;
                hook.typeDescriptor = typeDescriptor;
                hook.slotTypeNameFunction = slotFunction.getEntryPoint();
                return hook;
            }
        }
        return null;
    }

    private boolean isRegistrationHelperTable(Address address) {
        if (!isProgramAddress(address)) {
            return false;
        }
        String cacheKey = addressCacheKey("registration-helper-table", address);
        Boolean cached = registrationHelperTableCache.get(cacheKey);
        if (cached != null) {
            runMetrics.increment("registrationHelperTableCacheHits");
            return cached;
        }
        runMetrics.increment("registrationHelperTableCacheMisses");
        Address slot0 = registrationCodePointer(address);
        Address slot1 = registrationCodePointer(address.add(0x8));
        Address slot2 = registrationCodePointer(address.add(0x10));
        Address slot3 = registrationCodePointer(address.add(0x18));
        Address slot4 = registrationCodePointer(address.add(0x20));
        boolean callableLayout = Objects.equals(slot0, slot1) &&
            isExecutableAddress(slot0) &&
            isExecutableAddress(slot2) &&
            isExecutableAddress(slot3) &&
            isExecutableAddress(slot4);
        if (!callableLayout) {
            registrationHelperTableCache.put(cacheKey, false);
            return false;
        }

        boolean result = isPlausibleTypeName(registrationHookTypeNameFromSlot(address, 3));
        if (!result) {
            result = decodeRegistrationThunkTypeId(slot2) != null;
        }
        registrationHelperTableCache.put(cacheKey, result);
        return result;
    }

    private String registrationHookTypeNameFromSlot(Address helperTable, int slot) {
        if (!isProgramAddress(helperTable) || slot < 0) {
            return null;
        }
        String cacheKey = addressCacheKey(
            "registration-hook-slot-name:" + slot,
            helperTable);
        Optional<String> cached = registrationHookSlotTypeNameCache.get(cacheKey);
        if (cached != null) {
            runMetrics.increment("registrationHookSlotNameCacheHits");
            return cached.orElse(null);
        }
        runMetrics.increment("registrationHookSlotNameCacheMisses");
        Address typeDescriptor = registrationHookTypeDescriptorFromSlot(helperTable, slot);
        if (!isProgramAddress(typeDescriptor)) {
            registrationHookSlotTypeNameCache.put(cacheKey, Optional.empty());
            return null;
        }
        Symbol symbol = currentProgram.getSymbolTable().getPrimarySymbol(typeDescriptor);
        if (symbol != null) {
            String typeName = parseInstallRegistrationHookTypeName(symbol.getName(true));
            if (typeName != null) {
                registrationHookSlotTypeNameCache.put(cacheKey, Optional.of(typeName));
                return typeName;
            }
        }

        String result = parseMsvcInstallRegistrationHookTypeDescriptor(typeDescriptor);
        registrationHookSlotTypeNameCache.put(cacheKey, Optional.ofNullable(result));
        return result;
    }

    private Address registrationHookTypeDescriptorFromSlot(Address helperTable, int slot) {
        if (!isProgramAddress(helperTable) || slot < 0) {
            return null;
        }
        Address target = registrationCodePointer(helperTable.add(slot * 8L));
        return uniqueAddressReturnedByFunction(target);
    }

    private String parseMsvcInstallRegistrationHookTypeDescriptor(Address typeDescriptor) {
        if (!isProgramAddress(typeDescriptor)) {
            return null;
        }

        String descriptorName = readPrintableString(typeDescriptor.add(0x10L));
        if (descriptorName == null) {
            return null;
        }

        int markerIndex = -1;
        int markerLength = 0;
        for (String templateName : REGISTRATION_HOOK_TEMPLATE_NAMES) {
            String marker = templateName + "@";
            int candidate = descriptorName.indexOf(marker);
            if (candidate >= 0 && (markerIndex < 0 || candidate < markerIndex)) {
                markerIndex = candidate;
                markerLength = marker.length();
            }
        }
        if (markerIndex < 0) {
            return null;
        }
        int start = markerIndex + markerLength;
        int end = descriptorName.indexOf("@Hub@Amazon@@", start);
        if (end < 0 || end <= start) {
            return null;
        }

        String encoded = descriptorName.substring(start, end);
        if (encoded.startsWith("V") || encoded.startsWith("U")) {
            encoded = encoded.substring(1);
        }
        while (encoded.endsWith("@")) {
            encoded = encoded.substring(0, encoded.length() - 1);
        }
        if (encoded.isEmpty()) {
            return null;
        }

        String[] parts = encoded.split("@");
        ArrayList<String> names = new ArrayList<>();
        for (int i = parts.length - 1; i >= 0; i--) {
            if (!parts[i].isEmpty()) {
                names.add(parts[i]);
            }
        }
        if (names.isEmpty()) {
            return null;
        }

        String typeName = String.join("::", names);
        return isPlausibleTypeName(typeName) ? typeName : null;
    }

    private TypeIdDecode decodeRegistrationThunkTypeId(Address registerThunk) {
        Function function = functionAtOrContaining(registerThunk);
        if (function == null) {
            return null;
        }
        String cacheKey = functionCacheKey("registration-thunk-type-id", function);
        Optional<TypeIdDecode> cached = registrationThunkTypeIdCache.get(cacheKey);
        if (cached != null) {
            runMetrics.increment("registrationThunkTypeIdCacheHits");
            return cached.orElse(null);
        }
        runMetrics.increment("registrationThunkTypeIdCacheMisses");
        HighFunction high = highFunction(function);
        if (high == null) {
            registrationThunkTypeIdCache.put(cacheKey, Optional.empty());
            return null;
        }
        LinkedHashMap<String, TypeIdDecode> decodedByTypeId = new LinkedHashMap<>();
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            if (operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            PcodeCallTargetInfo target = pcodeCallTargetInfo(operation);
            if (target == null || !isExecutableAddress(target.resolvedTarget)) {
                continue;
            }
            TypeIdDecode typeId = decodeDirectTypeIdProvider(target.resolvedTarget);
            if (typeId != null && typeId.typeId != null) {
                decodedByTypeId.putIfAbsent(normalizeUuid(typeId.typeId), typeId);
            }
        }
        TypeIdDecode result = decodedByTypeId.size() == 1
            ? decodedByTypeId.values().iterator().next()
            : null;
        registrationThunkTypeIdCache.put(cacheKey, Optional.ofNullable(result));
        return result;
    }

    private JsonArray hookTypeNamesJson(Map<String, HookTypeEvidence> hooksById) {
        JsonArray array = new JsonArray();
        for (HookTypeEvidence hook : hooksById.values()) {
            array.add(hook.toJson());
        }
        return array;
    }

    private JsonArray fieldHandlerVtablesJson(
        Map<String, RegistrationFunction> registrationFunctions) {

        LinkedHashMap<String, Address> vtableAddresses = new LinkedHashMap<>();
        LinkedHashMap<String, Integer> fieldCounts = new LinkedHashMap<>();
        LinkedHashMap<String, List<FieldCall>> fieldsByVtable = new LinkedHashMap<>();
        LinkedHashMap<String, LinkedHashSet<String>> handlerTypeNames = new LinkedHashMap<>();
        LinkedHashMap<String, String> handlerTypeSources = new LinkedHashMap<>();
        for (RegistrationFunction function : registrationFunctions.values()) {
            for (FieldCall field : function.fields) {
                if (field.handlerVtable == null) {
                    continue;
                }
                String key = field.handlerVtable.toString();
                vtableAddresses.putIfAbsent(key, field.handlerVtable);
                fieldCounts.put(key, fieldCounts.getOrDefault(key, 0) + 1);
                fieldsByVtable.computeIfAbsent(key, ignored -> new ArrayList<>()).add(field);
                if (field.handlerTypeName != null &&
                    parseNetworkTemplateType(field.handlerTypeName) != null) {
                    handlerTypeNames
                        .computeIfAbsent(key, ignored -> new LinkedHashSet<>())
                        .add(field.handlerTypeName);
                    String source = field.handlerConstruction == null
                        ? "handler-vtable-template"
                        : "handler-constructor-template";
                    if (!handlerTypeSources.containsKey(key) ||
                        "handler-constructor-template".equals(source)) {
                        handlerTypeSources.put(key, source);
                    }
                }
            }
        }

        JsonArray array = new JsonArray();
        for (Map.Entry<String, Address> entry : vtableAddresses.entrySet()) {
            int fieldCount = fieldCounts.getOrDefault(entry.getKey(), 0);
            Set<String> names = handlerTypeNames.getOrDefault(
                entry.getKey(),
                new LinkedHashSet<>());
            String handlerTypeName = names.size() == 1
                ? names.iterator().next()
                : null;
            array.add(fieldHandlerVtableJson(
                entry.getValue(),
                fieldCount,
                handlerTypeName,
                handlerTypeName == null ? null : handlerTypeSources.get(entry.getKey()),
                fieldsByVtable.getOrDefault(entry.getKey(), Collections.emptyList())));
        }
        return array;
    }

    private JsonObject fieldHandlerVtableJson(
        Address address,
        int fieldCount,
        String handlerTypeName,
        String handlerTypeSource,
        List<FieldCall> fields) {

        JsonObject object = new JsonObject();
        object.addProperty("address", formatAddress(address));
        object.addProperty("fieldCount", fieldCount);
        NetworkSchemaJson.add(object, "handlerTypeName", handlerTypeName);
        NetworkSchemaJson.add(object, "handlerTypeSource", handlerTypeSource);
        HandlerContainerTypeEvidence handlerContainerType =
            handlerContainerTypeEvidence(handlerTypeName, handlerTypeSource);
        if (handlerContainerType != null) {
            object.add("handlerContainerType", handlerContainerType.toJson());
        }
        FieldHandlerShape shape = fieldHandlerShape(address);
        if (shape != null) {
            object.addProperty("handlerKind", shape.kind);
            NetworkSchemaJson.add(object, "handlerKindSource", shape.kindSource);
            object.addProperty("vtableSlots", shape.vtableSlots);
            object.addProperty("physicalFieldCount", shape.physicalFieldCount);
        }

        JsonArray slots = new JsonArray();
        Address marshal = null;
        Address marshalTarget = null;
        Address unmarshal = null;
        Address unmarshalTarget = null;
        int slotCount = shape == null
            ? FIELD_HANDLER_CONTAINER_VTABLE_SLOTS
            : shape.vtableSlots;
        for (int slot = 0; slot < slotCount; slot++) {
            Address target = readPointer(address.add(slot * 8L));
            if (target == null || !isExecutableAddress(target)) {
                continue;
            }
            String name = slot < FIELD_HANDLER_SLOT_NAMES.length
                ? FIELD_HANDLER_SLOT_NAMES[slot]
                : null;
            slots.add(virtualFunctionSlot(slot, name, target));
            if (slot == FIELD_HANDLER_MARSHAL_SLOT) {
                marshal = target;
                marshalTarget = terminalJumpTarget(target);
                object.addProperty("marshal", formatAddress(marshal));
                NetworkSchemaJson.add(object, "marshalTarget", formatAddress(marshalTarget));
            }
            else if (slot == FIELD_HANDLER_UNMARSHAL_SLOT) {
                unmarshal = target;
                unmarshalTarget = terminalJumpTarget(target);
                object.addProperty("unmarshal", formatAddress(unmarshal));
                NetworkSchemaJson.add(object, "unmarshalTarget", formatAddress(unmarshalTarget));
            }
        }
        ContainerWireShape containerWireShape = shape == null ? null : shape.containerWireShape;
        HandlerWireShapeEvidence handlerEvidence = shape == null
            ? classifyHandlerWireShape(
                marshal,
                marshalTarget,
                unmarshal,
                unmarshalTarget)
            : shape.handlerWireEvidence;
        WireShape wireShape = shape == null
            ? handlerEvidence.selected
            : shape.wireShape;
        HandlerValueTypeRecovery valueType = containerWireShape == null
            ? consensusHandlerValueType(fields)
            : null;
        WireShape semanticValueShape = remoteServerGdeRefHandlerShape(
            address,
            wireShape,
            handlerEvidence,
            valueType,
            marshalTarget == null ? marshal : marshalTarget,
            unmarshalTarget == null ? unmarshal : unmarshalTarget);
        if (semanticValueShape != null) {
            wireShape = semanticValueShape;
        }
        if (wireShape != null && wireShape.shape != null) {
            object.addProperty("wireShape", wireShape.shape);
            object.addProperty("wireShapeSource", wireShape.source);
        }
        if (wireShape != null && wireShape.layout != null) {
            object.addProperty("wireLayout", wireShape.layout);
            object.addProperty("wireLayoutSource", wireShape.layoutSource);
        }
        if (handlerEvidence != null) {
            object.add("wireShapeEvidence", handlerWireShapeEvidenceJson(handlerEvidence));
            if (handlerEvidence.selectedSequence != null) {
                object.add(
                    "fixedSequenceShape",
                    handlerEvidence.selectedSequence.toJson(addressFormatter));
            }
        }
        if (containerWireShape != null) {
            if (containerWireShape.deltaShape != null) {
                NetworkSchemaJson.add(
                    object,
                    "deltaWireShape",
                    containerWireShape.deltaShape.shape);
                NetworkSchemaJson.add(
                    object,
                    "deltaWireLayout",
                    containerWireShape.deltaShape.layout);
            }
            if (containerWireShape.fullShape != null) {
                NetworkSchemaJson.add(
                    object,
                    "fullWireShape",
                    containerWireShape.fullShape.shape);
                NetworkSchemaJson.add(
                    object,
                    "fullWireLayout",
                    containerWireShape.fullShape.layout);
            }
            NetworkSchemaJson.add(object, "keyNativeType", containerWireShape.keyNativeType);
            NetworkSchemaJson.add(object, "keyNativeTypeSource", containerWireShape.keyNativeTypeSource);
            object.add(
                "deltaMarshalShapes",
                NetworkSchemaJson.stringArray(
                    provenWireShapes(containerWireShape.deltaMarshalEvidence)));
            object.add(
                "fullMarshalShapes",
                NetworkSchemaJson.stringArray(
                    provenWireShapes(containerWireShape.fullMarshalEvidence)));
            object.add(
                "deltaMarshalLayouts",
                NetworkSchemaJson.stringArray(
                    wireLayouts(containerWireShape.deltaMarshalEvidence)));
            object.add(
                "fullMarshalLayouts",
                NetworkSchemaJson.stringArray(
                    wireLayouts(containerWireShape.fullMarshalEvidence)));
            if (containerWireShape.fullContainerPlan != null) {
                object.add(
                    "fullContainerPlan",
                    containerWireShape.fullContainerPlan.toJson(addressFormatter));
            }
            if (!containerWireShape.fullContainerPlanDiagnostics.isEmpty()) {
                JsonArray diagnostics = new JsonArray();
                for (ContainerPlanDiagnostic diagnostic :
                        containerWireShape.fullContainerPlanDiagnostics) {
                    diagnostics.add(diagnostic.toJson(addressFormatter));
                }
                object.add("fullContainerPlanDiagnostics", diagnostics);
            }
            if (containerWireShape.valueTypeInfo != null) {
                object.add(
                    "valueTypeInfo",
                    containerWireShape.valueTypeInfo.toJson(addressFormatter));
                NetworkSchemaJson.add(object, "valueTypeName", containerWireShape.valueTypeInfo.name);
                NetworkSchemaJson.add(object, "valueTypeId", containerWireShape.valueTypeInfo.typeId);
                NetworkSchemaJson.add(object, "valueTypeSource", containerWireShape.valueTypeInfo.source);
                NetworkSchemaJson.add(
                    object,
                    "valueTypeNameSource",
                    containerWireShape.valueTypeInfo.nameSource);
                NetworkSchemaJson.add(object, "valueTypeInfoAddress", formatAddress(containerWireShape.valueTypeInfo.address));
            }
            if (containerWireShape.valueTypeShape != null) {
                object.add(
                    "valueTypeShape",
                    containerWireShape.valueTypeShape.toJson(addressFormatter));
            }
            if (!containerWireShape.embeddedValueTypeShapes.isEmpty()) {
                JsonArray shapes = new JsonArray();
                for (NestedTypeShape embeddedShape : containerWireShape.embeddedValueTypeShapes) {
                    shapes.add(embeddedShape.toJson(addressFormatter));
                }
                object.add("embeddedValueTypeShapes", shapes);
            }
            if (!containerWireShape.valueTypeInfoCandidates.isEmpty()) {
                JsonArray candidates = new JsonArray();
                for (NativeTypeInfoEvidence candidate : containerWireShape.valueTypeInfoCandidates) {
                    candidates.add(candidate.toJson(addressFormatter));
                }
                object.add("valueTypeInfoCandidates", candidates);
            }
        }
        else {
            if (valueType != null) {
                object.add("valueTypeShape", valueType.typeShape().toJson(addressFormatter));
                if (valueType.typeInfo() != null) {
                    object.add("valueTypeInfo", valueType.typeInfo().toJson(addressFormatter));
                    NetworkSchemaJson.add(object, "valueTypeName", valueType.typeInfo().name);
                    NetworkSchemaJson.add(object, "valueTypeId", valueType.typeInfo().typeId);
                    NetworkSchemaJson.add(object, "valueTypeSource", valueType.typeInfo().source);
                    NetworkSchemaJson.add(
                        object,
                        "valueTypeNameSource",
                        valueType.typeInfo().nameSource);
                    NetworkSchemaJson.add(
                        object,
                        "valueTypeInfoAddress",
                        formatAddress(valueType.typeInfo().address));
                }
            }
        }
        object.add("vtableDiagnostics", vtableDiagnostics(
            address,
            shape,
            slotCount,
            null));
        object.add("slots", slots);
        return object;
    }

    private JsonObject handlerWireShapeEvidenceJson(HandlerWireShapeEvidence evidence) {
        JsonObject object = new JsonObject();
        NetworkSchemaJson.add(object, "resolution", evidence.resolution);
        NetworkSchemaJson.add(object, "conflict", evidence.conflict);
        NetworkSchemaJson.add(
            object,
            "unmarshalReadBufferParameter",
            evidence.unmarshalReadBufferParameter);
        if (evidence.unmarshalEventCount != null) {
            object.addProperty("unmarshalEventCount", evidence.unmarshalEventCount);
        }
        NetworkSchemaJson.add(
            object,
            "unmarshalDiagnostic",
            evidence.unmarshalDiagnostic);
        NetworkSchemaJson.add(
            object,
            "quantizedVec3Diagnostic",
            evidence.quantizedVec3Diagnostic);
        if (!evidence.unmarshalEvents.isEmpty()) {
            JsonArray events = new JsonArray();
            for (CodecWireEvent event : evidence.unmarshalEvents) {
                JsonObject value = new JsonObject();
                NetworkSchemaJson.add(value, "nativeType", event.nativeType());
                NetworkSchemaJson.add(value, "shape", event.wireEvidence().shape);
                NetworkSchemaJson.add(value, "layout", event.wireEvidence().layout);
                NetworkSchemaJson.add(value, "source", event.wireEvidence().source);
                NetworkSchemaJson.add(value, "layoutSource", event.wireEvidence().layoutSource);
                NetworkSchemaJson.add(value, "callsite", formatAddress(event.callsite()));
                NetworkSchemaJson.add(value, "target", formatAddress(event.target()));
                NetworkSchemaJson.add(value, "targetName", event.targetName());
                events.add(value);
            }
            object.add("unmarshalEvents", events);
        }
        addDirectionalWireShape(object, "marshal", evidence.marshal);
        addDirectionalWireShape(object, "unmarshal", evidence.unmarshal);
        if (evidence.marshalSequence != null) {
            object.add(
                "marshalFixedSequence",
                evidence.marshalSequence.toJson(addressFormatter));
        }
        if (evidence.unmarshalSequence != null) {
            object.add(
                "unmarshalFixedSequence",
                evidence.unmarshalSequence.toJson(addressFormatter));
        }
        return object;
    }

    private void addDirectionalWireShape(
        JsonObject object,
        String direction,
        WireShape shape) {

        if (shape == null) {
            return;
        }
        JsonObject value = new JsonObject();
        NetworkSchemaJson.add(value, "shape", shape.shape);
        NetworkSchemaJson.add(value, "source", shape.source);
        NetworkSchemaJson.add(value, "layout", shape.layout);
        NetworkSchemaJson.add(value, "layoutSource", shape.layoutSource);
        object.add(direction, value);
    }

    private FieldHandlerShape fieldHandlerShape(Address vtable) {
        if (!isProgramAddress(vtable)) {
            return null;
        }

        String key = addressCacheKey("field-handler-shape", vtable);
        if (fieldHandlerShapeCache.containsKey(key)) {
            return fieldHandlerShapeCache.get(key);
        }

        FieldHandlerShape result = recoverFieldHandlerShape(vtable);
        fieldHandlerShapeCache.put(key, result);
        return result;
    }

    private FieldHandlerShape recoverFieldHandlerShape(Address vtable) {
        String handlerTypeName = fieldHandlerTypeName(null, vtable);
        NetworkTemplateType handlerType = parseNetworkTemplateType(handlerTypeName);

        ContainerWireShape container = classifyReplicatedContainerWireShape(vtable);
        if (container != null) {
            return new FieldHandlerShape(
                "replicated-container",
                "self-vtable-slot14-slot15-dispatch",
                FIELD_HANDLER_CONTAINER_VTABLE_SLOTS,
                container.primaryShape,
                container,
                null,
                1);
        }

        Address marshal = readPointer(vtable.add(FIELD_HANDLER_MARSHAL_SLOT * 8L));
        Address marshalTarget = terminalJumpTarget(marshal);
        Address unmarshal = readPointer(vtable.add(FIELD_HANDLER_UNMARSHAL_SLOT * 8L));
        Address unmarshalTarget = terminalJumpTarget(unmarshal);
        HandlerWireShapeEvidence wireEvidence = classifyHandlerWireShape(
            marshal,
            marshalTarget,
            unmarshal,
            unmarshalTarget);
        return new FieldHandlerShape(
            fieldHandlerKindFromType(handlerType),
            handlerType == null ? null : "ghidra-handler-template-type",
            FIELD_HANDLER_SCALAR_VTABLE_SLOTS,
            wireEvidence.selected,
            null,
            wireEvidence,
            1);
    }

    private String fieldHandlerKindFromType(NetworkTemplateType type) {
        if (type == null) {
            return "replicated-field";
        }
        if (type.simpleName.equals("DeltaCompressedReplicatedFieldHandler") ||
            type.simpleName.equals("DeltaCompressedReplicatedFieldHandlerBase") ||
            type.simpleName.equals("DeltaCompressedCounterHandler")) {
            return "delta-compressed-replicated-field";
        }
        if (type.simpleName.equals("DynamicDeltaReplicatedFieldHandler")) {
            return "dynamic-delta-replicated-field";
        }
        if (type.simpleName.equals("FloatTimerDeltaReplicatedField")) {
            return "float-timer-delta-replicated-field";
