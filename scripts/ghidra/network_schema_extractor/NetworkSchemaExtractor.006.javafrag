    private void observePcodeTempUnmarshal(
        Map<String, String> tempNativeTypes,
        PcodeOp op,
        String nativeType) {

        observePcodeTempUnmarshal(tempNativeTypes, null, op, nativeType, null);
    }

    private void observePcodeTempUnmarshal(
        Map<String, String> tempNativeTypes,
        Map<String, String> tempWireShapes,
        PcodeOp op,
        String nativeType,
        String wireShape) {

        boolean hasNativeType = nativeType != null && !nativeType.isEmpty();
        boolean hasWireShape = wireShape != null && !wireShape.isEmpty();
        if (tempNativeTypes == null || (!hasNativeType && !hasWireShape) ||
            op == null || op.getOpcode() != PcodeOp.CALL) {
            return;
        }
        if (hasNativeType && wireShapeFromNativeType(nativeType) != null) {
            PcodeStorage scalarOutput = pcodeScalarUnmarshalOutputStorage(op, nativeType);
            if (scalarOutput == null) {
                scalarOutput = provenUnmarshalOutputStorage(op);
            }
            putPcodeTempUnmarshalRange(
                tempNativeTypes,
                tempWireShapes,
                scalarOutput,
                nativeType,
                wireShape);
            return;
        }
        PcodeStorage storage = provenUnmarshalOutputStorage(op);
        putPcodeTempUnmarshal(
            tempNativeTypes,
            tempWireShapes,
            storage,
            nativeType,
            wireShape);
    }

    private void putPcodeTempUnmarshal(
        Map<String, String> tempNativeTypes,
        Map<String, String> tempWireShapes,
        PcodeStorage storage,
        String nativeType,
        String wireShape) {

        if (!isPcodeLocalTempStorage(storage)) {
            return;
        }
        String key = storageKey(storage);
        if (nativeType != null && !nativeType.isEmpty()) {
            tempNativeTypes.put(key, nativeType);
        }
        if (tempWireShapes != null && wireShape != null && !wireShape.isEmpty()) {
            tempWireShapes.put(key, wireShape);
        }
    }

    private void putPcodeTempUnmarshalRange(
        Map<String, String> tempNativeTypes,
        Map<String, String> tempWireShapes,
        PcodeStorage storage,
        String nativeType,
        String wireShape) {

        if (!isPcodeLocalTempStorage(storage)) {
            return;
        }
        Integer width = nativeTypeByteWidth(nativeType);
        if (width == null) {
            width = wireShapeByteWidth(wireShape);
        }
        if (width == null || width <= 0 || width > 64) {
            putPcodeTempUnmarshal(
                tempNativeTypes,
                tempWireShapes,
                storage,
                nativeType,
                wireShape);
            return;
        }
        for (int byteOffset = 0; byteOffset < width; byteOffset++) {
            putPcodeTempUnmarshal(
                tempNativeTypes,
                tempWireShapes,
                storage.plus(byteOffset),
                nativeType,
                wireShape);
        }
    }

    private PcodeStorage provenUnmarshalOutputStorage(PcodeOp op) {
        if (op == null || op.getOpcode() != PcodeOp.CALL || op.getSeqnum() == null) {
            return null;
        }
        Function target = pcodeCallTarget(op);
        Integer outputSlot = unmarshalOutputParameterSlot(target);
        Function owner = functionContaining(op.getSeqnum().getTarget());
        return outputSlot == null
            ? null
            : provenCallArgumentStorage(owner, op, target, outputSlot);
    }

    private PcodeStorage nestedDirectTypeCallOutputStorage(
        Function owner,
        PcodeOp op,
        NestedTypeShape shape,
        Map<String, PcodeStorage> callerParamStorage) {

        if (op == null || shape == null || shape.memberBase == null) {
            return translatedAbsoluteHelperStorage(
                provenUnmarshalOutputStorage(op),
                callerParamStorage);
        }

        Map<String, PcodeStorage> arguments =
            callArgumentStorageMap(owner, op, callerParamStorage);
        PcodeStorage storage = arguments.get(shape.memberBase);
        if (storage == null && "this".equals(shape.memberBase)) {
            storage = arguments.get("param_1");
        }
        if (storage != null) {
            return storage;
        }

        Integer parameterIndex = pcodeParameterIndex(shape.memberBase);
        if (parameterIndex != null && parameterIndex > 0) {
            storage = provenCallArgumentStorage(
                owner,
                op,
                pcodeCallTarget(op),
                parameterIndex);
            storage = translatedAbsoluteHelperStorage(storage, callerParamStorage);
            if (storage != null) {
                return storage;
            }
        }

        return translatedAbsoluteHelperStorage(
            provenUnmarshalOutputStorage(op),
            callerParamStorage);
    }

    private NestedDirectTypeCallShape recoverNestedDirectTypeCallShape(
        Function owner,
        PcodeOp op,
        Function target,
        String nativeType) {

        return recoverNestedDirectTypeCallShape(
            owner,
            op,
            target,
            nativeType,
            Collections.emptyMap());
    }

    private NestedDirectTypeCallShape recoverNestedDirectTypeCallShape(
        Function owner,
        PcodeOp op,
        Function target,
        String nativeType,
        Map<String, PcodeStorage> callerParamStorage) {

        if (owner == null || op == null || target == null || nativeType == null) {
            return null;
        }

        String targetName = fullFunctionName(target);
        String typeName = firstNonEmpty(
            directUnmarshalValueTypeName(target),
            nativeType);
        if (typeName == null || wireShapeFromNativeType(typeName) != null) {
            return null;
        }

        HighFunction high = highFunction(target);
        if (high == null) {
            return null;
        }

        NestedTypeShape semanticShape = recoverNestedDirectTypeShape(
            target,
            typeName);
        if (semanticShape != null && !semanticShape.members.isEmpty()) {
            PcodeStorage semanticStorage = nestedDirectTypeCallOutputStorage(
                owner,
                op,
                semanticShape,
                callerParamStorage);
            if (semanticStorage != null) {
                return new NestedDirectTypeCallShape(
                    semanticStorage,
                    copyNestedTypeShape(semanticShape));
            }
        }

        LinkedHashMap<String, LinkedHashMap<Long, NestedTypeMember>> byBase =
            nestedDirectTypeMemberCandidates(target, high);
        if (byBase.isEmpty()) {
            return null;
        }

        Map<String, PcodeStorage> arguments =
            callArgumentStorageMap(owner, op, callerParamStorage);
        return translatedNestedDirectTypeCallShape(
            typeName,
            target,
            targetName,
            byBase,
            arguments);
    }

    private LinkedHashMap<String, LinkedHashMap<Long, NestedTypeMember>>
        nestedDirectTypeMemberCandidates(Function target, HighFunction high) {

        LinkedHashMap<String, LinkedHashMap<Long, NestedTypeMember>> byBase =
            new LinkedHashMap<>();
        if (target == null || high == null) {
            return byBase;
        }

        HashMap<String, String> tempNativeTypes = new HashMap<>();
        HashMap<String, String> tempWireShapes = new HashMap<>();
        for (PcodeOpAST op : orderedPcodeOps(high)) {
            if (op.getOpcode() == PcodeOp.CALL) {
                Function callTarget = pcodeCallTarget(op);
                RawPcodeWrite rawWrite = pcodeReadRawWrite(op, callTarget);
                if (rawWrite != null) {
                    addNestedTypeMemberCandidate(
                        byBase,
                        rawWrite.storage,
                        rawWrite.nativeType,
                        rawWrite.wireEvidence,
                        op,
                        callTarget,
                        "pcode-multi-output-readraw-fixed-bytes");
                    markNestedTypeMemberWireOrder(
                        byBase,
                        rawWrite.storage,
                        "cfg-call-order");
                    continue;
                }
                if (callTarget != null && isReadRawFunction(callTarget)) {
                    recordNestedTypeShapeReject(
                        "readraw-output-storage-unresolved:" +
                            formatAddress(target.getEntryPoint()) + ":" +
                            formatAddress(op.getSeqnum().getTarget()));
                }


                NestedTypeShape nestedMemberShape =
                    recoverNestedDirectMemberShape(target, callTarget);
                PcodeStorage storage = nestedMemberShape == null
                    ? provenUnmarshalOutputStorage(op)
                    : nestedDirectTypeCallOutputStorage(
                        target,
                        op,
                        nestedMemberShape,
                        Collections.emptyMap());
                if (nestedMemberShape != null &&
                    addNestedDirectTypeMemberCandidates(
                        byBase,
                        storage,
                        nestedMemberShape,
                        op,
                        callTarget,
                        "pcode-multi-output-nested-direct-type-call")) {
                    continue;
                }

                String memberType = unmarshalNativeTypeFromTarget(callTarget);
                WireShape memberWireEvidence =
                    wireShapeEvidenceFromUnmarshalTarget(callTarget, memberType);
                if (memberType == null) {
                    memberType = scalarOutputStoreNativeType(callTarget);
                }
                observePcodeTempUnmarshal(
                    tempNativeTypes,
                    tempWireShapes,
                    op,
                    memberType,
                    memberWireEvidence == null ? null : memberWireEvidence.shape);
                addNestedTypeMemberCandidate(
                    byBase,
                    storage,
                    memberType,
                    memberWireEvidence,
                    op,
                    callTarget,
                    "pcode-multi-output-call");
                markNestedTypeMemberWireOrder(byBase, storage, "cfg-call-order");
                continue;
            }
            if (op.getOpcode() != PcodeOp.STORE || op.getNumInputs() < 3) {
                continue;
            }
            PcodeStorage storage = pcodeStorageExpression(op.getInput(1));
            String memberType = pcodeValueNativeType(op.getInput(2), tempNativeTypes);
            PcodeCallTargetInfo valueTarget = pcodeValueCallTargetInfo(op.getInput(2));
            WireShape memberWireEvidence = pcodeStoredValueWireEvidence(
                op.getInput(2),
                tempWireShapes,
                tempNativeTypes,
                valueTarget,
                memberType);
            addNestedTypeMemberCandidate(
                byBase,
                storage,
                memberType,
                memberWireEvidence,
                op,
                valueTarget == null ? null : valueTarget.target,
                "pcode-multi-output-store");
            markNestedTypeMemberWireOrder(byBase, storage, "cfg-store-order");
        }
        return byBase;
    }

    private NestedDirectTypeCallShape translatedNestedDirectTypeCallShape(
        String typeName,
        Function target,
        String targetName,
        Map<String, LinkedHashMap<Long, NestedTypeMember>> byBase,
        Map<String, PcodeStorage> arguments) {

        if (typeName == null || target == null || byBase == null ||
            byBase.isEmpty() || arguments == null || arguments.isEmpty()) {
            return null;
        }

        LinkedHashMap<String, LinkedHashMap<Long, NestedTypeMember>> translated =
            new LinkedHashMap<>();
        for (Map.Entry<String, LinkedHashMap<Long, NestedTypeMember>> entry :
            byBase.entrySet()) {
            if (!isProvenOutputParameterBase(target, entry.getKey())) {
                continue;
            }
            PcodeStorage argumentStorage = arguments.get(entry.getKey());
            if (argumentStorage == null) {
                continue;
            }
            LinkedHashMap<Long, NestedTypeMember> members =
                translated.computeIfAbsent(
                    argumentStorage.base,
                    ignored -> new LinkedHashMap<>());
            for (NestedTypeMember member : entry.getValue().values()) {
                NestedTypeMember copy = copyNestedTypeMember(member);
                copy.offset = argumentStorage.offset + member.offset;
                members.put(copy.offset, copy);
            }
        }

        NestedDirectTypeCallShape selected = null;
        int matches = 0;
        for (Map.Entry<String, LinkedHashMap<Long, NestedTypeMember>> entry :
            translated.entrySet()) {
            ArrayList<NestedTypeMember> members =
                new ArrayList<>(entry.getValue().values());
            members.sort((left, right) -> Long.compare(left.offset, right.offset));
            if (!isTranslatedDirectTypeMemberShape(members)) {
                continue;
            }
            matches++;
            long baseOffset = members.get(0).offset;
            for (int i = 0; i < members.size(); i++) {
                NestedTypeMember member = members.get(i);
                member.index = i;
                member.name = "_" + i;
                member.offset -= baseOffset;
                member.nativeOffset = member.offset;
            }

            NestedTypeShape shape = new NestedTypeShape();
            shape.typeName = NetworkSchemaText.sourceTypeLeaf(typeName);
            shape.typeNameFull = typeName;
            shape.typeNameSource = "ghidra-symbol";
            shape.function = target.getEntryPoint();
            shape.functionName = targetName;
            shape.memberBase = entry.getKey();
            shape.memberNameSource = "synthetic-offset";
            shape.memberNamesProven = false;
            shape.layoutProven = true;
            shape.validation = "layout-consistent-parameter-direct-type";
            shape.members.addAll(members);
            NestedTypeShape wireSequence = directWireSequenceShape(
                target,
                typeName,
                targetName);
            sameNestedWireSequence(shape, wireSequence);
            applyNestedTypeMemberNames(shape);
            selected = new NestedDirectTypeCallShape(
                new PcodeStorage(entry.getKey(), baseOffset),
                shape);
        }
        if (matches != 1) {
            return null;
        }
        return selected;
    }

    private boolean isTranslatedDirectTypeMemberShape(List<NestedTypeMember> members) {
        if (members == null || members.size() < 2 ||
            members.size() > NESTED_DIRECT_TYPE_MEMBER_LIMIT) {
            return false;
        }
        for (int i = 0; i < members.size(); i++) {
            NestedTypeMember member = members.get(i);
            if (member == null ||
                Boolean.TRUE.equals(member.typeConflict) ||
                member.offset < 0 ||
                member.wireLayout == null) {
                return false;
            }
            if (i + 1 >= members.size()) {
                continue;
            }
            if (member.byteWidth == null || member.byteWidth <= 0) {
                return false;
            }
            long end = member.offset + member.byteWidth;
            if (end > members.get(i + 1).offset || end > 0x400) {
                return false;
            }
        }
        return members.get(members.size() - 1).offset <= 0x400;
    }

    private NestedTypeMember copyNestedTypeMember(NestedTypeMember source) {
        NestedTypeMember copy = new NestedTypeMember();
        copy.index = source.index;
        copy.offset = source.offset;
        copy.nativeOffset = source.nativeOffset;
        copy.name = source.name;
        copy.nameSource = source.nameSource;
        copy.nameProven = source.nameProven;
        copy.nameEvidence = source.nameEvidence;
        copy.nativeType = source.nativeType;
        copy.typeId = source.typeId;
        copy.typeIdSource = source.typeIdSource;
        copy.typeIdentityProven = source.typeIdentityProven;
        copy.typeIdentitySource = source.typeIdentitySource;
        copy.wireShape = source.wireShape;
        copy.wireShapeSource = source.wireShapeSource;
        copy.wireLayout = source.wireLayout;
        copy.wireLayoutSource = source.wireLayoutSource;
        copy.byteWidth = source.byteWidth;
        copy.wireOrdinal = source.wireOrdinal;
        copy.wireOrderSource = source.wireOrderSource;
        copy.callsite = source.callsite;
        copy.target = source.target;
        copy.targetName = source.targetName;
        copy.typeConflict = source.typeConflict;
        return copy;
    }

    private Integer pcodeParameterIndex(String parameterName) {
        if (parameterName == null || !parameterName.startsWith("param_")) {
            return null;
        }
        try {
            return Integer.parseInt(parameterName.substring("param_".length()));
        }
        catch (NumberFormatException ignored) {
            return null;
        }
    }

    private void attachNestedDirectTypeShape(
        FieldCall field,
        Function target,
        String nativeType) {

        if (field == null || target == null || nativeType == null) {
            return;
        }
        NestedTypeShape shape = recoverNestedDirectTypeShape(target, nativeType);
        if (shape != null) {
            applyNestedTypeShapeToField(
                field,
                shape,
                "message-unmarshal-pcode-nested-direct-type-shape");
        }
    }

    private void applyNestedTypeShapeToField(
        FieldCall field,
        NestedTypeShape shape,
        String wireShapeSource) {

        if (field == null || shape == null) {
            return;
        }
        enrichKnownSerializeIdentity(shape);
        if (field.nestedTypeShape == null) {
            field.nestedTypeShape = shape;
        }
        field.sourceTypeName = appendDistinctType(
            field.sourceTypeName,
            field.nativeType);
        field.sourceTypeName = appendDistinctType(
            field.sourceTypeName,
            shape.typeNameFull);
        String shapeWire = provenNestedTypeIdentityWireShape(shape);
        if (shapeWire == null) {
            shapeWire = wireShapeFromNestedTypeShape(shape);
        }
        String shapeLayout = wireLayoutFromNestedTypeShape(shape);
        if (shapeLayout != null &&
            (field.wireLayout == null || field.wireLayout.equals(shapeLayout))) {
            field.wireLayout = shapeLayout;
            field.wireLayoutSource = wireShapeSource;
        }
        if (shapeWire != null &&
            (field.wireShape == null || field.wireShape.equals(shapeWire))) {
            field.wireShape = shapeWire;
            field.wireShapeSource = wireShapeSource;
        }
    }

    private String provenNestedTypeIdentityWireShape(NestedTypeShape shape) {
        if (shape == null || !Boolean.TRUE.equals(shape.identityProven) ||
            !Boolean.TRUE.equals(shape.memberCoverageProven) ||
            !Boolean.TRUE.equals(shape.wireOrderProven)) {
            return null;
        }
        return wireShapeFromNativeType(firstNonEmpty(
            shape.typeNameFull,
            shape.typeName));
    }

    private void applyMessageFieldWireShape(
        FieldCall field,
        String wireShape,
        String source) {

        if (field == null || wireShape == null || wireShape.isEmpty()) {
            return;
        }
        if (field.wireShape == null || field.wireShape.equals(wireShape)) {
            field.wireShape = wireShape;
            field.wireShapeSource = source;
        }
    }

    private String wireShapeFromNestedTypeShape(NestedTypeShape shape) {
        if (shape == null || shape.members.isEmpty()) {
            return null;
        }
        ArrayList<String> memberShapes = new ArrayList<>();
        for (NestedTypeMember member : shape.members) {
            if (member == null ||
                Boolean.TRUE.equals(member.typeConflict) ||
                member.wireShape == null ||
                member.wireShape.isEmpty()) {
                return null;
            }
            memberShapes.add(member.wireShape);
        }
        return compositeWireShape(memberShapes);
    }

    private String wireLayoutFromNestedTypeShape(NestedTypeShape shape) {
        if (shape == null || !Boolean.TRUE.equals(shape.memberCoverageProven) ||
            !Boolean.TRUE.equals(shape.wireOrderProven)) {
            return null;
        }
        List<NestedTypeMember> members = provenWireOrderedMembers(shape.members);
        if (members == null || members.isEmpty()) {
            return null;
        }
        ArrayList<String> layouts = new ArrayList<>(members.size());
        for (NestedTypeMember member : members) {
            WireShape evidence = nestedMemberWireEvidence(member);
            String layout = evidence == null
                ? null
                : firstNonEmpty(evidence.layout, evidence.shape);
            if (layout == null || canonicalLayoutWireShape(layout) == null) {
                return null;
            }
            layouts.add(layout);
        }
        return layouts.size() == 1
            ? canonicalLayoutWireShape(layouts.get(0))
            : compositeWireShape(layouts);
    }

    /**
     * Every proven spelling of a nested shape's product. The semantic variant
     * demands a wire shape on every member; the layout variant instead demands
     * proven member coverage and wire order, so a shape whose members only
     * carry layouts (raw ReadRaw limbs, call-frame callee outputs) still yields
     * a product. Callers that only need to know which of two candidate products
     * the nested shape actually proves should match against all spellings.
     */
    private List<String> provenNestedTypeProducts(NestedTypeShape shape) {
        LinkedHashSet<String> products = new LinkedHashSet<>();
        String semantic = wireShapeFromNestedTypeShape(shape);
        if (semantic != null) {
            products.add(semantic);
        }
        String layout = wireLayoutFromNestedTypeShape(shape);
        if (layout != null) {
            products.add(layout);
        }
        return new ArrayList<>(products);
    }

    private boolean matchesAnyCodecProduct(String product, List<String> candidates) {
        if (product == null || candidates == null) {
            return false;
        }
        for (String candidate : candidates) {
            if (compatibleCodecProducts(product, candidate)) {
                return true;
            }
        }
        return false;
    }

    private NestedTypeShape recoverNestedDirectTypeShape(
        Function target,
        String nativeType) {

        return recoverNestedDirectTypeShape(target, nativeType, false);
    }

    private NestedTypeShape recoverNestedDirectTypeShape(
        Function target,
        String nativeType,
        boolean allowAnonymousHelper) {

        if (target == null || (!allowAnonymousHelper && nativeType == null)) {
            return null;
        }
        String key = functionCacheKey(
            "nested-direct-type-shape:" + allowAnonymousHelper + ":" + nativeType,
            target);
        if (nestedTypeShapeCache.containsKey(key)) {
            return nestedTypeShapeCache.get(key);
        }
        if (!nestedTypeShapeActive.add(key)) {
            recordNestedTypeShapeReject("cycle");
            return null;
        }

        try {
            NestedTypeShape shape = recoverNestedDirectTypeShapeUncached(
                target,
                nativeType,
                allowAnonymousHelper);
            nestedTypeShapeCache.put(key, shape);
            if (shape == null) {
                nestedTypeShapeFailures++;
            }
            else {
                nestedTypeShapesRecovered++;
            }
            return shape;
        }
        finally {
            nestedTypeShapeActive.remove(key);
        }
    }

    private NestedTypeShape recoverNestedDirectTypeShapeUncached(
        Function target,
        String nativeType,
        boolean allowAnonymousHelper) {

        if (target == null) {
            return null;
        }

        String targetName = fullFunctionName(target);
        String owner = firstNonEmpty(
            directUnmarshalValueTypeName(target),
            nativeType);
        if (owner == null && !allowAnonymousHelper) {
            recordNestedTypeShapeReject("target-not-direct-unmarshal");
            return null;
        }
        HighFunction high = highFunction(target);
        if (high == null) {
            recordNestedTypeShapeReject("decompile-failed");
            return null;
        }

        NestedTypeShape delegated = directDelegatedUnmarshalShape(target, high);
        if (delegated != null) {
            return delegated;
        }

        LinkedHashMap<String, LinkedHashMap<Long, NestedTypeMember>> byBase =
            new LinkedHashMap<>();
        HashMap<String, String> tempNativeTypes = new HashMap<>();
        HashMap<String, String> tempWireShapes = new HashMap<>();
        for (PcodeOpAST op : orderedPcodeOps(high)) {
            if (op.getOpcode() == PcodeOp.CALL) {
                Function callTarget = pcodeCallTarget(op);
                RawPcodeWrite rawWrite = pcodeReadRawWrite(op, callTarget);
                if (rawWrite != null) {
                    addNestedTypeMemberCandidate(
                        byBase,
                        rawWrite.storage,
                        rawWrite.nativeType,
                        rawWrite.wireEvidence,
                        op,
                        callTarget,
                        "pcode-readraw-fixed-bytes");
                    markNestedTypeMemberWireOrder(
                        byBase,
                        rawWrite.storage,
                        "cfg-call-order");
                    continue;
                }
                NestedTypeShape nestedMemberShape = recoverNestedDirectMemberShape(
                    target,
                    callTarget);
                PcodeStorage storage = nestedMemberShape == null
                    ? provenUnmarshalOutputStorage(op)
                    : nestedDirectTypeCallOutputStorage(
                        target,
                        op,
                        nestedMemberShape,
                        Collections.emptyMap());
                if (nestedMemberShape != null &&
                    addNestedDirectTypeMemberCandidates(
                        byBase,
                        storage,
                        nestedMemberShape,
                        op,
                        callTarget,
                        "pcode-nested-direct-type-call")) {
                    continue;
                }
                String memberType = unmarshalNativeTypeFromTarget(callTarget);
                WireShape memberWireEvidence =
                    wireShapeEvidenceFromUnmarshalTarget(callTarget, memberType);
                if (memberType == null) {
                    memberType = scalarOutputStoreNativeType(callTarget);
                }
                observePcodeTempUnmarshal(
                    tempNativeTypes,
                    tempWireShapes,
                    op,
                    memberType,
                    memberWireEvidence == null ? null : memberWireEvidence.shape);
                addNestedTypeMemberCandidate(
                    byBase,
                    storage,
                    memberType,
                    memberWireEvidence,
                    op,
                    callTarget,
                    "pcode-call");
                markNestedTypeMemberWireOrder(byBase, storage, "cfg-call-order");
                continue;
            }
            if (op.getOpcode() != PcodeOp.STORE || op.getNumInputs() < 3) {
                continue;
            }
            PcodeStorage storage = pcodeStorageExpression(op.getInput(1));
            String memberType = pcodeValueNativeType(op.getInput(2), tempNativeTypes);
            PcodeCallTargetInfo valueTarget = pcodeValueCallTargetInfo(op.getInput(2));
            WireShape memberWireEvidence = pcodeStoredValueWireEvidence(
                op.getInput(2),
                tempWireShapes,
                tempNativeTypes,
                valueTarget,
                memberType);
            addNestedTypeMemberCandidate(
                byBase,
                storage,
                memberType,
                memberWireEvidence,
                op,
                valueTarget == null ? null : valueTarget.target,
                "pcode-store");
            markNestedTypeMemberWireOrder(byBase, storage, "cfg-store-order");
        }

        NestedTypeShape storageShape = directTypeShapeFromCandidates(
            owner,
            target,
            targetName,
            byBase,
            allowAnonymousHelper && owner == null);
        NestedTypeShape wireSequenceShape = directWireSequenceShape(
            target,
            owner,
            targetName);
        if (wireSequenceShape == null) {
            proveDirectTypeIdentity(storageShape, target);
            return storageShape;
        }
        if (storageShape == null) {
            proveDirectTypeIdentity(wireSequenceShape, target);
            return wireSequenceShape;
        }
        if (sameNestedWireSequenceInProvenStorageOrder(
                storageShape,
                wireSequenceShape,
                high) ||
            sameNestedWireSequence(storageShape, wireSequenceShape)) {
            proveDirectTypeIdentity(storageShape, target);
            return storageShape;
        }
        wireSequenceShape.validation = appendValidation(
            wireSequenceShape.validation,
            "typed-codec-native-storage-transform");
        proveDirectTypeIdentity(wireSequenceShape, target);
        return wireSequenceShape;
    }

    private NestedTypeShape recoverNestedDirectMemberShape(
        Function current,
        Function callTarget) {

