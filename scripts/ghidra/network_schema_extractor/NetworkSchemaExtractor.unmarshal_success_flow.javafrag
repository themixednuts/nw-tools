    private record UnmarshalFlowNode(
        PcodeBlockBasic block,
        UnmarshalStatusByte status) {
    }

    private record UnmarshalFlowEdge(
        UnmarshalFlowNode source,
        UnmarshalFlowNode target) {
    }

    private UnmarshalTerminalFlow successfulUnmarshalStateFlow(
        HighFunction high,
        String expectedResultBase,
        Set<String> active,
        int depth) {

        LinkedHashSet<String> resultBases = new LinkedHashSet<>();
        LinkedHashSet<String> provenResultBases = new LinkedHashSet<>();
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            StatusByteWrite write = unmarshalStatusByteWrite(operation);
            if (write != null) {
                resultBases.add(write.base());
                if (write.value() == UnmarshalStatusByte.SUCCESS ||
                    write.value() == UnmarshalStatusByte.FAILURE) {
                    provenResultBases.add(write.base());
                }
            }
        }
        // Output-parameter stores of computed values (e.g. *param_4 = count in
        // FilterChatResponseMsg at NewWorld+0x7d9070) look like wide status
        // writes whose ok byte is not a compile-time constant. A genuine
        // status-result base always has a constant 0/1 write on some path, so
        // prefer bases with a proven status transition when any exist.
        Set<String> candidateBases = provenResultBases.isEmpty()
            ? resultBases
            : provenResultBases;
        String resultBase = expectedResultBase;
        if (resultBase == null) {
            resultBase = candidateBases.size() == 1
                ? candidateBases.iterator().next()
                : returnedUnmarshalResultBase(high, candidateBases);
        }
        if (resultBase == null) {
            if (candidateBases.isEmpty()) {
                UnmarshalTerminalFlow transparent =
                    transparentReturnedResultUnmarshalTerminalFlow(
                        high,
                        expectedResultBase,
                        active,
                        depth);
                return transparent != null
                    ? transparent
                    : scalarReturnUnmarshalTerminalFlow(high);
            }
            return UnmarshalTerminalFlow.unresolved(
                "result-base-count:" + candidateBases.size());
        }

        Set<PcodeOpAST> delegatedSuccess = delegatedUnmarshalSuccessCalls(
            high,
            resultBase,
            active,
            depth);
        List<PcodeBlockBasic> entries = high.getBasicBlocks().stream()
            .filter(block -> NetworkSchemaControlFlow.predecessors(block).isEmpty())
            .sorted(Comparator
                .comparing(PcodeBlockBasic::getStart)
                .thenComparingInt(PcodeBlock::getIndex))
            .toList();
        if (entries.isEmpty()) {
            return UnmarshalTerminalFlow.unresolved("missing-entry-block");
        }
        boolean preconditionedSuccess = hasPreconditionedUnmarshalSuccess(
                high,
                resultBase);
        UnmarshalStatusByte initialStatus = preconditionedSuccess
            ? UnmarshalStatusByte.SUCCESS
            : UnmarshalStatusByte.UNSET;

        Map<PcodeBlockBasic, Map<PcodeBlockBasic, UnmarshalStatusByte>>
            terminalIncoming = new HashMap<>();
        LinkedHashSet<UnmarshalFlowNode> nodes = new LinkedHashSet<>();
        LinkedHashSet<UnmarshalFlowEdge> edges = new LinkedHashSet<>();
        LinkedHashSet<UnmarshalFlowNode> entryNodes = new LinkedHashSet<>();
        ArrayDeque<UnmarshalFlowNode> pending = new ArrayDeque<>();
        for (PcodeBlockBasic entry : entries) {
            UnmarshalFlowNode node = new UnmarshalFlowNode(
                entry,
                transferUnmarshalStatus(
                    high,
                    entry,
                    initialStatus,
                    null,
                    resultBase,
                    delegatedSuccess,
                    active,
                    depth,
                    preconditionedSuccess));
            entryNodes.add(node);
            if (nodes.add(node)) {
                pending.addLast(node);
            }
        }

        while (!pending.isEmpty()) {
            UnmarshalFlowNode source = pending.removeFirst();
            for (PcodeBlockBasic successor :
                    NetworkSchemaControlFlow.successors(source.block())) {
                UnmarshalStatusByte edgeStatus = incomingUnmarshalStatusForEdge(
                    high,
                    source.block(),
                    successor,
                    resultBase,
                    terminalIncoming);
                // Shared-cleanup aggregates (ReceivePlayerPositionWithCameraClientMsg
                // at NewWorld+0x3f99b30) do CMP [result+1],0 / JZ cleanup to skip the
                // explicit ok-clear store when ok is already 0. That edge is still a
                // failure join; treating it as SUCCESS lets paths skip later ReadRaws.
                UnmarshalStatusByte inputStatus =
                    isOkByteZeroBranch(source.block(), successor, resultBase)
                        ? UnmarshalStatusByte.FAILURE
                        : source.status();
                if (inputStatus == UnmarshalStatusByte.FAILURE) {
                    edgeStatus = UnmarshalStatusByte.FAILURE;
                }
                UnmarshalFlowNode target = new UnmarshalFlowNode(
                    successor,
                    transferUnmarshalStatus(
                        high,
                        successor,
                        inputStatus,
                        edgeStatus,
                        resultBase,
                        delegatedSuccess,
                        active,
                        depth,
                        preconditionedSuccess));
                edges.add(new UnmarshalFlowEdge(source, target));
                if (nodes.add(target)) {
                    pending.addLast(target);
                }
            }
        }

        LinkedHashSet<UnmarshalFlowNode> successfulTerminals = nodes.stream()
            .filter(node -> isTerminatingPcodeBlock(node.block()))
            .filter(node -> node.status() == UnmarshalStatusByte.SUCCESS)
            .collect(Collectors.toCollection(LinkedHashSet::new));
        if (successfulTerminals.isEmpty()) {
            UnmarshalTerminalFlow preconditioned = preconditionedUnmarshalSuccessSubgraph(
                high,
                resultBase,
                entries,
                preconditionedSuccess);
            if (preconditioned != null) {
                return preconditioned;
            }
            return UnmarshalTerminalFlow.unresolved("no-success-terminal");
        }

        SuccessfulUnmarshalSubgraph successful =
            constrainedSuccessfulUnmarshalSubgraph(edges, successfulTerminals);
        Set<UnmarshalFlowNode> successfulNodes = successful.nodes();

        LinkedHashSet<String> successfulPhysicalEdges = new LinkedHashSet<>();
        for (UnmarshalFlowEdge edge : successful.edges()) {
            successfulPhysicalEdges.add(unmarshalPhysicalEdgeKey(
                edge.source().block(),
                edge.target().block()));
        }
        HashMap<PcodeBlockBasic, LinkedHashSet<PcodeBlockBasic>> excluded =
            new HashMap<>();
        for (PcodeBlockBasic block : high.getBasicBlocks()) {
            for (PcodeBlockBasic successor : NetworkSchemaControlFlow.successors(block)) {
                if (!successfulPhysicalEdges.contains(
                        unmarshalPhysicalEdgeKey(block, successor))) {
                    excluded.computeIfAbsent(block, ignored -> new LinkedHashSet<>())
                        .add(successor);
                }
            }
        }

        HashMap<PcodeBlockBasic, Set<PcodeBlockBasic>> immutableExcluded = new HashMap<>();
        excluded.forEach((block, successors) ->
            immutableExcluded.put(block, Set.copyOf(successors)));
        Set<PcodeBlockBasic> mandatoryBlocks = mandatorySuccessfulPhysicalBlocks(
            successfulNodes,
            successful.edges(),
            entryNodes,
            successfulTerminals);
        statusFlowGraphDebugByFunction.put(
            high.getFunction().getEntryPoint().toString(),
            statusFlowGraphDebug(
                nodes,
                edges,
                successful,
                successfulTerminals,
                mandatoryBlocks));
        return new UnmarshalTerminalFlow(
            successfulTerminals.stream()
                .map(UnmarshalFlowNode::block)
                .collect(Collectors.toUnmodifiableSet()),
            Map.copyOf(immutableExcluded),
            mandatoryBlocks,
            "complete-status-product-graph");
    }

    private boolean hasPreconditionedUnmarshalSuccess(
        HighFunction high,
        String resultBase) {

        if (high == null || resultBase == null) {
            return false;
        }
        boolean sawFailure = false;
        boolean sawSuccess = false;
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            StatusByteWrite write = unmarshalStatusByteWrite(operation);
            if (write == null || !resultBase.equals(write.base())) {
                continue;
            }
            sawFailure |= write.value() == UnmarshalStatusByte.FAILURE;
            sawSuccess |= write.value() == UnmarshalStatusByte.SUCCESS;
        }
        if (sawSuccess) {
            return false;
        }

        for (PcodeBlockBasic source : high.getBasicBlocks()) {
            if (!NetworkSchemaControlFlow.predecessors(source).isEmpty()) {
                continue;
            }
            List<PcodeBlockBasic> successors = NetworkSchemaControlFlow.successors(source);
            if (successors.size() != 2) {
                continue;
            }
            for (PcodeBlockBasic zeroSuccessor : successors) {
                if (!isOkByteZeroBranch(source, zeroSuccessor, resultBase)) {
                    continue;
                }
                PcodeBlockBasic nonzeroSuccessor = successors.get(0) == zeroSuccessor
                    ? successors.get(1)
                    : successors.get(0);
                if (!reachesUnmarshalBufferConsumer(high, nonzeroSuccessor) ||
                    reachesUnmarshalBufferConsumer(high, zeroSuccessor)) {
                    continue;
                }
                runMetrics.increment("preconditionedUnmarshalSuccessSeeds");
                runMetrics.increment(sawFailure
                    ? "preconditionedUnmarshalFailureWriteSeeds"
                    : "preconditionedUnmarshalEntryGuardSeeds");
                return true;
            }
        }
        return false;
    }

    private boolean reachesUnmarshalBufferConsumer(
        HighFunction high,
        PcodeBlockBasic start) {

        if (high == null || start == null) {
            return false;
        }
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            if (operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            PcodeBlockBasic block = NetworkSchemaControlFlow.parentBlock(operation);
            if (block == null || block != start &&
                !NetworkSchemaControlFlow.reaches(start, block)) {
                continue;
            }
            Function target = pcodeCallTarget(operation);
            if (target == null) {
                continue;
            }
            if (pcodeReadRawWireEvidence(operation, target) != null ||
                !readBufferParameters(target).isEmpty()) {
                return true;
            }
            // Ghidra can omit trailing register arguments from a call op even
            // though the callee still consumes the corresponding Win64 formal.
            // Probe all register formals directly so a preconditioned result
            // wrapper is not mistaken for an always-failing helper.
            for (int slot = 1; slot <= 4; slot++) {
                if (hasReadBufferFlow(
                        target,
                        "param_" + slot,
                        new LinkedHashSet<>())) {
                    runMetrics.increment(
                        "preconditionedUnmarshalRegisterBufferConsumers");
                    return true;
                }
            }
        }
        return false;
    }

    private UnmarshalTerminalFlow transparentReturnedResultUnmarshalTerminalFlow(
        HighFunction high,
        String expectedResultBase,
        Set<String> active,
        int depth) {

        Function owner = high.getFunction();
        Integer returnedSlot = returnedParameterSlot(owner);
        String resultBase = returnedSlot == null ? null : "param_" + returnedSlot;
        if (resultBase == null || expectedResultBase != null &&
            !expectedResultBase.equals(resultBase) ||
            !allReturnsTransportFormalParameter(high, returnedSlot)) {
            return null;
        }

        PcodeOpAST delegatedCall = null;
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            if (operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            Function target = pcodeCallTarget(operation);
            Integer resultSlot = provenCallArgumentSlot(
                owner,
                operation,
                target,
                new PcodeStorage(resultBase, 0L));
            if (target == null || resultSlot == null ||
                !isTailResultDelegation(operation, resultBase)) {
                continue;
            }
            UnmarshalTerminalFlow nested = successfulUnmarshalTerminalFlow(
                highFunction(target),
                "param_" + resultSlot,
                active,
                depth + 1);
            if (!isCompleteUnmarshalTerminalFlow(nested)) {
                continue;
            }
            if (delegatedCall != null) {
                return null;
            }
            delegatedCall = operation;
        }
        if (delegatedCall == null) {
            return null;
        }

        PcodeBlockBasic delegatedBlock =
            NetworkSchemaControlFlow.parentBlock(delegatedCall);
        Set<PcodeBlockBasic> terminals = high.getBasicBlocks().stream()
            .filter(this::isTerminatingPcodeBlock)
            .collect(Collectors.toUnmodifiableSet());
        if (delegatedBlock == null || terminals.isEmpty() ||
            terminals.stream().anyMatch(terminal ->
                !NetworkSchemaControlFlow.dominates(high, delegatedBlock, terminal))) {
            return null;
        }
        Set<PcodeBlockBasic> mandatory = high.getBasicBlocks().stream()
            .filter(block -> terminals.stream().allMatch(terminal ->
                NetworkSchemaControlFlow.dominates(high, block, terminal)))
            .collect(Collectors.toUnmodifiableSet());
        runMetrics.increment("transparentUnmarshalResultWrappers");
        return new UnmarshalTerminalFlow(
            terminals,
            Map.of(),
            mandatory,
            "complete-transparent-returned-result-delegate");
    }

    private boolean allReturnsTransportFormalParameter(
        HighFunction high,
        int parameterSlot) {

        boolean sawReturn = false;
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            if (operation.getOpcode() != PcodeOp.RETURN) {
                continue;
            }
            if (operation.getNumInputs() < 2) {
                return false;
            }
            sawReturn = true;
            Varnode value = operation.getInput(operation.getNumInputs() - 1);
            PcodeStorage storage = pcodeStorageExpression(value);
            Integer slot = formalParameterSlot(storage);
            if (slot == null) {
                slot = transportedFormalParameterSlot(value);
            }
            if (!Integer.valueOf(parameterSlot).equals(slot) ||
                formalParameterSlot(storage) != null && storage.offset != 0L) {
                return false;
            }
        }
        return sawReturn;
    }

    private Set<PcodeBlockBasic> mandatorySuccessfulPhysicalBlocks(
        Set<UnmarshalFlowNode> successfulNodes,
        Set<UnmarshalFlowEdge> edges,
        Set<UnmarshalFlowNode> entries,
        Set<UnmarshalFlowNode> terminals) {

        if (successfulNodes == null || successfulNodes.isEmpty() ||
            edges == null || entries == null || terminals == null ||
            terminals.isEmpty()) {
            return Set.of();
        }
        HashMap<UnmarshalFlowNode, List<UnmarshalFlowNode>> successors =
            new HashMap<>();
        for (UnmarshalFlowEdge edge : edges) {
            if (successfulNodes.contains(edge.source()) &&
                successfulNodes.contains(edge.target())) {
                successors.computeIfAbsent(
                    edge.source(),
                    ignored -> new ArrayList<>()).add(edge.target());
            }
        }
        Set<UnmarshalFlowNode> successfulEntries = entries.stream()
            .filter(successfulNodes::contains)
            .collect(Collectors.toUnmodifiableSet());
        if (successfulEntries.isEmpty()) {
            return Set.of();
        }

        LinkedHashSet<PcodeBlockBasic> candidates = successfulNodes.stream()
            .map(UnmarshalFlowNode::block)
            .collect(Collectors.toCollection(LinkedHashSet::new));
        candidates.removeIf(block -> successfulTerminalReachableWithoutBlock(
            block,
            successfulEntries,
            terminals,
            successors));
        return Set.copyOf(candidates);
    }

    private boolean successfulTerminalReachableWithoutBlock(
        PcodeBlockBasic excludedBlock,
        Set<UnmarshalFlowNode> entries,
        Set<UnmarshalFlowNode> terminals,
        Map<UnmarshalFlowNode, List<UnmarshalFlowNode>> successors) {

        ArrayDeque<UnmarshalFlowNode> pending = new ArrayDeque<>();
        HashSet<UnmarshalFlowNode> visited = new HashSet<>();
        for (UnmarshalFlowNode entry : entries) {
            if (entry.block() != excludedBlock && visited.add(entry)) {
                pending.addLast(entry);
            }
        }
        while (!pending.isEmpty()) {
            UnmarshalFlowNode node = pending.removeFirst();
            if (terminals.contains(node)) {
                return true;
            }
            for (UnmarshalFlowNode successor :
                    successors.getOrDefault(node, List.of())) {
                if (successor.block() != excludedBlock &&
                    visited.add(successor)) {
                    pending.addLast(successor);
                }
            }
        }
        return false;
    }

    private UnmarshalStatusByte transferUnmarshalStatus(
        HighFunction high,
        PcodeBlockBasic block,
        UnmarshalStatusByte input,
        UnmarshalStatusByte terminalEdgeStatus,
        String resultBase,
        Set<PcodeOpAST> delegatedSuccess,
        Set<String> active,
        int depth,
        boolean preconditionedSuccess) {

        UnmarshalStatusByte status = input;
        var operations = block.getIterator();
        while (operations.hasNext()) {
            PcodeOp operation = operations.next();
            if (!(operation instanceof PcodeOpAST ast)) {
                continue;
            }
            StatusByteWrite write = unmarshalStatusByteWrite(ast);
            if (write != null && resultBase.equals(write.base())) {
                UnmarshalStatusByte written = effectiveUnmarshalStatusByte(
                    high,
                    ast,
                    write,
                    active,
                    depth);
                if (written == UnmarshalStatusByte.UNKNOWN &&
                    terminalEdgeStatus != null) {
                    status = terminalEdgeStatus;
                }
                else if (written == UnmarshalStatusByte.UNKNOWN &&
                    preconditionedSuccess) {
                    status = UnmarshalStatusByte.FAILURE;
                    runMetrics.increment(
                        "preconditionedUnmarshalUnknownWritesAsFailure");
                }
                else {
                    status = written;
                }
            }
            else if (delegatedSuccess.contains(ast)) {
                status = UnmarshalStatusByte.SUCCESS;
            }
        }
        return status;
    }

    private UnmarshalStatusByte incomingUnmarshalStatusForEdge(
        HighFunction high,
        PcodeBlockBasic predecessor,
        PcodeBlockBasic target,
        String resultBase,
        Map<PcodeBlockBasic, Map<PcodeBlockBasic, UnmarshalStatusByte>> cache) {

        Map<PcodeBlockBasic, UnmarshalStatusByte> incoming = cache.computeIfAbsent(
            target,
            block -> {
                Map<PcodeBlockBasic, UnmarshalStatusByte> recovered =
                    incomingUnmarshalStatus(high, block, resultBase);
                return recovered == null ? Map.of() : recovered;
            });
        return incoming.get(predecessor);
    }

    private boolean isOkByteZeroBranch(
        PcodeBlockBasic source,
        PcodeBlockBasic successor,
        String resultBase) {

        if (source == null || successor == null || resultBase == null) {
            return false;
        }
        if (isOkByteZeroBranchPcode(source, successor, resultBase)) {
            return true;
        }
        // Listing fallback for NewWorld+0x3f99c12: CMP byte ptr [RDI+0x1],0 / JZ
        // when RDI holds the unmarshal result (param_2).
        return isOkByteZeroBranchInstruction(source, successor, resultBase);
    }

    private boolean isOkByteZeroBranchPcode(
        PcodeBlockBasic source,
        PcodeBlockBasic successor,
        String resultBase) {

        PcodeOpAST branch = null;
        var operations = source.getIterator();
        while (operations.hasNext()) {
            PcodeOp operation = operations.next();
            if (!(operation instanceof PcodeOpAST ast) ||
                ast.getOpcode() != PcodeOp.CBRANCH ||
                ast.getNumInputs() < 2) {
                continue;
            }
            if (branch != null) {
                return false;
            }
            branch = ast;
        }
        if (branch == null) {
            return false;
        }
        Address destination = pcodeAddress(branch.getInput(0));
        boolean takenEdge = blockContainsAddress(successor, destination);
        if (!takenEdge && source.getOutSize() != 2) {
            return false;
        }
        PcodeOp condition = branch.getInput(1).getDef();
        if (condition == null ||
            (condition.getOpcode() != PcodeOp.INT_EQUAL &&
                condition.getOpcode() != PcodeOp.INT_NOTEQUAL) ||
            condition.getNumInputs() != 2) {
            return false;
        }
        int zeroSlot = NetworkSchemaIntegerEvaluator.equals(condition.getInput(0), 0L)
            ? 0
            : NetworkSchemaIntegerEvaluator.equals(condition.getInput(1), 0L)
                ? 1
                : -1;
        if (zeroSlot < 0) {
            return false;
        }
        boolean zeroOutcome = condition.getOpcode() == PcodeOp.INT_EQUAL
            ? takenEdge
            : !takenEdge;
        if (!zeroOutcome) {
            return false;
        }
        PcodeStorage ok = okByteStorage(condition.getInput(1 - zeroSlot));
        return ok != null &&
            resultBase.equals(ok.base) &&
            ok.offset == 1L;
    }

    private boolean isOkByteZeroBranchInstruction(
        PcodeBlockBasic source,
        PcodeBlockBasic successor,
        String resultBase) {

        Function owner = functionContaining(source.getStart());
        if (owner == null) {
            return false;
        }
        Instruction compare = null;
        String okRegister = null;
        Instruction jump = null;
        Boolean jumpOnZero = null;
        for (Instruction instruction : functionInstructions(owner)) {
            Address address = instruction.getMinAddress();
            if (source.getStart() != null && address.compareTo(source.getStart()) < 0) {
                continue;
            }
            if (source.getStop() != null && address.compareTo(source.getStop()) > 0) {
                break;
            }
            String mnemonic = NetworkSchemaX86.upperMnemonic(instruction);
            if ("CMP".equals(mnemonic)) {
                MemoryReference memory = NetworkSchemaX86.memoryReference(instruction, 0);
                Long immediate = NetworkSchemaX86.immediateValue(instruction, 1);
                if (memory != null &&
                    memory.displacement == 1 &&
                    Long.valueOf(0L).equals(immediate)) {
                    compare = instruction;
                    okRegister = memory.baseRegister;
                }
            }
            else if (compare != null && okRegister != null &&
                ("JZ".equals(mnemonic) || "JE".equals(mnemonic) ||
                    "JNZ".equals(mnemonic) || "JNE".equals(mnemonic))) {
                jump = instruction;
                jumpOnZero = "JZ".equals(mnemonic) || "JE".equals(mnemonic);
            }
        }
        if (compare == null || jump == null || okRegister == null || jumpOnZero == null ||
            jump.getNumOperands() < 1) {
            return false;
        }
        Address destination = null;
        try {
            for (Object object : jump.getOpObjects(0)) {
                if (object instanceof Address address) {
                    destination = address;
                    break;
                }
            }
        }
        catch (Exception ignored) {
            return false;
        }
        if (destination == null) {
            return false;
        }
        // The edge carries ok==0 iff it is the taken edge of a JZ/JE or the
        // fallthrough edge of a JNZ/JNE. Anything else is a success continuation.
        boolean zeroOutcome = blockContainsAddress(successor, destination)
            ? jumpOnZero.booleanValue()
            : !jumpOnZero.booleanValue();
        if (!zeroOutcome) {
            return false;
        }
        // Provenance proof: the compared register holds the unmarshal result
        // pointer, so [reg+1] is the ok byte by construction. Pure re-test gates
        // (ContractsComponentClientFacet_OnSearchContracts at NewWorld+0x2da5aa0)
        // re-check a previously stored ok byte with no nearby ok-clear; the
        // forward ABI tracker proves the register is a copy of the result param.
        if (okByteRegisterHoldsResultPointer(owner, source, compare, okRegister, resultBase)) {
            return true;
        }
        // Listing fallback for NewWorld+0x3f99c12: CMP [reg+1],0 / JZ cleanup
        // with a nearby MOV [reg+1],0 ok-clear sibling.
        boolean sawOkClear = blockClearsOkRegisterAfter(
            owner,
            jump.getMinAddress(),
            okRegister);
        if (!sawOkClear) {
            for (PcodeBlockBasic sibling : NetworkSchemaControlFlow.successors(source)) {
                if (sibling == successor) {
                    continue;
                }
                if (blockClearsOkRegister(owner, sibling, okRegister)) {
                    sawOkClear = true;
                    break;
                }
            }
        }
        return sawOkClear;
    }

    private final Map<String, Map<Integer, ForwardArgState>> abiBlockEntryStateCache =
        lruCache(FUNCTION_INSTRUCTION_CACHE_LIMIT);

    private Map<Integer, ForwardArgState> abiBlockEntryStatesCached(
        Function owner,
        HighFunction high,
        PcodeBlockBasic entryBlock) {

        String key = functionCacheKey("abi-block-entry-states", owner);
        Map<Integer, ForwardArgState> cached = abiBlockEntryStateCache.get(key);
        if (cached != null) {
            return cached;
        }
        Map<Integer, ForwardArgState> result = abiBlockEntryStates(owner, high, entryBlock);
        abiBlockEntryStateCache.put(key, result);
        return result;
    }

    private boolean okByteRegisterHoldsResultPointer(
        Function owner,
        PcodeBlockBasic source,
        Instruction compare,
        String okRegister,
        String resultBase) {

        if (owner == null || source == null || compare == null || okRegister == null ||
            resultBase == null || !resultBase.matches("param_[0-9]+")) {
            return false;
        }
        HighFunction high = highFunction(owner);
        PcodeBlockBasic entryBlock = functionEntryBlock(high, owner);
        if (high == null || entryBlock == null) {
            return false;
        }
        ForwardArgState input = abiBlockEntryStatesCached(owner, high, entryBlock)
            .get(source.getIndex());
        if (input == null) {
            return false;
        }
        ForwardArgState state = input.copy();
        LinkedHashSet<String> dereferencedResultPointers = new LinkedHashSet<>();
        for (Instruction instruction : blockInstructions(owner, source)) {
            if (instruction.getMinAddress().equals(compare.getMinAddress())) {
                TrackedValue value = state.registers.get(okRegister);
                if (trackedValueIsBasePointer(value, resultBase)) {
                    return true;
                }
                if (dereferencedResultPointers.contains(okRegister)) {
                    runMetrics.increment("dereferencedUnmarshalResultWrapperProofs");
                    return true;
                }
                return false;
            }

            String destination = NetworkSchemaX86.registerOperand(instruction, 0);
            boolean resultDereference = false;
            if (destination != null &&
                "MOV".equals(NetworkSchemaX86.upperMnemonic(instruction))) {
                String sourceRegister = NetworkSchemaX86.registerOperand(instruction, 1);
                if (sourceRegister != null &&
                    dereferencedResultPointers.contains(sourceRegister)) {
                    resultDereference = true;
                }
                MemoryReference sourceMemory =
                    NetworkSchemaX86.memoryReference(instruction, 1);
                TrackedValue sourceBase = sourceMemory == null
                    ? null
                    : state.registers.get(sourceMemory.baseRegister);
                if (sourceMemory != null && sourceMemory.displacement == 0 &&
                    trackedValueIsBasePointer(sourceBase, resultBase)) {
                    resultDereference = true;
                }
            }
            if (destination != null) {
                dereferencedResultPointers.remove(destination);
                if (resultDereference) {
                    dereferencedResultPointers.add(destination);
                }
            }
            observeForwardInstruction(instruction, state, false);
        }
        return false;
    }

    private boolean trackedValueIsBasePointer(
        TrackedValue value,
        String expectedBase) {

        return value != null && expectedBase != null &&
            expectedBase.equals(value.baseKey) &&
            value.baseOffset != null && value.baseOffset.intValue() == 0;
    }

    private boolean blockContainsAddress(PcodeBlockBasic block, Address address) {
        if (block == null || address == null) {
            return false;
        }
        Address start = block.getStart();
        Address stop = block.getStop();
        return Objects.equals(start, address) ||
            start != null && stop != null &&
                start.compareTo(address) <= 0 &&
                stop.compareTo(address) >= 0;
    }

    private boolean blockClearsOkRegister(
        Function owner,
        PcodeBlockBasic block,
        String okRegister) {

        return block != null &&
            blockClearsOkRegisterAfter(owner, block.getStart(), okRegister);
    }

    private boolean blockClearsOkRegisterAfter(
        Function owner,
        Address after,
        String okRegister) {

        if (owner == null || after == null || okRegister == null) {
            return false;
        }
        int seen = 0;
        for (Instruction instruction : functionInstructions(owner)) {
            Address address = instruction.getMinAddress();
            if (address.compareTo(after) <= 0) {
                continue;
            }
            if (++seen > 8) {
                return false;
            }
            if (!"MOV".equals(NetworkSchemaX86.upperMnemonic(instruction))) {
                continue;
            }
            MemoryReference memory = NetworkSchemaX86.memoryReference(instruction, 0);
            Long immediate = NetworkSchemaX86.immediateValue(instruction, 1);
            if (memory != null &&
                okRegister.equals(memory.baseRegister) &&
                memory.displacement == 1 &&
                Long.valueOf(0L).equals(immediate)) {
                return true;
            }
        }
        return false;
    }

    private PcodeStorage okByteStorage(Varnode node) {
        if (node == null) {
            return null;
        }
        PcodeStorage direct = pcodeStorageExpression(node);
        if (direct != null) {
            return direct;
        }
        PcodeStorage loaded = pcodeLoadedStorageExpression(node);
        if (loaded != null) {
            return loaded;
        }
        PcodeOp definition = node.getDef();
        if (definition == null) {
            return null;
        }
        return switch (definition.getOpcode()) {
            case PcodeOp.COPY, PcodeOp.CAST, PcodeOp.INT_ZEXT, PcodeOp.INT_SEXT ->
                okByteStorage(definition.getInput(0));
            case PcodeOp.LOAD -> definition.getNumInputs() >= 2
                ? unmarshalResultStorageExpression(definition.getInput(1))
                : null;
            case PcodeOp.SUBPIECE -> definition.getNumInputs() >= 2 &&
                NetworkSchemaIntegerEvaluator.equals(definition.getInput(1), 0L)
                ? okByteStorage(definition.getInput(0))
                : null;
            default -> null;
        };
    }

    private String statusFlowGraphDebug(
        Set<UnmarshalFlowNode> nodes,
        Set<UnmarshalFlowEdge> edges,
        SuccessfulUnmarshalSubgraph successful,
        Set<UnmarshalFlowNode> terminals,
        Set<PcodeBlockBasic> mandatory) {

        StringBuilder builder = new StringBuilder();
        builder.append("nodes=[");
        boolean first = true;
        for (UnmarshalFlowNode node : nodes) {
            if (!first) {
                builder.append(',');
            }
            first = false;
            builder.append(formatAddress(node.block().getStart()))
                .append(':')
                .append(node.status().name().charAt(0));
            if (terminals.contains(node)) {
                builder.append('T');
            }
            if (successful.nodes().contains(node)) {
                builder.append('G');
            }
            if (mandatory.contains(node.block())) {
                builder.append('M');
            }
        }
        builder.append("],edges=[");
        first = true;
        for (UnmarshalFlowEdge edge : edges) {
            if (!first) {
                builder.append(',');
            }
            first = false;
            if (successful.edges().contains(edge)) {
                builder.append('*');
            }
            builder.append(formatAddress(edge.source().block().getStart()))
                .append(':')
                .append(edge.source().status().name().charAt(0))
                .append('>')
                .append(formatAddress(edge.target().block().getStart()))
                .append(':')
                .append(edge.target().status().name().charAt(0));
        }
        return builder.append(']').toString();
    }

    private String unmarshalPhysicalEdgeKey(
        PcodeBlockBasic source,
        PcodeBlockBasic target) {

        return source.getIndex() + "->" + target.getIndex();
    }
