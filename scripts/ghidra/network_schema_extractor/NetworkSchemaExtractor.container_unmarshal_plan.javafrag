    private void reconcileFullContainerUnmarshalSemantics(
        FullContainerPlan plan,
        Address unmarshalFull) {

        if (plan == null || !isExecutableAddress(unmarshalFull)) {
            return;
        }
        List<ContainerCodecCall> keyLeaves = physicalContainerCodecLeaves(plan.keyCodecs);
        List<ContainerCodecCall> valueLeaves = physicalContainerCodecLeaves(plan.valueCodecs);
        Function function = functionAtOrContaining(resolvedCodeTarget(unmarshalFull));
        if (keyLeaves == null || valueLeaves == null) {
            List<ContainerCodecCall> decoded = recoverFullContainerUnmarshalCodecs(
                function,
                "param_2",
                plan,
                -1,
                new LinkedHashSet<>(),
                0);
            if (decoded != null) {
                plan.unmarshalCodecs.clear();
                plan.unmarshalCodecs.addAll(decoded);
                ArrayList<ContainerCodecCall> encoded = new ArrayList<>(
                    plan.keyCodecs.size() + plan.valueCodecs.size());
                encoded.addAll(plan.keyCodecs);
                encoded.addAll(plan.valueCodecs);
                ContainerCodecAgreement agreement =
                    reconcileConditionalContainerCodecSequence(encoded, decoded);
                if (agreement != ContainerCodecAgreement.NONE) {
                    plan.unmarshalReconciliation = agreement ==
                            ContainerCodecAgreement.SEMANTIC
                        ? "complete-conditional-semantic-agreement"
                        : "complete-conditional-physical-agreement";
                    return;
                }
                if (sameConditionalContainerPhysicalPaths(encoded, decoded)) {
                    plan.unmarshalReconciliation =
                        "complete-conditional-path-agreement";
                    return;
                }
            }
            plan.unmarshalReconciliation = "marshal-codec-sequence-not-linear";
            return;
        }
        int expectedCount = keyLeaves.size() + valueLeaves.size();
        if (expectedCount == 0) {
            plan.unmarshalReconciliation = "marshal-codec-sequence-empty";
            return;
        }
        List<ContainerCodecCall> decoded = recoverFullContainerUnmarshalCodecs(
            function,
            "param_2",
            plan,
            expectedCount,
            new LinkedHashSet<>(),
            0);
        if (decoded == null) {
            plan.unmarshalReconciliation = "unmarshal-loop-unresolved";
            return;
        }
        plan.unmarshalCodecs.clear();
        plan.unmarshalCodecs.addAll(decoded);
        ContainerCodecAgreement agreement = reconcileLogicalContainerCodecSequence(
            plan.keyCodecs,
            plan.valueCodecs,
            decoded);
        if (agreement != ContainerCodecAgreement.NONE) {
            plan.unmarshalReconciliation = agreement == ContainerCodecAgreement.SEMANTIC
                ? "complete-logical-sequence-agreement"
                : "complete-physical-sequence-agreement";
            return;
        }
        ArrayList<ContainerCodecCall> encodedPlan = new ArrayList<>(
            plan.keyCodecs.size() + plan.valueCodecs.size());
        encodedPlan.addAll(plan.keyCodecs);
        encodedPlan.addAll(plan.valueCodecs);
        if (sameConditionalContainerPhysicalPaths(encodedPlan, decoded)) {
            plan.unmarshalReconciliation = "complete-conditional-path-agreement";
            return;
        }
        List<ContainerCodecCall> decodedLeaves = physicalContainerCodecLeaves(decoded);
        if (decodedLeaves == null || decodedLeaves.size() != expectedCount) {
            plan.unmarshalReconciliation = "marshal-unmarshal-codec-count-mismatch";
            return;
        }

        ArrayList<ContainerCodecCall> encoded = new ArrayList<>(expectedCount);
        encoded.addAll(keyLeaves);
        encoded.addAll(valueLeaves);
        ArrayList<WireShape> reconciled = new ArrayList<>(expectedCount);
        for (int index = 0; index < expectedCount; index++) {
            WireShape marshal = encoded.get(index).wireEvidence;
            WireShape unmarshal = decodedLeaves.get(index).wireEvidence;
            if (marshal == null || marshal.layout == null ||
                unmarshal == null || !unmarshal.hasProvenSemantics()) {
                plan.unmarshalReconciliation = "unmarshal-codec-semantic-unproven";
                return;
            }
            if (marshal.hasProvenSemantics()) {
                if (!wireShapeMatchesExpected(marshal.shape, unmarshal.shape)) {
                    plan.unmarshalReconciliation = "marshal-unmarshal-semantic-mismatch";
                    return;
                }
                reconciled.add(marshal);
                continue;
            }
            Integer marshalWidth = wireShapeByteWidth(marshal.layout);
            Integer unmarshalWidth = wireShapeByteWidth(unmarshal.layout);
            if (!marshal.layout.equals(unmarshal.layout) &&
                (marshalWidth == null || !marshalWidth.equals(unmarshalWidth))) {
                plan.unmarshalReconciliation = "marshal-unmarshal-layout-mismatch";
                return;
            }
            reconciled.add(WireShape.semantic(
                unmarshal.shape,
                marshal.layout,
                "marshal-full+unmarshal-loop-ordinal-agreement"));
        }

        for (int index = 0; index < expectedCount; index++) {
            ContainerCodecCall target = encoded.get(index);
            ContainerCodecCall source = decodedLeaves.get(index);
            target.wireEvidence = reconciled.get(index);
            target.evidenceSource = "marshal-full+unmarshal-loop-ordinal-agreement";
            if (target.nativeType == null) {
                target.nativeType = source.nativeType;
            }
            if (target.typeId == null) {
                target.typeId = source.typeId;
                target.typeIdSource = source.typeIdSource;
            }
            mergeProvenContainerCodecIdentity(target, source);
        }
        plan.unmarshalReconciliation = "complete-ordinal-agreement";
    }

    private List<ContainerCodecCall> physicalContainerCodecLeaves(
        List<ContainerCodecCall> codecs) {

        ArrayList<ContainerCodecCall> leaves = new ArrayList<>();
        for (ContainerCodecCall codec : codecs) {
            if (codec.members.isEmpty()) {
                leaves.add(codec);
                continue;
            }
            if (!"linear-sequence".equals(codec.memberSemantics) &&
                !"counted-sequence".equals(codec.memberSemantics) &&
                !"fixed-sequence".equals(codec.memberSemantics) &&
                !"structured-value".equals(codec.memberSemantics)) {
                return null;
            }
            List<ContainerCodecCall> nested = physicalContainerCodecLeaves(codec.members);
            if (nested == null || nested.isEmpty()) {
                return null;
            }
            leaves.addAll(nested);
        }
        return List.copyOf(leaves);
    }

    private List<ContainerCodecCall> logicalContainerCodecLeaves(
        List<ContainerCodecCall> codecs) {

        ArrayList<ContainerCodecCall> leaves = new ArrayList<>();
        for (ContainerCodecCall codec : codecs) {
            if (promoteSemanticContainerCodecBoundary(codec)) {
                leaves.add(codec);
                continue;
            }
            if (codec.members.isEmpty() || "counted-sequence".equals(codec.memberSemantics) ||
                "fixed-sequence".equals(codec.memberSemantics) ||
                "structured-value".equals(codec.memberSemantics)) {
                leaves.add(codec);
                continue;
            }
            if ("optional-suffix".equals(codec.memberSemantics)) {
                List<ContainerCodecCall> required =
                    logicalContainerCodecLeaves(codec.members);
                List<ContainerCodecCall> optional =
                    logicalContainerCodecLeaves(codec.optionalMembers);
                if (required == null || required.isEmpty() ||
                    optional == null || optional.isEmpty()) {
                    return null;
                }
                leaves.addAll(required);
                leaves.addAll(optional);
                continue;
            }
            if (!"linear-sequence".equals(codec.memberSemantics)) {
                return null;
            }
            List<ContainerCodecCall> nested = logicalContainerCodecLeaves(codec.members);
            if (nested == null || nested.isEmpty()) {
                return null;
            }
            leaves.addAll(nested);
        }
        return List.copyOf(leaves);
    }

    private boolean promoteSemanticContainerCodecBoundary(ContainerCodecCall codec) {
        if (codec == null || codec.members.isEmpty() ||
            !"linear-sequence".equals(codec.memberSemantics)) {
            return false;
        }
        String nativeType = firstNonEmpty(
            codec.nativeType,
            marshalFunctionTemplateType(codec.targetName));
        WireShape semantic = semanticWireEvidenceForNativeType(nativeType);
        List<String> observed = containerPhysicalLayouts(codec);
        List<String> expected = semantic == null
            ? null
            : containerAggregatePhysicalLayouts(semantic.layout);
        if (observed == null || expected == null ||
            observed.size() != expected.size()) {
            return false;
        }
        for (int index = 0; index < observed.size(); index++) {
            if (!containerPhysicalLayoutsMatch(
                    observed.get(index),
                    expected.get(index))) {
                return false;
            }
        }
        String source = "codec-template+complete-child-codec-coverage";
        codec.nativeType = nativeType;
        codec.wireEvidence = WireShape.semantic(
            semantic.shape,
            semantic.layout,
            source);
        codec.evidenceSource = source;
        codec.memberSemantics = "fixed-sequence";
        codec.analysisStatus = "complete";
        applyContainerCodecTypeIdentity(codec, nativeType);
        return true;
    }

    private List<ContainerCodecCall> recoverFullContainerUnmarshalCodecs(
        Function function,
        String readBufferParameter,
        FullContainerPlan plan,
        int expectedCount,
        Set<String> active,
        int depth) {

        if (function == null || readBufferParameter == null || depth > 8) {
            return null;
        }
        String context = function.getEntryPoint() + "|" + readBufferParameter;
        if (!active.add(context)) {
            return null;
        }
        try {
            HighFunction high = highFunction(function);
            if (high == null) {
                return null;
            }
            List<ContainerCodecCall> selectedExact = null;
            List<ContainerCodecCall> selectedFallback = null;
            String selectedExactStorageProof = null;
            String selectedFallbackStorageProof = null;
            List<PcodeOpAST> operations = orderedPcodeOps(high);
            List<NetworkSchemaNaturalLoop> loops = NetworkSchemaControlFlow.naturalLoops(high);
            if (loops.isEmpty()) {
                plan.unmarshalDiagnostics.add(
                    formatAddress(function.getEntryPoint()) + ":no-natural-loop");
            }
            for (NetworkSchemaNaturalLoop loop : loops) {
                if (hasContainingNaturalLoop(loop, loops)) {
                    continue;
                }
                List<ContainerCodecCall> candidate = unmarshalContainerLoopCodecs(
                    function,
                    high,
                    loop,
                    readBufferParameter,
                    plan);
                if (plan.sequenceMarkerProven) {
                    candidate = withoutContainerSequenceCodecs(candidate);
                }
                if (candidate.isEmpty()) {
                    recordUnmarshalLoopCallDiagnostics(
                        function,
                        loop,
                        readBufferParameter,
                        operations,
                        plan);
                    continue;
                }
                List<ContainerCodecCall> physicalCandidate =
                    physicalContainerCodecLeaves(candidate);
                int physicalCount = physicalCandidate == null
                    ? -1
                    : physicalCandidate.size();
                boolean rootMarshalAgreement = depth == 0 &&
                    fullContainerLoopMatchesMarshalPlan(plan, candidate, expectedCount);
                String storageProof = unmarshalContainerStorageProof(
                        function,
                        high,
                        loop,
                        readBufferParameter,
                        operations,
                        plan,
                        rootMarshalAgreement);
                if (storageProof == null) {
                    plan.unmarshalDiagnostics.add(
                        unmarshalLoopDiagnosticPrefix(function, loop) +
                        ":codec-count=" + candidate.size() +
                        ":physical-codec-count=" + physicalCount +
                        ":expected-count=" + expectedCount +
                        ":storage-proof-unresolved");
                    continue;
                }
                if (physicalCount == expectedCount) {
                    if (selectedExact != null) {
                        recordNestedTypeShapeReject("ambiguous-full-container-unmarshal-loop");
                        return null;
                    }
                    selectedExact = candidate;
                    selectedExactStorageProof = storageProof;
                    continue;
                }
                if (selectedFallback != null) {
                    recordNestedTypeShapeReject("ambiguous-full-container-unmarshal-loop");
                    return null;
                }
                selectedFallback = candidate;
                selectedFallbackStorageProof = storageProof;
            }
            if (selectedExact != null) {
                plan.unmarshalStorageProof = selectedExactStorageProof;
                plan.unmarshalAnalysisStatus = "exact-loop-codec-count";
                return selectedExact;
            }
            if (selectedFallback != null) {
                plan.unmarshalStorageProof = selectedFallbackStorageProof;
                plan.unmarshalAnalysisStatus = "single-loop-codec-sequence";
                return selectedFallback;
            }

            PcodeStorage readBuffer = new PcodeStorage(readBufferParameter, 0L);
            for (PcodeOpAST operation : operations) {
                if (operation.getOpcode() != PcodeOp.CALL) {
                    continue;
                }
                Function target = pcodeCallTarget(operation);
                Integer bufferSlot = provenCallArgumentSlot(
                    function,
                    operation,
                    target,
                    readBuffer);
                if (target == null || bufferSlot == null ||
                    pcodeReadRawWireEvidence(operation, target) != null ||
                    validatedUnmarshalLeaf(target, "param_" + bufferSlot) != null) {
                    continue;
                }
                List<ContainerCodecCall> candidate = recoverFullContainerUnmarshalCodecs(
                    target,
                    "param_" + bufferSlot,
                    plan,
                    expectedCount,
                    active,
                    depth + 1);
                if (candidate == null) {
                    continue;
                }
                if (selectedExact != null) {
                    recordNestedTypeShapeReject("ambiguous-full-container-unmarshal-helper");
                    return null;
                }
                selectedExact = candidate;
            }
            if (selectedExact == null && plan.unmarshalAnalysisStatus == null) {
                plan.unmarshalAnalysisStatus = "no-unmarshal-codec-sequence";
            }
            return selectedExact;
        }
        finally {
            active.remove(context);
        }
    }

    private void recordUnmarshalLoopCallDiagnostics(
        Function function,
        NetworkSchemaNaturalLoop loop,
        String readBufferParameter,
        List<PcodeOpAST> operations,
        FullContainerPlan plan) {

        PcodeStorage readBuffer = new PcodeStorage(readBufferParameter, 0L);
        int callCount = 0;
        for (PcodeOpAST operation : operations) {
            if (!loop.contains(operation) || operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            callCount++;
            Function target = pcodeCallTarget(operation);
            Integer pcodeSlot = uniqueCallArgumentSlot(operation, readBuffer);
            Integer abiSlot = instructionAbiCallArgumentSlot(
                function,
                operation,
                target,
                readBuffer);
            String classification;
            if (target == null) {
                classification = "target-unresolved";
            }
            else if (pcodeReadRawWireEvidence(operation, target) != null) {
                classification = "read-raw";
            }
            else if (pcodeSlot != null && abiSlot != null &&
                !pcodeSlot.equals(abiSlot)) {
                classification = "buffer-slot-conflict";
            }
            else {
                Integer slot = pcodeSlot != null ? pcodeSlot : abiSlot;
                WireShape leaf = slot == null
                    ? null
                    : validatedUnmarshalLeaf(target, "param_" + slot);
                classification = leaf == null
                    ? "not-leaf"
                    : "unmarshal-leaf:" +
                        (leaf.shape == null ? leaf.layout : leaf.shape);
            }
            plan.unmarshalDiagnostics.add(
                unmarshalLoopDiagnosticPrefix(function, loop) +
                ":call=" + formatAddress(operation.getSeqnum().getTarget()) +
                ":target=" + (target == null
                    ? "<unresolved>"
                    : formatAddress(target.getEntryPoint())) +
                ":pcode-buffer-slot=" + diagnosticInteger(pcodeSlot) +
                ":abi-buffer-slot=" + diagnosticInteger(abiSlot) +
                ":classification=" + classification);
        }
        if (callCount == 0) {
            plan.unmarshalDiagnostics.add(
                unmarshalLoopDiagnosticPrefix(function, loop) + ":no-call-operations");
        }
    }

    private String unmarshalLoopDiagnosticPrefix(
        Function function,
        NetworkSchemaNaturalLoop loop) {

        return formatAddress(function.getEntryPoint()) +
            ":loop=" + formatAddress(loop.header().getStart());
    }

    private String diagnosticInteger(Integer value) {
        return value == null ? "<unproven>" : value.toString();
    }

    private String unmarshalContainerStorageProof(
        Function function,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        String readBufferParameter,
        List<PcodeOpAST> operations,
        FullContainerPlan plan,
        boolean rootMarshalAgreement) {

        if (rootMarshalAgreement) {
            return "vtable-unmarshal-full+marshal-loop-physical-agreement";
        }
        ContainerLoopInduction induction = containerLoopInduction(loop);
        if (plan.storageKind == ContainerStorageKind.VECTOR) {
            return induction != null &&
                induction.storageKind() == ContainerStorageKind.VECTOR &&
                Objects.equals(induction.stride(), plan.elementStride)
                    ? induction.source()
                    : null;
        }
        if (induction != null && induction.storageKind() != ContainerStorageKind.INDEX_MAP) {
            return null;
        }
        List<PcodeCodecCall> codecs = loopReadBufferCodecCalls(
            function,
            loop,
            readBufferParameter,
            operations);
        if (codecs.isEmpty()) {
            return null;
        }
        String insertionOwner = fullContainerInsertionOutput(
            function,
            high,
            loop,
            operations,
            codecs,
            readBufferParameter);
        return insertionOwner != null && !insertionOwner.equals(readBufferParameter)
            ? "cfg-ordered-buffer-codecs+unique-owner-insertion"
            : null;
    }

    private boolean fullContainerLoopMatchesMarshalPlan(
        FullContainerPlan plan,
        List<ContainerCodecCall> decoded,
        int expectedCount) {

        if (plan == null || decoded == null || expectedCount <= 0) {
            return false;
        }
        ArrayList<ContainerCodecCall> encoded = new ArrayList<>(
            plan.keyCodecs.size() + plan.valueCodecs.size());
        encoded.addAll(plan.keyCodecs);
        encoded.addAll(plan.valueCodecs);
        if (encoded.isEmpty()) {
            return false;
        }
        if (samePhysicalContainerCodecSequence(encoded, decoded)) {
            return true;
        }
        boolean ordinalAgreement = sameProvenOrdinalContainerCodecSequence(
            encoded,
            decoded,
            expectedCount);
        if (ordinalAgreement) {
            runMetrics.increment("rootContainerOrdinalPhysicalProofs");
        }
        return ordinalAgreement;
    }

    private String fullContainerInsertionOutput(
        Function owner,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations,
        List<PcodeCodecCall> codecs,
        String readBufferParameter) {

        String selectedOwner = null;
        for (PcodeOpAST operation : operations) {
            if (!loop.contains(operation) || operation.getOpcode() != PcodeOp.CALL ||
                directCallWireEvidence(operation) != null ||
                codecs.stream().anyMatch(codec -> !NetworkSchemaControlFlow.precedes(
                    high,
                    codec.operation(),
                    operation))) {
                continue;
            }
            String candidate = containerInsertionOutputParameter(owner, operation);
            if (candidate == null) {
                continue;
            }
            if (candidate.equals(readBufferParameter)) {
                continue;
            }
            if (selectedOwner != null && !selectedOwner.equals(candidate)) {
                runMetrics.increment("fullContainerInsertionOwnerConflicts");
                return null;
            }
            selectedOwner = candidate;
        }
        if (selectedOwner == null) {
            InstructionContainerInsertion instructionInsertion =
                uniqueInstructionContainerInsertion(
                    owner,
                    high,
                    loop,
                    codecs,
                    readBufferParameter);
            selectedOwner = instructionInsertion == null
                ? null
                : instructionInsertion.outputParameter();
        }
        runMetrics.increment(selectedOwner == null
            ? "fullContainerInsertionOwnerMisses"
            : "fullContainerInsertionOwnerProofs");
        return selectedOwner;
    }

    private List<ContainerCodecCall> withoutContainerSequenceCodecs(
        List<ContainerCodecCall> codecs) {

        if (codecs == null || codecs.isEmpty()) {
            return codecs == null ? List.of() : codecs;
        }
        return codecs.stream()
            .filter(codec -> !isContainerSequenceCodec(codec))
            .toList();
    }

    private List<ContainerCodecCall> unmarshalContainerLoopCodecs(
        Function function,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        String readBufferParameter,
        FullContainerPlan plan) {

        ArrayList<ContainerCodecCall> result = new ArrayList<>();
        PcodeStorage readBuffer = new PcodeStorage(readBufferParameter, 0L);
        List<PcodeOpAST> operations = orderedPcodeOps(high);
        for (PcodeOpAST operation : operations) {
            if (!loop.contains(operation) || operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            NetworkSchemaNaturalLoop ownerLoop =
                NetworkSchemaControlFlow.innermostLoopContaining(high, operation);
            if (ownerLoop != null && !ownerLoop.equals(loop)) {
                continue;
            }
            ContainerCodecCall codec = unmarshalContainerDirectCodec(
                function,
                high,
                loop,
                operation,
                readBuffer,
                plan);
            if (codec != null) {
                result.add(codec);
            }
        }
        List<ContainerCodecCall> nested = unmarshalNestedFixedSequenceCodecs(
            function,
            high,
            loop,
            operations,
            readBuffer,
            plan);
        if (nested == null) {
            return List.of();
        }
        result.addAll(nested);
        result.sort(Comparator.comparing(codec -> codec.callsite));
        applyContainerCodecElementOffsets(high, loop, result);
        return List.copyOf(result);
    }

    private WireShape unmarshalLoopRawWireEvidence(
        Function function,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        PcodeOpAST readCall,
        RawPcodeWrite raw,
        FullContainerPlan plan) {

        List<PcodeOpAST> operations = orderedPcodeOps(high);
        WireShape booleanEvidence = boundedNormalizedBooleanReadEvidence(
            high,
            operations,
            readCall,
            raw);
        if (booleanEvidence != null) {
            return booleanEvidence;
        }

        Integer width = wireShapeByteWidth(raw.wireEvidence.layout);
        if (plan.storageKind == ContainerStorageKind.VECTOR &&
            width != null && width == Byte.BYTES &&
            plan.elementStride != null && plan.elementStride == Byte.BYTES &&
            rawReadTargetsAffineElement(loop, readCall, raw, plan.elementStride)) {
            return WireShape.semantic(
                "u8",
                raw.wireEvidence.layout,
                "full-container-unmarshal-affine-byte-element");
        }
        return raw.wireEvidence;
    }

    private boolean rawReadTargetsAffineElement(
        NetworkSchemaNaturalLoop loop,
        PcodeOpAST readCall,
        RawPcodeWrite raw,
        long elementStride) {

        Varnode output = storageVarnodeForCallOutput(readCall, raw.storage);
        if (output == null) {
            return false;
        }
        for (PcodeOpAST induction : affinePointerInductions(loop, elementStride)) {
            Long offset = elementRelativeOffset(output, induction.getOutput(), elementStride);
            if (offset != null && offset == 0L) {
                return true;
            }
        }
        return false;
    }

    private ContainerCodecCall unmarshalContainerCodec(
        PcodeOpAST operation,
        Function target,
        String nativeType,
        WireShape evidence) {

        ContainerCodecCall codec = new ContainerCodecCall();
        codec.operation = operation;
        codec.callsite = operation.getSeqnum().getTarget();
        codec.target = target.getEntryPoint();
        codec.targetName = fullFunctionName(target);
        codec.nativeType = nativeType;
        codec.wireEvidence = evidence;
        codec.evidenceSource = "full-container-unmarshal-loop";
        if (nativeType != null) {
            applyContainerCodecTypeIdentity(codec, nativeType);
        }
        return codec;
    }

    private void applyUnmarshalContainerCodecOutputStorage(
        ContainerCodecCall codec,
        PcodeStorage output) {

        if (codec == null || !isParameterStorage(output) ||
            output.offset < 0L || output.offset > 0x100000L) {
            return;
        }
        codec.elementBase = output.base;
        codec.elementOffset = output.offset;
    }

    private void applyUnmarshalContainerCodecOutputStorage(
        ContainerCodecCall codec,
        HighFunction high,
        PcodeOpAST call,
        PcodeStorage output) {

        PcodeStorage aggregateOutput = typedAggregateUnmarshalOutputStorage(codec, call);
        PcodeStorage resolved = isParameterStorage(aggregateOutput)
            ? aggregateOutput
            : null;
        if (resolved == null && isParameterStorage(output)) {
            resolved = output;
        }
        if (resolved == null) {
            PcodeStorage localOutput = aggregateOutput == null
                ? output
                : aggregateOutput;
            resolved = postCallUnmarshalOutputStorage(
                codec,
                high,
                call,
                localOutput);
        }
        if (resolved == null) {
            resolved = normalizedBooleanUnmarshalOutputStorage(
                codec,
                high,
                call,
                output);
        }
        applyUnmarshalContainerCodecOutputStorage(codec, resolved);
    }

    private PcodeStorage postCallUnmarshalOutputStorage(
        ContainerCodecCall codec,
        HighFunction high,
        PcodeOpAST call,
        PcodeStorage output) {

        Integer width = containerCodecNativeOutputByteWidth(codec);
        return postCallUnmarshalOutputStorage(
            high,
            call,
            output,
            width,
            false);
    }

    private PcodeStorage postCallUnmarshalOutputStorage(
        HighFunction high,
        PcodeOpAST call,
        PcodeStorage output,
        Integer width,
        boolean allowLocalStackDestination) {

        Long outputEnd = output == null || width == null || width <= 0
            ? null
            : addExactOrNull(output.offset, width.longValue());
        if (high == null || call == null || output == null || outputEnd == null ||
            isParameterStorage(output)) {
            return null;
        }

        PcodeStorage selected = null;
        boolean afterCall = false;
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            if (!afterCall) {
                afterCall = operation == call;
                continue;
            }
            if (operation.getOpcode() == PcodeOp.CALL) {
                PcodeStorage nextOutput = provenUnmarshalOutputStorage(operation);
                if (storageRangesOverlap(
                        output,
                        width,
                        nextOutput,
                        width)) {
                    break;
                }
                continue;
            }
            boolean memoryStore = operation.getOpcode() == PcodeOp.STORE &&
                operation.getNumInputs() >= 3;
            boolean directStorageAssignment =
                isDirectPcodeStorageAssignment(operation);
            if (!memoryStore && !directStorageAssignment) {
                continue;
            }
            PcodeStorage destination = memoryStore
                ? pcodeStorageExpression(operation.getInput(1))
                : pcodeStorageExpression(operation.getOutput());
            Varnode storedValue = memoryStore
                ? operation.getInput(2)
                : operation.getOutput();
            Long sourceOffset = pcodeValueStorageOffsetInRange(
                storedValue,
                output,
                outputEnd,
                new LinkedHashSet<>(),
                0);
            int destinationByteOffset = 0;
            if (sourceOffset == null) {
                PcodeValueStorageLane lane = pcodeValueStorageLaneInRange(
                    storedValue,
                    output,
                    outputEnd,
                    new LinkedHashSet<>(),
                    0);
                if (lane != null) {
                    sourceOffset = lane.sourceOffset();
                    destinationByteOffset = lane.valueOffset();
                    runMetrics.increment("packedPostCallOutputByteLaneProofs");
                }
            }
            boolean allowedDestination = isParameterStorage(destination) ||
                allowLocalStackDestination && destination != null &&
                    "stack".equals(destination.base);
            if (!allowedDestination || sourceOffset == null) {
                continue;
            }
            long relative = sourceOffset - output.offset;
            PcodeStorage root;
            try {
                root = destination.plus(Math.subtractExact(
                    (long)destinationByteOffset,
                    relative));
            }
            catch (ArithmeticException ignored) {
                return null;
            }
            if (isParameterStorage(root) &&
                    (root.offset < 0L || root.offset > 0x100000L) ||
                selected != null && !selected.sameLocation(root)) {
                return null;
            }
            selected = root;
            if (directStorageAssignment) {
                runMetrics.increment("postCallDirectStorageAssignmentProofs");
            }
        }
        return selected;
    }

    private boolean storageRangesOverlap(
        PcodeStorage left,
        Integer leftWidth,
        PcodeStorage right,
        Integer rightWidth) {

        if (left == null || right == null ||
            leftWidth == null || leftWidth <= 0 ||
            rightWidth == null || rightWidth <= 0 ||
            !Objects.equals(left.base, right.base)) {
            return false;
        }
        Long leftEnd = addExactOrNull(left.offset, leftWidth.longValue());
        Long rightEnd = addExactOrNull(right.offset, rightWidth.longValue());
        return leftEnd != null && rightEnd != null &&
            left.offset < rightEnd && right.offset < leftEnd;
    }

    private Long pcodeValueStorageOffsetInRange(
        Varnode value,
        PcodeStorage expected,
        long expectedEnd,
        Set<String> active,
        int depth) {

        if (value == null || expected == null || depth > 48 ||
            !active.add(pcodeNodeKey(value))) {
            return null;
        }
        PcodeStorage loaded = pcodeLoadedStorageExpression(value);
        Long loadedEnd = loaded == null
            ? null
            : addExactOrNull(loaded.offset, (long)value.getSize());
        if (loaded != null && loadedEnd != null &&
            Objects.equals(loaded.base, expected.base) &&
            loaded.offset >= expected.offset && loadedEnd <= expectedEnd) {
            return loaded.offset;
        }

        PcodeOp definition = value.getDef();
        if (definition == null ||
            definition.getOpcode() == PcodeOp.CALL ||
            definition.getOpcode() == PcodeOp.CALLIND) {
            return null;
        }
        if (definition.getOpcode() == PcodeOp.SUBPIECE &&
            definition.getNumInputs() == 2 &&
            definition.getInput(1).isConstant()) {
            Long source = pcodeValueStorageOffsetInRange(
                definition.getInput(0),
                expected,
                expectedEnd,
                new LinkedHashSet<>(active),
                depth + 1);
            long byteOffset = definition.getInput(1).getOffset();
            Long shifted = source == null
                ? null
                : addExactOrNull(source, byteOffset);
            Long shiftedEnd = shifted == null
                ? null
                : addExactOrNull(shifted, (long)value.getSize());
            return shifted != null && shiftedEnd != null &&
                shifted >= expected.offset && shiftedEnd <= expectedEnd
                ? shifted
                : null;
        }
        if (definition.getOpcode() == PcodeOp.PIECE) {
            ArrayList<long[]> ranges = new ArrayList<>();
            for (int slot = 0; slot < definition.getNumInputs(); slot++) {
                Varnode input = definition.getInput(slot);
                Long source = pcodeValueStorageOffsetInRange(
                    input,
                    expected,
                    expectedEnd,
                    new LinkedHashSet<>(active),
                    depth + 1);
                Long end = source == null
                    ? null
                    : addExactOrNull(source, (long)input.getSize());
                if (source == null || end == null) {
                    return null;
                }
                ranges.add(new long[] { source, end });
            }
            ranges.sort((left, right) -> Long.compare(left[0], right[0]));
            long start = ranges.get(0)[0];
            long covered = start;
            for (long[] range : ranges) {
                if (range[0] != covered || range[1] <= range[0]) {
                    return null;
                }
                covered = range[1];
            }
            Long expectedPieceEnd = addExactOrNull(start, (long)value.getSize());
            return expectedPieceEnd != null && covered == expectedPieceEnd &&
                start >= expected.offset && covered <= expectedEnd
                ? start
                : null;
        }
        Long selected = null;
        for (int slot = 0; slot < definition.getNumInputs(); slot++) {
            Varnode input = definition.getInput(slot);
            if (input == null || input.isConstant()) {
                continue;
            }
            Long candidate = pcodeValueStorageOffsetInRange(
                input,
                expected,
                expectedEnd,
                new LinkedHashSet<>(active),
                depth + 1);
            if (candidate == null) {
                continue;
            }
            if (selected != null && !selected.equals(candidate)) {
                return null;
            }
            selected = candidate;
        }
        return selected;
    }
