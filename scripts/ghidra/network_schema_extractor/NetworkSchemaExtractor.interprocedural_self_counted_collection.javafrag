    /**
     * Maps a helper that owns its count read back onto the caller's output.
     * The count-bounded loop is recovered inside the helper; the caller has no
     * separate count storage to bind.
     */
    private InterproceduralCollectionCall selfCountedCollectionCall(
        Function caller,
        PcodeOpAST call,
        Function helper,
        Map<String, PcodeStorage> callerParamStorage) {

        Map<String, CollectionOutputShape> shapes =
            collectionOutputShapesByParameterFromPcode(helper);
        if (shapes.size() != 1) {
            recordNestedTypeShapeReject(shapes.isEmpty()
                ? "self-counted-collection-output-unrecovered"
                : "self-counted-collection-output-ambiguous");
            return null;
        }
        CollectionOutputShape shape = shapes.values().iterator().next();
        if (shape.wireEvidence == null || shape.storage == null ||
            shape.storage.offset != 0L) {
            return null;
        }
        if (!selfCountedCollectionOwnsCompleteWireProduct(helper, shape)) {
            recordNestedTypeShapeReject(
                "self-counted-collection-is-nested-member");
            return null;
        }
        Integer slot = formalParameterSlot(shape.storage);
        if (slot == null) {
            recordNestedTypeShapeReject(
                "self-counted-collection-owner-parameter-unproven");
            return null;
        }
        PcodeStorage owner = translatedAbsoluteHelperStorage(
            provenCallArgumentStorage(caller, call, helper, slot),
            callerParamStorage);
        if (owner == null) {
            recordNestedTypeShapeReject(
                "self-counted-collection-owner-argument-unresolved");
            return null;
        }
        return new InterproceduralCollectionCall(
            owner,
            null,
            shape.storageKind,
            shape.wireEvidence);
    }

    /**
     * A self-counted helper can be promoted to the whole call only when its
     * recovered count and element calls consume the complete wire product.
     * Composite helpers often contain one nested vector alongside scalar or
     * fixed-sequence members; promoting that descendant would discard those
     * siblings from the caller's codec trace.
     */
    private boolean selfCountedCollectionOwnsCompleteWireProduct(
        Function helper,
        CollectionOutputShape shape) {

        List<String> readBuffers = readBufferParameters(helper);
        if (readBuffers.size() != 1) {
            return false;
        }
        HighFunction high = highFunction(helper);
        if (high == null) {
            return false;
        }
        List<PcodeOpAST> operations = orderedPcodeOps(high);
        PcodeStorage readBuffer = new PcodeStorage(readBuffers.get(0), 0L);
        LinkedHashSet<Address> ownedCallsites = new LinkedHashSet<>(
            shape.codecCallsites);
        ownedCallsites.add(shape.countCallsite);
        for (PcodeOpAST operation : operations) {
            codecWireTraceCheckpoint();
            if (operation.getOpcode() != PcodeOp.CALL ||
                ownedCallsites.contains(operation.getSeqnum().getTarget())) {
                continue;
            }
            Function target = pcodeCallTarget(operation);
            if (target == null) {
                continue;
            }
            PcodeStorage targetReadBuffer = callTargetReadBufferStorage(
                high,
                operations,
                operation,
                target,
                readBuffer,
                new LinkedHashSet<>());
            if (targetReadBuffer != null) {
                return false;
            }
        }
        return true;
    }
