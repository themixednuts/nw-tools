    private boolean hasStructuredContainerValue(
        List<String> deltaShapes,
        List<String> fullShapes) {

        if (pairedContainerWireShapeFromDeltaKeyAndFullValue(deltaShapes, fullShapes) != null) {
            return false;
        }
        return stripTrailingContainerCount(replicatedContainerFullValueShapes(fullShapes)).size() > 1;
    }

    private WireShape scalarContainerWireShape(ContainerWireShape container) {
        return container == null ? null : container.primaryShape;
    }

    private List<String> wireEvidenceTokens(List<WireShape> evidence) {
        return evidence.stream()
            .map(item -> item.shape == null ? item.layout : item.shape)
            .filter(Objects::nonNull)
            .toList();
    }

    private List<String> provenWireShapes(List<WireShape> evidence) {
        return evidence.stream().allMatch(WireShape::hasProvenSemantics)
            ? evidence.stream().map(item -> item.shape).toList()
            : Collections.emptyList();
    }

    private List<String> wireLayouts(List<WireShape> evidence) {
        return evidence.stream()
            .map(item -> item.layout)
            .filter(Objects::nonNull)
            .toList();
    }

    private WireShape pairedContainerWireShapeFromDeltaKeyAndFullValue(
        List<String> deltaShapes,
        List<String> fullShapes) {

        String keyShape = replicatedContainerDeltaKeyShape(deltaShapes);
        if (keyShape == null) {
            return null;
        }
        List<String> fullValueShapes =
            collapseWholeFloatVectorValue(stripTrailingContainerCount(
                replicatedContainerFullValueShapes(fullShapes)));
        boolean fullIncludesKey = fullValueShapes.size() >= 2 &&
            keyShape.equals(fullValueShapes.get(0));
        if (fullIncludesKey) {
            fullValueShapes = collapseWholeFloatVectorValue(
                stripTrailingContainerCount(
                    fullValueShapes.subList(1, fullValueShapes.size())));
        }
        if (fullValueShapes.isEmpty()) {
            return null;
        }
        String valueShape = fullValueShapes.size() == 1
            ? fullValueShapes.get(0)
            : "composite<" + String.join(",", fullValueShapes) + ">";
        return WireShape.semantic(
            containerShape(keyShape, valueShape),
            fullIncludesKey
                ? "replicated-container-delta-key-full-key-product"
                : "replicated-container-delta-key-full-product");
    }

    private String containerShapeFromDeltaMarshalShapes(List<String> shapes) {
        int sequenceIndex = containerSequenceMarkerIndex(shapes);
        if (sequenceIndex < 0) {
            return null;
        }
        String keyShape = previousDataShape(shapes, sequenceIndex);
        List<String> valueShapes = replicatedContainerDeltaValueShapes(shapes);
        String valueShape = valueShapes.size() == 1
            ? valueShapes.get(0)
            : nextDataShape(shapes, sequenceIndex + 1);
        return containerShape(keyShape, valueShape);
    }

    private String containerShapeFromFullMarshalShapes(List<String> shapes) {
        List<String> valueShapes = replicatedContainerFullValueShapes(shapes);
        String keyShape = valueShapes.size() >= 2 ? valueShapes.get(0) : null;
        String valueShape = valueShapes.size() >= 2 ? valueShapes.get(1) : null;
        return containerShape(keyShape, valueShape);
    }

    private String containerShape(String keyShape, String valueShape) {
        if (keyShape == null || valueShape == null) {
            return null;
        }
        return "replicated-container<" + keyShape + "," + valueShape + ">";
    }

    private WireShape completeFullContainerIndexMapWireShape(FullContainerPlan plan) {
        if (plan == null || plan.storageKind != ContainerStorageKind.INDEX_MAP ||
            plan.unmarshalReconciliation == null ||
            !plan.unmarshalReconciliation.startsWith("complete-") ||
            plan.keyCodecs.isEmpty() || plan.valueCodecs.isEmpty()) {
            return null;
        }
        List<ContainerCodecCall> keys = logicalContainerCodecLeaves(plan.keyCodecs);
        List<ContainerCodecCall> values = logicalContainerCodecLeaves(plan.valueCodecs);
        WireShape key = sequenceElementWireEvidence(keys);
        WireShape value = sequenceElementWireEvidence(values);
        if (key == null || value == null || !key.hasProvenSemantics() ||
            !value.hasProvenSemantics() ||
            !isScalarContainerPlanWireEvidence(key) ||
            !isScalarContainerPlanWireEvidence(value)) {
            return null;
        }
        String shape = containerShape(key.shape, value.shape);
        String layout = containerShape(key.layout, value.layout);
        if (shape == null || layout == null) {
            return null;
        }
        runMetrics.increment("completeContainerPlansPromotedToWireShapes");
        return WireShape.semantic(
            shape,
            layout,
            "full-container-plan+unmarshal-agreement");
    }

    private boolean isScalarContainerPlanWireEvidence(WireShape evidence) {
        if (evidence == null || !evidence.hasProvenSemantics() ||
            isAggregateWireEvidence(evidence)) {
            return false;
        }
        for (String candidate : new String[] {evidence.shape, evidence.layout}) {
            if (candidate == null || candidate.isBlank() ||
                "class-value".equals(candidate) ||
                "actor-instantiation-parameters".equals(candidate)) {
                return false;
            }
        }
        return true;
    }

    private void collectOrderedMarshalShapes(
        Address address,
        String writeBufferParameter,
        ArrayList<WireShape> shapes) {

        NetworkSchemaFlowSequence.Result<WireShape> sequence = marshalShapeSequence(
            address,
            writeBufferParameter,
            new LinkedHashSet<>());
        if (sequence.complete()) {
            shapes.addAll(sequence.events());
        }
    }

    private NetworkSchemaFlowSequence.Result<WireShape> marshalShapeSequence(
        Address address,
        String writeBufferParameter,
        Set<String> activeContexts) {

        Address targetAddress = resolvedCodeTarget(address);
        if (!isExecutableAddress(targetAddress) || writeBufferParameter == null) {
            return marshalShapeSequenceFailure(
                NetworkSchemaFlowSequence.Status.NO_TERMINATING_PATH);
        }

        Function function = functionAtOrContaining(targetAddress);
        if (function == null) {
            return marshalShapeSequenceFailure(
                NetworkSchemaFlowSequence.Status.NO_TERMINATING_PATH);
        }
        WireShape leaf = validatedMarshalLeaf(function, writeBufferParameter);
        if (leaf != null) {
            return new NetworkSchemaFlowSequence.Result<>(
                NetworkSchemaFlowSequence.Status.COMPLETE,
                List.of(leaf));
        }
        String context = function.getEntryPoint() + "|" + writeBufferParameter;
        if (!activeContexts.add(context)) {
            return marshalShapeSequenceFailure(
                NetworkSchemaFlowSequence.Status.CYCLIC_EVENTS);
        }
        try {
            HighFunction high = highFunction(function);
            if (high == null) {
                return marshalShapeSequenceFailure(
                    NetworkSchemaFlowSequence.Status.NO_TERMINATING_PATH);
            }
            Map<PcodeBlockBasic, List<WireShape>> shapesByBlock = new HashMap<>();
            PcodeStorage writeBuffer = new PcodeStorage(writeBufferParameter, 0L);
            for (PcodeOpAST op : orderedPcodeOps(high)) {
                if (op.getOpcode() == PcodeOp.CALL) {
                    Function called = pcodeCallTarget(op);
                    Integer pcodeSlot = uniqueCallArgumentSlot(op, writeBuffer);
                    if (called == null) {
                        if (pcodeSlot != null) {
                            return marshalShapeSequenceFailure(
                                NetworkSchemaFlowSequence.Status.NO_TERMINATING_PATH);
                        }
                        continue;
                    }
                    Integer writeBufferSlot = provenCallArgumentSlot(
                        function,
                        op,
                        called,
                        writeBuffer);
                    if (writeBufferSlot == null) {
                        continue;
                    }
                    String calledBufferParameter = "param_" + writeBufferSlot;
                    WireShape calledLeaf = validatedMarshalLeaf(
                        called,
                        calledBufferParameter);
                    if (calledLeaf != null) {
                        if (!addMarshalShapesForOperation(
                                shapesByBlock,
                                op,
                                List.of(calledLeaf))) {
                            return marshalShapeSequenceFailure(
                                NetworkSchemaFlowSequence.Status.NO_TERMINATING_PATH);
                        }
                        continue;
                    }
                    NetworkSchemaFlowSequence.Result<WireShape> nested =
                        marshalShapeSequence(
                        called.getEntryPoint(),
                        calledBufferParameter,
                        activeContexts);
                    if (!nested.complete()) {
                        return nested;
                    }
                    if (!addMarshalShapesForOperation(
                            shapesByBlock,
                            op,
                            nested.events())) {
                        return marshalShapeSequenceFailure(
                            NetworkSchemaFlowSequence.Status.NO_TERMINATING_PATH);
                    }
                    continue;
                }
                if (op.getOpcode() == PcodeOp.CALLIND) {
                    Integer byteLength = provenVirtualRawWriteLength(
                        function,
                        op,
                        writeBufferParameter);
                    if (byteLength != null) {
                        boolean normalizedBoolean = byteLength == Byte.BYTES &&
                            rawWriteArgumentIsNormalizedBoolean(function, op);
                        WireShape rawWrite = normalizedBoolean
                            ? WireShape.semantic(
                                "bool",
                                fixedByteLayout(byteLength),
                                "marshal-pcode-normalized-boolean-write")
                            : WireShape.layout(
                                fixedByteLayout(byteLength),
                                "marshal-pcode-raw-width-layout");
                        if (!addMarshalShapesForOperation(
                                shapesByBlock,
                                op,
                                List.of(rawWrite))) {
                            return marshalShapeSequenceFailure(
                                NetworkSchemaFlowSequence.Status.NO_TERMINATING_PATH);
                        }
                    }
                }
            }
            NetworkSchemaFlowSequence.Result<WireShape> sequence =
                NetworkSchemaFlowSequence.analyze(
                high,
                shapesByBlock,
                this::sameWireEvidence);
            return collapseValidatedMarshalSequence(function, sequence);
        }
        finally {
            activeContexts.remove(context);
        }
    }

    private boolean addMarshalShapesForOperation(
        Map<PcodeBlockBasic, List<WireShape>> shapesByBlock,
        PcodeOpAST operation,
        List<WireShape> shapes) {

        if (shapes.isEmpty()) {
            return true;
        }
        PcodeBlockBasic block = NetworkSchemaControlFlow.parentBlock(operation);
        if (block == null) {
            return false;
        }
        shapesByBlock.computeIfAbsent(block, ignored -> new ArrayList<>()).addAll(shapes);
        return true;
    }

    private NetworkSchemaFlowSequence.Result<WireShape> marshalShapeSequenceFailure(
        NetworkSchemaFlowSequence.Status status) {

        return new NetworkSchemaFlowSequence.Result<>(status, List.of());
    }

    private List<PcodeOpAST> orderedPcodeOps(HighFunction high) {
        return NetworkSchemaControlFlow.orderedOperations(high);
    }

    private Integer pcodeVirtualRawWriteLength(PcodeOp op, String writeBufferParameter) {
        if (op == null || op.getOpcode() != PcodeOp.CALLIND || op.getNumInputs() < 2) {
            return null;
        }
        PcodeVirtualDispatch target = pcodeVirtualDispatch(op.getInput(0));
        if (target == null || target.objectOffset() != 0L ||
            target.slotOffset() != 0x40L ||
            !target.root().isStorage(writeBufferParameter)) {
            return null;
        }

        if (op.getNumInputs() <= 3) {
            return null;
        }
        Long byteLength = NetworkSchemaIntegerEvaluator.evaluate(op.getInput(3));
        return byteLength != null && byteLength > 0L && byteLength <= 0x1000L
            ? byteLength.intValue()
            : null;
    }

    private String fixedByteLayout(int length) {
        return "fixed-bytes-" + length;
    }

    private String previousDataShape(List<String> shapes, int beforeIndex) {
        for (int i = beforeIndex - 1; i >= 0; i--) {
            String shape = shapes.get(i);
            if (isReplicatedContainerDataShape(shape)) {
                return shape;
            }
        }
        return null;
    }

    private String nextDataShape(List<String> shapes, int startIndex) {
        for (int i = startIndex; i < shapes.size(); i++) {
            String shape = shapes.get(i);
            if (isReplicatedContainerDataShape(shape)) {
                return shape;
            }
        }
        return null;
    }

    private boolean isReplicatedContainerDataShape(String shape) {
        return shape != null &&
            !"vlq-u32".equals(shape) &&
            !isContainerSequenceMarker(shape);
    }

    private int containerSequenceMarkerIndex(List<String> shapes) {
        if (shapes == null) {
            return -1;
        }
        for (int index = 0; index < shapes.size(); index++) {
            if (isContainerSequenceMarker(shapes.get(index))) {
                return index;
            }
        }
        return -1;
    }

    private boolean isContainerSequenceMarker(String shape) {
        return "sequence-number".equals(shape) || "optional<vlq-u64>".equals(shape);
    }

    private WireShape classifyMarshalPath(
        Address address,
        HandlerWireShapeEvidence handlerEvidence) {

        Address targetAddress = resolvedCodeTarget(address);
        Function function = isExecutableAddress(targetAddress)
            ? functionAtOrContaining(targetAddress)
            : null;
        WireShape fixedArray = fixedArrayLoopWireShape(
            function,
            "param_2",
            NetworkSchemaCodecClassifier.CodecDirection.ENCODE);
        if (fixedArray != null) {
            return fixedArray;
        }
        FixedSequenceShape fixedSequence = fixedSequenceShape(
            function,
            "param_2",
            NetworkSchemaCodecClassifier.CodecDirection.ENCODE);
        if (fixedSequence != null && fixedSequence.wireEvidence != null) {
            handlerEvidence.marshalSequence = fixedSequence;
            return fixedSequence.wireEvidence;
        }
        WireShape countedSequence = handlerCountedMarshalShape(
            function,
            "param_2");
        if (countedSequence != null) {
            return countedSequence;
        }
        ArrayList<WireShape> shapes = new ArrayList<>();
        collectOrderedMarshalShapes(address, "param_2", shapes);
        WireShape packedPosition = packedPositionMarshalShape(function, shapes);
        if (packedPosition != null) {
            return packedPosition;
        }
        return orderedWireEvidence(shapes, "marshal-cfg-exact-call-stack");
    }

    private String marshalFunctionTemplateType(String name) {
        if (name == null ||
            (!name.contains("::Marshal") && !name.contains("::Unmarshal"))) {
            return null;
        }

        int templateStart = marshalClassTemplateStart(name);
        if (templateStart < 0) {
            templateStart = marshalMethodTemplateStart(name);
        }
        int templateEnd = NetworkSchemaText.matchingIndex(name, templateStart, '<', '>');
        if (templateStart < 0 || templateEnd < 0) {
            return null;
        }

        String nativeType = name.substring(templateStart + 1, templateEnd).trim();
        return nativeType.isEmpty() ? null : nativeType;
    }

    private int marshalClassTemplateStart(String name) {
        int marshaller = name.indexOf("Marshaller<");
        if (marshaller < 0) {
            marshaller = name.indexOf("Marshaler<");
        }
        return marshaller < 0 ? -1 : name.indexOf('<', marshaller);
    }

    private int marshalMethodTemplateStart(String name) {
        int method = name.indexOf("::Marshal<");
        if (method < 0) {
            method = name.indexOf("::Unmarshal<");
        }
        return method < 0 ? -1 : name.indexOf('<', method);
    }

    private Address absoluteAddress(long value) {
        return currentProgram.getAddressFactory()
            .getDefaultAddressSpace()
            .getAddress(value);
    }

    private Address subtract(Address address, long value) {
        if (address == null) {
            return null;
        }
        return absoluteAddress(address.getOffset() - value);
    }

    private boolean isVtableLike(Address address) {
        if (!isProgramAddress(address)) {
            return false;
        }
        int executableSlots = 0;
        for (int slot = 0; slot < 4; slot++) {
            Address target = readPointer(address.add(slot * 8L));
            if (target != null && isExecutableAddress(target)) {
                executableSlots++;
            }
        }
        return executableSlots >= 3;
    }

    private boolean isExecutableAddress(Address address) {
        if (!isProgramAddress(address)) {
            return false;
        }
        MemoryBlock block = currentProgram.getMemory().getBlock(address);
        return block != null && block.isExecute();
    }

    private Address callTarget(Instruction instruction) {
        Address[] flows = instruction.getFlows();
        if (flows != null) {
            for (Address flow : flows) {
                if (isProgramAddress(flow)) {
                    return flow;
                }
            }
        }
        for (Reference reference : instruction.getReferencesFrom()) {
            if (reference.getReferenceType().isCall() && isProgramAddress(reference.getToAddress())) {
                return reference.getToAddress();
            }
        }
        return null;
    }

    private Address referencedAddress(Instruction instruction) {
        List<Address> addresses = referencedAddresses(instruction);
        return addresses.isEmpty() ? null : addresses.get(0);
    }

    private Address referencedAddress(Instruction instruction, int operandIndex) {
        List<Address> addresses = referencedAddresses(instruction, operandIndex);
        return addresses.isEmpty() ? null : addresses.get(0);
    }

    private List<Address> referencedAddresses(Instruction instruction) {
        LinkedHashSet<Address> result = new LinkedHashSet<>();
        for (Reference reference : instruction.getReferencesFrom()) {
            Address to = reference.getToAddress();
            if (isProgramAddress(to)) {
                result.add(to);
            }
        }
        for (int i = 0; i < instruction.getNumOperands(); i++) {
            for (Object object : NetworkSchemaX86.operandObjects(instruction, i)) {
                if (object instanceof Address address && isProgramAddress(address)) {
                    result.add(address);
                }
            }
            Address computed = computedOperandAddress(instruction, i);
            if (isProgramAddress(computed)) {
                result.add(computed);
            }
        }
        for (Address address : pcodeConstantAddresses(instruction)) {
            result.add(address);
        }
        return new ArrayList<>(result);
    }

    private List<Address> referencedAddresses(Instruction instruction, int operandIndex) {
        LinkedHashSet<Address> result = new LinkedHashSet<>();
        for (Reference reference : instruction.getReferencesFrom()) {
            if (reference.getOperandIndex() != operandIndex) {
                continue;
            }
            Address to = reference.getToAddress();
            if (isProgramAddress(to)) {
                result.add(to);
            }
        }

        for (Object object : NetworkSchemaX86.operandObjects(instruction, operandIndex)) {
            if (object instanceof Address address && isProgramAddress(address)) {
                result.add(address);
            }
        }

        Address computed = computedOperandAddress(instruction, operandIndex);
        if (isProgramAddress(computed)) {
            result.add(computed);
        }
        return new ArrayList<>(result);
    }

    private List<Address> pcodeConstantAddresses(Instruction instruction) {
        LinkedHashSet<Address> result = new LinkedHashSet<>();
        try {
            for (PcodeOp op : instruction.getPcode()) {
                collectPcodeAddress(result, op.getOutput());
                for (int i = 0; i < op.getNumInputs(); i++) {
                    collectPcodeAddress(result, op.getInput(i));
                }
            }
        }
        catch (Exception ignored) {
            return List.of();
        }
        return new ArrayList<>(result);
    }

    private void collectPcodeAddress(Set<Address> result, Varnode node) {
        if (node == null) {
            return;
        }
        Address nodeAddress = node.getAddress();
        if (isProgramAddress(nodeAddress)) {
            result.add(nodeAddress);
        }
        if (node.isConstant()) {
            Address address = absoluteAddress(node.getOffset());
            if (isProgramAddress(address)) {
                result.add(address);
            }
        }
    }

    private Address computedOperandAddress(Instruction instruction, int operandIndex) {
        Object[] objects = NetworkSchemaX86.operandObjects(instruction, operandIndex);
        boolean ripRelative = false;
        boolean hasNonRipRegister = false;
        long displacement = 0;
        Address absoluteCandidate = null;

        for (Object object : objects) {
            if (object instanceof Register register) {
                String name = NetworkSchemaX86.canonicalRegisterName(register.getName());
                if ("RIP".equals(name) || "EIP".equals(name)) {
                    ripRelative = true;
                }
                else {
                    hasNonRipRegister = true;
                }
            }
            else if (object instanceof Scalar scalar) {
                long signed = scalar.getSignedValue();
                displacement += signed;

                Address candidate = absoluteAddress(scalar.getUnsignedValue());
                if (isProgramAddress(candidate)) {
                    absoluteCandidate = candidate;
                }
            }
        }

        if (ripRelative) {
            long next = instruction.getMinAddress().getOffset() + instruction.getLength();
            Address computed = absoluteAddress(next + displacement);
            if (isProgramAddress(computed)) {
                return computed;
            }
        }

        return hasNonRipRegister ? null : absoluteCandidate;
    }

    private TrackedValue trackedLeaValue(
        Instruction instruction,
        ForwardArgState state) {

        Integer offset = trackedThisOffsetForMemoryOperand(instruction, 1, state.registers);
        if (offset != null) {
            return TrackedValue.thisOffset(offset);
        }

        MemoryReference memory = NetworkSchemaX86.memoryReference(instruction, 1);
        Integer stackOffset = stackSlotOffset(memory, state);
        if (stackOffset != null) {
            return TrackedValue.stackOffset(stackOffset);
        }

        TrackedValue baseOffset = trackedBaseOffsetForMemoryOperand(instruction, 1, state.registers);
        if (baseOffset != null) {
            return baseOffset;
        }

        TrackedValue dependencies = trackedAddressDependenciesForMemoryOperand(
            instruction,
            1,
            state.registers);
        if (dependencies != null) {
            return dependencies;
        }

        Long immediate = trackedImmediateForMemoryOperand(instruction, 1, state.registers);
        if (immediate != null) {
            return TrackedValue.immediate(immediate);
        }

        Address address = referencedAddress(instruction, 1);
        if (address != null) {
            return TrackedValue.address(address);
        }
        return null;
    }

    private TrackedValue trackedOperandValue(
        Instruction instruction,
        int operandIndex,
        ForwardArgState state) {

        String sourceRegister = NetworkSchemaX86.registerOperand(instruction, operandIndex);
        if (sourceRegister != null) {
            TrackedValue value = state.registers.get(sourceRegister);
            return value == null ? null : value.copy();
        }

        TrackedValue value = trackedThisLoadValue(instruction, operandIndex, state);
        if (value != null) {
            return value;
        }

        value = trackedStackLoadValue(instruction, operandIndex, state);
        if (value != null) {
            return value;
        }

        value = trackedBaseLoadValue(instruction, operandIndex, state);
        if (value != null) {
            return value;
        }

        value = trackedFormattedFieldNamePointerLoadValue(instruction, operandIndex, state);
        if (value != null) {
            return value;
        }

        value = trackedBaseOffsetForMemoryOperand(
            instruction,
            operandIndex,
            state.registers);
        PcodeStorage dependency = pcodeStorageFromTrackedValue(value);
        if (dependency != null) {
            return TrackedValue.storageDependency(dependency);
        }

        Address address = referencedAddress(instruction, operandIndex);
        if (address != null) {
            return TrackedValue.address(address);
        }

        String sourceText = NetworkSchemaX86.operandText(instruction, operandIndex);
        if (sourceText != null && sourceText.contains("[")) {
            return null;
        }

        Long immediate = literalOperandValue(instruction, operandIndex);
        return immediate == null ? null : TrackedValue.immediate(immediate);
    }

    private Integer trackedThisOffsetForMemoryOperand(
        Instruction instruction,
        int operandIndex,
        Map<String, TrackedValue> registers) {

        MemoryAddress memory = NetworkSchemaX86.memoryAddress(instruction, operandIndex);
        if (memory == null) {
            return null;
        }
        boolean sawThisBase = false;
        int displacement = 0;
        int thisBaseOffset = 0;
        for (MemoryTerm term : memory.terms) {
            if ("RIP".equals(term.register) || "RSP".equals(term.register)) {
                return null;
            }

            TrackedValue value = registers.get(term.register);
            if (value == null) {
                return null;
            }
            if (value.thisOffset != null) {
                if (sawThisBase || term.scale != 1) {
