        if (node == null) {
            return null;
        }
        String key = "vector-owner:" + pcodeNodeKey(node);
        if (!seen.add(key)) {
            return null;
        }

        PcodeStorage loaded = pcodeLoadedStorageExpression(node);
        if (isVectorOwnerStorage(loaded)) {
            return loaded;
        }

        PcodeOp def = node.getDef();
        if (def == null) {
            return null;
        }
        switch (def.getOpcode()) {
            case PcodeOp.LOAD: {
                PcodeStorage storage = pcodeStorageExpression(def.getInput(1));
                return isVectorOwnerStorage(storage) ? storage : null;
            }
            case PcodeOp.COPY:
            case PcodeOp.CAST:
            case PcodeOp.SUBPIECE:
            case PcodeOp.INDIRECT:
            case PcodeOp.INT_ZEXT:
            case PcodeOp.INT_SEXT:
                return def.getNumInputs() == 0
                    ? null
                    : vectorOwnerStorageForElementPointer(
                        def.getInput(0),
                        seen,
                        depth + 1);
            case PcodeOp.PTRADD:
            case PcodeOp.PTRSUB:
            case PcodeOp.INT_ADD:
            case PcodeOp.INT_SUB:
                return mergedVectorOwnerStorage(def, seen, depth + 1, true);
            case PcodeOp.MULTIEQUAL:
                return mergedVectorOwnerStorage(def, seen, depth + 1, true);
            default:
                return null;
        }
    }

    private PcodeStorage mergedVectorOwnerStorage(
        PcodeOp def,
        Set<String> seen,
        int depth,
        boolean allowSingleKnownInput) {

        PcodeStorage merged = null;
        int known = 0;
        for (int i = 0; i < def.getNumInputs(); i++) {
            PcodeStorage storage = vectorOwnerStorageForElementPointer(
                def.getInput(i),
                new LinkedHashSet<>(seen),
                depth);
            if (storage == null) {
                continue;
            }
            known++;
            if (merged == null) {
                merged = storage;
            }
            else if (!merged.sameLocation(storage)) {
                return null;
            }
        }
        return known > 0 && (allowSingleKnownInput || known == def.getNumInputs())
            ? merged
            : null;
    }

    private boolean isVectorOwnerStorage(PcodeStorage storage) {
        if (storage == null || storage.offset != 0L) {
            return false;
        }
        if (storage.base != null && storage.base.matches("param_\\d+")) {
            return true;
        }
        return "stack".equals(storage.base) && stackArgumentParameterIndex(storage.offset) != null;
    }

    private String formalParameterBaseFromStorage(Function function, PcodeStorage storage) {
        if (storage == null || storage.offset != 0L && !"stack".equals(storage.base)) {
            return null;
        }
        if (storage.base != null && storage.base.matches("param_\\d+") &&
            storage.offset == 0L) {
            return storage.base;
        }
        if (!"stack".equals(storage.base)) {
            return null;
        }
        Integer index = stackArgumentParameterIndex(storage.offset);
        if (index == null) {
            return null;
        }
        return "param_" + index;
    }

    private Integer stackArgumentParameterIndex(long stackOffset) {
        if (stackOffset < 0x28 || ((stackOffset - 0x28) & 0x7L) != 0L) {
            return null;
        }
        long index = 5L + ((stackOffset - 0x28) / 8L);
        return index > Integer.MAX_VALUE ? null : (int) index;
    }

    private String nativeTypeFromWireShape(String shape) {
        if (shape == null) {
            return "unknown";
        }
        return switch (shape) {
            case "bool" -> "bool";
            case "u8" -> "AZ::u8";
            case "u16" -> "AZ::u16";
            case "u32", "vlq-u32" -> "AZ::u32";
            case "u64", "vlq-u64" -> "AZ::u64";
            case "f32" -> "float";
            case "f64" -> "double";
            case "vec2" -> "AZ::Vector2";
            case "vec3" -> "AZ::Vector3";
            case "vec4" -> "AZ::Vector4";
            case "class-value" -> "ClassValue";
            default -> shape;
        };
    }

    private boolean shouldRecurseContainerValueHelper(
        Function callTarget,
        WireShape wireEvidence) {

        return callTarget != null && wireEvidence == null;
    }

    private int containerValueExpectedShapeSpan(
        String observedShape,
        List<String> expectedShapes,
        int expectedIndex) {

        if (observedShape == null || expectedShapes == null ||
            expectedIndex < 0 || expectedIndex >= expectedShapes.size()) {
            return 0;
        }
        String expected = expectedShapes.get(expectedIndex);
        if (wireShapeMatchesExpected(expected, observedShape)) {
            return 1;
        }
        List<String> compositeShapes = compositeMemberWireShapes(observedShape);
        if (compositeShapes != null &&
            wireShapePrefixMatches(expectedShapes, expectedIndex, compositeShapes)) {
            return compositeShapes.size();
        }
        if ("vec2".equals(observedShape) &&
            expectedShapeRun(expectedShapes, expectedIndex, "f32", 2)) {
            return 2;
        }
        if ("vec3".equals(observedShape) &&
            expectedShapeRun(expectedShapes, expectedIndex, "f32", 3)) {
            return 3;
        }
        if (("vec4".equals(observedShape) || "quat".equals(observedShape)) &&
            expectedShapeRun(expectedShapes, expectedIndex, "f32", 4)) {
            return 4;
        }
        String elementShape = vectorElementWireShape(observedShape);
        if (elementShape != null && "vlq-u32".equals(expected)) {
            if (expectedIndex + 1 < expectedShapes.size() &&
                wireShapeMatchesExpected(expectedShapes.get(expectedIndex + 1), elementShape)) {
                return 2;
            }
            return 1;
        }
        return 0;
    }

    private List<String> compositeMemberWireShapes(String observedShape) {
        if (observedShape == null ||
            !observedShape.startsWith("composite<") ||
            !observedShape.endsWith(">")) {
            return null;
        }
        String inner = observedShape.substring("composite<".length(), observedShape.length() - 1);
        if (inner.trim().isEmpty()) {
            return null;
        }
        ArrayList<String> shapes = new ArrayList<>();
        for (String part : NetworkSchemaText.splitTopLevel(inner)) {
            String shape = part.trim();
            if (shape.isEmpty()) {
                return null;
            }
            shapes.add(shape);
        }
        return shapes;
    }

    private boolean expectedShapeRun(
        List<String> expectedShapes,
        int start,
        String shape,
        int count) {

        if (start + count > expectedShapes.size()) {
            return false;
        }
        for (int i = 0; i < count; i++) {
            if (!shape.equals(expectedShapes.get(start + i))) {
                return false;
            }
        }
        return true;
    }

    private String vectorElementWireShape(String observedShape) {
        if (observedShape == null ||
            !observedShape.startsWith("vec<") ||
            !observedShape.endsWith(">")) {
            return null;
        }
        String element = observedShape.substring(4, observedShape.length() - 1).trim();
        return element.isEmpty() ? null : element;
    }
