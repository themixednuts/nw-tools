    private String containerInsertionOutputParameter(
        Function owner,
        PcodeOp operation) {

        String output = uniqueLikelyOutputParameter(owner, operation);
        if (output != null) {
            return output;
        }
        PcodeStorage receiver = uniqueContainerInsertionReceiverStorage(
            owner,
            operation);
        return formalParameterBaseFromStorage(owner, receiver);
    }

    private PcodeStorage containerInsertionOutputStorage(
        Function owner,
        PcodeOp operation) {

        PcodeStorage output = uniqueLikelyOutputStorage(owner, operation);
        return output != null
            ? output
            : uniqueContainerInsertionReceiverStorage(owner, operation);
    }

    private PcodeStorage uniqueContainerInsertionReceiverStorage(
        Function owner,
        PcodeOp operation) {

        if (owner == null || operation == null ||
            !isArgumentPassingOperation(operation)) {
            return null;
        }
        Function target = pcodeCallTarget(operation);
        PcodeStorage instructionReceiver = instructionCallRegisterStorage(
            owner,
            operation,
            target,
            "RCX");
        String instructionParameter = formalParameterBaseFromStorage(
            owner,
            instructionReceiver);
        if (isProvenOutputParameterBase(owner, instructionParameter)) {
            runMetrics.increment("instructionReceiverOutputParameterProofs");
            return instructionReceiver;
        }
        PcodeStorage stagedReceiver = stagedStackSourceStorage(
            owner,
            operation,
            target,
            instructionReceiver);
        String stagedParameter = formalParameterBaseFromStorage(
            owner,
            stagedReceiver);
        if (isProvenOutputParameterBase(owner, stagedParameter) &&
            insertionTargetDereferencesReceiver(target)) {
            runMetrics.increment("stagedInsertionReceiverOutputParameterProofs");
            return stagedReceiver;
        }

        LinkedHashMap<String, PcodeStorage> candidates = new LinkedHashMap<>();
        if (operation.getNumInputs() > 1) {
            addContainerInsertionReceiverCandidate(
                owner,
                candidates,
                pcodeStorageExpression(operation.getInput(1)));
        }
        addContainerInsertionReceiverCandidate(
            owner,
            candidates,
            provenCallArgumentStorage(owner, operation, target, 1));
        for (PcodeStorage dependency : instructionCallArgumentStorageDependencies(
                owner,
                operation,
                target,
                1)) {
            addContainerInsertionReceiverCandidate(owner, candidates, dependency);
        }
        if (candidates.isEmpty()) {
            return null;
        }
        PcodeStorage selected = candidates.values().iterator().next();
        if (candidates.values().stream().anyMatch(candidate ->
                !selected.sameLocation(candidate))) {
            return null;
        }
        runMetrics.increment("instructionReceiverOutputParameterProofs");
        return selected;
    }

    private boolean insertionTargetDereferencesReceiver(Function target) {
        HighFunction high = highFunction(target);
        if (high == null) {
            return false;
        }
        int pointerSize = currentProgram.getDefaultPointerSize();
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            checkAnalysisCancelled();
            if (operation.getOpcode() != PcodeOp.LOAD ||
                operation.getNumInputs() < 2 || operation.getOutput() == null ||
                operation.getOutput().getSize() != pointerSize) {
                continue;
            }
            PcodeMemoryPath source = pcodeMemoryPath(operation.getInput(1), 0);
            if (source == null || source.root().storageBase() == null ||
                !"param_1".equals(source.root().storageBase()) ||
                !source.dereferenceOffsets().isEmpty() || source.offset() != 0L) {
                continue;
            }
            runMetrics.increment("insertionTargetReceiverDereferenceProofs");
            return true;
        }
        return false;
    }

    private void addContainerInsertionReceiverCandidate(
        Function owner,
        Map<String, PcodeStorage> candidates,
        PcodeStorage storage) {

        String parameter = formalParameterBaseFromStorage(owner, storage);
        if (isProvenOutputParameterBase(owner, parameter)) {
            candidates.putIfAbsent(storageKey(storage), storage);
        }
    }

    /**
     * Reconstructs a native index-map key/value boundary from the insertion
     * ABI. The caller decodes a flat wire sequence into adjacent stack
     * aggregates, then passes pointer-to-pointer arguments for the key and
     * value to the insertion helper. A separate direct key argument is used by
     * that helper for hashing/equality and disambiguates the two aggregates.
     */
    private WireShape countedIndexMapWireEvidence(
        Function owner,
        HighFunction high,
        PcodeOpAST insertion,
        List<PcodeCodecCall> codecs,
        WireShape sequence) {

        if (owner == null || high == null || insertion == null ||
            codecs == null || codecs.size() < 2 || sequence == null) {
            return null;
        }
        Function target = pcodeCallTarget(insertion);
        if (target == null) {
            return null;
        }

        ArrayList<IndexMapInsertionSource> copiedSources = new ArrayList<>();
        int argumentCount = provenCallArgumentCandidateCount(
            owner,
            insertion,
            target);
        for (int slot = 1; slot <= argumentCount; slot++) {
            Integer copiedWidth = insertionTargetParameterReadSpan(
                target,
                slot,
                true);
            if (copiedWidth == null) {
                continue;
            }
            PcodeStorage staging = provenCallArgumentStorage(
                owner,
                insertion,
                target,
                slot);
            PcodeStorage source = stagedStackDependencyStorage(
                owner,
                insertion,
                target,
                staging);
            if (source == null || !"stack".equals(source.base) ||
                source.sameLocation(staging)) {
                continue;
            }
            copiedSources.add(new IndexMapInsertionSource(
                slot,
                source,
                copiedWidth));
        }
        if (copiedSources.size() != 2) {
            runMetrics.increment("indexMapInsertionSourcePartitionMisses");
            runMetrics.increment("indexMapInsertionCopiedSourceCountMisses");
            return null;
        }

        IndexMapInsertionSource key = null;
        for (IndexMapInsertionSource candidate : copiedSources) {
            if (!hasDirectInsertionKeyProbe(
                    owner,
                    insertion,
                    target,
                    argumentCount,
                    candidate)) {
                continue;
            }
            if (key != null) {
                runMetrics.increment("indexMapInsertionSourcePartitionMisses");
                runMetrics.increment("indexMapInsertionKeyProbeAmbiguities");
                return null;
            }
            key = candidate;
        }
        if (key == null) {
            runMetrics.increment("indexMapInsertionSourcePartitionMisses");
            runMetrics.increment("indexMapInsertionKeyProbeMisses");
            return null;
        }
        IndexMapInsertionSource selectedKey = key;
        IndexMapInsertionSource value = copiedSources.stream()
            .filter(candidate -> candidate != selectedKey)
            .findFirst()
            .orElse(null);
        if (value == null) {
            return null;
        }

        ArrayList<PcodeCodecCall> keyCodecs = new ArrayList<>();
        ArrayList<PcodeCodecCall> valueCodecs = new ArrayList<>();
        boolean observedValue = false;
        for (PcodeCodecCall codec : codecs) {
            Integer width = scalarNativeOutputByteWidth(codec.evidence());
            if (width == null) {
                width = wireShapeByteWidth(codec.evidence().layout);
            }
            PcodeStorage output = codecUnmarshalOutputStorage(
                codec.operation(),
                null,
                codec.evidence());
            if (!storageRangeWithin(output, width, key) &&
                !storageRangeWithin(output, width, value)) {
                output = postCallUnmarshalOutputStorage(
                    high,
                    codec.operation(),
                    output,
                    width,
                    true);
            }
            if (storageRangeWithin(output, width, key)) {
                if (observedValue) {
                    runMetrics.increment("indexMapInsertionSourcePartitionMisses");
                    runMetrics.increment("indexMapInsertionCodecOrderMisses");
                    return null;
                }
                keyCodecs.add(codec);
            }
            else if (storageRangeWithin(output, width, value)) {
                observedValue = true;
                valueCodecs.add(codec);
            }
            else {
                runMetrics.increment("indexMapInsertionSourcePartitionMisses");
                runMetrics.increment("indexMapInsertionCodecStorageMisses");
                return null;
            }
        }
        WireShape keyEvidence = orderedCodecProductWireEvidence(
            keyCodecs,
            "cfg-counted-index-map-key");
        WireShape valueEvidence = orderedCodecProductWireEvidence(
            valueCodecs,
            "cfg-counted-index-map-value");
        if (keyEvidence == null || valueEvidence == null ||
            !keyEvidence.hasProvenSemantics() ||
            !valueEvidence.hasProvenSemantics()) {
            runMetrics.increment("indexMapInsertionSourcePartitionMisses");
            runMetrics.increment("indexMapInsertionCodecProductMisses");
            return null;
        }
        runMetrics.increment("indexMapInsertionSourcePartitions");
        return WireShape.semantic(
            "map<" + keyEvidence.shape + "," + valueEvidence.shape + ">",
            sequence.layout,
            "cfg-counted-index-map+insertion-key-value-abi");
    }

    private boolean hasDirectInsertionKeyProbe(
        Function owner,
        PcodeOpAST insertion,
        Function target,
        int argumentCount,
        IndexMapInsertionSource candidate) {

        int matches = 0;
        for (int slot = 1; slot <= argumentCount; slot++) {
            if (slot == candidate.argumentSlot()) {
                continue;
            }
            Integer directWidth = insertionTargetParameterReadSpan(
                target,
                slot,
                false);
            if (!Objects.equals(directWidth, candidate.byteWidth())) {
                continue;
            }
            PcodeStorage direct = provenCallArgumentStorage(
                owner,
                insertion,
                target,
                slot);
            if (candidate.storage().sameLocation(direct)) {
                matches++;
            }
        }
        return matches == 1;
    }

    private Integer insertionTargetParameterReadSpan(
        Function target,
        int parameterSlot,
        boolean indirect) {

        HighFunction high = highFunction(target);
        if (high == null || parameterSlot <= 0) {
            return null;
        }
        String parameter = "param_" + parameterSlot;
        long minimum = Long.MAX_VALUE;
        long maximum = Long.MIN_VALUE;
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            checkAnalysisCancelled();
            if (operation.getOpcode() != PcodeOp.LOAD ||
                operation.getNumInputs() < 2 || operation.getOutput() == null) {
                continue;
            }
            PcodeMemoryPath path = pcodeMemoryPath(
                operation.getInput(1),
                indirect ? 1 : 0);
            if (path == null || path.root().storageBase() == null ||
                !parameter.equals(path.root().storageBase()) ||
                path.offset() < 0L ||
                indirect && (path.dereferenceOffsets().size() != 1 ||
                    path.dereferenceOffsets().get(0) != 0L) ||
                !indirect && !path.dereferenceOffsets().isEmpty()) {
                continue;
            }
            Long end = addExactOrNull(
                path.offset(),
                (long)operation.getOutput().getSize());
            if (end == null) {
                return null;
            }
            minimum = Math.min(minimum, path.offset());
            maximum = Math.max(maximum, end);
        }
        return minimum == 0L && maximum > 0L && maximum <= 0x1000L
            ? (int)maximum
            : null;
    }

    private boolean storageRangeWithin(
        PcodeStorage member,
        Integer memberWidth,
        IndexMapInsertionSource aggregate) {

        if (member == null || memberWidth == null || memberWidth <= 0 ||
            aggregate == null ||
            !Objects.equals(member.base, aggregate.storage().base)) {
            return false;
        }
        Long memberEnd = addExactOrNull(member.offset, memberWidth.longValue());
        Long aggregateEnd = addExactOrNull(
            aggregate.storage().offset,
            (long)aggregate.byteWidth());
        return memberEnd != null && aggregateEnd != null &&
            member.offset >= aggregate.storage().offset &&
            memberEnd <= aggregateEnd;
    }

    private record IndexMapInsertionSource(
        int argumentSlot,
        PcodeStorage storage,
        int byteWidth) {
    }

    private InstructionContainerInsertion uniqueInstructionContainerInsertion(
        Function owner,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeCodecCall> codecs,
        String readBufferParameter) {

        if (owner == null || high == null || loop == null || codecs == null ||
            codecs.isEmpty()) {
            return null;
        }
        UnmarshalTerminalFlow terminalFlow = successfulUnmarshalTerminalFlow(high);
        if (terminalFlow.terminals().isEmpty()) {
            runMetrics.increment("instructionContainerInsertionSuccessFlowMisses");
            return null;
        }
        InstructionContainerInsertion selected = null;
        for (PcodeBlockBasic block : loop.body()) {
            for (Instruction instruction : blockInstructions(owner, block)) {
                checkAnalysisCancelled();
                if (!instruction.getFlowType().isCall() ||
                    codecs.stream().anyMatch(codec -> Objects.equals(
                        codec.operation().getSeqnum().getTarget(),
                        instruction.getMinAddress())) ||
                    !instructionFollowsAllContainerCodecs(
                        high,
                        block,
                        instruction.getMinAddress(),
                        codecs,
                        terminalFlow)) {
                    continue;
                }
                ForwardArgState state = instructionStateBeforeAddress(
                    owner,
                    instruction.getMinAddress());
                PcodeStorage receiver = state == null
                    ? null
                    : pcodeStorageFromTrackedValue(state.registers.get("RCX"));
                String outputParameter = formalParameterBaseFromStorage(owner, receiver);
                if (!isProvenOutputParameterBase(owner, outputParameter) ||
                    outputParameter.equals(readBufferParameter)) {
                    continue;
                }
                Function target = functionAtOrContaining(
                    resolvedCodeTarget(callTarget(instruction)));
                if (target == null) {
                    continue;
                }
                InstructionContainerInsertion candidate =
                    new InstructionContainerInsertion(
                        instruction.getMinAddress(),
                        target,
                        outputParameter);
                if (selected != null && !selected.callsite().equals(candidate.callsite())) {
                    runMetrics.increment("instructionContainerInsertionConflicts");
                    return null;
                }
                selected = candidate;
            }
        }
        if (selected != null) {
            runMetrics.increment("instructionContainerInsertionProofs");
        }
        return selected;
    }

    private boolean instructionFollowsAllContainerCodecs(
        HighFunction high,
        PcodeBlockBasic instructionBlock,
        Address instructionAddress,
        List<PcodeCodecCall> codecs,
        UnmarshalTerminalFlow terminalFlow) {

        if (high == null || instructionBlock == null || instructionAddress == null ||
            terminalFlow == null || terminalFlow.terminals().isEmpty()) {
            return false;
        }
        for (PcodeCodecCall codec : codecs) {
            PcodeOpAST operation = codec.operation();
            PcodeBlockBasic codecBlock = NetworkSchemaControlFlow.parentBlock(operation);
            Address codecAddress = operation == null || operation.getSeqnum() == null
                ? null
                : operation.getSeqnum().getTarget();
            if (codecBlock == null || codecAddress == null) {
                return false;
            }
            if (codecBlock == instructionBlock) {
                if (codecAddress.compareTo(instructionAddress) >= 0) {
                    return false;
                }
            }
            else if (!unmarshalSuccessFlowReaches(
                    codecBlock,
                    instructionBlock,
                    terminalFlow)) {
                return false;
            }
        }
        return true;
    }

    private boolean unmarshalSuccessFlowReaches(
        PcodeBlockBasic source,
        PcodeBlockBasic target,
        UnmarshalTerminalFlow terminalFlow) {

        if (source == null || target == null || terminalFlow == null) {
            return false;
        }
        if (source == target) {
            return true;
        }
        ArrayDeque<PcodeBlockBasic> pending = new ArrayDeque<>();
        LinkedHashSet<PcodeBlockBasic> visited = new LinkedHashSet<>();
        pending.addLast(source);
        visited.add(source);
        while (!pending.isEmpty()) {
            checkAnalysisCancelled();
            PcodeBlockBasic block = pending.removeFirst();
            Set<PcodeBlockBasic> excluded = terminalFlow.excludedEdges()
                .getOrDefault(block, Set.of());
            for (PcodeBlockBasic successor : NetworkSchemaControlFlow.successors(block)) {
                if (excluded.contains(successor) || !visited.add(successor)) {
                    continue;
                }
                if (successor == target) {
                    return true;
                }
                pending.addLast(successor);
            }
        }
        return false;
    }
    private record InstructionContainerInsertion(
        Address callsite,
        Function target,
        String outputParameter) {
    }
