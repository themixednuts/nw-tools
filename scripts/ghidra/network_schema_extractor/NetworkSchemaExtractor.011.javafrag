    private String unmarshalTemplateType(String functionName) {
        if (functionName == null) {
            return null;
        }
        int nameIndex = functionName.indexOf("Unmarshal<");
        if (nameIndex < 0) {
            return null;
        }
        int start = functionName.indexOf('<', nameIndex);
        int end = NetworkSchemaText.matchingIndex(functionName, start, '<', '>');
        if (start < 0 || end < 0) {
            return null;
        }
        return functionName.substring(start + 1, end).trim();
    }

    private HighFunction highFunction(Function function) {
        if (function == null || decompiler == null) {
            return null;
        }
        runMetrics.increment("highFunctionRequests");
        String key = functionCacheKey("high-function", function);
        Map<String, HighFunction> cache = highFunctionCacheFor(function);
        if (cache.containsKey(key)) {
            runMetrics.increment("highFunctionHits");
            return cache.get(key);
        }
        if (failedHighFunctions.contains(key)) {
            runMetrics.increment("highFunctionHits");
            return null;
        }
        runMetrics.increment("highFunctionMisses");
        if (!highFunctionSeen.add(key)) {
            runMetrics.increment("highFunctionRecompilations");
            highFunctionRecompileCounts.merge(
                formatAddress(function.getEntryPoint()),
                1,
                Integer::sum);
        }
        try {
            DecompileResults results = decompiler.decompileFunction(function, 30, monitor);
            if (!results.decompileCompleted() || results.getHighFunction() == null) {
                runMetrics.increment("highFunctionFailures");
                failedHighFunctions.add(key);
                return null;
            }
            runMetrics.increment("highFunctionCompleted");
            HighFunction high = results.getHighFunction();
            cache.put(key, high);
            return high;
        }
        catch (Exception ignored) {
            runMetrics.increment("highFunctionFailures");
            failedHighFunctions.add(key);
            return null;
        }
    }

    private Map<String, HighFunction> highFunctionCacheFor(Function function) {
        long bodyBytes = function.getBody() == null
            ? Long.MAX_VALUE
            : function.getBody().getNumAddresses();
        return bodyBytes <= SMALL_HIGH_FUNCTION_BYTE_LIMIT
            ? smallHighFunctionCache
            : highFunctionCache;
    }

    private Function pcodeCallTarget(PcodeOp op) {
        PcodeCallTargetInfo info = pcodeCallTargetInfo(op);
        return info == null ? null : info.target;
    }

    private PcodeCallTargetInfo pcodeCallTargetInfo(PcodeOp op) {
        if (op == null || op.getOpcode() != PcodeOp.CALL || op.getNumInputs() == 0) {
            return null;
        }
        Address rawAddress = pcodeAddress(op.getInput(0));
        Address resolvedAddress = resolvedCodeTarget(rawAddress);
        Function direct = functionExactlyAt(rawAddress);
        Function resolved = direct == null ? functionExactlyAt(resolvedAddress) : null;
        Function target = direct == null ? resolved : direct;
        Address selectedAddress = direct == null ? resolvedAddress : rawAddress;
        Function containing = target == null ? functionContaining(selectedAddress) : null;
        PcodeCallTargetInfo info = new PcodeCallTargetInfo();
        info.rawTarget = rawAddress;
        info.resolvedTarget = resolvedAddress;
        info.target = target;
        info.targetExactStart = target != null;
        info.containing = containing;
        return info;
    }

    private PcodeCallTargetInfo pcodeValueCallTargetInfo(Varnode node) {
        return pcodeValueCallTargetInfo(node, new LinkedHashSet<>(), 0);
    }

    private PcodeCallTargetInfo pcodeValueCallTargetInfo(
        Varnode node,
        Set<String> seen,
        int depth) {

        if (node == null) {
            return null;
        }
        String key = pcodeNodeKey(node);
        if (!seen.add(key)) {
            return null;
        }
        PcodeOp def = node.getDef();
        if (def == null) {
            return null;
        }
        switch (def.getOpcode()) {
            case PcodeOp.CALL:
                return pcodeCallTargetInfo(def);
            case PcodeOp.COPY:
            case PcodeOp.CAST:
            case PcodeOp.INT_ZEXT:
            case PcodeOp.INT_SEXT:
            case PcodeOp.SUBPIECE:
            case PcodeOp.INDIRECT:
                return def.getNumInputs() == 0
                    ? null
                    : pcodeValueCallTargetInfo(def.getInput(0), seen, depth + 1);
            case PcodeOp.MULTIEQUAL:
                PcodeCallTargetInfo merged = null;
                for (int i = 0; i < def.getNumInputs(); i++) {
                    PcodeCallTargetInfo value =
                        pcodeValueCallTargetInfo(def.getInput(i), seen, depth + 1);
                    if (value == null) {
                        continue;
                    }
                    if (merged == null) {
                        merged = value;
                    }
                    else if (!sameAddressValue(merged.resolvedTarget, value.resolvedTarget)) {
                        return null;
                    }
                }
                return merged;
            default:
                return null;
        }
    }

    private Address pcodeAddress(Varnode node) {
        if (node == null) {
            return null;
        }
        Address address = node.getAddress();
        if (isProgramAddress(address)) {
            return address;
        }
        if (node.isConstant()) {
            address = absoluteAddress(node.getOffset());
            if (isProgramAddress(address)) {
                return address;
            }
        }
        return null;
    }

    private Integer returnedParameterSlot(Function function) {
        if (function == null || function.getEntryPoint() == null) {
            return null;
        }
        String key = functionCacheKey("returned-parameter-slot", function);
        Integer cached = returnedParameterSlotCache.get(key);
        if (cached != null) {
            return cached > 0 ? cached : null;
        }
        if (!returnedParameterSlotActive.add(key)) {
            return null;
        }

        Integer selected = null;
        boolean sawReturnValue = false;
        boolean valid = true;
        try {
            HighFunction high = highFunction(function);
            if (high == null) {
                valid = false;
                return null;
            }
            for (PcodeOpAST operation : orderedPcodeOps(high)) {
                if (operation.getOpcode() != PcodeOp.RETURN ||
                    operation.getNumInputs() < 2) {
                    continue;
                }
                Varnode value = operation.getInput(operation.getNumInputs() - 1);
                if (value == null || value.isConstant()) {
                    continue;
                }
                PcodeStorage storage = pcodeStorageExpression(value);
                Integer slot = formalParameterSlot(storage);
                if (slot == null || storage.offset != 0L) {
                    valid = false;
                    return null;
                }
                sawReturnValue = true;
                if (selected == null) {
                    selected = slot;
                }
                else if (!selected.equals(slot)) {
                    valid = false;
                    return null;
                }
            }
            return valid && sawReturnValue ? selected : null;
        }
        finally {
            returnedParameterSlotActive.remove(key);
            returnedParameterSlotCache.put(
                key,
                valid && sawReturnValue && selected != null ? selected : -1);
        }
    }

    private Integer formalParameterSlot(PcodeStorage storage) {
        if (storage == null || storage.base == null ||
            !storage.base.startsWith("param_")) {
            return null;
        }
        try {
            int slot = Integer.parseInt(storage.base.substring("param_".length()));
            return slot > 0 ? slot : null;
        }
        catch (NumberFormatException ignored) {
            return null;
        }
    }

    private String pcodeBaseRegisterName(Varnode node) {
        if (node == null || !node.isRegister() || node.getAddress() == null) {
            return null;
        }
        try {
            Register register =
                currentProgram.getLanguage().getRegister(node.getAddress(), node.getSize());
            if (register == null) {
                return null;
            }
            Register base = register.getBaseRegister();
            return (base == null ? register : base)
                .getName()
                .toUpperCase(Locale.ROOT);
        }
        catch (Exception ignored) {
            return null;
        }
    }

    private boolean isStackPointerVarnode(Varnode node) {
        String registerName = pcodeBaseRegisterName(node);
        if (registerName == null) {
            return false;
        }
        try {
            Register stackPointer = currentProgram.getCompilerSpec().getStackPointer();
            if (stackPointer != null) {
                Register stackBase = stackPointer.getBaseRegister();
                String stackName = (stackBase == null ? stackPointer : stackBase)
                    .getName()
                    .toUpperCase(Locale.ROOT);
                return registerName.equals(stackName);
            }
        }
        catch (Exception ignored) {
        }
        return "RSP".equals(registerName) ||
            "ESP".equals(registerName) ||
            "SP".equals(registerName);
    }

    private boolean sameAddressValue(Address left, Address right) {
        if (left == null || right == null) {
            return left == right;
        }
        return left.equals(right);
    }

    private PcodeStorage pcodeStorageExpression(Varnode node) {
        PcodeMemoryPath path = pcodeMemoryPath(node, 0);
        return path == null ? null : path.directStorage();
    }

    private PcodeStorage pcodeLoadedStorageExpression(Varnode node) {
        PcodeMemoryPath path = pcodeMemoryPath(node, 1);
        if (path == null) {
            return null;
        }
        PcodeStorage loaded = path.loadedStorage();
        return loaded == null ? path.directStorage() : loaded;
    }

    private PcodeVirtualDispatch pcodeVirtualDispatch(Varnode node) {
        PcodeMemoryPath path = pcodeMemoryPath(node, 2);
        return path == null ? null : path.virtualDispatch();
    }

    private PcodeMemoryPath pcodeMemoryPath(Varnode node, int remainingDereferences) {
        if (node == null) {
            return null;
        }
        String key = pcodeMemoryPathCacheKey(node, remainingDereferences);
        Optional<PcodeMemoryPath> cached = pcodeMemoryPathCache.get(key);
        if (cached != null) {
            runMetrics.increment("pcodeMemoryPathHits");
            return cached.orElse(null);
        }
        runMetrics.increment("pcodeMemoryPathMisses");
        PcodeMemoryPath path = pcodeMemoryPath(
            node,
            remainingDereferences,
            new HashSet<>(),
            new HashMap<>());
        pcodeMemoryPathCache.put(key, Optional.ofNullable(path));
        return path;
    }

    private String pcodeMemoryPathCacheKey(Varnode node, int remainingDereferences) {
        String owner = "<unknown>";
        if (node.getHigh() != null && node.getHigh().getHighFunction() != null &&
            node.getHigh().getHighFunction().getFunction() != null) {
            owner = node.getHigh().getHighFunction().getFunction().getEntryPoint().toString();
        }
        else if (node.getDef() != null && node.getDef().getSeqnum() != null) {
            owner = node.getDef().getSeqnum().getTarget().toString();
        }
        return owner + ':' + remainingDereferences + ':' + pcodeSsaNodeKey(node);
    }

    private PcodeMemoryPath pcodeMemoryPath(
        Varnode node,
        int remainingDereferences,
        Set<String> active,
        Map<String, Optional<PcodeMemoryPath>> memo) {

        if (node == null) {
            return null;
        }
        String key = "memory-path:" + remainingDereferences + ":" + pcodeSsaNodeKey(node);
        Optional<PcodeMemoryPath> cached = memo.get(key);
        if (cached != null) {
            return cached.orElse(null);
        }
        if (!active.add(key)) {
            return null;
        }

        PcodeMemoryPath result;
        try {
            PcodeOp def = node.getDef();
            result = def == null
                ? null
                : pcodeMemoryPathFromDef(
                    def,
                    remainingDereferences,
                    active,
                    memo);
            if (result == null) {
                result = pcodeStaticMemoryPath(node);
            }
            if (result == null) {
                Integer parameterSlot = formalParameterSlot(node);
                if (parameterSlot != null) {
                    result = PcodeMemoryPath.storageRoot("param_" + parameterSlot, 0L);
                }
            }
            if (result == null && node.getAddress() != null &&
                node.getAddress().isStackAddress()) {
                result = PcodeMemoryPath.storageRoot("stack", node.getOffset());
            }
            if (result == null && isStackPointerVarnode(node)) {
                result = PcodeMemoryPath.storageRoot("stack", 0L);
            }
            if (result == null) {
                String liveIn = pcodeLiveInRoot(node);
                if (liveIn != null) {
                    result = PcodeMemoryPath.storageRoot(liveIn, 0L);
                }
            }
        }
        finally {
            active.remove(key);
        }
        memo.put(key, Optional.ofNullable(result));
        return result;
    }

    private String pcodeLiveInRoot(Varnode node) {
        if (node == null || node.getDef() != null || !node.isRegister() ||
            isStackPointerVarnode(node)) {
            return null;
        }
        Varnode representative = node;
        if (node.getHigh() != null && node.getHigh().getRepresentative() != null) {
            representative = node.getHigh().getRepresentative();
        }
        Integer parameterSlot = formalParameterSlot(representative);
        if (parameterSlot != null) {
            return "param_" + parameterSlot;
        }
        return "input:" + pcodeSsaNodeKey(representative);
    }

    private PcodeMemoryPath pcodeMemoryPathFromDef(
        PcodeOp def,
        int remainingDereferences,
        Set<String> active,
        Map<String, Optional<PcodeMemoryPath>> memo) {

        switch (def.getOpcode()) {
            case PcodeOp.COPY:
            case PcodeOp.CAST:
            case PcodeOp.INT_ZEXT:
            case PcodeOp.INT_SEXT:
            case PcodeOp.SUBPIECE:
            case PcodeOp.INDIRECT:
                return def.getNumInputs() == 0
                    ? null
                    : pcodeMemoryPath(
                        def.getInput(0),
                        remainingDereferences,
                        active,
                        memo);
            case PcodeOp.LOAD:
                if (remainingDereferences == 0 || def.getNumInputs() < 2) {
                    return null;
                }
                PcodeMemoryPath address = pcodeMemoryPath(
                    def.getInput(1),
                    remainingDereferences - 1,
                    active,
                    memo);
                return address == null ? null : address.dereference();
            case PcodeOp.PTRADD:
                return pcodePointerAddPath(
                    def,
                    remainingDereferences,
                    active,
                    memo);
            case PcodeOp.PTRSUB:
                return pcodePointerSubPath(
                    def,
                    remainingDereferences,
                    active,
                    memo);
            case PcodeOp.INT_ADD:
                return pcodeAddPath(
                    def,
                    remainingDereferences,
                    active,
                    memo,
                    true);
            case PcodeOp.INT_SUB:
                return pcodeAddPath(
                    def,
                    remainingDereferences,
                    active,
                    memo,
                    false);
            case PcodeOp.MULTIEQUAL:
                return pcodeMergedMemoryPath(
                    def,
                    remainingDereferences,
                    active,
                    memo);
            case PcodeOp.PIECE:
                return pcodePieceMemoryPath(
                    def,
                    remainingDereferences,
                    active,
                    memo);
            case PcodeOp.CALL:
                Function target = pcodeCallTarget(def);
                Integer returnedSlot = returnedParameterSlot(target);
                return returnedSlot == null || returnedSlot >= def.getNumInputs()
                    ? null
                    : pcodeMemoryPath(
                        def.getInput(returnedSlot),
                        remainingDereferences,
                        active,
                        memo);
            default:
                return null;
        }
    }

    private PcodeMemoryPath pcodePointerAddPath(
        PcodeOp def,
        int remainingDereferences,
        Set<String> active,
        Map<String, Optional<PcodeMemoryPath>> memo) {

        if (def.getNumInputs() < 3) {
            return null;
        }
        PcodeMemoryPath base =
            pcodeMemoryPath(
                def.getInput(0),
                remainingDereferences,
                active,
                memo);
        Long index = NetworkSchemaIntegerEvaluator.evaluate(def.getInput(1));
        Long elementSize = NetworkSchemaIntegerEvaluator.evaluate(def.getInput(2));
        if (base == null || index == null || elementSize == null) {
            return null;
        }
        try {
            return base.plus(Math.multiplyExact(index, elementSize));
        }
        catch (ArithmeticException ignored) {
            return null;
        }
    }

    private PcodeMemoryPath pcodePointerSubPath(
        PcodeOp def,
        int remainingDereferences,
        Set<String> active,
        Map<String, Optional<PcodeMemoryPath>> memo) {

        if (def.getNumInputs() < 2) {
            return null;
        }
        PcodeMemoryPath base =
            pcodeMemoryPath(
                def.getInput(0),
                remainingDereferences,
                active,
                memo);
        Long offset = NetworkSchemaIntegerEvaluator.evaluate(def.getInput(1));
        if (base == null || offset == null) {
            return null;
        }
        return base.plus(offset);
    }

    private PcodeMemoryPath pcodeAddPath(
        PcodeOp def,
        int remainingDereferences,
        Set<String> active,
        Map<String, Optional<PcodeMemoryPath>> memo,
        boolean add) {
        if (def.getNumInputs() < 2) {
            return null;
        }
        PcodeMemoryPath left =
            pcodeMemoryPath(
                def.getInput(0),
                remainingDereferences,
                active,
                memo);
        Long right = NetworkSchemaIntegerEvaluator.evaluate(def.getInput(1));
        if (left != null && right != null) {
            return left.plus(add ? right : -right);
        }
        if (add) {
            PcodeMemoryPath rightPath =
                pcodeMemoryPath(
                    def.getInput(1),
                    remainingDereferences,
                    active,
                    memo);
            Long leftConstant = NetworkSchemaIntegerEvaluator.evaluate(def.getInput(0));
            if (rightPath != null && leftConstant != null) {
                return rightPath.plus(leftConstant);
            }
        }
        return null;
    }

    private PcodeMemoryPath pcodeMergedMemoryPath(
        PcodeOp def,
        int remainingDereferences,
        Set<String> active,
        Map<String, Optional<PcodeMemoryPath>> memo) {

        PcodeMemoryPath merged = null;
        for (int i = 0; i < def.getNumInputs(); i++) {
            PcodeMemoryPath path =
                pcodeMemoryPath(
                    def.getInput(i),
                    remainingDereferences,
                    active,
                    memo);
            if (path == null) {
                return null;
            }
            if (merged == null) {
                merged = path;
            }
            else if (!merged.equals(path)) {
                return null;
            }
        }
        return merged;
    }

    private PcodeMemoryPath pcodePieceMemoryPath(
        PcodeOp def,
        int remainingDereferences,
        Set<String> active,
        Map<String, Optional<PcodeMemoryPath>> memo) {

        if (def.getNumInputs() < 2) {
            return null;
        }
        PcodeMemoryPath selected = null;
        for (int slot = 0; slot < def.getNumInputs(); slot++) {
            PcodeMemoryPath candidate = pcodeMemoryPath(
                def.getInput(slot),
                remainingDereferences,
                active,
                memo);
            if (candidate == null) {
                return null;
            }
            if (selected == null) {
                selected = candidate;
            }
            else if (!selected.equals(candidate)) {
                return null;
            }
        }
        return selected;
    }

    private Integer formalParameterSlot(Varnode node) {
        if (node == null) {
            return null;
        }
        if (node.getHigh() instanceof HighParam parameter) {
            return parameter.getSlot() + 1;
        }

        var highFunction = node.getHigh() == null
            ? null
            : node.getHigh().getHighFunction();
        if (highFunction != null && highFunction.getLocalSymbolMap() != null) {
            var symbols = highFunction.getLocalSymbolMap();
            for (int index = 0; index < symbols.getNumParams(); index++) {
                HighParam parameter = symbols.getParam(index);
                if (parameter == null) {
                    continue;
                }
                for (Varnode instance : parameter.getInstances()) {
                    if (sameVarnodeIdentity(node, instance)) {
                        return parameter.getSlot() + 1;
                    }
                }
            }
            Integer abiSlot = abiParameterSlot(node, highFunction.getFunction());
            if (abiSlot != null) {
                return abiSlot;
            }
        }
        return win64LiveInParameterSlot(node);
    }

    private Integer win64LiveInParameterSlot(Varnode node) {
        if (node == null || node.getDef() != null) {
            return null;
        }
        String register = pcodeBaseRegisterName(node);
        if (register == null) {
            return null;
        }
        for (int slot = 1; slot <= 4; slot++) {
            if (register.equals(win64ArgumentRegister(slot))) {
                return slot;
            }
        }
        return null;
    }

    private Integer abiParameterSlot(Varnode node, Function function) {
        if (node == null || node.getAddress() == null || function == null) {
            return null;
        }
        PrototypeModel convention = function.getCallingConvention();
        if (convention == null) {
            convention = currentProgram.getCompilerSpec().getDefaultCallingConvention();
        }
        if (convention == null) {
            return null;
        }

        Parameter[] declared = function.getParameters();
        int candidateCount = Math.max(16, declared.length + 8);
        Integer selected = null;
        for (int index = 0; index < candidateCount; index++) {
            VariableStorage storage = convention.getArgLocation(
                index,
                declared,
                DataType.DEFAULT,
                currentProgram);
            if (storage == null || storage.isUnassignedStorage() ||
                !storageContains(storage, node)) {
                continue;
            }
            if (selected != null) {
                return null;
            }
            selected = index + 1;
        }
        return selected;
    }

    private boolean storageContains(VariableStorage storage, Varnode node) {
        for (Varnode piece : storage.getVarnodes()) {
            if (piece == null || piece.getAddress() == null ||
                !piece.getAddress().getAddressSpace().equals(
                    node.getAddress().getAddressSpace())) {
                continue;
            }
            long pieceStart = piece.getOffset();
            long pieceEnd = pieceStart + piece.getSize();
            long nodeStart = node.getOffset();
            long nodeEnd = nodeStart + node.getSize();
            if (nodeStart >= pieceStart && nodeEnd <= pieceEnd) {
                return true;
            }
        }
        return false;
    }

    private boolean sameVarnodeIdentity(Varnode left, Varnode right) {
        if (left == null || right == null) {
            return false;
        }
        if (left instanceof VarnodeAST leftAst && right instanceof VarnodeAST rightAst) {
            return leftAst.getUniqueId() == rightAst.getUniqueId();
        }
        return left == right;
    }

    private String pcodeValueNativeType(
        Varnode node,
        Map<String, String> tempNativeTypes) {
        return pcodeValueNativeType(node, tempNativeTypes, new LinkedHashSet<>(), 0);
    }

    private String pcodeValueWireShape(
        Varnode node,
        Map<String, String> tempWireShapes,
        Map<String, String> tempNativeTypes) {
        return pcodeValueWireShape(
            node,
            tempWireShapes,
            tempNativeTypes,
            new LinkedHashSet<>(),
            0);
    }

    private String pcodeValueWireShape(
        Varnode node,
        Map<String, String> tempWireShapes,
        Map<String, String> tempNativeTypes,
        Set<String> seen,
        int depth) {

        if (node == null) {
            return null;
        }
        String tempShape = pcodeTempWireShape(node, tempWireShapes);
        if (tempShape != null) {
            return tempShape;
        }
        String key = "shape:" + pcodeNodeKey(node);
        if (!seen.add(key)) {
            return null;
        }

        PcodeOp def = node.getDef();
        if (def == null) {
            return wireShapeFromNativeType(
                firstNonEmpty(
                    pcodeTempNativeType(node, tempNativeTypes),
                    pcodeValueNativeType(node, tempNativeTypes)));
        }

        switch (def.getOpcode()) {
            case PcodeOp.CALL: {
                Function target = pcodeCallTarget(def);
                String nativeType = unmarshalNativeTypeFromTarget(target);
                String shape = wireShapeFromUnmarshalTarget(target, nativeType);
                if (shape != null) {
                    return shape;
                }
                return wireShapeFromNativeType(scalarOutputStoreNativeType(target));
            }
            case PcodeOp.COPY:
            case PcodeOp.CAST:
            case PcodeOp.SUBPIECE:
            case PcodeOp.INDIRECT:
                return def.getNumInputs() == 0
                    ? null
                    : pcodeValueWireShape(
                        def.getInput(0),
                        tempWireShapes,
                        tempNativeTypes,
                        seen,
                        depth + 1);
            case PcodeOp.INT_EQUAL:
            case PcodeOp.INT_NOTEQUAL:
            case PcodeOp.INT_LESS:
            case PcodeOp.INT_LESSEQUAL:
            case PcodeOp.INT_SLESS:
            case PcodeOp.INT_SLESSEQUAL:
            case PcodeOp.BOOL_AND:
            case PcodeOp.BOOL_OR:
            case PcodeOp.BOOL_XOR:
            case PcodeOp.BOOL_NEGATE:
                return node.getSize() == 1 ? "bool" : null;
            case PcodeOp.MULTIEQUAL:
                return pcodeMergedValueWireShape(
                    def,
                    tempWireShapes,
                    tempNativeTypes,
                    seen,
                    depth + 1);
            case PcodeOp.PIECE:
                return pcodePieceValueWireShape(
                    def,
                    tempWireShapes,
                    tempNativeTypes,
                    seen,
                    depth + 1);
            default:
                return wireShapeFromNativeType(pcodeValueNativeType(node, tempNativeTypes));
        }
    }

    private String pcodeMergedValueWireShape(
        PcodeOp def,
        Map<String, String> tempWireShapes,
        Map<String, String> tempNativeTypes,
        Set<String> seen,
        int depth) {

        String merged = null;
        for (int i = 0; i < def.getNumInputs(); i++) {
            String valueShape =
                pcodeValueWireShape(
                    def.getInput(i),
                    tempWireShapes,
                    tempNativeTypes,
                    new LinkedHashSet<>(seen),
                    depth);
            if (valueShape == null) {
                return null;
            }
            if (merged == null) {
                merged = valueShape;
            }
            else if (!merged.equals(valueShape)) {
                return null;
            }
        }
        return merged;
    }

    private String pcodePieceValueWireShape(
        PcodeOp def,
        Map<String, String> tempWireShapes,
        Map<String, String> tempNativeTypes,
        Set<String> seen,
        int depth) {

        if (def.getNumInputs() != 2 || def.getOutput() == null) {
            return null;
        }
        String high = pcodeValueWireShape(
            def.getInput(0),
            tempWireShapes,
            tempNativeTypes,
            new LinkedHashSet<>(seen),
            depth);
        String low = pcodeValueWireShape(
            def.getInput(1),
            tempWireShapes,
            tempNativeTypes,
            new LinkedHashSet<>(seen),
            depth);
        Integer width = high == null ? null : wireShapeByteWidth(high);
        return high != null && high.equals(low) && width != null &&
            width == def.getOutput().getSize()
                ? high
                : null;
    }

    private String pcodeValueNativeType(
        Varnode node,
        Map<String, String> tempNativeTypes,
        Set<String> seen,
        int depth) {

        if (node == null) {
            return null;
        }
        String tempType = pcodeTempNativeType(node, tempNativeTypes);
        if (tempType != null) {
            return pcodeNativeTypeAtValueWidth(tempType, node.getSize());
        }
        String key = "type:" + pcodeNodeKey(node);
        if (!seen.add(key)) {
            return null;
        }

        PcodeOp def = node.getDef();
        if (def == null) {
            return null;
        }

        switch (def.getOpcode()) {
            case PcodeOp.CALL:
                return unmarshalNativeTypeFromTarget(pcodeCallTarget(def));
            case PcodeOp.COPY:
            case PcodeOp.CAST:
            case PcodeOp.SUBPIECE:
            case PcodeOp.INDIRECT: {
                String sourceType = def.getNumInputs() == 0
                    ? null
                    : pcodeValueNativeType(
                        def.getInput(0),
                        tempNativeTypes,
                        seen,
                        depth + 1);
                return pcodeNativeTypeAtValueWidth(sourceType, node.getSize());
            }
            case PcodeOp.INT_EQUAL:
            case PcodeOp.INT_NOTEQUAL:
            case PcodeOp.INT_LESS:
            case PcodeOp.INT_LESSEQUAL:
            case PcodeOp.INT_SLESS:
            case PcodeOp.INT_SLESSEQUAL:
            case PcodeOp.BOOL_AND:
            case PcodeOp.BOOL_OR:
            case PcodeOp.BOOL_XOR:
            case PcodeOp.BOOL_NEGATE:
                return node.getSize() == 1 ? "bool" : null;
            case PcodeOp.MULTIEQUAL:
                return pcodeMergedValueNativeType(
                    def,
                    tempNativeTypes,
                    seen,
                    depth + 1);
            case PcodeOp.PIECE:
                return pcodePieceValueNativeType(
                    def,
                    tempNativeTypes,
                    seen,
                    depth + 1);
import ghidra.program.model.pcode.HighParam;
