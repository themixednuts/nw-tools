    private void recordContainerValueShapeRejectSample(
        String reason,
        NativeTypeInfoEvidence candidate,
        Address vtable,
        Address unmarshalFull,
        Function target,
        List<String> valueWireShapes,
        Map<String, LinkedHashMap<Long, NestedTypeMember>> byBase) {

        if (containerValueShapeRejectSamples.size() >=
            CONTAINER_VALUE_SHAPE_REJECT_SAMPLE_LIMIT) {
            return;
        }

        JsonObject sample = new JsonObject();
        sample.addProperty("reason", reason);
        NetworkSchemaJson.add(sample, "handlerVtable", formatAddress(vtable));
        NetworkSchemaJson.add(sample, "unmarshalFull", formatAddress(unmarshalFull));
        if (target != null) {
            NetworkSchemaJson.add(sample, "function", formatAddress(target.getEntryPoint()));
            NetworkSchemaJson.add(sample, "functionName", fullFunctionName(target));
        }
        if (candidate != null) {
            sample.add("candidate", candidate.toJson(addressFormatter));
        }
        sample.add("expectedWireShapes", NetworkSchemaJson.stringArray(valueWireShapes));
        JsonArray bases = new JsonArray();
        int baseCount = 0;
        int emittedBases = 0;
        for (Map.Entry<String, LinkedHashMap<Long, NestedTypeMember>> entry : byBase.entrySet()) {
            baseCount++;
            if (emittedBases >= 8) {
                continue;
            }
            JsonObject base = new JsonObject();
            NetworkSchemaJson.add(base, "base", entry.getKey());
            ArrayList<NestedTypeMember> callOrderMembers = new ArrayList<>(entry.getValue().values());
            ArrayList<NestedTypeMember> offsetOrderMembers =
                new ArrayList<>(callOrderMembers);
            offsetOrderMembers.sort((left, right) -> Long.compare(left.offset, right.offset));
            base.addProperty("memberCount", offsetOrderMembers.size());
            base.addProperty(
                "shapeMatchesExpected",
                isContainerValueMemberShape(offsetOrderMembers, valueWireShapes));
            JsonArray memberJson = new JsonArray();
            for (int i = 0; i < offsetOrderMembers.size() && i < 16; i++) {
                NestedTypeMember member = offsetOrderMembers.get(i);
                JsonObject object = member.toJson(addressFormatter);
                object.addProperty("expectedWireShape",
                    i < valueWireShapes.size() ? valueWireShapes.get(i) : "<none>");
                memberJson.add(object);
            }
            base.add("members", memberJson);
            bases.add(base);
            emittedBases++;
        }
        sample.addProperty("observedBaseCount", baseCount);
        sample.add("observedBases", bases);
        containerValueShapeRejectSamples.add(sample);
    }

    private JsonArray containerValuePcodeOpsDiagnostic(Function target) {
        return containerValuePcodeOpsDiagnostic(
            target,
            new LinkedHashSet<>(),
            0,
            Collections.emptyMap());
    }

    private JsonArray containerValuePcodeOpsDiagnostic(
        Function target,
        Set<String> seen,
        int depth,
        Map<String, PcodeStorage> callerParamStorage) {

        JsonArray result = new JsonArray();
        if (target == null || depth > 2) {
            return result;
        }
        if (!seen.add(target.getEntryPoint().toString())) {
            return result;
        }
        HighFunction high = highFunction(target);
        if (high == null) {
            return result;
        }

        HashMap<String, String> tempNativeTypes = new HashMap<>();
        HashMap<String, String> tempWireShapes = new HashMap<>();
        Iterator<PcodeOpAST> ops = high.getPcodeOps();
        int emitted = 0;
        while (ops.hasNext() && emitted < 80) {
            PcodeOpAST op = ops.next();
            if (op.getOpcode() == PcodeOp.CALL) {
                Function callTarget = pcodeCallTarget(op);
                String nativeType = firstNonEmpty(
                    unmarshalNativeTypeFromTarget(callTarget),
                    scalarOutputStoreNativeType(callTarget));
                WireShape wireEvidence =
                    wireShapeEvidenceFromUnmarshalTarget(callTarget, nativeType);
                String wireShape = wireEvidence == null ? null : wireEvidence.shape;
                observePcodeTempUnmarshal(
                    tempNativeTypes,
                    tempWireShapes,
                    op,
                    nativeType,
                    wireShape);
                PcodeStorage storage = provenUnmarshalOutputStorage(op);
                if (nativeType == null && wireShape == null && storage == null) {
                    continue;
                }
                Map<String, PcodeStorage> helperParamStorage =
                    callArgumentStorageMap(target, op, callerParamStorage);
                JsonObject object = new JsonObject();
                object.addProperty("op", "CALL");
                NetworkSchemaJson.add(object, "callsite", formatAddress(op.getSeqnum().getTarget()));
                NetworkSchemaJson.add(object, "target", formatAddress(callTarget == null ? null : callTarget.getEntryPoint()));
                NetworkSchemaJson.add(object, "targetName", fullFunctionName(callTarget));
                NetworkSchemaJson.add(object, "nativeType", nativeType);
                NetworkSchemaJson.add(object, "wireShape", wireShape);
                addPcodeStorageDiagnostic(object, "output", storage);
                NetworkSchemaJson.add(object, "outputSource", storage == null
                    ? null
                    : "callee-write-target+caller-abi");
                addTranslatedPcodeStorageDiagnostics(
                    object,
                    "output",
                    storage,
                    callerParamStorage);
                object.add("arguments", pcodeCallArgumentsDiagnostic(
                    op,
                    tempNativeTypes,
                    tempWireShapes,
                    callerParamStorage));
                addPcodeArgumentMapDiagnostic(object, helperParamStorage);
                if (shouldRecurseContainerValueHelper(
                        callTarget,
                        wireEvidence)) {
                    JsonArray helperOps = containerValuePcodeOpsDiagnostic(
                        callTarget,
                        new LinkedHashSet<>(seen),
                        depth + 1,
                        helperParamStorage);
                    if (helperOps.size() > 0) {
                        object.add("helperPcodeOps", helperOps);
                    }
                }
                result.add(object);
                emitted++;
                continue;
            }
            if (op.getOpcode() != PcodeOp.STORE || op.getNumInputs() < 3) {
                continue;
            }

            PcodeStorage storage = pcodeStorageExpression(op.getInput(1));
            PcodeStorage valueStorage = pcodeLoadedStorageExpression(op.getInput(2));
            String nativeType = pcodeValueNativeType(op.getInput(2), tempNativeTypes);
            String wireShape = pcodeValueWireShape(op.getInput(2), tempWireShapes, tempNativeTypes);
            PcodeCallTargetInfo targetInfo = pcodeValueCallTargetInfo(op.getInput(2));
            if (storage == null && valueStorage == null && nativeType == null &&
                wireShape == null && targetInfo == null) {
                continue;
            }
            JsonObject object = new JsonObject();
            object.addProperty("op", "STORE");
            NetworkSchemaJson.add(object, "callsite", formatAddress(op.getSeqnum().getTarget()));
            addPcodeStorageDiagnostic(object, "storage", storage);
            addPcodeStorageDiagnostic(object, "valueStorage", valueStorage);
            addTranslatedPcodeStorageDiagnostics(
                object,
                "storage",
                storage,
                callerParamStorage);
            addTranslatedPcodeStorageDiagnostics(
                object,
                "valueStorage",
                valueStorage,
                callerParamStorage);
            NetworkSchemaJson.add(object, "nativeType", nativeType);
            NetworkSchemaJson.add(object, "wireShape", wireShape);
            if (targetInfo != null) {
                NetworkSchemaJson.add(object, "valueTarget", formatAddress(targetInfo.targetAddress()));
                NetworkSchemaJson.add(object, "valueTargetName", fullFunctionName(targetInfo.target));
            }
            result.add(object);
            emitted++;
        }
        return result;
    }

    private PcodeStorage containerValueUnmarshalOutputStorage(
        PcodeOp op,
        Map<String, PcodeStorage> callerParamStorage) {

        PcodeStorage rooted = uniqueTranslatedCallArgumentStorage(
            op,
            callerParamStorage,
            "element");
        return rooted == null ? provenUnmarshalOutputStorage(op) : rooted;
    }

    private PcodeStorage uniqueTranslatedCallArgumentStorage(
        PcodeOp op,
        Map<String, PcodeStorage> callerParamStorage,
        String requiredBase) {

        if (op == null || op.getOpcode() != PcodeOp.CALL ||
            callerParamStorage == null || callerParamStorage.isEmpty()) {
            return null;
        }
        Function owner = op.getSeqnum() == null
            ? null
            : functionContaining(op.getSeqnum().getTarget());
        Function target = pcodeCallTarget(op);
        PcodeStorage selected = null;
        int argumentCount = provenCallArgumentCount(op, target);
        for (int slot = 1; slot <= argumentCount; slot++) {
            PcodeStorage storage = translatedAbsoluteHelperStorage(
                provenCallArgumentStorage(owner, op, target, slot),
                callerParamStorage);
            if (storage == null || !requiredBase.equals(storage.base)) {
                continue;
            }
            if (selected != null && !selected.sameLocation(storage)) {
                return null;
            }
            selected = storage;
        }
        return selected;
    }

    private JsonArray pcodeCallArgumentsDiagnostic(
        PcodeOp op,
        Map<String, String> tempNativeTypes,
        Map<String, String> tempWireShapes,
        Map<String, PcodeStorage> callerParamStorage) {

        JsonArray result = new JsonArray();
        if (op == null || op.getOpcode() != PcodeOp.CALL) {
            return result;
        }
        Function owner = op.getSeqnum() == null
            ? null
            : functionContaining(op.getSeqnum().getTarget());
        Function target = pcodeCallTarget(op);
        int argumentCount = provenCallArgumentCount(op, target);
        for (int slot = 1; slot <= argumentCount; slot++) {
            Varnode input = slot < op.getNumInputs() ? op.getInput(slot) : null;
            PcodeStorage storage = provenCallArgumentStorage(owner, op, target, slot);
            if (input == null && storage == null) {
                continue;
            }
            JsonObject object = new JsonObject();
            object.addProperty("slot", slot);
            addPcodeStorageDiagnostic(object, "storage", storage);
            addTranslatedPcodeStorageDiagnostics(
                object,
                "storage",
                storage,
                callerParamStorage);
            NetworkSchemaJson.add(
                object,
                "nativeType",
                input == null ? null : pcodeValueNativeType(input, tempNativeTypes));
            NetworkSchemaJson.add(
                object,
                "wireShape",
                input == null
                    ? null
                    : pcodeValueWireShape(input, tempWireShapes, tempNativeTypes));
            Long constant = provenCallArgumentImmediate(owner, op, target, slot);
            if (constant != null) {
                object.addProperty("constant", "0x" + Long.toHexString(constant));
            }
            result.add(object);
        }
        return result;
    }

    private Map<String, PcodeStorage> callArgumentStorageMap(
        Function owner,
        PcodeOp op,
        Map<String, PcodeStorage> callerParamStorage) {

        if (owner == null || op == null || op.getOpcode() != PcodeOp.CALL) {
            return Collections.emptyMap();
        }
        Function target = pcodeCallTarget(op);
        if (target == null) {
            return Collections.emptyMap();
        }
        LinkedHashMap<String, PcodeStorage> result = new LinkedHashMap<>();
        int argumentCount = provenCallArgumentCount(op, target);
        for (int slot = 1; slot <= argumentCount; slot++) {
            String param = "param_" + slot;
            if (result.containsKey(param)) {
                continue;
            }
            PcodeStorage storage = provenCallArgumentStorage(
                owner,
                op,
                target,
                slot);
            storage = canonicalFormalParameterStorage(storage);
            storage = translatedAbsoluteHelperStorage(storage, callerParamStorage);
            if (storage != null) {
                result.put(param, storage);
            }
        }
        return result;
    }

    private PcodeStorage canonicalFormalParameterStorage(PcodeStorage storage) {

        if (storage == null || !"stack".equals(storage.base)) {
            return storage;
        }
        Integer parameter = stackArgumentParameterIndex(storage.offset);
        return parameter == null
            ? storage
            : new PcodeStorage("param_" + parameter, 0L);
    }

    private void addPcodeArgumentMapDiagnostic(
        JsonObject object,
        Map<String, PcodeStorage> argumentMap) {

        if (object == null || argumentMap == null || argumentMap.isEmpty()) {
            return;
        }
        JsonArray json = new JsonArray();
        for (Map.Entry<String, PcodeStorage> entry : argumentMap.entrySet()) {
            JsonObject item = new JsonObject();
            NetworkSchemaJson.add(item, "param", entry.getKey());
            addPcodeStorageDiagnostic(item, "storage", entry.getValue());
            json.add(item);
        }
        object.add("argumentMap", json);
    }

    private void addTranslatedPcodeStorageDiagnostics(
        JsonObject object,
        String prefix,
        PcodeStorage storage,
        Map<String, PcodeStorage> callerParamStorage) {

        if (object == null || storage == null || callerParamStorage == null ||
            callerParamStorage.isEmpty()) {
            return;
        }
        addPcodeStorageDiagnostic(
            object,
            "translated" + capitalizeAscii(prefix),
            translatedRelativeHelperStorage(storage, callerParamStorage));
        addPcodeStorageDiagnostic(
            object,
            "translatedAbsolute" + capitalizeAscii(prefix),
            translatedAbsoluteHelperStorage(storage, callerParamStorage));
    }

    private PcodeStorage translatedRelativeHelperStorage(
        PcodeStorage storage,
        Map<String, PcodeStorage> callerParamStorage) {

        if (storage == null || callerParamStorage == null || callerParamStorage.isEmpty()) {
            return storage;
        }
        PcodeStorage callerBase = callerParamStorage.get(storage.base);
        if (callerBase == null) {
            return storage;
        }
        return new PcodeStorage(callerBase.expression(), storage.offset);
    }

    private PcodeStorage translatedAbsoluteHelperStorage(
        PcodeStorage storage,
        Map<String, PcodeStorage> callerParamStorage) {

        if (storage == null || callerParamStorage == null || callerParamStorage.isEmpty()) {
            return storage;
        }
        PcodeStorage callerBase = callerParamStorage.get(storage.base);
        if (callerBase == null) {
            return storage;
        }
        return callerBase.plus(storage.offset);
    }

    private String capitalizeAscii(String value) {
        if (value == null || value.isEmpty()) {
            return "";
        }
        return value.substring(0, 1).toUpperCase(Locale.ROOT) + value.substring(1);
    }

    private void addPcodeStorageDiagnostic(JsonObject object, String prefix, PcodeStorage storage) {
        if (object == null || storage == null) {
            return;
        }
        NetworkSchemaJson.add(object, prefix + "Base", storage.base);
        NetworkSchemaJson.add(object, prefix + "Offset", "0x" + Long.toHexString(storage.offset));
        NetworkSchemaJson.add(object, prefix + "Expression", storage.expression());
    }

    private boolean isContainerValueMemberShape(
        List<NestedTypeMember> members,
        List<String> valueWireShapes) {

        if (members == null || members.isEmpty() || valueWireShapes == null ||
            valueWireShapes.isEmpty() ||
            members.size() > NESTED_DIRECT_TYPE_MEMBER_LIMIT) {
            return false;
        }
        int expectedIndex = 0;
        long previousEnd = Long.MIN_VALUE;
        HashSet<String> locations = new HashSet<>();
        for (NestedTypeMember member : members) {
            if (member == null || Boolean.TRUE.equals(member.typeConflict) ||
                member.byteWidth == null || member.byteWidth <= 0 || member.offset < 0) {
                return false;
            }
            long end = member.offset + member.byteWidth;
            if (end < member.offset || end > 0x400 ||
                previousEnd != Long.MIN_VALUE && member.offset < previousEnd ||
                !locations.add(member.offset + ":" + member.byteWidth)) {
                return false;
            }
            int span = containerValueExpectedShapeSpan(
                member.wireShape,
                valueWireShapes,
                expectedIndex);
            if (span <= 0) {
                return false;
            }
            expectedIndex += span;
            previousEnd = end;
        }
        return expectedIndex == valueWireShapes.size();
    }

    private boolean wireShapeMatchesExpected(String expectedShape, String observedShape) {
        if (expectedShape == null || observedShape == null) {
            return false;
        }
        if (expectedShape.equals(observedShape)) {
            return true;
        }
        return isBoolByteWireShape(expectedShape) && isBoolByteWireShape(observedShape);
    }

    private boolean isBoolByteWireShape(String shape) {
        return "bool".equals(shape) || "u8".equals(shape);
    }

    private ArrayList<NestedTypeMember> datatypeValueMembersForWireShapes(
        Structure structure,
        List<String> valueWireShapes) {

        if (structure == null || valueWireShapes == null || valueWireShapes.isEmpty()) {
            return null;
        }

        ArrayList<NestedTypeMember> members = new ArrayList<>();
        for (DataTypeComponent component : structure.getDefinedComponents()) {
            if (members.size() >= valueWireShapes.size()) {
                break;
            }
            if (!isProvenDatatypeMemberName(component.getFieldName())) {
                continue;
            }

            NestedTypeMember member = datatypeValueMember(component);
            if (member == null) {
                return null;
            }
            String expected = valueWireShapes.get(members.size());
            if (!wireShapeMatchesExpected(expected, member.wireShape)) {
                return null;
            }
            member.index = members.size();
            members.add(member);
        }

        return members.size() == valueWireShapes.size() ? members : null;
    }

    private NestedTypeMember datatypeValueMember(DataTypeComponent component) {
        if (component == null || component.getDataType() == null) {
            return null;
        }

        DataType dataType = component.getDataType();
        String nativeType = normalizePrototypeTypeName(dataType.getDisplayName());
        NestedDatatypeScalar nestedScalar = dataType instanceof Structure
            ? singleNestedDatatypeScalar((Structure) dataType)
            : null;
        String wireShape = nestedScalar == null
            ? wireShapeFromNativeType(nativeType)
            : nestedScalar.wireShape;
        if (wireShape == null) {
            return null;
        }

        NestedTypeMember member = new NestedTypeMember();
        member.offset = component.getOffset();
        if (nestedScalar != null && nestedScalar.offset != 0L) {
            member.nativeOffset = (long) component.getOffset() + nestedScalar.offset;
        }
        member.name = component.getFieldName();
        member.nameSource = "ghidra-datatype";
        member.nameProven = true;
        if (nestedScalar != null && nestedScalar.path != null) {
            member.nameEvidence = nestedScalar.path;
        }
        member.nativeType = nativeType;
        member.wireShape = wireShape;
        member.wireShapeSource = nestedScalar == null
            ? "ghidra-datatype-member"
            : "ghidra-nested-datatype-member";
        member.wireLayout = wireShape;
        member.wireLayoutSource = member.wireShapeSource;
        member.byteWidth = component.getLength();
        return member;
    }

    private NestedDatatypeScalar singleNestedDatatypeScalar(Structure structure) {
        List<NestedDatatypeScalar> scalars = nestedDatatypeScalars(structure, 0L, "");
        return scalars.size() == 1 ? scalars.get(0) : null;
    }

    private List<NestedDatatypeScalar> nestedDatatypeScalars(
        Structure structure,
        long baseOffset,
        String pathPrefix) {

        if (structure == null) {
            return Collections.emptyList();
        }
        ArrayList<NestedDatatypeScalar> scalars = new ArrayList<>();
        for (DataTypeComponent component : structure.getDefinedComponents()) {
            if (!isProvenDatatypeMemberName(component.getFieldName()) ||
                component.getDataType() == null) {
                continue;
            }
            String path = pathPrefix.isEmpty()
                ? component.getFieldName()
                : pathPrefix + "." + component.getFieldName();
            DataType dataType = component.getDataType();
            if (dataType instanceof Structure) {
                scalars.addAll(nestedDatatypeScalars(
                    (Structure) dataType,
                    baseOffset + component.getOffset(),
                    path));
                continue;
            }

            String nativeType = normalizePrototypeTypeName(dataType.getDisplayName());
            String wireShape = wireShapeFromNativeType(nativeType);
            if (wireShape == null) {
                continue;
            }
            scalars.add(new NestedDatatypeScalar(
                baseOffset + component.getOffset(),
                path,
                nativeType,
                wireShape));
        }
        return scalars;
    }

    private List<NativeTypeInfoEvidence> collectReplicatedContainerValueTypeInfoCandidates(
        Address marshal,
        Address marshalFull,
        Address unmarshal,
        Address unmarshalFull,
        FullContainerPlan fullContainerPlan) {

        LinkedHashMap<String, NativeTypeInfoEvidence> candidates = new LinkedHashMap<>();
        collectBufferFlowTypeInfo(marshal, "param_2", "delta", candidates);
        collectBufferFlowTypeInfo(marshalFull, "param_2", "full", candidates);
        collectBufferFlowTypeInfo(unmarshal, "param_2", "delta", candidates);
        collectBufferFlowTypeInfo(unmarshalFull, "param_2", "full", candidates);
        collectContainerElementTypeInfo(
            unmarshalFull,
            "param_2",
            fullContainerPlan == null ? null : fullContainerPlan.elementStride,
            candidates);
        collectContainerMapValueTypeInfo(
            unmarshalFull,
            fullContainerPlan,
            candidates);
        ArrayList<NativeTypeInfoEvidence> result = new ArrayList<>(candidates.size());
        for (NativeTypeInfoEvidence candidate : candidates.values()) {
            result.add(withDirectContainerElementSize(candidate, fullContainerPlan));
        }
        return result;
    }

    private NativeTypeInfoEvidence selectedReplicatedContainerValueTypeInfo(
        List<NativeTypeInfoEvidence> candidates,
        NestedTypeShape valueTypeShape) {

        if (valueTypeShape != null && valueTypeShape.typeId != null) {
            for (NativeTypeInfoEvidence candidate : candidates) {
                if (isExactContainerValueTypeEvidence(candidate) &&
                    uuidEquals(valueTypeShape.typeId, candidate.typeId)) {
                    return candidate;
                }
            }
        }
        if (valueTypeShape != null && isPlausibleTypeName(valueTypeShape.typeNameFull)) {
            for (NativeTypeInfoEvidence candidate : candidates) {
                if (isExactContainerValueTypeEvidence(candidate) &&
                    sameNativeTypeName(valueTypeShape.typeNameFull, candidate.name)) {
                    return candidate;
                }
            }
        }

        NativeTypeInfoEvidence selected = null;
        for (NativeTypeInfoEvidence candidate : candidates) {
            if (!isProvenContainerValueTypeEvidence(candidate)) {
                continue;
            }
            if (selected != null && !sameNativeTypeInfoIdentity(selected, candidate)) {
                recordNestedTypeShapeReject("ambiguous-proven-container-value-type");
                return null;
            }
            selected = candidate;
        }
        return selected;
    }

    private List<NativeTypeInfoEvidence> provenReplicatedContainerValueTypeInfoCandidates(
        List<NativeTypeInfoEvidence> candidates,
        NestedTypeShape valueTypeShape) {

        if (candidates == null || candidates.isEmpty()) {
            return List.of();
        }
        ArrayList<NativeTypeInfoEvidence> proven = new ArrayList<>();
        for (NativeTypeInfoEvidence candidate : candidates) {
            if (isProvenContainerValueTypeEvidence(candidate)) {
                proven.add(candidate);
                continue;
            }
            if (valueTypeShape == null ||
                !Boolean.TRUE.equals(valueTypeShape.identityProven) ||
                !isExactContainerValueTypeEvidence(candidate)) {
                continue;
            }
            boolean typeIdMatches = valueTypeShape.typeId != null &&
                candidate.typeId != null &&
                uuidEquals(valueTypeShape.typeId, candidate.typeId);
            boolean nameMatches = isPlausibleTypeName(valueTypeShape.typeNameFull) &&
                sameNativeTypeName(valueTypeShape.typeNameFull, candidate.name);
            if (typeIdMatches || nameMatches) {
                proven.add(candidate);
            }
        }
        return List.copyOf(proven);
    }

    private boolean isProvenContainerValueTypeEvidence(
        NativeTypeInfoEvidence evidence) {

        if (evidence == null ||
            (evidence.typeId == null && !isPlausibleTypeName(evidence.name)) ||
            evidence.nativeSize == null || evidence.nativeSize <= 0L ||
            evidence.source == null) {
            return false;
        }
        return evidence.source.startsWith("unmarshal-full-element-vptr") ||
            evidence.source.startsWith("full-direct-") &&
                evidence.source.endsWith("-marshal-template") &&
                "cfg-vector-affine-stride+direct-typed-element-helper".equals(
                    evidence.nativeSizeSource);
    }

    private boolean isExactContainerValueTypeEvidence(NativeTypeInfoEvidence evidence) {
        if (evidence == null || evidence.source == null) {
            return false;
        }
        return evidence.source.startsWith("unmarshal-full-element-vptr") ||
            evidence.source.startsWith("full-") &&
                evidence.source.endsWith("-marshal-template");
    }

    private void collectBufferFlowTypeInfo(
        Address address,
        String bufferParameter,
        String phase,
        Map<String, NativeTypeInfoEvidence> candidates) {

        collectBufferFlowTypeInfo(
            functionAtOrContaining(resolvedCodeTarget(address)),
            bufferParameter,
            phase,
            new ArrayDeque<>(),
            new LinkedHashSet<>(),
            candidates);
    }

    private void collectBufferFlowTypeInfo(
        Function function,
        String bufferParameter,
        String phase,
        Deque<Address> callStack,
        Set<String> completedContexts,
        Map<String, NativeTypeInfoEvidence> candidates) {

        if (function == null || bufferParameter == null) {
            return;
        }
        String context = function.getEntryPoint() + "|" + bufferParameter;
        if (callStack.contains(function.getEntryPoint()) || !completedContexts.add(context)) {
            return;
        }

        HighFunction high = highFunction(function);
        if (high == null) {
            return;
        }
        callStack.addLast(function.getEntryPoint());
        try {
            PcodeStorage buffer = new PcodeStorage(bufferParameter, 0L);
            for (PcodeOpAST op : orderedPcodeOps(high)) {
                if (op.getOpcode() != PcodeOp.CALL) {
                    continue;
                }
                Function target = pcodeCallTarget(op);
                Integer bufferSlot = provenCallArgumentSlot(
                    function,
                    op,
                    target,
                    buffer);
                if (bufferSlot == null || target == null) {
                    continue;
                }

                int codecDepth = callStack.size();
                NativeTypeInfoEvidence codecType =
                    nativeTypeInfoFromMarshalFunction(target.getEntryPoint(), phase, codecDepth);
                if (codecType != null) {
                    putNativeTypeInfoCandidate(candidates, codecType);
                    continue;
                }

                if (validatedMarshalLeaf(target, "param_" + bufferSlot) != null) {
                    continue;
                }
                collectBufferFlowTypeInfo(
                    target,
                    "param_" + bufferSlot,
                    phase,
                    callStack,
                    completedContexts,
                    candidates);
            }
        }
        finally {
            callStack.removeLast();
        }
    }

    private NativeTypeInfoEvidence nativeTypeInfoFromMarshalFunction(
        Address address,
        String phase,
        int helperDepth) {

        Address targetAddress = resolvedCodeTarget(address);
        Function function = functionAtOrContaining(targetAddress);
        if (function == null) {
            return null;
        }

        String functionName = fullFunctionName(function);
        String nativeType = marshalFunctionTemplateType(functionName);
        if (!isPlausibleTypeName(nativeType) || wireShapeFromNativeType(nativeType) != null) {
            return null;
        }

        SerializeTypeInfo reflected = serializeTypeForTypeName(nativeType);
        if (reflected == null || reflected.typeId == null) {
            return null;
        }

        String source = (phase == null ? "unknown" : phase) +
            (helperDepth <= 1 ? "-direct" : "-nested") +
            "-marshal-template";
        return new NativeTypeInfoEvidence(
            function.getEntryPoint(),
            reflected.name,
            reflected.typeId,
            source,
            "marshal-function-template");
    }

    private void putNativeTypeInfoCandidate(
        Map<String, NativeTypeInfoEvidence> candidates,
        NativeTypeInfoEvidence candidate) {

        String identity = nativeTypeInfoIdentityKey(candidate);
        if (identity == null) {
            return;
        }
        if (candidate.typeId != null && isPlausibleTypeName(candidate.name)) {
            candidates.entrySet().removeIf(entry ->
                entry.getValue().typeId == null &&
                    sameNativeTypeName(entry.getValue().name, candidate.name));
        }
        if (candidate.typeId == null && candidates.values().stream().anyMatch(existing ->
                existing.typeId != null && sameNativeTypeName(existing.name, candidate.name))) {
            return;
        }
        NativeTypeInfoEvidence existing = candidates.get(identity);
        if (existing == null || nativeTypeInfoCandidatePriority(candidate) >
            nativeTypeInfoCandidatePriority(existing) ||
            (nativeTypeInfoCandidatePriority(candidate) ==
                nativeTypeInfoCandidatePriority(existing) &&
                !isPlausibleTypeName(existing.name) &&
                isPlausibleTypeName(candidate.name))) {
            candidates.put(identity, candidate);
        }
    }

    private String nativeTypeInfoIdentityKey(NativeTypeInfoEvidence evidence) {
        if (evidence == null) {
            return null;
        }
        String typeId = normalizeUuid(evidence.typeId);
        if (typeId != null) {
            return "type-id:" + typeId;
        }
        return isPlausibleTypeName(evidence.name)
            ? "type-name:" + normalizeNativeType(evidence.name)
            : null;
    }

    private boolean sameNativeTypeInfoIdentity(
        NativeTypeInfoEvidence left,
        NativeTypeInfoEvidence right) {

        if (left == null || right == null) {
            return false;
        }
        if (left.typeId != null && right.typeId != null) {
            return uuidEquals(left.typeId, right.typeId);
        }
        return sameNativeTypeName(left.name, right.name);
    }

    private boolean sameNativeTypeName(String left, String right) {
        return isPlausibleTypeName(left) && isPlausibleTypeName(right) &&
            normalizeNativeType(left).equals(normalizeNativeType(right));
    }

    private int nativeTypeInfoCandidatePriority(NativeTypeInfoEvidence evidence) {
        if (evidence == null || evidence.source == null) {
            return 0;
        }
        String source = evidence.source;
        if (source.startsWith(
                "unmarshal-full-element-vptr+linked-node-allocation")) {
            return 6;
        }
        if (source.startsWith("unmarshal-full-element-vptr")) {
            return 5;
        }
        if (source.startsWith("full-direct-marshal-template")) {
            return 4;
        }
        if (source.startsWith("full-nested-marshal-template")) {
            return 3;
        }
        if (source.startsWith("delta-direct-marshal-template")) {
            return 2;
        }
        return source.startsWith("delta-nested-marshal-template") ? 1 : 0;
    }
