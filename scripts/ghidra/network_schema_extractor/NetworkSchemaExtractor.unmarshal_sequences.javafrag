    private Map<PcodeOpAST, UnmarshalSequenceAction> unmarshalSequenceActions(
        Function function,
        HighFunction high,
        String readBufferParameter,
        Set<String> activeContexts,
        Map<String, CodecWireTrace> completedContexts) {

        IdentityHashMap<PcodeOpAST, UnmarshalSequenceAction> actions =
            new IdentityHashMap<>();
        List<PcodeOpAST> operations = orderedPcodeOps(high);
        for (NetworkSchemaNaturalLoop loop : NetworkSchemaControlFlow.naturalLoops(high)) {
            UnmarshalSequenceSummary summary = staticUnmarshalSequence(
                function,
                high,
                loop,
                operations,
                readBufferParameter,
                activeContexts,
                completedContexts);
            if (summary == null || summary.operations().stream().anyMatch(actions::containsKey)) {
                continue;
            }
            for (PcodeOpAST operation : summary.operations()) {
                actions.put(operation, new UnmarshalSequenceAction(
                    summary.events(),
                    summary.elementEventCount(),
                    summary.storage(),
                    false));
            }
            actions.put(
                summary.emissionOperation(),
                new UnmarshalSequenceAction(
                    summary.events(),
                    summary.elementEventCount(),
                    summary.storage(),
                    true));
        }
        return actions;
    }

    private UnmarshalSequenceSummary staticUnmarshalSequence(
        Function function,
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations,
        String readBufferParameter,
        Set<String> activeContexts,
        Map<String, CodecWireTrace> completedContexts) {

        UnmarshalStaticSequenceStorage storage = unmarshalStaticSequenceStorage(
            high,
            loop,
            operations);
        if (storage == null) {
            return null;
        }
        List<PcodeOpAST> inductions = List.of(storage.induction());

        Map<PcodeBlockBasic, List<UnmarshalIterationEvent>> eventsByBlock = new HashMap<>();
        ArrayList<PcodeOpAST> eventOperations = new ArrayList<>();
        for (PcodeOpAST operation : operations) {
            if (!loop.contains(operation) || !operationTouchesStaticSequenceElement(
                    operation,
                    loop,
                    inductions,
                    storage)) {
                continue;
            }
            List<CodecWireEvent> events = unmarshalOperationEvents(
                function,
                high,
                operations,
                operation,
                readBufferParameter,
                activeContexts,
                completedContexts);
            if (events.isEmpty()) {
                continue;
            }
            PcodeBlockBasic block = NetworkSchemaControlFlow.parentBlock(operation);
            if (block == null) {
                return null;
            }
            UnmarshalIterationEvent event = new UnmarshalIterationEvent(
                operation,
                List.copyOf(events));
            eventsByBlock.computeIfAbsent(block, ignored -> new ArrayList<>()).add(event);
            eventOperations.add(operation);
        }
        if (eventsByBlock.isEmpty()) {
            return null;
        }

        NetworkSchemaFlowSequence.Result<UnmarshalIterationEvent> iteration =
            NetworkSchemaFlowSequence.analyzeLoopIteration(
                loop,
                eventsByBlock,
                (left, right) -> left == right);
        if (!iteration.complete() || iteration.events().isEmpty()) {
            return null;
        }
        ArrayList<CodecWireEvent> elementEvents = new ArrayList<>();
        for (UnmarshalIterationEvent event : iteration.events()) {
            elementEvents.addAll(event.events());
        }
        if (elementEvents.isEmpty() || elementEvents.stream().anyMatch(event ->
                event.wireEvidence() == null || event.wireEvidence().layout == null)) {
            return null;
        }

        ArrayList<CodecWireEvent> expanded = new ArrayList<>(
            Math.multiplyExact(elementEvents.size(), storage.iterations()));
        for (int index = 0; index < storage.iterations(); index++) {
            expanded.addAll(elementEvents);
        }
        PcodeOpAST emission = iteration.events().get(0).operation();
        return new UnmarshalSequenceSummary(
            List.copyOf(expanded),
            elementEvents.size(),
            storage,
            emission,
            Set.copyOf(eventOperations));
    }

    private UnmarshalStaticSequenceStorage unmarshalStaticSequenceStorage(
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations) {

        FixedSequenceStorage direct = fixedSequenceStorage(high, loop, operations);
        if (direct != null) {
            PcodeOpAST countCall = fixedSequenceCountCall(
                high,
                loop,
                operations,
                NetworkSchemaCodecClassifier.CodecDirection.DECODE);
            if (countCall != null && hasFixedSequenceCapacityGuard(
                    high,
                    loop,
                    operations,
                    direct,
                    countCall,
                    NetworkSchemaCodecClassifier.CodecDirection.DECODE) &&
                countControlsFixedSequenceExtent(
                    high,
                    loop,
                    operations,
                    direct,
                    countCall)) {
                return new UnmarshalStaticSequenceStorage(
                    direct.induction(),
                    direct.data(),
                    direct.stride(),
                    1);
            }
        }

        Integer capacity = counterControlledLoopTripCount(high, loop);
        if (capacity == null) {
            return null;
        }
        UnmarshalStaticSequenceStorage selected = null;
        for (PcodeOpAST induction : counterControlledUnmarshalElementInductions(
                high,
                loop,
                operations)) {
            Long stride = affinePointerInductionStride(induction, loop);
            if (stride == null) {
                stride = physicalRegisterAffineStepInLoop(induction, loop, false);
            }
            PcodeStorage initial = counterControlledUnmarshalInitialStorage(
                induction,
                loop);
            if (stride == null || stride <= 0L || initial == null ||
                !initial.base.matches("param_\\d+") ||
                loopBackedgeConditionDependsOn(high, loop, induction.getOutput())) {
                continue;
            }
            UnmarshalStaticSequenceStorage candidate =
                new UnmarshalStaticSequenceStorage(
                    induction,
                    initial,
                    stride,
                    capacity);
            if (selected != null) {
                return null;
            }
            selected = candidate;
        }
        return selected;
    }

    private List<PcodeOpAST> counterControlledUnmarshalElementInductions(
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations) {

        if (high == null || loop == null || loop.header() == null || operations == null) {
            return List.of();
        }
        ArrayList<PcodeOpAST> result = new ArrayList<>();
        var headerOperations = loop.header().getIterator();
        while (headerOperations.hasNext()) {
            PcodeOp operation = headerOperations.next();
            if (!(operation instanceof PcodeOpAST induction) ||
                induction.getOpcode() != PcodeOp.MULTIEQUAL ||
                induction.getOutput() == null ||
                induction.getOutput().getSize() != currentProgram.getDefaultPointerSize()) {
                continue;
            }
            Long stride = affinePointerInductionStride(induction, loop);
            if (stride == null) {
                stride = physicalRegisterAffineStepInLoop(induction, loop, false);
            }
            PcodeStorage initial = counterControlledUnmarshalInitialStorage(
                induction,
                loop);
            boolean conditionControlled = loopBackedgeConditionDependsOn(
                high,
                loop,
                induction.getOutput());
            boolean usedByCodec = stride != null && stride > 0L &&
                unmarshalLoopCallUsesInduction(loop, operations, induction, stride);
            if (stride == null || stride <= 0L || initial == null ||
                !initial.base.matches("param_\\d+") || conditionControlled ||
                !usedByCodec) {
                if (stride == null || stride <= 0L) {
                    runMetrics.increment("counterUnmarshalElementStrideRejects");
                }
                else if (initial == null || !initial.base.matches("param_\\d+")) {
                    runMetrics.increment("counterUnmarshalElementInitialStorageRejects");
                }
                else if (conditionControlled) {
                    runMetrics.increment("counterUnmarshalElementConditionRejects");
                }
                else {
                    runMetrics.increment("counterUnmarshalElementCodecUseRejects");
                }
                continue;
            }
            result.add(induction);
            runMetrics.increment("directUnmarshalSequenceInductionProofs");
        }
        return List.copyOf(result);
    }

    private boolean loopBackedgeConditionDependsOn(
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        Varnode induction) {

        if (high == null || loop == null || induction == null) {
            return false;
        }
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            if (!loop.contains(operation) || operation.getOpcode() != PcodeOp.CBRANCH ||
                operation.getNumInputs() < 2 ||
                !branchBlockHasDirectLoopBackedge(operation, loop)) {
                continue;
            }
            Varnode condition = operation.getInput(operation.getNumInputs() - 1);
            if (pcodeNodeDependsOn(
                    condition,
                    induction,
                    new LinkedHashSet<>(),
                    0) ||
                blockPhysicalValueDependsOn(
                    NetworkSchemaControlFlow.parentBlock(operation),
                    operation,
                    condition,
                    induction,
                    new LinkedHashSet<>(),
                    0)) {
                runMetrics.increment("physicalOrSsaLoopBackedgeConditionProofs");
                return true;
            }
        }
        return false;
    }

    private PcodeStorage counterControlledUnmarshalInitialStorage(
        PcodeOpAST induction,
        NetworkSchemaNaturalLoop loop) {

        PcodeStorage initial = fixedSequenceInitialStorage(induction, loop);
        if (initial != null && initial.base.matches("param_\\d+")) {
            return initial;
        }

        // MULTIEQUAL inputs are normally ordered like the header predecessors,
        // but physical-register recovery can preserve a useful preheader value
        // while losing that slot association. A parameter-backed input is an
        // independently sufficient initial-storage proof; the affine backedge
        // and codec-use checks still prove that this phi is the element cursor.
        PcodeStorage selected = null;
        for (int slot = 0; slot < induction.getNumInputs(); slot++) {
            Varnode input = induction.getInput(slot);
            PcodeStorage candidate = pcodeStorageExpression(input);
            if (candidate == null) {
                candidate = pcodeLoadedStorageExpression(input);
            }
            if (candidate == null || !candidate.base.matches("param_\\d+")) {
                continue;
            }
            if (selected != null && !selected.sameLocation(candidate)) {
                return null;
            }
            selected = candidate;
        }
        if (selected != null) {
            runMetrics.increment("parameterBackedUnmarshalInductionInitials");
        }
        return selected;
    }

    private boolean unmarshalLoopCallUsesInduction(
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> operations,
        PcodeOpAST induction,
        long stride) {

        for (PcodeOpAST operation : operations) {
            if (!loop.contains(operation) || operation.getOpcode() != PcodeOp.CALL) {
                continue;
            }
            Function target = pcodeCallTarget(operation);
            String nativeType = unmarshalNativeTypeFromTarget(target);
            WireShape evidence = wireShapeEvidenceFromUnmarshalTarget(target, nativeType);
            if (evidence == null || evidence.layout == null) {
                continue;
            }
            if (operationTouchesSequenceElement(
                    operation,
                    List.of(induction),
                    stride)) {
                return true;
            }
        }
        return false;
    }

    private boolean operationTouchesStaticSequenceElement(
        PcodeOpAST operation,
        NetworkSchemaNaturalLoop loop,
        List<PcodeOpAST> inductions,
        UnmarshalStaticSequenceStorage storage) {

        if (operationTouchesSequenceElement(
                operation,
                inductions,
                storage.stride())) {
            return true;
        }
        if (operation == null || operation.getOpcode() != PcodeOp.CALL ||
            storage.data() == null) {
            return false;
        }
        Long elementEnd = addExactOrNull(storage.data().offset, storage.stride());
        if (elementEnd == null) {
            return false;
        }
        for (PcodeStorage output : scalarCallOutputStorages(operation)) {
            if (output != null && output.base.equals(storage.data().base) &&
                output.offset >= storage.data().offset &&
                output.offset < elementEnd) {
                runMetrics.increment("abiStaticSequenceOutputProofs");
                return true;
            }
        }
        return false;
    }

    private Integer counterControlledLoopTripCount(
        HighFunction high,
        NetworkSchemaNaturalLoop loop) {

        Integer selected = null;
        var iterator = loop.header().getIterator();
        while (iterator.hasNext()) {
            PcodeOp operation = iterator.next();
            if (!(operation instanceof PcodeOpAST induction) ||
                induction.getOpcode() != PcodeOp.MULTIEQUAL ||
                induction.getOutput() == null) {
                continue;
            }
            Long step = affineLoopInductionStep(induction, loop);
            Long initial = inductionInitialConstant(high, induction, loop);
            if (step == null || step <= 0L || initial == null) {
                continue;
            }
            Integer candidate = loopTripCountForInduction(
                high,
                loop,
                induction,
                initial,
                step);
            if (candidate == null) {
                continue;
            }
            runMetrics.increment("counterControlledLoopTripCountCandidates");
            if (selected != null && !selected.equals(candidate)) {
                return null;
            }
            selected = candidate;
        }
        if (selected != null) {
            runMetrics.increment("counterControlledLoopTripCountProofs");
        }
        return selected;
    }

    private Long affineLoopInductionStep(
        PcodeOpAST induction,
        NetworkSchemaNaturalLoop loop) {

        Long step = affinePointerInductionStride(induction);
        return step != null
            ? step
            : physicalRegisterAffineStepInLoop(induction, loop, false);
    }

    private Long inductionInitialConstant(
        HighFunction high,
        PcodeOpAST induction,
        NetworkSchemaNaturalLoop loop) {

        Long selected = null;
        for (int slot = 0; slot < induction.getNumInputs(); slot++) {
            Varnode input = induction.getInput(slot);
            PcodeBlockBasic predecessor = phiInputPredecessor(induction, loop, slot);
            if (predecessor != null && loop.contains(predecessor)) {
                continue;
            }
            if (predecessor == null && isAffineBackedgeInput(
                    induction,
                    input,
                    loop,
                    slot)) {
                continue;
            }
            Long candidate = NetworkSchemaIntegerEvaluator.evaluate(input);
            if (candidate == null && predecessor != null) {
                candidate = physicalRegisterConstantAtBlockExit(
                    predecessor,
                    induction.getOutput());
                if (candidate != null) {
                    runMetrics.increment("physicalRegisterLoopInitialConstants");
                }
            }
            if (candidate == null) {
                continue;
            }
            if (selected != null && !selected.equals(candidate)) {
                return null;
            }
            selected = candidate;
        }
        Long preheader = physicalRegisterInitialConstantFromLoopPreheaders(
            induction,
            loop);
        if (preheader != null) {
            if (selected != null && !selected.equals(preheader)) {
                return null;
            }
            if (selected == null) {
                runMetrics.increment("physicalRegisterLoopInitialConstants");
            }
            selected = preheader;
        }
        Long dominating = dominatingPhysicalRegisterInitialConstant(
            high,
            induction,
            loop);
        if (dominating != null) {
            if (selected != null && !selected.equals(dominating)) {
                return null;
            }
            if (selected == null) {
                runMetrics.increment("dominatingPhysicalRegisterLoopInitialConstants");
            }
            selected = dominating;
        }
        return selected;
    }

    private Long dominatingPhysicalRegisterInitialConstant(
        HighFunction high,
        PcodeOpAST induction,
        NetworkSchemaNaturalLoop loop) {

        if (high == null || induction == null || induction.getOutput() == null ||
            loop == null || loop.header() == null ||
            induction.getOutput().getAddress() == null ||
            !induction.getOutput().getAddress().getAddressSpace().isRegisterSpace()) {
            return null;
        }
        PcodeOpAST header = firstLoopHeaderOperation(loop);
        if (header == null) {
            return null;
        }
        Long selected = null;
        boolean foundWrite = false;
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            if (loop.contains(operation) || operation.getOutput() == null ||
                !samePcodeStorageLocation(
                    operation.getOutput(),
                    induction.getOutput()) ||
                !NetworkSchemaControlFlow.precedes(high, operation, header)) {
                continue;
            }
            PcodeBlockBasic block = NetworkSchemaControlFlow.parentBlock(operation);
            if (block == null || !NetworkSchemaControlFlow.dominates(
                    high,
                    block,
                    loop.header())) {
                continue;
            }
            foundWrite = true;
            selected = switch (operation.getOpcode()) {
                case PcodeOp.COPY, PcodeOp.CAST, PcodeOp.INT_ZEXT, PcodeOp.INT_SEXT ->
                    operation.getNumInputs() < 1
                        ? null
                        : NetworkSchemaIntegerEvaluator.evaluate(operation.getInput(0));
                default -> null;
            };
        }
        return foundWrite ? selected : null;
    }

    private Long physicalRegisterInitialConstantFromLoopPreheaders(
        PcodeOpAST induction,
        NetworkSchemaNaturalLoop loop) {

        if (induction == null || induction.getOutput() == null || loop == null ||
            loop.header() == null || induction.getOutput().getAddress() == null ||
            !induction.getOutput().getAddress().getAddressSpace().isRegisterSpace()) {
            return null;
        }
        Long selected = null;
        boolean foundPreheader = false;
        for (int edge = 0; edge < loop.header().getInSize(); edge++) {
            if (!(loop.header().getIn(edge) instanceof PcodeBlockBasic predecessor) ||
                loop.contains(predecessor)) {
                continue;
            }
            foundPreheader = true;
            Long candidate = physicalRegisterConstantAtBlockExit(
                predecessor,
                induction.getOutput());
            if (candidate == null) {
                return null;
            }
            if (selected != null && !selected.equals(candidate)) {
                return null;
            }
            selected = candidate;
        }
        return foundPreheader ? selected : null;
    }

    private Long physicalRegisterConstantAtBlockExit(
        PcodeBlockBasic block,
        Varnode register) {

        if (block == null || register == null) {
            return null;
        }
        PcodeOp producer = null;
        var iterator = block.getIterator();
        while (iterator.hasNext()) {
            PcodeOp operation = iterator.next();
            if (operation.getOutput() != null &&
                samePcodeStorageLocation(operation.getOutput(), register)) {
                producer = operation;
            }
        }
        if (producer == null) {
            return null;
        }
        Long direct = NetworkSchemaIntegerEvaluator.evaluate(producer.getOutput());
        if (direct != null) {
            return direct;
        }
        return switch (producer.getOpcode()) {
            case PcodeOp.COPY, PcodeOp.CAST, PcodeOp.INT_ZEXT, PcodeOp.INT_SEXT ->
                producer.getNumInputs() < 1
                    ? null
                    : NetworkSchemaIntegerEvaluator.evaluate(producer.getInput(0));
            default -> null;
        };
    }

    private Integer loopTripCountForInduction(
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        PcodeOpAST induction,
        long initial,
        long step) {

        Integer selected = null;
        for (PcodeOpAST comparison : orderedPcodeOps(high)) {
            if (!loop.contains(comparison) || !isOrderedIntegerComparison(comparison)) {
                continue;
            }
            int constantSlot = comparison.getInput(0).isConstant()
                ? 0
                : comparison.getInput(1).isConstant() ? 1 : -1;
            if (constantSlot < 0) {
                continue;
            }
            int variableSlot = 1 - constantSlot;
            Long threshold = NetworkSchemaIntegerEvaluator.evaluate(
                comparison.getInput(constantSlot));
            PcodeBlockBasic block = NetworkSchemaControlFlow.parentBlock(comparison);
            Long offset = affineLoopInductionOffsetAt(
                block,
                comparison,
                comparison.getInput(variableSlot),
                induction.getOutput());
            PcodeOpAST branch = loopBackedgeBranchUsingComparison(
                high,
                loop,
                block,
                comparison);
            if (threshold == null || offset == null || branch == null) {
                continue;
            }
            Boolean trueContinues = branchTrueContinuesLoop(branch, loop);
            if (trueContinues == null) {
                runMetrics.increment("loopTripCountBranchDirectionRejects");
                continue;
            }
            runMetrics.increment("loopTripCountBranchDirectionProofs");
            Integer candidate = evaluateLoopTripCount(
                comparison.getOpcode(),
                constantSlot,
                threshold,
                initial,
                offset,
                step,
                trueContinues);
            if (candidate == null) {
                runMetrics.increment("loopTripCountEvaluationRejects");
                continue;
            }
            runMetrics.increment("loopTripCountEvaluationProofs");
            if (selected != null && !selected.equals(candidate)) {
                return null;
            }
            selected = candidate;
        }
        return selected;
    }

    private PcodeOpAST loopBackedgeBranchUsingComparison(
        HighFunction high,
        NetworkSchemaNaturalLoop loop,
        PcodeBlockBasic comparisonBlock,
        PcodeOpAST comparison) {

        PcodeOpAST direct = branchUsingComparison(comparisonBlock, comparison);
        if (direct != null && branchBlockHasDirectLoopBackedge(direct, loop)) {
            runMetrics.increment("directLoopBackedgeComparisonProofs");
            return direct;
        }
        PcodeOpAST selected = null;
        for (PcodeOpAST operation : orderedPcodeOps(high)) {
            if (!loop.contains(operation) || operation.getOpcode() != PcodeOp.CBRANCH ||
                operation.getNumInputs() < 2 ||
                !branchBlockHasDirectLoopBackedge(operation, loop)) {
                continue;
            }
            Varnode condition = operation.getInput(operation.getNumInputs() - 1);
            if (!pcodeNodeDependsOn(
                    condition,
                    comparison.getOutput(),
                    new LinkedHashSet<>(),
                    0) &&
                !blockPhysicalValueDependsOn(
                    NetworkSchemaControlFlow.parentBlock(operation),
                    operation,
                    condition,
                    comparison.getOutput(),
                    new LinkedHashSet<>(),
                    0)) {
                continue;
            }
            if (selected != null && selected != operation) {
                return null;
            }
            selected = operation;
        }
        if (selected != null) {
            runMetrics.increment("naturalLoopBackedgeComparisonProofs");
        }
        return selected;
    }

    private boolean branchBlockHasDirectLoopBackedge(
        PcodeOpAST branch,
        NetworkSchemaNaturalLoop loop) {

        PcodeBlockBasic block = branch == null
            ? null
            : NetworkSchemaControlFlow.parentBlock(branch);
        if (block == null || loop == null || loop.header() == null) {
            return false;
        }
        return NetworkSchemaControlFlow.successors(block).stream().anyMatch(successor ->
            successor == loop.header() || Objects.equals(
                successor.getStart(),
                loop.header().getStart()));
    }

    private Long affineLoopInductionOffsetAt(
        PcodeBlockBasic block,
        PcodeOp boundary,
        Varnode value,
        Varnode induction) {

        Long offset = affineOffsetFromPhi(
            value,
            induction,
            new LinkedHashSet<>(),
            0);
        Long physicalOffset = physicalRegisterAffineOffsetBefore(
            block,
            boundary,
            value,
            induction);
        if (physicalOffset != null &&
            (offset == null || samePcodeStorageLocation(value, induction))) {
            runMetrics.increment("physicalRegisterLoopComparisonOffsets");
            return physicalOffset;
        }
        return offset;
    }

    private Long physicalRegisterAffineOffsetBefore(
        PcodeBlockBasic block,
        PcodeOp boundary,
        Varnode value,
        Varnode induction) {

        if (block == null || boundary == null || value == null || induction == null ||
            !samePcodeStorageLocation(value, induction)) {
            return null;
        }
        PcodeOp producer = lastPhysicalRegisterProducerBefore(block, boundary, value);
        Long offset = physicalRegisterAffineStep(producer, induction);
        return offset == null || offset <= 0L || offset > 0x100000L ? null : offset;
    }

    private Long affineOffsetFromPhi(
        Varnode node,
        Varnode phi,
        Set<String> seen,
        int depth) {

        if (node == null || phi == null || depth > 24 ||
            !seen.add(pcodeNodeKey(node))) {
            return null;
        }
        if (sameVarnodeIdentity(node, phi)) {
            return 0L;
        }
        PcodeOp definition = node.getDef();
        if (definition == null) {
            return null;
        }
        if ((definition.getOpcode() == PcodeOp.INT_ADD ||
             definition.getOpcode() == PcodeOp.INT_SUB) &&
            definition.getNumInputs() == 2) {
            Long constant = NetworkSchemaIntegerEvaluator.evaluate(definition.getInput(1));
            Long base = affineOffsetFromPhi(
                definition.getInput(0),
                phi,
                seen,
                depth + 1);
            if (constant != null && base != null) {
                try {
                    return definition.getOpcode() == PcodeOp.INT_ADD
                        ? Math.addExact(base, constant)
                        : Math.subtractExact(base, constant);
                }
                catch (ArithmeticException ignored) {
                    return null;
                }
            }
            if (definition.getOpcode() == PcodeOp.INT_ADD) {
                constant = NetworkSchemaIntegerEvaluator.evaluate(definition.getInput(0));
                base = affineOffsetFromPhi(
                    definition.getInput(1),
                    phi,
                    seen,
                    depth + 1);
                if (constant != null && base != null) {
                    try {
                        return Math.addExact(base, constant);
                    }
                    catch (ArithmeticException ignored) {
                        return null;
                    }
                }
            }
            return null;
        }
        return transparentPcodeDefinition(definition)
            ? affineOffsetFromPhi(
                definition.getInput(0),
                phi,
                seen,
                depth + 1)
            : null;
    }

    private Boolean branchTrueContinuesLoop(
        PcodeOpAST branch,
        NetworkSchemaNaturalLoop loop) {

        PcodeBlockBasic block = NetworkSchemaControlFlow.parentBlock(branch);
        List<PcodeBlockBasic> successors = block == null
            ? List.of()
            : NetworkSchemaControlFlow.successors(block);
        if (successors.size() != 2 || branch.getNumInputs() < 1) {
            return null;
        }
        Address destination = pcodeAddress(branch.getInput(0));
        PcodeBlockBasic trueSuccessor = branchTargetSuccessor(
            successors,
            destination);
        if (trueSuccessor == null) {
            return null;
        }
        PcodeBlockBasic falseSuccessor = successors.get(0) == trueSuccessor
            ? successors.get(1)
            : successors.get(0);
        if (trueSuccessor == loop.header() || Objects.equals(
                trueSuccessor.getStart(),
                loop.header().getStart())) {
            return true;
        }
        if (falseSuccessor == loop.header() || Objects.equals(
                falseSuccessor.getStart(),
                loop.header().getStart())) {
            return false;
        }
        boolean trueReaches = NetworkSchemaControlFlow.reaches(
            trueSuccessor,
            loop.header());
        boolean falseReaches = NetworkSchemaControlFlow.reaches(
            falseSuccessor,
            loop.header());
        return trueReaches == falseReaches ? null : trueReaches;
    }

    private Integer evaluateLoopTripCount(
        int opcode,
        int constantSlot,
        long threshold,
        long initial,
        long offset,
        long step,
        boolean trueContinues) {

        for (int iteration = 1; iteration <= 0xffff; iteration++) {
            long induction;
            long variable;
            try {
                induction = Math.addExact(
                    initial,
                    Math.multiplyExact((long)iteration - 1L, step));
                variable = Math.addExact(induction, offset);
            }
            catch (ArithmeticException ignored) {
                return null;
            }
            long left = constantSlot == 0 ? threshold : variable;
            long right = constantSlot == 0 ? variable : threshold;
            boolean condition = switch (opcode) {
                case PcodeOp.INT_LESS -> Long.compareUnsigned(left, right) < 0;
                case PcodeOp.INT_LESSEQUAL -> Long.compareUnsigned(left, right) <= 0;
                case PcodeOp.INT_SLESS -> left < right;
                case PcodeOp.INT_SLESSEQUAL -> left <= right;
                default -> false;
            };
            boolean continues = trueContinues ? condition : !condition;
            if (!continues) {
                return iteration;
            }
        }
        return null;
    }

    private List<CodecWireEvent> unmarshalOperationEvents(
        Function function,
        HighFunction high,
        List<PcodeOpAST> operations,
        PcodeOpAST operation,
        String readBufferParameter,
        Set<String> activeContexts,
        Map<String, CodecWireTrace> completedContexts) {

        ArrayList<CodecWireEvent> events = new ArrayList<>();
        if (operation.getOpcode() == PcodeOp.CALL) {
            collectCodecCallEvents(
                function,
                high,
                operations,
                operation,
                new PcodeStorage(readBufferParameter, 0L),
                activeContexts,
                completedContexts,
                events);
            return List.copyOf(events);
        }
        CodecWireEvent direct = directCursorReadEvent(
            high,
            operation,
            operations,
            readBufferParameter);
        return direct == null ? List.of() : List.of(direct);
    }

    private record UnmarshalIterationEvent(
        PcodeOpAST operation,
        List<CodecWireEvent> events) {
    }

    private record UnmarshalSequenceSummary(
        List<CodecWireEvent> events,
        int elementEventCount,
        UnmarshalStaticSequenceStorage storage,
        PcodeOpAST emissionOperation,
        Set<PcodeOpAST> operations) {
    }

    private record UnmarshalSequenceAction(
        List<CodecWireEvent> events,
        int elementEventCount,
        UnmarshalStaticSequenceStorage storage,
        boolean emit) {
    }

    private record UnmarshalStaticSequenceStorage(
        PcodeOpAST induction,
        PcodeStorage data,
        long stride,
        int iterations) {
    }
